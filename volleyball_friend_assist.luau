local function updateAimPower()
    observeReceivePass()
    if powerHeld and os.clock() >= powerHeld.releaseAt then releaseAimPower() end
    if not alive or not api.Config.AimBot then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local power = char and char:FindFirstChild("Power")
    local now = os.clock()
    if not root or not humanoid or not power or humanoid.Health <= 0 or root.Anchored or humanoid.Sit
        or not receiveFocused or UIS:GetFocusedTextBox() or GuiService.MenuIsOpen
        or humanoid.FloorMaterial == Enum.Material.Air or player:GetAttribute("NG_InAria") == true
        or player:GetAttribute("NG_PuoBattere") == true or player:GetAttribute("NG_InMatch") == false
        or now < (api.DiveBusyUntil or 0) then
        releaseAimPower(); powerAwaiting, api.AimPower = nil, nil; return
    end
    for _, attribute in ipairs({"NG_StunLocale", "NG_BloccoComandi", "NG_MinigiocoBattuta"}) do
        local blockedUntil = tonumber(player:GetAttribute(attribute))
        if blockedUntil and now < blockedUntil then releaseAimPower(); return end
    end
    if powerAwaiting then
        if powerAwaiting.character ~= char then powerAwaiting = nil; releaseAimPower(); return end
        if power.Value ~= powerAwaiting.before then
            api.AimMetrics.PowerAcknowledged += 1; powerAwaiting = nil
        elseif now >= powerAwaiting.deadline then
            api.AimMetrics.PowerTimeouts += 1
            log("receive_power_timeout", {before = powerAwaiting.before, current = power.Value})
            powerAwaiting, powerNext = nil, now+1
            releaseAimPower()
            aimStatus.Text = "AimBot: power input unacknowledged"
            return
        else return end
    end
    if powerHeld or now < powerNext or (now < aimUntil and not (aimSession and aimSession.preparing)) then return end
    if aimSession and aimSession.preparing and aimSession.contactAt-now <= math.max(0.1,receivePing*2+0.04) then
        -- Keep the last acknowledged safe value near contact; don't chase power while moving into the ball.
        return
    end
    powerNext = now + 0.08
    local target, name = api.GetReceiveTarget()
    if aimSession and aimSession.preparing then target,name=aimSession.target,aimSession.name end
    local area = api.GetReceiveArea()
    local net = api.ServeViewerNet(root.Position, netCache)
    if not target or not area or not net then return end
    local cache = workspace:FindFirstChild("BallCache")
    local incoming
    for _, ball in ipairs(cache and cache:GetChildren() or {}) do
        local pos, vel = ball:FindFirstChild("Position"), ball:FindFirstChild("Velocity")
        local owner = ball:GetAttribute("NG_UltimoTocco") or ball:GetAttribute("NG_ToccoUltimo")
        if ball.Name == "Ball" and not ball:GetAttribute("DeadAt") and not ball:GetAttribute("Settling")
            and pos and vel and owner ~= player.UserId and api.TargetNearNet(pos.Value, net, netCache) then
            local delta, motion = flat(pos.Value-root.Position), flat(vel.Value-root.AssemblyLinearVelocity)
            local time = motion.Magnitude > 0.1 and math.clamp(-delta:Dot(motion)/motion:Dot(motion), 0, 1.2) or 0
            if delta.Magnitude < 60 and (delta:Dot(motion) < -0.1 or delta.Magnitude <= area.radius)
                and (delta+motion*time).Magnitude <= area.radius+4 then
                local spin = ball:FindFirstChild("Spin")
                local sample = {position = pos.Value, velocity = vel.Value, eventN = ball:GetAttribute("NG_EvN"),
                    eventTime = ball:GetAttribute("NG_EvT"), spin = spin and spin.Value or Vector3.zero,
                    gravity = ball:GetAttribute("NG_GravFattore"), side = ball:GetAttribute("NG_SpinOltreRete"),
                    rampFraction = ball:GetAttribute("NG_SpinRampaFraz"), rampExponent = ball:GetAttribute("NG_SpinRampaEsp"),
                    rampMin = ball:GetAttribute("NG_SpinRampaMin")}
                if api.CheckIncomingBounds(ball, sample, net, root.Position) then incoming = ball; break end
            end
        end
    end
    if not incoming then
        api.AimPower = nil
        aimStatus.Text = "AimBot: " .. name .. " / armed"
        return
    end
    local binds = player:FindFirstChild("Keybinds")
    local presets = powerPresets(binds)
    local simple = player:GetAttribute("NG_SimplePowers") ~= false
    local choices = simple and {1,8,15} or {}
    if not simple then for index=1,15 do table.insert(choices,index) end end
    for _, preset in ipairs(presets) do table.insert(choices,preset.power) end
    local contactLead = aimSession and aimSession.preparing and math.clamp(aimSession.contactAt-now,0,0.35) or 0
    local projectedRoot = root.Position+root.AssemblyLinearVelocity*contactLead
    local distance = flat(target-projectedRoot).Magnitude
    local kind = receiveKind(incoming)
    local desired, miss = api.PickSafeReceivePower(projectedRoot,target,net,choices,kind)
    if not desired then
        api.AimPower={ready=false,safe=false,target=name,reason=miss}
        aimStatus.Text="AimBot: no safe own-side pass"
        return
    end
    api.AimPower = {desired = desired, current = power.Value, ready = power.Value == desired,
        distance = distance, estimatedMiss = miss, target = name, kind = kind, estimated = true,safe=true}
    aimStatus.Text = string.format("AimBot: %s / P%d%s ~",name,desired,power.Value==desired and "" or " preparing")
    if power.Value == desired then return end
    local key, stepDistance = nil, math.abs(desired-power.Value)
    for _, preset in ipairs(presets) do
        local distanceFromGoal = math.abs(desired-preset.power)
        if distanceFromGoal < stepDistance then key,stepDistance=preset.key,distanceFromGoal end
    end
    if not key then key = binds and binds:GetAttribute(desired>power.Value and "IncreasePowerKey" or "DecreasePowerKey") end
    local scripts = player:FindFirstChild("PlayerScripts")
    local input = scripts and scripts:FindFirstChild("Input")
    local bridge = input and input:FindFirstChild("NG_InputVirtuale")
    if type(key) ~= "string" or not bridge or not bridge:IsA("BindableEvent") then
        aimStatus.Text = "AimBot: native power input unavailable"; powerNext = now+1; return
    end
    local held = {bridge = bridge, key = key, releaseAt = now+0.02}
    powerHeld = held
    powerAwaiting = {before = power.Value, character = char, deadline = now+0.45+receivePing}
    local ok, err = pcall(function() bridge:Fire("tasto", key, true) end)
    if not ok then
        releaseAimPower(); powerAwaiting, powerNext = nil, now+1
        api.AimMetrics.Errors += 1; api.AimMetrics.LastError = tostring(err); return
    end
    api.AimMetrics.PowerInputs += 1
    log("receive_power_input", {key = key, before = powerAwaiting and powerAwaiting.before,
        desired = desired, distance = distance, estimated = true})
    task.delay(0.02, function() if powerHeld == held then releaseAimPower() end end)
end
