local aimFeature = loadOptionalOverlay("AimBot", function()
-- AIM_RUNTIME_BEGIN
-- No camera writes. Facing is armed only for a receive, never while idle.
local aimUntil, aimCharacter, aimAutoRotate, aimOrigin = 0, nil, nil, nil
local aimSession, pendingPass
local receiveLockOverride
local finishedAimFlights = setmetatable({}, {__mode = "k"})
local powerHeld, powerAwaiting, powerNext = nil, nil, 0
local unsafePasses = setmetatable({}, {__mode = "k"})
api.AimMetrics = {Turns = 0, Prepares = 0, Commits = 0, FacingWaits = 0, NativeLockOverrides = 0, Errors = 0, PowerInputs = 0, PowerAcknowledged = 0, PowerTimeouts = 0,
    LaunchStops = 0, FeedbackSamples = 0, FeedbackRejected = 0, UnsafePassSkips = 0}
-- Measured native-physics ground ranges from standing receives on 2026-10-14.
-- Different traits/heights and hard-spike receive modifiers can change these estimates.
api.ReceivePowerCalibration = {Ready = true, Estimated = true, SourceUserId = 58427452,
    Anchors = {{power = 3, distance = 36.49}, {power = 8, distance = 76.42}, {power = 13, distance = 111.06}}}
api.ReceivePowerFeedback = type(savedReceiveFeedback) == "table" and savedReceiveFeedback.UserId == player.UserId
    and savedReceiveFeedback.Height == player:GetAttribute("Height") and savedReceiveFeedback
    or {UserId = player.UserId, Height = player:GetAttribute("Height"), Groups = {}}
local function receiveKind(ball)
    if ball and ball:GetAttribute("NG_Battuta") == true then return "serve" end
    local kind = ball and ball:GetAttribute("NG_UltimoTipo")
    return (kind == "Spike" or (tonumber(ball and ball:GetAttribute("NG_PotSpike")) or 0) > 0) and "spike" or "normal"
end
function api.ReceiveDistanceForPower(power, kind)
    local anchors = api.ReceivePowerCalibration.Anchors
    local low, high = anchors[1], anchors[2]
    for index = 2, #anchors do
        low, high = anchors[index-1], anchors[index]
        if power <= high.power then break end
    end
    local correction = kind and api.ReceivePowerFeedback.Groups[kind]
    return low.distance + (high.distance - low.distance) * (power - low.power) / (high.power - low.power)
        + (correction and correction.offset or 0)
end
function api.ReceivePowerForDistance(distance, choices, kind)
    local best, error = nil, math.huge
    for _, power in ipairs(choices) do
        local difference = api.ReceiveDistanceForPower(power, kind) - distance
        -- When choices are coarse, prefer a small undershoot over an equally large overshoot.
        local cost = math.abs(difference) * (difference > 0 and 1.35 or 1)
        if cost < error then best, error = power, cost end
    end
    return best, best and math.abs(api.ReceiveDistanceForPower(best, kind) - distance) or math.huge
end
function api.ReceiveFallbackPoint(position, net, height)
    if not position or not net then return nil end
    local side = flat(position - net.center):Dot(net.normal) >= 0 and 1 or -1
    -- Bias inside the front zone toward the net, with room for the safety buffer.
    local depth = math.max(api.Config.ReceiveNetBuffer + 2, net.halfDepth / 3 * api.Config.ReceiveFrontZoneFraction)
    local center = net.center + net.normal * side * depth
    return Vector3.new(center.X, height or position.Y, center.Z)
end
function api.GetReceiveTarget()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local head = char and char:FindFirstChild("Head")
    local net = root and api.ServeViewerNet(root.Position, netCache)
    if not root or not net then return nil, "waiting for court" end
    if api.Config.ReceiveAimMode == "FrontZoneTest" then
        return api.ReceiveFallbackPoint(root.Position, net, head and head.Position.Y), "front-zone test", nil, "test"
    end
    for _, candidate in ipairs(Players:GetPlayers()) do
        if candidate ~= player and candidate.UserId == 58427452 then
            local other = candidate.Character
            local targetRoot = other and other:FindFirstChild("HumanoidRootPart")
            local targetHead = other and other:FindFirstChild("Head")
            local humanoid = other and other:FindFirstChildOfClass("Humanoid")
            if other and other.Parent and targetRoot and humanoid and humanoid.Health > 0 then
                return Vector3.new(targetRoot.Position.X, targetHead and targetHead.Position.Y or targetRoot.Position.Y,
                    targetRoot.Position.Z), "KEDO_EV", candidate, "player"
            end
        end
    end
    return api.ReceiveFallbackPoint(root.Position, net, head and head.Position.Y), "front-zone center", nil, "fallback"
end
function api.IsReceivePowerSafe(position, target, net, power, kind)
    if not position or not target or not net or not power then return false, "pass unavailable" end
    local direction = flat(target-position)
    local sideDepth = flat(position-net.center):Dot(net.normal)
    if direction.Magnitude < 0.05 or math.abs(sideDepth)<0.15 then return false, "pass unavailable" end
    local endpoint = position + direction.Unit * math.max(0,api.ReceiveDistanceForPower(power,kind))
    local ownDepth = flat(endpoint-net.center):Dot(net.normal) * (sideDepth>0 and 1 or -1)
    local inCourt = api.IsLandingInOwnCourt(position,endpoint,net)
    if not inCourt or ownDepth < api.Config.ReceiveNetBuffer then return false, "overpass / out risk", endpoint end
    return true, "buffered own-side pass", endpoint
end
function api.PickSafeReceivePower(position,target,net,choices,kind)
    local safe = {}
    for _,power in ipairs(choices) do
        if api.IsReceivePowerSafe(position,target,net,power,kind) then table.insert(safe,power) end
    end
    if #safe==0 then return nil, "no buffered pass power" end
    local distance=flat(target-position).Magnitude
    local desired=api.ReceivePowerForDistance(math.max(0,distance-api.Config.ReceivePassShortBias),safe,kind)
    local boosted=desired+math.max(0,math.floor(api.Config.ReceivePowerBonus))
    local ownSide=flat(position-net.center):Dot(net.normal)>0 and 1 or -1
    local towardNet=flat(target-position):Dot(net.normal)*ownSide < -0.05
    if towardNet then for _,power in ipairs(safe) do if power==boosted then desired=boosted;break end end end
    return desired, math.abs(api.ReceiveDistanceForPower(desired,kind)-distance)
end
function api.CanCommitReceivePass(ball)
    if not api.Config.AimBot then return true end
    local char=player.Character
    local root,power=char and char:FindFirstChild("HumanoidRootPart"),char and char:FindFirstChild("Power")
    local target=aimSession and aimSession.ball==ball and aimSession.target or api.GetReceiveTarget()
    local net=root and api.ServeViewerNet(root.Position,netCache)
    local position=root and root.Position+root.AssemblyLinearVelocity*(api.ReceiveTiming and api.ReceiveTiming.leadSeconds or 0)
    local safe,reason,endpoint=api.IsReceivePowerSafe(position,target,net,power and power.Value,receiveKind(ball))
    if powerAwaiting and power and powerAwaiting.character==char and power.Value~=powerAwaiting.before then
        api.AimMetrics.PowerAcknowledged+=1
        powerAwaiting=nil
    end
    if powerAwaiting then safe,reason=false,"power not acknowledged" end
    api.LastPassSafety={safe=safe,reason=reason,endpoint=endpoint,power=power and power.Value,predicted=true}
    if not safe and ball then
        local key=tostring(ball:GetAttribute("NG_EvN"))..":"..tostring(ball:GetAttribute("NG_EvT"))
        if unsafePasses[ball]~=key then
            unsafePasses[ball]=key
            api.AimMetrics.UnsafePassSkips+=1
            log("receive_pass_skipped",api.LastPassSafety)
        end
    end
    return safe
end
local function stopReceiveAim()
    -- Do not replay an old camera-lock goal after launch. Native camera control resumes itself.
    local humanoid = aimCharacter and aimCharacter:FindFirstChildOfClass("Humanoid")
    local root = aimCharacter and aimCharacter:FindFirstChild("HumanoidRootPart")
    if humanoid and aimAutoRotate ~= nil and not (root and root:FindFirstChild("NG_LockCamera")) then
        humanoid.AutoRotate = aimAutoRotate
    end
    aimUntil, aimCharacter, aimAutoRotate, aimOrigin = 0, nil, nil, nil
    aimSession = nil
    api.LastReceiveAim = nil
    api.ReceiveFacing = nil
end
local function receiveFacingSample(root, session)
    local untilContact = math.clamp((session.contactAt or os.clock())-os.clock()+receivePing,0,0.3)
    local contactPosition = root.Position + flat(root.AssemblyLinearVelocity)*untilContact
    local direction = flat(session.target - contactPosition)
    local look = flat(root.CFrame.LookVector)
    if direction.Magnitude < 0.05 or look.Magnitude < 0.05 then session.stableSince = nil; return end
    direction = direction.Unit
    local angle = math.deg(math.acos(math.clamp(look.Unit:Dot(direction),-1,1)))
    local limit = math.clamp(api.Config.ReceiveAimMaxErrorDegrees,0.5,8)
    if angle > limit then
        session.stableSince,session.stableHeading = nil,nil
    elseif not session.stableSince then
        session.stableSince,session.stableHeading = os.clock(),direction
    end
    local required = math.clamp(math.max(api.Config.ReceiveAimSettleSeconds,receivePing*2+0.025),0.06,0.2)
    local stableFor = session.stableSince and os.clock()-session.stableSince or 0
    api.ReceiveFacing = {angleError=angle,stableSeconds=stableFor,requiredSeconds=required,
        ready=session.stableSince~=nil and stableFor>=required,eventN=session.eventN,
        projectedContact=contactPosition,moving=flat(root.AssemblyLinearVelocity).Magnitude>0.5}
    return api.ReceiveFacing
end
function api.IsReceiveFacingReady(ball)
    local session = aimSession
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not session or not root or not ball or not alive or not api.Config.AimBot or os.clock()>=aimUntil
        or session.character~=player.Character or session.ball~=ball
        or ball:GetAttribute("NG_EvN")~=session.eventN or ball:GetAttribute("NG_EvT")~=session.eventTime then
        return false
    end
    local sample = receiveFacingSample(root,session)
    if not sample or not sample.ready then api.AimMetrics.FacingWaits+=1;return false end
    return true
end
local function restoreReceiveLock()
    if not receiveLockOverride then return end
    local override = receiveLockOverride
    receiveLockOverride = nil
    if player:GetAttribute("NG_ReceiveLock") == false then player:SetAttribute("NG_ReceiveLock", override.original) end
end
local function suppressReceiveCameraLock()
    if receiveLockOverride or player:GetAttribute("NG_ReceiveLock") ~= true then return end
    local override = {original = true}
    receiveLockOverride = override
    player:SetAttribute("NG_ReceiveLock", false)
    api.AimMetrics.NativeLockOverrides += 1
    -- Prevent the native receive-start camera lock from fighting the requested body yaw.
    -- Restore the setting immediately after the input window, not for the whole assist session.
    task.delay(0.08, function() if receiveLockOverride == override then restoreReceiveLock() end end)
end
function api.CancelReceiveAim()
    stopReceiveAim()
    pendingPass = nil
    restoreReceiveLock()
end
function api.SetReceiveAimMode(mode)
    assert(mode == "Player" or mode == "FrontZoneTest", "Unknown receive aim mode")
    api.CancelReceiveAim()
    api.Config.ReceiveAimMode = mode
    aimStatus.Text = mode == "FrontZoneTest" and "AimBot: front-zone test target" or "AimBot: KEDO_EV / fallback"
end
local function observeReceivePass()
    local pass = pendingPass
    if not pass then return end
    local ball, now = pass.ball, os.clock()
    if not ball or not ball.Parent or now > pass.feedbackUntil or player.Character ~= pass.character then pendingPass = nil; return end
    if ball:GetAttribute("NG_EvN") == pass.eventN and ball:GetAttribute("NG_EvT") == pass.eventTime then
        local owner = ball:GetAttribute("NG_UltimoTocco") or ball:GetAttribute("NG_ToccoUltimo")
        local kind = ball:GetAttribute("NG_UltimoTipo")
        if owner == player.UserId and (kind == "Bump" or kind == "Receive") and aimSession == pass then
            -- Contact attributes can arrive before the new flight payload. Release yaw now, sample later.
            finishedAimFlights[ball] = {eventN = pass.eventN, eventTime = pass.eventTime}
            api.AimMetrics.LaunchStops += 1
            stopReceiveAim()
        end
        return
    end
    pendingPass = nil
    finishedAimFlights[ball] = {eventN = pass.eventN, eventTime = pass.eventTime}
    if aimSession == pass then
        api.AimMetrics.LaunchStops += 1
        stopReceiveAim()
    end
    local owner = ball:GetAttribute("NG_UltimoTocco") or ball:GetAttribute("NG_ToccoUltimo")
    local kind = ball:GetAttribute("NG_UltimoTipo")
    local origin, velocity = ball:GetAttribute("NG_EvP"), ball:GetAttribute("NG_EvV")
    local power = pass.character:FindFirstChild("Power")
    local floor = tonumber(workspace:GetAttribute("NG_QuotaSuolo")) or tuning.QUOTA_CAMPO or 0.408
    if owner ~= player.UserId or (kind ~= "Bump" and kind ~= "Receive") or ball:GetAttribute("DeadAt")
        or ball:GetAttribute("Settling") or typeof(origin) ~= "Vector3" or typeof(velocity) ~= "Vector3"
        or origin.Y <= floor + api.Config.CollisionRadius + 0.1 or velocity.Y <= 1
        or not pass.powerStable or powerAwaiting or not power or power.Value ~= pass.power then
        api.AimMetrics.FeedbackRejected += 1; return
    end
    local flight = api.Flight(origin, velocity, floor, {spin = ball:GetAttribute("NG_EvS") or Vector3.zero,
        gravity = ball:GetAttribute("NG_GravFattore"), side = ball:GetAttribute("NG_SpinOltreRete"),
        rampFraction = ball:GetAttribute("NG_SpinRampaFraz"), rampExponent = ball:GetAttribute("NG_SpinRampaEsp"),
        rampMin = ball:GetAttribute("NG_SpinRampaMin")})
    local delta = flat(flight.landing - pass.target)
    local longitudinal = delta:Dot(pass.direction)
    local lateral = (delta - pass.direction * longitudinal).Magnitude
    local actualRange = flat(flight.landing - pass.rootPosition):Dot(pass.direction)
    local residual = actualRange - api.ReceiveDistanceForPower(pass.power)
    api.LastPassFeedback = {power = pass.power, kind = pass.kind, target = pass.target,
        landing = flight.landing, alongError = longitudinal, lateralError = lateral,
        launchAngleError = flat(velocity).Magnitude > 0.001 and math.deg(math.acos(math.clamp(flat(velocity).Unit:Dot(pass.direction),-1,1))) or 0,
        predicted = true, used = false}
    -- Bad-facing/misdirected launches must not corrupt the distance calibration.
    if lateral > 8 or actualRange <= 0 or math.abs(residual) > 40 then
        api.AimMetrics.FeedbackRejected += 1
        log("receive_power_feedback_rejected", api.LastPassFeedback)
        return
    end
    local group = api.ReceivePowerFeedback.Groups[pass.kind]
    local cap = math.max(0, api.Config.ReceiveFeedbackMaxCorrection)
    local offset = math.clamp(residual, -cap, cap)
    if group then offset = group.offset * 0.65 + offset * 0.35 end
    api.ReceivePowerFeedback.Groups[pass.kind] = {offset = offset, samples = math.min(1000, (group and group.samples or 0) + 1)}
    api.LastPassFeedback.used = true
    api.LastPassFeedback.correction = offset
    api.AimMetrics.FeedbackSamples += 1
    log("receive_power_feedback", api.LastPassFeedback)
end
local function faceReceiveTarget()
    observeReceivePass()
    if aimSession and aimSession.preparing and aimSession.ball and
        (not aimSession.ball.Parent or aimSession.ball:GetAttribute("NG_EvN") ~= aimSession.eventN
            or aimSession.ball:GetAttribute("NG_EvT") ~= aimSession.eventTime) then stopReceiveAim(); return false end
    if not alive or not api.Config.AimBot or os.clock() >= aimUntil or player.Character ~= aimCharacter
        or UIS:GetFocusedTextBox() or GuiService.MenuIsOpen or not receiveFocused
        or os.clock() < (api.DiveBusyUntil or 0) then stopReceiveAim(); return false end
    local root = aimCharacter and aimCharacter:FindFirstChild("HumanoidRootPart")
    local humanoid = aimCharacter and aimCharacter:FindFirstChildOfClass("Humanoid")
    local target, name = aimSession and aimSession.target, aimSession and aimSession.name
    if not root or not humanoid or humanoid.Health <= 0 or root.Anchored or humanoid.Sit
        or humanoid.FloorMaterial == Enum.Material.Air or player:GetAttribute("NG_InAria") == true
        or not target then stopReceiveAim(); return false end
    local untilContact = math.clamp((aimSession.contactAt or os.clock())-os.clock()+receivePing,0,0.3)
    local direction = flat(target - (root.Position + flat(root.AssemblyLinearVelocity)*untilContact))
    if direction.Magnitude < 0.05 then stopReceiveAim(); return false end
    if aimAutoRotate == nil then aimAutoRotate = humanoid.AutoRotate end
    receiveFacingSample(root,aimSession)
    humanoid.AutoRotate = false
    local frame = CFrame.lookAt(root.Position, root.Position + direction.Unit)
    root.CFrame = frame
    local lock = root:FindFirstChild("NG_LockCamera")
    if lock and lock:IsA("AlignOrientation") then
        lock.CFrame = frame
    end
    local power = aimCharacter:FindFirstChild("Power")
    api.LastReceiveAim = {target = target, name = name, expires = aimUntil,
        targetUserId = aimSession.targetUserId, source = aimSession.source,
        power = power and power.Value, estimated = true, powerReady = api.AimPower and api.AimPower.ready or false}
    return true
end
function api.AimReceive(origin, lead, ball, preparing)
    if not api.Config.AimBot then return false end
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 or humanoid.Sit or humanoid.FloorMaterial == Enum.Material.Air
        or player:GetAttribute("NG_InAria") == true or player:GetAttribute("NG_PuoBattere") == true
        or player:GetAttribute("NG_InMatch") == false then return false end
    for _, attribute in ipairs({"NG_StunLocale", "NG_BloccoComandi", "NG_MinigiocoBattuta"}) do
        local blockedUntil = tonumber(player:GetAttribute(attribute))
        if blockedUntil and os.clock() < blockedUntil then return false end
    end
    local target, name, targetPlayer, source = api.GetReceiveTarget()
    if not target then aimStatus.Text = "AimBot: " .. name; return false end
    local eventN, eventTime = ball and ball:GetAttribute("NG_EvN"), ball and ball:GetAttribute("NG_EvT")
    local owner = ball and (ball:GetAttribute("NG_UltimoTocco") or ball:GetAttribute("NG_ToccoUltimo"))
    if ball and (not ball.Parent or ball:GetAttribute("DeadAt") or ball:GetAttribute("Settling") or owner == player.UserId) then return false end
    local finished = ball and finishedAimFlights[ball]
    if finished and finished.eventN == eventN and finished.eventTime == eventTime then return false end
    if aimSession and ball and aimSession.ball == ball and aimSession.eventN == eventN and aimSession.eventTime == eventTime then
        if preparing and aimSession.preparing then aimSession.contactAt=os.clock()+(lead or 0) end
        if not preparing and aimSession.preparing then
            local root, power = char:FindFirstChild("HumanoidRootPart"), char:FindFirstChild("Power")
            if not root or not power then api.CancelReceiveAim(); return false end
            aimSession.preparing, aimSession.power, aimSession.powerStable = false, power.Value, powerAwaiting == nil
            aimSession.contactAt=os.clock()+(lead or 0)
            aimSession.rootPosition = root.Position
            local direction = flat(aimSession.target - root.Position)
            if direction.Magnitude < 0.05 then api.CancelReceiveAim(); return false end
            aimSession.direction = direction.Unit
            aimSession.feedbackUntil = os.clock() + math.max(0.9, (lead or 0) + 2 * receivePing + 0.5)
            aimUntil = os.clock() + math.clamp((lead or 0) + receivePing + 0.18, 0.2, 0.55)
            pendingPass = aimSession
            api.AimMetrics.Commits += 1
            suppressReceiveCameraLock()
            log("receive_aim_commit", {target = aimSession.target, targetUserId = aimSession.targetUserId,
                source = aimSession.source, settleSeconds = os.clock() - aimSession.armedAt, power = power.Value,
                movementSpeed=flat(root.AssemblyLinearVelocity).Magnitude,
                stableSeconds=api.ReceiveFacing and api.ReceiveFacing.stableSeconds,
                angleError=api.ReceiveFacing and api.ReceiveFacing.angleError})
        end
        return true
    end
    stopReceiveAim()
    local root = char:FindFirstChild("HumanoidRootPart")
    local power = char:FindFirstChild("Power")
    if not root or not power then return false end
    local direction = flat(target - root.Position)
    if direction.Magnitude < 0.05 then return false end
    aimCharacter = player.Character
    aimOrigin = origin
    aimUntil = os.clock() + math.clamp((lead or 0) + receivePing + 0.18, 0.2, 0.55)
    aimSession = {ball = ball, eventN = eventN, eventTime = eventTime, target = target, name = name,
        targetUserId = targetPlayer and targetPlayer.UserId, source = source,
        preparing = preparing == true, armedAt = os.clock(), contactAt = os.clock() + (lead or 0),
        rootPosition = root.Position, direction = direction.Unit, power = power.Value, kind = receiveKind(ball),
        powerStable = powerAwaiting == nil, character = char,
        feedbackUntil = os.clock() + math.max(0.9, (lead or 0) + 2 * receivePing + 0.5)}
    pendingPass = ball and not preparing and aimSession or nil
    local ok = faceReceiveTarget()
    if ok then
        api.AimMetrics.Turns += 1
        if preparing then api.AimMetrics.Prepares += 1 else api.AimMetrics.Commits += 1 end
        if not preparing then suppressReceiveCameraLock() end
        aimStatus.Text = "AimBot: " .. name .. " / receive"
        log("receive_aim", {target = target, name = name, targetUserId = aimSession.targetUserId, source = source,
            origin = origin, estimated = true, movementSpeed=flat(root.AssemblyLinearVelocity).Magnitude,
            preparing = preparing == true, settleSeconds = 0,
            powerReady = api.AimPower and api.AimPower.ready or false})
    else
        api.CancelReceiveAim()
    end
    return ok
end
function api.PrepareReceiveAim(origin, lead, ball)
