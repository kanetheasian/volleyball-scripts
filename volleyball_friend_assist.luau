        corner(object, 6); return object
    end
    local window = make("Frame", {Name = "ControlCenter", Size = UDim2.fromOffset(780, 560),
        Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
