connect(UIS.InputBegan, function(input, processed)
    if processed or UIS:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.Five then api.SetAutoAim(not api.Config.AutoAim); updateButtons() end
    if input.KeyCode == Enum.KeyCode.Six and api.FullAssist then api.FullAssist.Toggle(); return end
    local syntheticJump = api.FullAssist and api.FullAssist.IsSyntheticJump()
    local syntheticMouse = api.FullAssist and api.FullAssist.IsSyntheticMouse()
    if input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.S
        or input.KeyCode == Enum.KeyCode.D then cancelFull("Manual movement override") end
    local binds = player:FindFirstChild("Keybinds")
    if binds and input.KeyCode and input.KeyCode.Name == binds:GetAttribute("SprintKey") then cancelFull("Manual sprint override") end
    if input.KeyCode == Enum.KeyCode.Space and not syntheticJump then
        cancelFull("Manual jump override")
        local state = readState()
        if api.FullAssist then api.FullAssist.OnJumpIntent(state) end
        armJump(state)
    end
    if input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.R then
        cancelFull("Manual set / receive override")
        jumpStopped, jumpCancelled = true, true; stopAim(); currentPlan = nil
    end
    if input.UserInputType == Enum.UserInputType.MouseButton1 and not syntheticMouse then cancelFull("Manual spike override") end
    if input.UserInputType == Enum.UserInputType.MouseButton1 and not syntheticMouse and currentState and currentState.airborne
        and player:GetAttribute("NG_JumpMode") == "spike" then
        local state = readState()
        recordShot(state, false)
        if api.FullAssist then api.FullAssist.OnManualShot(state) end
    end
end)
local function scan()
    refreshNets()
    refreshBlockAnimations()
    local keep = {}
    local cache = workspace:FindFirstChild("BallCache")
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local available = {}
    for _, ball in ipairs(cache and cache:GetChildren() or {}) do
        local sample = readBall(ball)
        local viewerNet = root and netAt(root.Position, 20)
        local floor = tonumber(workspace:GetAttribute("NG_QuotaSuolo")) or tuning.QUOTA_CAMPO or 0.408
        if sample and sample.position.Y > floor + api.Config.CollisionRadius + 0.02
            and sample.velocity.Magnitude >= 0.1 and viewerNet and netAt(sample.position, 20) == viewerNet then
            available[#available + 1] = {ball = ball, distance = (sample.position - root.Position).Magnitude}
        end
    end
    table.sort(available, function(a, b) return a.distance < b.distance end)
    for index = 1, math.min(api.Config.MaxBalls, #livePaths, #available) do
        local ball = available[index].ball
        keep[ball] = true
        if not tracked[ball] then tracked[ball] = {highlight = make("Highlight", {Name = "BallGlow",
            DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, FillColor = Color3.fromRGB(255, 231, 90),
            OutlineColor = Color3.new(1, 1, 1), FillTransparency = 0.55, OutlineTransparency = 0}, world)} end
    end
    for ball, record in pairs(tracked) do if not keep[ball] then record.highlight:Destroy(); tracked[ball] = nil end end
    local roster, count = {}, 0
    for _, candidate in ipairs(Players:GetPlayers()) do
        if count < api.Config.MaxPlayers then
            roster[candidate], count = true, count + 1
            if not blockRecords[candidate] then blockRecords[candidate] = {} end
        end
    end
    for candidate, record in pairs(blockRecords) do if not roster[candidate] then
        for _, adorn in ipairs(record) do adorn:Destroy() end
        blockRecords[candidate] = nil
    end end
end
local function updateOverlays(state)
    for candidate, record in pairs(blockRecords) do
        local character = candidate.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local sameCourt = state and root and api.InCourt(root.Position, state.net, -8)
        local enabled = sameCourt and api.IsBlocking(candidate) and (candidate == player and api.Config.ShowOwnBlocks
            or candidate ~= player and api.Config.ShowOtherBlocks)
        local shapes = enabled and api.GetBlockVolumes(character) or {}
        for index, shape in ipairs(shapes) do
            local adorn = record[index]
            if not adorn then
                adorn = make("BoxHandleAdornment", {Name = "BlockVolume", AlwaysOnTop = true, ZIndex = 2,
                    Transparency = 0.8}, world)
                record[index] = adorn
            end
            adorn.Adornee, adorn.Size = shape.source, shape.size
            adorn.CFrame = shape.source.CFrame:ToObjectSpace(shape.frame)
            adorn.Color3 = candidate ~= player and colors.other or shape.kind == "hands" and colors.hands or colors.block
            adorn.Visible = true
        end
        for index = #shapes + 1, #record do record[index].Visible = false; record[index].Adornee = nil end
    end
    if state and state.volume and api.Config.ShowSpikeHitbox then
        spikeAnchor.CFrame = state.volume.frame or CFrame.new(state.volume.center)
        spikeAdornment.Radius = math.max(state.volume.radii.X, state.volume.radii.Y, state.volume.radii.Z)
        spikeAdornment.Visible = state.volume.kind == "sphere"
        spikeBoxAdornment.Size = state.volume.radii * 2
        spikeBoxAdornment.Visible = state.volume.kind == "box"
        api.LastSpikeVolume = state.volume
    else spikeAdornment.Visible = false; spikeBoxAdornment.Visible = false; api.LastSpikeVolume = nil end
    for ball, record in pairs(tracked) do
        local sample = readBall(ball)
        local mesh = ball:FindFirstChild("Ball1") or ball:FindFirstChild("Ball")
        record.highlight.Adornee = mesh and mesh:IsA("BasePart") and mesh or nil
        record.highlight.Enabled = sample ~= nil and api.Config.HighlightBall and record.highlight.Adornee ~= nil
    end
end
local function observeLaunch(ball, sample, record)
    local eventKey = tostring(sample.eventN) .. ":" .. tostring(sample.eventT)
    local owner = ball:GetAttribute("NG_UltimoTocco") or ball:GetAttribute("NG_ToccoUltimo")
    local kind = tostring(ball:GetAttribute("NG_UltimoTipo") or ""):lower()
    if owner == player.UserId and (kind:find("spik", 1, true) or kind:find("schiacc", 1, true)) then
        jumpStopped = true; currentPlan = nil
        releaseTiltKeys()
        api.PlanPreview = nil
        -- Ownership/type may replicate after NG_EvN. Do not consume the event until
        -- it is identifiable as our spike; never compare against a pre-click flight.
        local shot = api.LastShot
        if shot and shot.ball == ball and shot.eventN == sample.eventN and shot.eventT == sample.eventT
            and os.clock() - shot.time <= 1.5 then return end
        if record.ownEventKey == eventKey or record.ownLogged then return end
        record.ownEventKey, record.ownLogged = eventKey, true
        if api.FullAssist then api.FullAssist.OnOwnLaunch(ball, sample) end
        local velocity = ball:GetAttribute("NG_EvV")
        local entry = {eventN = sample.eventN, observedVelocity = velocity, position = ball:GetAttribute("NG_EvP"),
            time = os.clock(), source = "replicated own spike", tilt = player:GetAttribute("TiltValue")}
        if shot and entry.time - shot.time >= 0 and entry.time - shot.time <= 1.5
            and shot.ball == ball and api.ValidVector(velocity) and api.ValidVector(shot.velocity) then
            entry.modelVelocityError = (velocity - shot.velocity).Magnitude
            entry.power = shot.power
            entry.clickTilt, entry.planned = shot.tilt, shot.planned
        end
        if api.ValidVector(velocity) and api.ValidVector(entry.position) then
            local flight = api.Flight(entry.position, velocity, tonumber(workspace:GetAttribute("NG_QuotaSuolo")) or tuning.QUOTA_CAMPO or 0.408,
                {net = netAt(entry.position, 20)})
            entry.landing = flight and flight.landing
            local net = netAt(entry.position, 20)
            entry.classification = flight and net and api.LandingClass(flight.landing, net)
        end
        api.LaunchHistory[#api.LaunchHistory + 1] = entry
        while #api.LaunchHistory > 40 do table.remove(api.LaunchHistory, 1) end
        api.Metrics.Launches += 1
        log("own_spike_launch", entry)
    else
        record.ownLogged = false
    end
end
local function solveFlights(state)
    api.CurrentFlights = {}
    if not state then for _, path in ipairs(livePaths) do hidePath(path) end; return end
    local index = 0
    for ball, record in pairs(tracked) do
        local sample = readBall(ball)
        if sample then
            observeLaunch(ball, sample, record)
            index += 1
            sample.net = state.net
            local current = api.Flight(sample.position, sample.velocity, state.floor, sample)
            drawPath(livePaths[index], current, state.net, state.floor)
            local owner = ball:GetAttribute("NG_UltimoTocco") or ball:GetAttribute("NG_ToccoUltimo")
            local kind = tostring(ball:GetAttribute("NG_UltimoTipo") or ""):lower()
            local ownSpike = owner == player.UserId and (kind:find("spik", 1, true) or kind:find("schiacc", 1, true)) ~= nil
            local entry = {ball = ball, eventN = sample.eventN, eventT = sample.eventT, flight = current, ownSpike = ownSpike}
            api.CurrentFlights[#api.CurrentFlights + 1] = entry
            if ownSpike then api.LastSpikeFlight = entry end
        end
    end
    for unused = index + 1, #livePaths do hidePath(livePaths[unused]) end
    status.Text = "Live ball paths: " .. tostring(index) .. " | Power " .. tostring(state.power)
    detail.Text = "Your shot path appears after actual spike contact.\nLanding is estimated; floating text is OUT only."
end
local function readFlightViewer()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local net = root and netAt(root.Position, 20)
    if not net or not humanoid or humanoid.Health <= 0 then return nil end
    local power = character:FindFirstChild("Power")
    return {net = net, floor = tonumber(workspace:GetAttribute("NG_QuotaSuolo")) or tuning.QUOTA_CAMPO or 0.408,
        power = power and power.Value or "?"}
end
local function tick(dt)
    if not alive or not api.Startup.Ready then return end
    scanElapsed, planElapsed, flightElapsed = scanElapsed + dt, planElapsed + dt, flightElapsed + dt
    if scanElapsed >= 1 / api.Config.ScanHz then scanElapsed = 0; scan() end
    for ball, record in pairs(tracked) do
        local sample = readBall(ball)
        if sample then
            if record.visualEventN ~= sample.eventN or record.visualEventT ~= sample.eventT then
                record.visualEventN, record.visualEventT, flightElapsed = sample.eventN, sample.eventT, 1
            end
            observeLaunch(ball, sample, record)
        end
    end
    currentState = readState()
    local state = currentState
    if not state then
        stopAim(); currentPlan = nil; api.PlanPreview = nil
        local viewer = readFlightViewer()
        status.Text = "Waiting for character / verified court"
        if flightElapsed >= 1 / api.Config.FlightHz then flightElapsed = 0; solveFlights(viewer) end
        return
    end
    if state.airborne and not airborneBefore then
        if not jumpAim then jumpStopped, jumpCancelled, clickedAt, jumpEdge, jumpTarget = false, false, nil, nil, nil end
        jumpStartedAt, jumpStartY, jumpPeakY = os.clock(), state.rootPosition.Y, state.rootPosition.Y
        if jumpAim then jumpAim.becameAirborne = true else api.JumpLock = nil end
        planElapsed = 1
    end
    if state.airborne then jumpPeakY = math.max(jumpPeakY or state.rootPosition.Y, state.rootPosition.Y) end
    if not state.airborne then
        groundObserved = true
        if airborneBefore and jumpStartedAt then
            api.LastJump = {rise = (jumpPeakY or jumpStartY) - jumpStartY, duration = os.clock() - jumpStartedAt, edge = jumpEdge}
            log("jump_complete", api.LastJump)
        end
        local windup = jumpAim and not jumpAim.becameAirborne and os.clock() - jumpAim.requestedAt <= 1.2
            and player:GetAttribute("NG_InAria") == true
        if not windup then
            jumpStopped, jumpCancelled, jumpEdge, jumpTarget, jumpStartedAt, jumpStartY, jumpPeakY = false, false, nil, nil, nil, nil, nil
            api.JumpLock = nil
            stopAim()
        end
    end
    airborneBefore = state.airborne
    if clickedAt and os.clock() - clickedAt > 0.45 then jumpStopped = true; currentPlan = nil; releaseTiltKeys() end
    local prepared = jumpAim and not jumpAim.tiltApplied and api.FullAssist and api.FullAssist.PosePlan(state)
    local context = aimContext(state)
    if prepared then context.contact = true end
    local allowed, reason = api.AimAllowed(context)
    if allowed and jumpAim and jumpAim.applied and not jumpAim.tiltApplied and (state.tiltReady or prepared)
        and (prepared or planElapsed >= 1 / api.Config.PlanHz)
        and api.AllowAutomaticTilt(state.floorAir, state.motion.Y, os.clock() - (jumpStartedAt or os.clock())) then
        planElapsed = 0
        if not clickedAt then
            -- Native tilt's 0.3 argument is a time window, not a VY cap.
            -- Launch calculations must use measured player motion.
            local contactState = table.clone(state)
            currentPlan = prepared or api.Plan(contactState, opponents(state), jumpEdge, false, jumpTarget, currentPlan, jumpAim.heading, true)
            api.PlanReason = not currentPlan and "no in-bounds shot at this power / heading"
                or currentPlan.blockRisk and "blocker covers this shot" or "safe native tilt found"
            applyNativeTilt(state, currentPlan, prepared ~= nil)
        end
        api.PlanPreview = currentPlan
    elseif not allowed then
        currentPlan = nil; api.PlanPreview = nil
        if not api.HoldAimAllowed(context) and not (jumpAim and not jumpAim.becameAirborne) then stopAim() end
    end
    if state.airborne and api.Config.AutoAim then
        api.JumpSamples[#api.JumpSamples + 1] = {time = os.clock(), position = state.rootPosition, origin = state.origin,
            vy = state.motion.Y, contact = state.contactNow, tilt = player:GetAttribute("TiltValue"),
            bodyVertical = state.bodyVertical, bodyLateral = state.bodyLateral, look = state.look,
            reason = api.AimReason, applied = jumpAim and jumpAim.tiltApplied,
            landing = currentPlan and currentPlan.flight.landing}
        while #api.JumpSamples > 240 do table.remove(api.JumpSamples, 1) end
    end
    if currentPlan then
        targetMarker.Position, targetMarker.Transparency = currentPlan.flight.landing, 0.2
        targetMarker.Color = currentPlan.blockRisk and colors.OUT or colors.IN
        aimStatus.Text = currentPlan.blockRisk and "Auto Aim: holds / possible block in path"
            or "Auto Aim: takeoff facing / native WASD tilt"
    else
        targetMarker.Transparency = 1
        aimStatus.Text = api.Config.AutoAim and api.TakeoffSkipped and "Auto Aim: " .. api.TakeoffSkipped
            or jumpAim and (jumpAim.tiltApplied and "Auto Aim: native tilt applied / hit stays manual"
            or state.contactNow and "Auto Aim: " .. (api.PlanReason or "evaluating contact")
            or "Auto Aim: tracking ball into strike volume")
            or api.Config.AutoAim and "Auto Aim: " .. (allowed and "no safe reachable edge at this power" or reason)
            or "Auto Aim OFF [5] / power + hit stay manual"
    end
    if flightElapsed >= 1 / api.Config.FlightHz then flightElapsed = 0; solveFlights(state) end
end
local ok, err = xpcall(function()
    api.Startup.Stage = "modules"
    local tuningModule, physicsModule = RS:FindFirstChild("NG_TaraturaPalla"), RS:FindFirstChild("NG_Palla")
    assert(tuningModule and physicsModule, "Missing native volleyball modules")
    tuning, physics = require(tuningModule), require(physicsModule)
    assert(type(tuning.Schiacciata) == "function" and type(physics.PassoValori) == "function", "Native spike calculation unavailable")
    local volumeModule = RS:FindFirstChild("NG_SfereColpo")
    if volumeModule then volumes = require(volumeModule) end
    api.Config.BallRadius = tonumber(tuning.RAGGIO_PALLA) or 1.05
    livePaths = {}
    for index = 1, api.Config.MaxBalls do livePaths[index] = newPath("BallFlight" .. index) end
    targetMarker = ownPart("OpenEdgeTarget"); targetMarker.Shape = Enum.PartType.Ball; targetMarker.Size = Vector3.one
    spikeAnchor = ownPart("SpikeAnchor")
    spikeAdornment = make("SphereHandleAdornment", {Name = "SpikeVolume", Adornee = spikeAnchor,
        AlwaysOnTop = true, ZIndex = 1, Radius = 1, Transparency = 0.86,
        Color3 = Color3.fromRGB(100, 205, 255), Visible = false}, world)
    spikeBoxAdornment = make("BoxHandleAdornment", {Name = "SpikeBoxVolume", Adornee = spikeAnchor,
        AlwaysOnTop = true, ZIndex = 1, Transparency = 0.86, Size = Vector3.one,
        Color3 = Color3.fromRGB(100, 205, 255), Visible = false}, world)
    refreshNets()
    api.SetterPreview = createSetterPreview()
    api.FullAssist = createFullAssist(fullAssistHost())
    if fullPreference ~= nil then api.FullAssist.Wanted = fullPreference end
    if backgroundPreference ~= nil then api.FullAssist.Config.AllowBackground = backgroundPreference end
    local standalone = env.VRSSetterPreview
    if standalone and type(standalone.Destroy) == "function" then pcall(standalone.Destroy) end
    connect(RunService.Heartbeat, function(dt)
        local start = os.clock()
        local success, message = pcall(tick, dt)
        if api.FullAssist then api.FullAssist.SafeTick() end
        api.Metrics.Updates += 1
        api.Metrics.MeanMs = api.Metrics.MeanMs * 0.95 + (os.clock() - start) * 1000 * 0.05
        if not success then
            api.Metrics.Errors += 1; api.Metrics.LastError = tostring(message)
            api.SetAutoAim(false)
            for _, path in ipairs(livePaths) do hidePath(path) end
            status.Text = "Paused: " .. tostring(message)
            if api.Metrics.Errors <= 3 then warn("[VRSSpikeAssist] " .. tostring(message)); log("runtime_error", tostring(message)) end
        end
    end)
    local function render()
        if not alive or not api.Startup.Ready then return end
        local success, message = pcall(function() updateServeFacing(); updateOverlays(readState()); applyAim() end)
        if not success then api.Metrics.Errors += 1; api.Metrics.LastError = tostring(message); api.SetAutoAim(false) end
    end
    connect(RunService.PreSimulation, render)
    RunService:BindToRenderStep("VRS_SpikeAssist_Approach", Enum.RenderPriority.Character.Value + 1,
        function() if alive and api.Startup.Ready and api.FullAssist then api.FullAssist.SafeRender() end end)
    RunService:BindToRenderStep("VRS_SpikeAssist_Aim", Enum.RenderPriority.Character.Value + 2, render)
    api.Startup.Ready, api.Startup.Stage = true, "ready"
    api.FullAssist.SetEnabled(api.FullAssist.Wanted)
    status.Text = "Loaded / waiting for ball"
    updateButtons()
    log("started", {version = api.Version, place = game.PlaceId, autoAim = false})
    print("[VRSSpikeAssist] v" .. api.Version .. " loaded. Full assist stays armed after calibration on sippywippy; [6] toggles it ON/OFF.")
end, function(message) return tostring(message) end)
if not ok then
    api.Startup.Error = err
    status.Text = "Startup failed: " .. err
    log("startup_error", err)
    warn("[VRSSpikeAssist] " .. err)
end
