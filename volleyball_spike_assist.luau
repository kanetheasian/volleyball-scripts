        receiverPosition = target.position, net = target.net,
        look = state.look, time = os.clock(), freeze = state.freeze}
    detail.Text = string.format("sippywippy / NET INSET 0.2 / LEAD %.1f\n", lead and lead.shift or 0) .. contact.quality .. " / ESTIMATED"
    targetMarker.Position = target.point
