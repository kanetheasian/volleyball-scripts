local function hidePath(path)
    if not path then return end
    for _, part in ipairs(path.parts) do part.Transparency = 1 end
    path.marker.Transparency, path.tag.Enabled = 1, false
end
local function drawPath(path, flight, net, floor)
    if not flight or not flight.landed or not api.Config.ShowTrajectory then hidePath(path); return end
    local classification, nearLine = api.LandingClass(flight.landing, net)
    local color = flight.netBlocked and colors.UNKNOWN or colors[classification]
    if nearLine then color = colors.UNKNOWN end
    local count = #flight.nodes - 1
    for index, part in ipairs(path.parts) do
        if index <= math.min(count, #path.parts) then
            local first = math.floor((index - 1) * count / math.min(count, #path.parts)) + 1
            local last = math.floor(index * count / math.min(count, #path.parts)) + 1
            local a, b = flight.nodes[first], flight.nodes[last]
            local length = (b - a).Magnitude
            if length > 0.001 then
                part.Size, part.CFrame, part.Color = Vector3.new(0.24, 0.24, length), CFrame.lookAt((a + b) * 0.5, b), color
                part.Transparency = 0.15
            else part.Transparency = 1 end
        else part.Transparency = 1 end
    end
    path.marker.CFrame = CFrame.new(flight.landing.X, floor + 0.1, flight.landing.Z) * CFrame.Angles(0, 0, math.pi / 2)
    path.marker.Color, path.marker.Transparency = color, 0.28
    path.label.TextColor3 = color
    path.label.Text = api.MarkerText(classification)
    path.tag.Enabled = path.label.Text ~= ""
end
local function refreshNets()
    nets = {}
    local courts = workspace:FindFirstChild("InCourts")
    for _, court in ipairs(courts and courts:GetChildren() or {}) do if court:IsA("BasePart") then
        for _, top in ipairs(workspace:GetChildren()) do
            if top.Name == "NetTop" and top:IsA("BasePart") and flat(top.Position - court.Position).Magnitude < 2 then
                local axis = flat(top.CFrame.RightVector)
                if axis.Magnitude > 0.99 then
                    axis = axis.Unit
                    local x, z = math.abs(axis:Dot(court.CFrame.RightVector)) > 0.99,
                        math.abs(axis:Dot(court.CFrame.LookVector)) > 0.99
                    if x or z then nets[#nets + 1] = {part = top, court = court, center = top.Position,
                        courtCenter = court.Position, axis = axis, normal = Vector3.new(-axis.Z, 0, axis.X),
                        halfWidth = math.min(top.Size.X, x and court.Size.X or court.Size.Z) * 0.5,
                        halfDepth = (x and court.Size.Z or court.Size.X) * 0.5,
                        topY = top.Position.Y + top.Size.Y * 0.5} end
                end
            end
        end
    end end
    api.CourtCount = #nets
end
local function netAt(position, allowance)
    for _, net in ipairs(nets) do
        if net.part.Parent and net.court.Parent and api.InCourt(position, net, -(allowance or 0)) then return net end
    end
end
