-- SPIKE_MATH_BEGIN
local function flat(value) return Vector3.new(value.X, 0, value.Z) end
local function finite(value) return type(value) == "number" and value == value and math.abs(value) < 1e8 end
function api.ValidVector(value)
    return typeof(value) == "Vector3" and finite(value.X) and finite(value.Y) and finite(value.Z)
end
function api.Side(position, net)
    local value = flat(position - net.center):Dot(net.normal)
    return math.abs(value) >= 0.15 and (value > 0 and 1 or -1) or nil
end
function api.InCourt(position, net, margin)
    local offset = flat(position - net.courtCenter)
    margin = margin or 0
    return math.abs(offset:Dot(net.axis)) <= net.halfWidth - margin + 0.0001
        and math.abs(offset:Dot(net.normal)) <= net.halfDepth - margin + 0.0001
end
function api.LandingClass(position, net)
    if not api.ValidVector(position) or not net then return "UNKNOWN", false end
    local offset = flat(position - net.courtCenter)
    local clearance = math.min(net.halfWidth - math.abs(offset:Dot(net.axis)),
        net.halfDepth - math.abs(offset:Dot(net.normal)))
    return clearance >= -0.0001 and "IN" or "OUT", math.abs(clearance) <= api.Config.BallRadius
end
function api.EdgeTargets(origin, net)
    local side = api.Side(origin, net)
    if not side then return {} end
    local margin = math.max(api.Config.AimMargin or api.Config.LineMargin, api.Config.BallRadius + 0.25)
    local targets = {}
    if net.halfWidth <= margin or net.halfDepth <= margin * 2 then return targets end
    for _, edge in ipairs({-1, 1}) do
        for _, fraction in ipairs({0.08, 0.18, 0.28, 0.55, 0.82}) do
            targets[#targets + 1] = {edge = edge, point = net.center
                + net.axis * (edge * (net.halfWidth - margin))
                - net.normal * (side * math.clamp(net.halfDepth * fraction, margin, net.halfDepth - margin))}
        end
    end
    return targets
end
function api.SplitBox(frame, size, notch, lowerFraction)
    if not finite(notch) or notch <= 0 or notch >= size.X then return {{frame = frame, size = size}} end
    local lower = size.Y * math.clamp(lowerFraction or 0, 0, 1)
    local upper, width = size.Y - lower, (size.X - notch) * 0.5
    local result = {}
    if lower > 0.001 then result[#result + 1] = {frame = frame * CFrame.new(0, (lower - size.Y) * 0.5, 0),
        size = Vector3.new(size.X, lower, size.Z)} end
    if upper > 0.001 then for _, side in ipairs({-1, 1}) do
        result[#result + 1] = {frame = frame * CFrame.new(side * (notch + width) * 0.5, lower * 0.5, 0),
            size = Vector3.new(width, upper, size.Z)}
    end end
    return result
end
function api.SegmentHitsBox(a, b, frame, size, radius)
    a, b = frame:PointToObjectSpace(a), frame:PointToObjectSpace(b)
    local delta, lo, hi = b - a, 0, 1
    for _, axis in ipairs({"X", "Y", "Z"}) do
        local half = size[axis] * 0.5 + (radius or 0)
        if math.abs(delta[axis]) < 1e-8 then
            if math.abs(a[axis]) > half then return false end
        else
            local enter, leave = (-half - a[axis]) / delta[axis], (half - a[axis]) / delta[axis]
            if enter > leave then enter, leave = leave, enter end
            lo, hi = math.max(lo, enter), math.min(hi, leave)
            if lo > hi then return false end
        end
    end
    radius = radius or 0
    if radius <= 0 then return true end
    -- Expanded slabs are only a broad phase: their square corners otherwise
    -- reject shots that clear the rounded ball/box corner.
    local cuts = {lo, hi}
    for _, axis in ipairs({"X", "Y", "Z"}) do
        if math.abs(delta[axis]) > 1e-8 then
            for _, sign in ipairs({-1, 1}) do
                local t = (sign * size[axis] * 0.5 - a[axis]) / delta[axis]
                if t > lo and t < hi then cuts[#cuts + 1] = t end
            end
        end
    end
    table.sort(cuts)
    for index = 2, #cuts do
        local left, right = cuts[index - 1], cuts[index]
        local middle, numerator, denominator = (left + right) * 0.5, 0, 0
        for _, axis in ipairs({"X", "Y", "Z"}) do
            local half, value = size[axis] * 0.5, a[axis] + delta[axis] * middle
            if math.abs(value) > half then
                local bound = value > 0 and half or -half
                numerator += (a[axis] - bound) * delta[axis]
                denominator += delta[axis]^2
            end
        end
        local t = denominator > 1e-12 and math.clamp(-numerator / denominator, left, right) or left
        local distance = 0
        for _, axis in ipairs({"X", "Y", "Z"}) do
            distance += math.max(math.abs(a[axis] + delta[axis] * t) - size[axis] * 0.5, 0)^2
        end
        if distance <= radius^2 + 1e-8 then return true end
    end
    return false
end
function api.Flight(origin, velocity, floor, options)
    options = options or {}
    local position, spin, elapsed = origin, options.spin or Vector3.zero, 0
    local nodes, times, crossed, netBlocked = {origin}, {0}, false, false
    local floorY, dt = floor + api.Config.CollisionRadius, math.min(tuning.PASSO_MAX or 1 / 60, 1 / 60)
    if dt <= 0 then return nil end
    local landed = false
    for step = 1, 480 do
        local before = position
        local gravity = options.gravity
        if options.freezeIn and elapsed >= options.freezeIn then gravity = options.freezeGravity or gravity end
        velocity, position, spin = physics.PassoValori(position, velocity, spin, dt, options.side, gravity,
            options.rampFraction, options.rampExponent, options.rampMin)
        elapsed += dt
        if not api.ValidVector(position) or not api.ValidVector(velocity) then return nil end
        if options.net then
            local net = options.net
            local a, b = flat(before - net.center):Dot(net.normal), flat(position - net.center):Dot(net.normal)
            if a * b < 0 or (math.abs(a) > 0.01 and math.abs(b) <= 0.01) then
                local cross = before:Lerp(position, math.clamp(a / (a - b), 0, 1))
                if math.abs(flat(cross - net.center):Dot(net.axis)) <= net.halfWidth + api.Config.BallRadius then
                    crossed = true
                    if cross.Y <= net.topY + api.Config.BallRadius + 0.1 then netBlocked = true end
                end
            end
        end
        if position.Y <= floorY and velocity.Y <= 0 then
            local alpha = math.clamp((before.Y - floorY) / math.max(before.Y - position.Y, 1e-8), 0, 1)
            position = before:Lerp(position, alpha)
            elapsed -= dt * (1 - alpha)
            landed = true
        end
        if landed or step % 2 == 0 then nodes[#nodes + 1], times[#times + 1] = position, elapsed end
        if landed then break end
    end
    return {nodes = nodes, times = times, landing = position, time = elapsed, landed = landed,
        crossed = crossed, netBlocked = netBlocked}
end
function api.BallisticLanding(position, velocity, floor)
    local gravity = -tuning.GRAVITA.Y
    if gravity <= 0 then return nil end
    local discriminant = velocity.Y ^ 2 + 2 * gravity * (position.Y - floor - api.Config.CollisionRadius)
    if discriminant < 0 then return nil end
    local time = (velocity.Y + math.sqrt(discriminant)) / gravity
    return position + flat(velocity) * time + Vector3.new(0, floor + api.Config.CollisionRadius - position.Y, 0)
end
function api.AimAllowed(context)
    if not context.enabled then return false, "OFF" end
    if not context.ready or not context.alive or context.anchored or context.sitting then return false, "character unavailable" end
    if not context.focused or context.typing or context.menu then return false, "focus / menu" end
    if not context.airborne or context.mode ~= "spike" then return false, "spike-mode jump only" end
    if context.inMatch == false or context.serving or context.blocked then return false, "game action blocked" end
    if context.setAim or context.stopped or context.cancelled then return false, "manual set / jump finished" end
    if not context.contact then return false, "waiting for nearby ball" end
    return true, "armed"
end
function api.HoldAimAllowed(context)
    if context.cancelled then return false, "manual override" end
    local holding = table.clone(context)
    holding.contact, holding.stopped = true, false
    -- A normal post-hit action cooldown should not release facing. A stun still does.
    holding.blocked = context.stunned == true
    return api.AimAllowed(holding)
end
function api.BodyAimFrame(rootPosition, heading, vertical, lateral)
    heading = flat(heading)
    if heading.Magnitude < 0.001 then return nil end
    return CFrame.lookAt(rootPosition, rootPosition + heading.Unit)
        * CFrame.Angles(math.rad(-math.clamp(vertical, -20, 20) / 20 * api.Config.MaxAimPitch), 0,
            math.rad(-math.clamp(lateral, -20, 20) / 20 * api.Config.MaxAimRoll))
end
function api.YawOnlyFrame(current, heading)
    local original, desired = flat(current.LookVector), flat(heading)
    if original.Magnitude < 0.001 or desired.Magnitude < 0.001 then return nil end
    local nativeTilt = CFrame.lookAt(Vector3.zero, original.Unit):Inverse() * (current - current.Position)
    return CFrame.lookAt(current.Position, current.Position + desired.Unit) * nativeTilt
end
function api.AllowAutomaticTilt(floorAir, verticalSpeed, jumpAge)
    -- Ascent hits are normal: waiting for descent misses the player's click.
    -- The caller requires nearby contact or a confirmed full-assist contact plan.
    return floorAir == true and jumpAge >= 0.08
end
function api.InStrikeVolume(position, volume, padding)
    if not volume then return false end
    local delta = volume.frame and volume.frame:PointToObjectSpace(position) or position - volume.center
    local r = volume.radii + Vector3.one * (padding or 0)
    if r.X <= 0 or r.Y <= 0 or r.Z <= 0 then return false end
    if volume.kind == "box" then
        return math.abs(delta.X) <= r.X and math.abs(delta.Y) <= r.Y and math.abs(delta.Z) <= r.Z
    end
    return (delta.X / r.X)^2 + (delta.Y / r.Y)^2 + (delta.Z / r.Z)^2 <= 1
end
function api.TiltLevels(tilt)
    if type(tilt) ~= "string" then return nil end
    return tilt:sub(1, 1) == "W" and 20 or tilt:sub(1, 1) == "S" and -20 or 0,
        tilt:find("D", 1, true) and 20 or tilt:find("A", 1, true) and -20 or 0
end
function api.MatchSetSource(sample, setterShape, otherShapes)
    if sample.kind ~= "set" and not tostring(sample.kind):find("alzat", 1, true) then return false, "not a set" end
    if sample.owner ~= nil then return tonumber(sample.owner) == 58427452, "replicated owner" end
    if not api.ValidVector(sample.eventPosition) or not setterShape
        or not api.InStrikeVolume(sample.eventPosition, setterShape, api.Config.BallRadius) then
        return false, "set origin outside setter volume"
    end
    for _, shape in ipairs(otherShapes or {}) do
        if api.InStrikeVolume(sample.eventPosition, shape, api.Config.BallRadius) then return false, "ambiguous set origin" end
    end
    return true, "unique setter volume"
end
function api.MarkerText(classification) return classification == "OUT" and "OUT" or "" end
function api.SmoothValue(current, goal, dt, seconds, rate)
    dt = math.clamp(dt or 0, 0, 0.05)
    if dt <= 0 then return current end
    local alpha = 1 - math.exp(-dt / math.max(seconds or 0.09, 0.001))
    local step = (goal - current) * alpha
    local limit = math.max(rate or math.huge, 0) * dt
    return current + math.clamp(step, -limit, limit)
end
function api.SmoothHeading(current, goal, dt)
    local from = math.atan2(-current.X, -current.Z)
    local to = math.atan2(-goal.X, -goal.Z)
    local difference = (to - from + math.pi) % (2 * math.pi) - math.pi
    local angle = api.SmoothValue(0, difference, dt, api.Config.YawSmoothingSeconds or 0.025,
        math.rad(api.Config.MaxYawDegreesPerSecond or 720))
    return Vector3.new(-math.sin(from + angle), 0, -math.cos(from + angle))
end
function api.PreferStablePlan(retained, candidate)
    if not retained or retained.blockRisk then return candidate end
    if not candidate or candidate.blockRisk then return retained end
    return retained.score - candidate.score >= api.Config.PlanSwitchImprovement and candidate or retained
end
function api.SetMotionCoherent(sample)
    if not sample or not api.ValidVector(sample.eventPosition) or not api.ValidVector(sample.eventVelocity)
        or not api.ValidVector(sample.velocity) or type(sample.eventN) ~= "number" or type(sample.eventT) ~= "number" then return false end
    local expected, actual = flat(sample.eventVelocity), flat(sample.velocity)
    return expected.Magnitude > 1 and (actual - expected).Magnitude <= math.max(0.75, expected.Magnitude * 0.04)
end
function api.ContactWindow(state, ball, lead, fraction, playerGravity, minimumDelay)
    if not state.volume or not ball or not lead or lead < 0.02 or lead > 0.45 then return nil end
    local reach = math.max(state.volume.radii.X, state.volume.radii.Y, state.volume.radii.Z) + api.Config.BallRadius
        + (ball.velocity - state.motion).Magnitude * lead
        + (tuning.GRAVITA.Magnitude * (ball.freezeGravity or ball.gravity or 1) + playerGravity) * lead * lead * 0.5
    if (ball.position - state.volume.center).Magnitude > reach then return nil end
    local position, velocity, spin = ball.position, ball.velocity, ball.spin
    local elapsed, dt = 0, math.min(tuning.PASSO_MAX or 1 / 60, 1 / 60)
    if dt <= 0 then return nil end
    minimumDelay = math.clamp(minimumDelay or 0.02, 0.02, lead)
    while elapsed < lead do
        local step = math.min(dt, lead - elapsed)
        local gravity = ball.gravity
        if ball.freezeIn and elapsed >= ball.freezeIn then gravity = ball.freezeGravity or gravity end
        velocity, position, spin = physics.PassoValori(position, velocity, spin, step, ball.side, gravity,
            ball.rampFraction, ball.rampExponent, ball.rampMin)
        elapsed += step
        if elapsed + 1e-8 >= minimumDelay then
            local offset = state.motion * elapsed - Vector3.new(0, playerGravity * elapsed * elapsed * 0.5, 0)
            local side = api.Side(state.rootPosition, state.net)
            if side then
                local depth = flat(state.rootPosition + offset - state.net.center):Dot(state.net.normal) * side
                if depth < 1.3 then offset += state.net.normal * side * (1.3 - depth) end
            end
            local shape = table.clone(state.volume)
            shape.center, shape.radii = shape.center + offset, shape.radii * fraction
            if shape.frame then shape.frame += offset end
            if api.InStrikeVolume(position, shape) then
                local projected = table.clone(state)
                projected.origin, projected.rootPosition = position, state.rootPosition + offset
                projected.motion = state.motion - Vector3.new(0, playerGravity * elapsed, 0)
                projected.ballVelocity, projected.ballGravity, projected.contactDelay = velocity, gravity, elapsed
                return projected
            end
        end
    end
    return nil
end
function api.PoseContactWindow(state, ball, contactIn, lead, fraction, playerGravity)
    if contactIn and contactIn >= 0.02 and contactIn <= 0.45 then
        local planned = api.ContactWindow(state, ball, math.min(0.45, contactIn + 0.025), fraction,
            playerGravity, math.max(0.02, contactIn - 0.025))
        if planned then return planned end
    end
    return api.ContactWindow(state, ball, math.min(0.45, lead + 0.2), fraction,
        playerGravity, math.max(0.02, lead - 0.06))
end
