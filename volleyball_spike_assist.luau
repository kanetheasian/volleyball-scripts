local function scan()
    refreshNets()
    refreshBlockAnimations()
    local keep = {}
    local cache = workspace:FindFirstChild("BallCache")
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local available = {}
    for _, ball in ipairs(cache and cache:GetChildren() or {}) do
        local sample = readBall(ball)
        local viewerNet = root and netAt(root.Position, 20)
        local floor = tonumber(workspace:GetAttribute("NG_QuotaSuolo")) or tuning.QUOTA_CAMPO or 0.408
        if sample and sample.position.Y > floor + api.Config.CollisionRadius + 0.02
            and sample.velocity.Magnitude >= 0.1 and viewerNet and netAt(sample.position, 20) == viewerNet then
            available[#available + 1] = {ball = ball, distance = (sample.position - root.Position).Magnitude}
        end
    end
    table.sort(available, function(a, b) return a.distance < b.distance end)
    for index = 1, math.min(api.Config.MaxBalls, #livePaths, #available) do
        local ball = available[index].ball
        keep[ball] = true
