local function aimContext(state)
    local blocked = false
    local stunUntil = tonumber(player:GetAttribute("NG_StunLocale"))
    for _, name in ipairs({"NG_StunLocale", "NG_BloccoComandi", "NG_MinigiocoBattuta"}) do
        local untilTime = tonumber(player:GetAttribute(name))
        if untilTime and os.clock() < untilTime then blocked = true end
    end
    local regular = env.VRSSetAim
    return {enabled = api.Config.AutoAim, ready = api.Startup.Ready, alive = state and state.humanoid.Health > 0,
        anchored = state and state.root.Anchored, sitting = state and state.humanoid.Sit,
        focused = focused or api.FullAssist and api.FullAssist.Config.AllowBackground
            and (api.FullAssist.Enabled or api.FullAssist.Recording),
        typing = UIS:GetFocusedTextBox() ~= nil, menu = GuiService.MenuIsOpen,
        airborne = state and state.airborne, mode = player:GetAttribute("NG_JumpMode"),
        inMatch = player:GetAttribute("NG_InMatch"), serving = player:GetAttribute("NG_PuoBattere") == true,
        blocked = blocked, setAim = regular and regular.Target ~= nil, stopped = jumpStopped,
        contact = state and state.contact, cancelled = jumpCancelled,
        stunned = stunUntil ~= nil and os.clock() < stunUntil}
end
-- SPIKE_AIM_RUNTIME_BEGIN
local function armJump(state)
    if jumpAim or not state or not groundObserved or state.floorAir or math.abs(state.motion.Y) > 1 then return end
    local context = aimContext(state)
    context.airborne, context.contact, context.stopped, context.cancelled = true, true, false, false
    if not api.AimAllowed(context) then return end
    local best, score
    local defenders = opponents(state)
    for _, goal in ipairs(api.EdgeTargets(state.rootPosition, state.net)) do
        local openness = 50
        for _, defender in ipairs(defenders) do
            openness = math.min(openness, flat(defender.position - goal.point).Magnitude)
        end
        local value = openness - flat(goal.point - state.rootPosition).Magnitude * 0.025
        if not score or value > score then best, score = goal, value end
    end
    if not best then return end
    jumpCancelled, jumpStopped, clickedAt = false, false, nil
    api.TakeoffSkipped = nil
    jumpAim = {character = state.character, net = state.net, edge = best.edge, point = best.point,
        requestedAt = os.clock(), applied = false, tiltApplied = false}
    jumpEdge, jumpTarget = best.edge, best.point
    api.JumpLock = {edge = best.edge, point = best.point, startedAt = os.clock()}
    log("jump_edge_locked", api.JumpLock)
end
local function commitTakeoff(state)
    if not jumpAim or jumpAim.applied or jumpAim.character ~= state.character then return end
    local age = os.clock() - jumpAim.requestedAt
    if state.floorAir then jumpAim.airFirstAt = jumpAim.airFirstAt or os.clock() end
    if age > 1.2 or (state.floorAir and os.clock() - jumpAim.airFirstAt > 0.08) then
        jumpCancelled = true; stopAim(); return
    end
    local gyro = state.root:FindFirstChild("Tilt")
    local origin = gyro and gyro:FindFirstChild("Origin")
    -- Wait for native windup to finish and the native takeoff reference to exist.
    -- Never retry after this one commit, including after a hit or a camera change.
    if not origin or not origin:IsA("CFrameValue") or state.root:FindFirstChild("NG_LockCamera") then return end
    if player:GetAttribute("NG_InAria") ~= true then return end
    -- Wait for launch motion so the contact forecast uses measured jump VY.
    if not state.floorAir and state.motion.Y <= 1 then return end
    -- Choose a feasible heading once while the native takeoff reference exists.
    -- Nearby hand geometry can make the nominal open sideline unreachable.
    local assisted = api.FullAssist and api.FullAssist.TakeoffPlan()
    local projected = not assisted and forecastContact(state)
    local takeoffPlan = assisted or projected and api.Plan(projected, opponents(projected), nil, false, nil, nil, nil, true)
    if projected and not takeoffPlan then
        api.PlanReason = "no safe in-bounds takeoff heading"
        api.TakeoffSkipped = api.PlanReason
        log("takeoff_skipped", {reason = api.PlanReason})
        jumpCancelled = true; stopAim(); return
    end
    if takeoffPlan then
        jumpAim.edge, jumpAim.point = takeoffPlan.edge, takeoffPlan.desired
        jumpEdge, jumpTarget = jumpAim.edge, jumpAim.point
        api.JumpLock = {edge = jumpEdge, point = jumpTarget, startedAt = jumpAim.requestedAt}
    end
    local fallback = state.net.center - state.net.normal * (api.Side(state.rootPosition, state.net) or 1) * state.net.halfDepth * 0.65
    local heading = takeoffPlan and takeoffPlan.heading or flat(fallback - state.root.Position)
    if heading.Magnitude < 0.001 then return end
    heading = heading.Unit
    local body = api.YawOnlyFrame(state.root.CFrame, heading)
    local base = api.YawOnlyFrame(origin.Value, heading)
    local target = api.YawOnlyFrame(gyro.CFrame, heading)
    if not body or not base or not target then return end
    jumpAim.heading, jumpAim.applied = heading, true
    origin.Value = base
    gyro.CFrame = target
    state.root.CFrame = body
    api.Metrics.YawWrites += 1
    api.Aiming = {edge = jumpAim.edge, desired = jumpAim.point, mode = "native WASD", yawWrites = 1}
    log("takeoff_yaw_once", {edge = jumpAim.edge, heading = heading,
        forecast = projected and projected.origin, feasible = takeoffPlan and not takeoffPlan.blockRisk,
        plannedTilt = takeoffPlan and {takeoffPlan.vertical, takeoffPlan.lateral}})
end
local function applyAim()
    if not alive or not api.Startup.Ready then return end
    local state = readState()
    local context = aimContext(state)
    local check = table.clone(context)
    check.airborne, check.contact, check.stopped = true, true, false
    local allowed, reason = api.AimAllowed(check)
    api.AimReason = reason
    if not state or not allowed then stopAim(); return end
    if not jumpAim then return end
    if jumpAim.character ~= state.character then stopAim(); return end
    commitTakeoff(state)
    if jumpAim and jumpAim.applied then api.AimReason = "takeoff facing set / native WASD tilt only" end
end
local function applyNativeTilt(state, plan, prepared)
    if not jumpAim or not jumpAim.applied or jumpAim.tiltApplied or not (state.tiltReady or prepared) or not plan or plan.blockRisk
        or clickedAt or jumpStopped or not tiltChannel or not tiltChannel.Parent then return end
    local keys = {}
    -- Lateral first: adding A/D after W starts the native fading pose.
    -- Applying W/S last leaves the intended full vertical pose latched.
    if plan.lateral >= 10 then keys[#keys + 1] = "D"
    elseif plan.lateral <= -10 then keys[#keys + 1] = "A" end
    if plan.vertical >= 10 then keys[#keys + 1] = "W"
    elseif plan.vertical <= -10 then keys[#keys + 1] = "S" end
    jumpAim.tiltApplied = true -- One stable native pose, not per-frame key spam / flips.
    for _, key in ipairs(keys) do
        sentKeys[key] = true
        tiltChannel:Fire("tasto", key, true)
        api.Metrics.NativeTiltTransitions += 1
    end
    api.Aiming = {edge = jumpAim.edge, desired = jumpAim.point, mode = "native WASD", yawWrites = 1,
        keys = keys, vertical = plan.vertical, lateral = plan.lateral, landing = plan.flight.landing, estimated = true}
    log("native_tilt_once", {keys = keys, edge = jumpAim.edge, vertical = plan.vertical, lateral = plan.lateral,
        origin = state.origin, rootPosition = state.rootPosition, vy = state.motion.Y, landing = plan.flight.landing,
        blockers = api.Metrics.BotBlockers, age = os.clock() - (jumpStartedAt or os.clock())})
end
-- SPIKE_AIM_RUNTIME_END
local function cancelFull(reason)
    if api.FullAssist and api.FullAssist.Play then api.FullAssist.Cancel(reason) end
end
local function recordShot(state, automatic)
    if not state then return end
    clickedAt = os.clock()
    api.LastShot = {time = clickedAt, velocity = api.Launch(state), power = state.power,
        origin = state.origin, rootPosition = state.rootPosition, ball = state.ball,
        eventN = state.eventN, eventT = state.eventT, vertical = state.vertical,
        lateral = state.lateral, bodyVertical = state.bodyVertical, vy = state.motion.Y,
        tilt = player:GetAttribute("TiltValue"), contactNow = state.contactNow,
        planned = currentPlan and currentPlan.flight.landing, automatic = automatic == true}
    log(automatic and "automatic_spike_click" or "manual_spike_click", api.LastShot)
end
-- FULL_ASSIST_HOST_BEGIN
local function fullAssistHost()
    local characterIds, nextCharacterId = setmetatable({}, {__mode = "k"}), 0
    local setEvents = setmetatable({}, {__mode = "k"})
    local sprintKey
    local function signature(state)
        local function vectorKey(v) return v and table.concat({v.X, v.Y, v.Z}, ",") or "none" end
        local character = state.character
        if not characterIds[character] then nextCharacterId += 1; characterIds[character] = nextCharacterId end
        local h, values = state.humanoid, {}
        local stable = {Height = true, Unit = true, Trait = true, SubTrait = true, Spec = true, NG_JumpLock = true,
            NG_NazSalto = true, NG_NazTSalto = true, NG_NazCorsa = true, NG_NazTCamminata = true,
            NG_NazHitboxSpike = true, Jump = true, Delay = true, Glide = true, HeightJumpPower = true}
        local sources = {player, character}
        local stats = player:FindFirstChild("Stats")
        if stats then sources[#sources + 1] = stats end
        for index, source in ipairs(sources) do
            local ok, attributes = pcall(function() return source:GetAttributes() end)
            if ok then for name, value in pairs(attributes) do
                if stable[name] or name:sub(1, 5) == "Trait" then
                    values[#values + 1] = tostring(index) .. "/" .. name .. "=" .. tostring(value)
                end
            end end
        end
        table.sort(values)
        -- WalkSpeed and JumpPower change during normal windup/launch; use native loadout data instead.
        return table.concat({tostring(characterIds[character]), tostring(h.HipHeight), tostring(workspace.Gravity),
            vectorKey(state.root.Size), vectorKey(state.volume and state.volume.radii), table.concat(values, ",")}, ":")
    end
    local function allowed(state, calibration)
        local context = aimContext(state)
        context.airborne, context.contact, context.stopped, context.cancelled = true, true, false, false
        if calibration then context.enabled, context.blocked = true, context.stunned end
        return api.AimAllowed(context)
    end
    local function ballSample(ball)
        local sample = ball and readBall(ball)
        if not sample then return nil end
        local owner = ball:GetAttribute("NG_UltimoTocco") or ball:GetAttribute("NG_ToccoUltimo")
        local kind = tostring(ball:GetAttribute("NG_UltimoTipo") or ""):lower()
        sample.owner, sample.kind, sample.eventPosition = owner, kind, ball:GetAttribute("NG_EvP")
        sample.eventVelocity = ball:GetAttribute("NG_EvV")
        sample.setPower = ball:GetAttribute("NG_SetPotenza")
        local setterShape, others = nil, {}
        if owner == nil and (kind == "set" or kind:find("alzat", 1, true)) and api.ValidVector(sample.eventPosition) then
            for _, candidate in ipairs(Players:GetPlayers()) do
                local character = candidate.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local top = character and character:FindFirstChild("TopHitbox")
                local rec = character and character:FindFirstChild("RecHitbox")
                if root and top and rec and (root.Position - sample.eventPosition).Magnitude < 20 then
                    local shape
                    if volumes and volumes.acceso() then
                        local center, radii = volumes.set(top, rec)
                        shape = {center = center, radii = radii, kind = "sphere"}
                    else shape = {center = top.Position, radii = top.Size * 0.5, frame = top.CFrame, kind = "box"} end
                    if candidate.UserId == 58427452 then setterShape = shape else others[#others + 1] = shape end
                end
            end
        end
        local identified, source = api.MatchSetSource(sample, setterShape, others)
        sample.source = source
        if identified and (sample.gravity == nil or sample.gravity == 1)
            and tuning.SET_FREEZE_FRAZ and tuning.SET_FREEZE_G and tuning.GRAVITA.Y < 0 then
            local setter
            for _, candidate in ipairs(Players:GetPlayers()) do if candidate.UserId == 58427452 then setter = candidate; break end end
            local initial = ball:GetAttribute("NG_EvV")
            if setter and (tonumber(setter:GetAttribute("TraitSetFreeze")) or 0) > 0 and api.ValidVector(initial) then
                local switchVelocity = math.max(0, initial.Y) * (1 - tuning.SET_FREEZE_FRAZ)
                sample.freezeIn = math.max(0, (sample.velocity.Y - switchVelocity) / -tuning.GRAVITA.Y)
                sample.freezeGravity = tuning.SET_FREEZE_G
            end
        end
        local key = tostring(sample.eventN) .. ":" .. tostring(sample.eventT) .. ":" .. tostring(owner) .. ":" .. kind
            .. ":" .. tostring(identified)
        local event = setEvents[ball]
        if not event or event.key ~= key then
            event = {key = key, at = os.clock()}; setEvents[ball] = event
            if kind == "set" or kind:find("alzat", 1, true) then
                api.LastSetAttributes = ball:GetAttributes()
                api.LastSetSource = {source = source, identified = identified, eventN = sample.eventN}
            end
        end
        local coherent = api.SetMotionCoherent(sample)
        sample.confirmed = identified and (coherent or os.clock() - event.at >= 0.06)
        if api.LastSetSource and api.LastSetSource.eventN == sample.eventN then api.LastSetSource.motionCoherent = coherent end
        return sample
    end
    local function flights(state)
        local result, cache = {}, workspace:FindFirstChild("BallCache")
        for _, ball in ipairs(cache and cache:GetChildren() or {}) do
            local sample = ballSample(ball)
            if sample and sample.confirmed and netAt(sample.position, 20) == state.net
                and api.Side(sample.position, state.net) == api.Side(state.rootPosition, state.net) then
                local flight = api.Flight(sample.position, sample.velocity, state.floor, sample)
                if flight then
                    flight.ball, flight.confirmed = ball, true
                    flight.eventN, flight.eventT = sample.eventN, sample.eventT
                    result[#result + 1] = flight
                end
            end
        end
        if #result == 0 then
            local preview = api.SetterPreview and api.SetterPreview.Current
            if preview and not preview.assumed and os.clock() - preview.time < 0.2
                and preview.net.court == state.net.court and preview.forward and preview.contact.ball then
                local sample = ballSample(preview.contact.ball)
                if sample and not sample.confirmed then
                    local flight = table.clone(preview.forward)
                    flight.ball, flight.confirmed = preview.contact.ball, false
                    flight.releaseDelay = preview.contact.delay
                    flight.setPower = preview.power
                    flight.eventN, flight.eventT = sample.eventN, sample.eventT
                    result[#result + 1] = flight
                end
            end
        end
        return result
    end
    local function futureContact(state, ball, lead)
        return api.ContactWindow(state, ball, lead, api.FullAssist.Config.ClickContactFraction, workspace.Gravity)
    end
    local function clearAttack(state, stage)
        local velocity, desired = api.Launch(state)
        if not velocity or not desired then return false end
        local candidate, reason, checkedFlight = assessCandidate(state, opponents(state), {heading = state.look, vertical = state.vertical,
            lateral = state.lateral, velocity = velocity, desired = desired, settled = true})
        local checks = api.LastAttackCheck or {}
        api.LastAttackCheck = checks
        checks[stage or "current"] = {time = os.clock(), origin = state.origin, rootPosition = state.rootPosition,
            motion = state.motion, look = state.look, power = state.power, vertical = state.vertical,
            lateral = state.lateral, velocity = velocity, desired = desired, contactDelay = state.contactDelay,
            flight = candidate and candidate.flight or checkedFlight, reason = reason,
            bounds = api.BoundsSafe(state, state.look, state.vertical, state.lateral),
            neutralBounds = api.BoundsSafe(state, state.look, 0, 0),
            window = api.LaunchWindowSafe(state, state.look, state.vertical, state.lateral, true),
            safe = candidate ~= nil and not candidate.blockRisk}
        return candidate ~= nil and not candidate.blockRisk
    end
    return {now = os.clock, serverNow = function() return workspace:GetServerTimeNow() end,
        userId = player.UserId, game = game, signature = signature,
        focused = function() return focused end,
        status = function(text)
            fullStatus.Text = text
            fullToggle.Text = "Full assist" .. (api.FullAssist and api.FullAssist.Wanted and " ON" or " OFF") .. " [6]"
            calibrate.Text = api.FullAssist and api.FullAssist.Recording and "Finish calibration" or "Record calibration"
            backgroundToggle.Text = "Background" .. (api.FullAssist and api.FullAssist.Config.AllowBackground and " ON" or " OFF")
        end,
        readState = readState, allowed = allowed, calibrationAllowed = function(state) return allowed(state, true) end,
        manualActive = function()
            if player:GetAttribute("NG_InAria") == true then return true end
            for _, key in ipairs({Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
                Enum.KeyCode.Space, Enum.KeyCode.F, Enum.KeyCode.R}) do
                if UIS:IsKeyDown(key) then return true end
            end
            local binds = player:FindFirstChild("Keybinds")
            local sprint = binds and binds:GetAttribute("SprintKey")
            local ok, key = pcall(function() return sprint and Enum.KeyCode[sprint] end)
            return ok and key and UIS:IsKeyDown(key) or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        end,
        baseWalkSpeed = function()
            local stats = player:FindFirstChild("Stats")
            return (16 + (stats and tonumber(stats:GetAttribute("TraitWalkFlat")) or 0)
                + (tonumber(player:GetAttribute("NG_NazTCamminata")) or 0))
                * (1 + (tonumber(player:GetAttribute("NG_NazCorsa")) or 0))
        end,
        sprint = function(down)
            if not down then
                if sprintKey and tiltChannel and tiltChannel.Parent then tiltChannel:Fire("tasto", sprintKey, false) end
                sprintKey = nil
                return true
            end
            local binds = player:FindFirstChild("Keybinds")
            local key = binds and binds:GetAttribute("SprintKey")
            if type(key) ~= "string" or not tiltChannel or not tiltChannel.Parent then return false end
            local ok, enum = pcall(function() return Enum.KeyCode[key] end)
            if not ok or not enum or UIS:IsKeyDown(enum) then return false end
            sprintKey = key
            tiltChannel:Fire("tasto", key, true)
            return true
        end,
        side = api.Side, inCourt = api.InCourt, ball = ballSample, flights = flights,
        releaseAim = stopAim, enableAim = function()
