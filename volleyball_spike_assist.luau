                    api.FullAssist.Config.ForecastSeconds)
            end
            return api.SetAutoAim(true)
        end,
        nativeInput = function()
            local scripts = player:FindFirstChild("PlayerScripts")
            local input = scripts and scripts:FindFirstChild("Input")
            local channel = input and input:FindFirstChild("NG_InputVirtuale")
            return channel and channel:IsA("BindableEvent") and channel
        end,
        mouseManager = function()
            local scripts = player:FindFirstChild("PlayerScripts")
            local input = scripts and scripts:FindFirstChild("Input")
            local channel = input and input:FindFirstChild("NG_InputVirtuale")
            if not channel or not channel:IsA("BindableEvent") then return nil end
            -- The native clic adapter sets its own Colpo flag and starts HandleInputBegan.
            -- Preserve the owned press/release interface without moving a desktop cursor.
            return {InputKind = "native clic", SendMouseButtonEvent = function(_, x, y, button, down)
                if not channel.Parent then error("Native spike input removed") end
                channel:Fire("clic", nil, down)
            end}
        end,
        jumpRelease = function() if tiltChannel and tiltChannel.Parent then tiltChannel:Fire("tasto", "Space", false) end end,
        jump = function(state)
            armJump(state)
            if not jumpAim or not tiltChannel or not tiltChannel.Parent then return false end
            tiltChannel:Fire("tasto", "Space", true)
            return true
        end,
        attack = function(state, candidate)
            local projected = table.clone(state)
            projected.origin, projected.rootPosition = candidate.origin, candidate.rootAtContact
            projected.motion = candidate.direction * candidate.profile.startSpeed + Vector3.new(0, candidate.velocityY, 0)
            projected.vertical, projected.lateral = 0, 0
            projected.bodyVertical, projected.bodyLateral = 0, 0
            projected.ball, projected.eventN, projected.eventT = candidate.flight.ball, candidate.flight.eventN, candidate.flight.eventT
            projected.ballVelocity, projected.ballGravity = nil, nil
            return api.Plan(projected, opponents(state), nil, false, nil, nil, nil, true)
        end,
        pointer = function()
            local background = api.FullAssist and api.FullAssist.Config.AllowBackground
            if not focused and not background or UIS:GetFocusedTextBox() or GuiService.MenuIsOpen or not workspace.CurrentCamera then return nil end
            local size = workspace.CurrentCamera.ViewportSize
            local point = background and Vector2.new(size.X * 0.5, size.Y * 0.5) or UIS:GetMouseLocation()
            local playerGui = player:FindFirstChild("PlayerGui")
            if not playerGui then return nil end
            for _, object in ipairs(playerGui:GetGuiObjectsAtPosition(point.X, point.Y)) do
                if object:IsA("TextButton") or object:IsA("ImageButton") or object:IsA("TextBox")
                    or object.Active and object.BackgroundTransparency < 1 then return nil end
            end
            return point
        end,
        recordAutoShot = function(state) recordShot(state, true) end,
        preparePose = function(state, ball, plan)
            if not jumpAim or not jumpAim.applied then return nil end
            local lead = api.FullAssist.HitLead()
            if not lead then return nil end
            local contact = api.PoseContactWindow(state, ball, plan.contactAt - os.clock(), lead,
                api.FullAssist.Config.ClickContactFraction, workspace.Gravity)
            if not contact then return nil end
            return api.Plan(contact, opponents(state), jumpEdge, false, jumpTarget, nil, jumpAim.heading, true)
        end,
        contactFuture = futureContact,
        poseReady = function(state)
            local aiming = api.Aiming
            local ready = jumpAim and jumpAim.applied and jumpAim.tiltApplied and aiming and aiming.vertical
                and flat(state.look).Magnitude > 0.01 and flat(state.look).Unit:Dot(jumpAim.heading) > 0.995
                and math.abs(state.vertical - aiming.vertical) <= 3 and math.abs(state.lateral - aiming.lateral) <= 3
                and math.abs(state.bodyVertical - aiming.vertical) <= 6 and math.abs(state.bodyLateral - aiming.lateral) <= 6
            api.LastPoseCheck = {time = os.clock(), ready = ready, vertical = state.vertical, lateral = state.lateral,
                bodyVertical = state.bodyVertical, bodyLateral = state.bodyLateral,
                headingDot = jumpAim and jumpAim.heading and flat(state.look).Unit:Dot(jumpAim.heading), aiming = aiming}
            return ready
        end,
        attackNow = function(state, ball)
            -- Check the real bound ball, current native pose and the measured input delay.
            local actual = table.clone(state)
            actual.origin, actual.ball = ball.position, ball.ball
            actual.ballVelocity, actual.ballGravity = ball.velocity, ball.gravity
            api.LastAttackCheck = {}
            if state.ball ~= ball.ball then return false end
            if api.InStrikeVolume(actual.origin, actual.volume) and not clearAttack(actual, "current") then return false end
            local future = futureContact(actual, ball, api.FullAssist.HitLead())
            return future and clearAttack(future, "future") or false
        end,
        unbindMovement = function() RunService:UnbindFromRenderStep("VRS_SpikeAssist_Approach") end}
end
