local servingPlayer, servingCharacter, servingNet, servingReadyAt
local function updateServeFacing()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local net = root and netAt(root.Position, 20)
    local function hide()
        serveFacingPart.Transparency = 1
        api.LastServe = nil
    end
    if not api.Config.ShowOpponentServe or not net or not humanoid or humanoid.Health <= 0 then
        servingPlayer, servingCharacter, servingNet, servingReadyAt = nil, nil, nil, nil
        hide(); return
    end
    local function source(candidate)
        if not candidate or candidate == player or candidate.Parent ~= Players then return nil end
        local c = candidate.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        local h = c and c:FindFirstChildOfClass("Humanoid")
        local ownTeam, otherTeam = player:GetAttribute("NG_Squadra"), candidate:GetAttribute("NG_Squadra")
        if not r or not h or h.Health <= 0 or (ownTeam and otherTeam and ownTeam == otherTeam)
            or not api.InCourt(r.Position, net, -30)
            or flat(r.Position - net.center):Dot(net.normal) * flat(root.Position - net.center):Dot(net.normal) >= 0 then return nil end
        return r, c
    end
    local now = os.clock()
    local owners = activeServeOwners(net)
    for _, candidate in ipairs(Players:GetPlayers()) do
        if candidate:GetAttribute("NG_PuoBattere") == true or owners[candidate.UserId] then
            local r, c = source(candidate)
            if r then
                servingPlayer, servingCharacter, servingNet, servingReadyAt = candidate, c, net.part, now
                break
            end
        end
    end
    local otherRoot, otherCharacter = source(servingPlayer)
    if not otherRoot or otherCharacter ~= servingCharacter or servingNet ~= net.part or not servingReadyAt
        or now - servingReadyAt > api.Config.ServeFacingGraceSeconds then hide(); return end
    local direction = flat(otherRoot.CFrame.LookVector)
    if direction.Magnitude < 0.001 then hide(); return end
    local floor = tonumber(workspace:GetAttribute("NG_QuotaSuolo")) or tuning.QUOTA_CAMPO or 0.408
    local start = Vector3.new(otherRoot.Position.X, floor + 0.13, otherRoot.Position.Z)
    local finish = start + direction.Unit * math.clamp(api.Config.ServeFacingLength, 10, 200)
    serveFacingPart.Size = Vector3.new(0.18, 0.18, (finish - start).Magnitude)
    serveFacingPart.CFrame = CFrame.lookAt((start + finish) * 0.5, finish)
    serveFacingPart.Transparency = 0.25
    api.LastServe = {kind = "character_facing", player = servingPlayer, start = start, finish = finish}
    api.Metrics.ServeFacingUpdates = (api.Metrics.ServeFacingUpdates or 0) + 1
end
