local function readBall(ball)
    if not ball.Parent or ball.Name ~= "Ball" or ball:GetAttribute("DeadAt") or ball:GetAttribute("Settling") then return nil end
    local pos, vel, spin = ball:FindFirstChild("Position"), ball:FindFirstChild("Velocity"), ball:FindFirstChild("Spin")
    if not pos or not vel or not pos:IsA("Vector3Value") or not vel:IsA("Vector3Value")
        or not api.ValidVector(pos.Value) or not api.ValidVector(vel.Value) then return nil end
    return {ball = ball, position = pos.Value, velocity = vel.Value,
        spin = spin and spin:IsA("Vector3Value") and spin.Value or Vector3.zero,
        gravity = ball:GetAttribute("NG_GravFattore"), side = ball:GetAttribute("NG_SpinOltreRete"),
        rampFraction = ball:GetAttribute("NG_SpinRampaFraz"), rampExponent = ball:GetAttribute("NG_SpinRampaEsp"),
        rampMin = ball:GetAttribute("NG_SpinRampaMin"), eventN = ball:GetAttribute("NG_EvN"), eventT = ball:GetAttribute("NG_EvT")}
end
local function readState()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local power = character and character:FindFirstChild("Power")
    if not root or not humanoid or not power or humanoid.Health <= 0 then return nil end
    local net = netAt(root.Position)
    if jumpAim and jumpAim.character == character and jumpAim.net.part.Parent and jumpAim.net.court.Parent then
        net = jumpAim.net -- Keep the jump's court while drifting across a sideline.
    end
    if not net then return nil end
    local volume = api.GetSpikeVolume(character)
    local origin = root.Position + Vector3.new(0, 4.9, 0)
    local nearest, distance
    for ball in pairs(tracked) do
        local sample = readBall(ball)
        if sample and netAt(sample.position, 20) and netAt(sample.position, 20).court == net.court then
            local gap = (sample.position - origin).Magnitude
            if gap < 14 and (not distance or gap < distance) then nearest, distance = sample, gap end
        end
    end
    if nearest then origin = nearest.position end
    local floorAir = humanoid.FloorMaterial == Enum.Material.Air
    local airborne = floorAir or (player:GetAttribute("NG_InAria") == true and math.abs(root.AssemblyLinearVelocity.Y) > 1)
    local vertical = math.clamp(-math.asin(math.clamp(root.CFrame.LookVector.Y, -1, 1)) / math.rad(api.Config.MaxAimPitch) * 20, -20, 20)
    local lateral = math.clamp(-math.asin(math.clamp(root.CFrame.RightVector.Y, -1, 1)) / math.rad(api.Config.MaxAimRoll) * 20, -20, 20)
    local bodyVertical, bodyLateral = vertical, lateral
    local nativeVertical, nativeLateral = api.TiltLevels(player:GetAttribute("TiltValue"))
    if nativeVertical then vertical, lateral = nativeVertical, nativeLateral end
    local contact, contactNow, tiltReady = false, false, false
    if volume and nearest then
        local delta = nearest.position - volume.center
        contactNow = api.InStrikeVolume(nearest.position, volume)
        -- Start the native pose within one visible ball radius of contact;
        -- waiting for strict center inclusion misses observed accepted hits.
        tiltReady = api.InStrikeVolume(nearest.position, volume, api.Config.BallRadius)
        contact = tiltReady or api.InStrikeVolume(nearest.position + (nearest.velocity - root.AssemblyLinearVelocity) * 0.12, volume)
        local owner = nearest.ball:GetAttribute("NG_UltimoTocco") or nearest.ball:GetAttribute("NG_ToccoUltimo")
        if owner == player.UserId then contact, contactNow, tiltReady = false, false, false end
    end
    return {character = character, root = root, humanoid = humanoid, net = net, volume = volume,
        origin = origin, rootPosition = root.Position, power = power.Value, motion = root.AssemblyLinearVelocity,
        look = root.CFrame.LookVector, vertical = vertical, lateral = lateral, contact = contact, contactNow = contactNow, tiltReady = tiltReady,
        bodyVertical = bodyVertical, bodyLateral = bodyLateral,
        ball = nearest and nearest.ball, eventN = nearest and nearest.eventN, eventT = nearest and nearest.eventT,
        ballVelocity = nearest and nearest.velocity, ballGravity = nearest and nearest.gravity,
        airborne = airborne, floorAir = floorAir,
        floor = tonumber(workspace:GetAttribute("NG_QuotaSuolo")) or tuning.QUOTA_CAMPO or 0.408}
