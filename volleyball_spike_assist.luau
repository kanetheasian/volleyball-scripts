local function refreshNets()
    nets = {}
    local courts = workspace:FindFirstChild("InCourts")
    for _, court in ipairs(courts and courts:GetChildren() or {}) do
        if court:IsA("BasePart") then
            for _, top in ipairs(workspace:GetChildren()) do
                if top.Name == "NetTop" and top:IsA("BasePart") and flat(top.Position - court.Position).Magnitude < 2 then
                    local axis = flat(top.CFrame.RightVector)
                    if axis.Magnitude > 0.99 then
                        axis = axis.Unit
                        local alongX = math.abs(axis:Dot(court.CFrame.RightVector)) > 0.99
                        local alongZ = math.abs(axis:Dot(court.CFrame.LookVector)) > 0.99
                        if alongX or alongZ then
                            nets[#nets + 1] = {part = top, court = court, center = top.Position, courtCenter = court.Position,
                                axis = axis, normal = Vector3.new(-axis.Z, 0, axis.X),
                                halfWidth = math.min(top.Size.X, alongX and court.Size.X or court.Size.Z) * 0.5,
                                halfDepth = (alongX and court.Size.Z or court.Size.X) * 0.5}
