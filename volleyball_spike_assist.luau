        or input.KeyCode == Enum.KeyCode.D then cancelFull("Manual movement override") end
    local binds = player:FindFirstChild("Keybinds")
    if binds and input.KeyCode and input.KeyCode.Name == binds:GetAttribute("SprintKey") then cancelFull("Manual sprint override") end
