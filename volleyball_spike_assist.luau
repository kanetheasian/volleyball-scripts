                    local refreshed = table.clone(plan)
                    refreshed.origin, refreshed.flight = position, flight
                    local attack = host.attack(state, refreshed)
                    if attack and not attack.blockRisk then refreshed.attack = attack; return refreshed end
                end
            end
        end
        return nil
    end
    local function choosePlan(state, now, flights)
        assist.Metrics.Plans += 1
        flights = flights or host.flights(state)
        local best
        local search = {time = now, flights = #flights, candidates = 0, checked = 0, rejected = {}}
        assist.LastSearch = search
        for _, flight in ipairs(flights) do
            if search.checked >= assist.Config.PlanCandidates then break end
            local play = assist.Play
            if flightAvailable(flight) and (not play.ball or play.ball == flight.ball) then
                if play.ball and (play.eventN ~= flight.eventN or play.eventT ~= flight.eventT)
                    and (play.confirmed or not flight.confirmed) then
                    assist.Cancel("Ball event changed before contact"); return nil
                end
                local candidates = assist.Candidates(state, flight, now)
                search.candidates += #candidates
                local groups = {}
                for _, candidate in ipairs(candidates) do
                    local group = string.format("%d:%d:%d", math.floor((candidate.contactAt - now) / 0.08 + 0.5),
                        math.floor(candidate.profile.startSpeed / 4), math.floor(candidate.origin.Y / 1.5))
                    if not groups[group] then
                        groups[group] = true
                        search.checked += 1
                        local attack = host.attack(state, candidate)
                        if attack and not attack.blockRisk then
                            candidate.attack = attack
                            if not best or candidate.score < best.score then best = candidate end
                            break
                        end
                        search.rejected[#search.rejected + 1] = {origin = candidate.origin, age = candidate.age,
                            contactIn = candidate.contactAt - now, blocked = attack and attack.blockRisk}
                        if search.checked >= assist.Config.PlanCandidates then break end
                    end
                end
            end
        end
        return best
    end
    function assist.IsSyntheticMouse() return pendingMouse ~= nil end
    function assist.IsSyntheticJump() return pendingJump ~= nil end
    function assist.TakeoffPlan() return assist.Play and assist.Play.jumped and assist.Plan and assist.Plan.attack end
    function assist.PosePlan(state)
        local play, plan = assist.Play, assist.Plan
        if not play or not plan or not play.jumped or not play.confirmed or play.clicked or not state.floorAir
            or not plan.attack or plan.attack.blockRisk or host.now() > plan.contactAt + 0.12 then return nil end
        local ball = host.ball(play.ball)
        if not ball or not ball.confirmed
            or ball.eventN ~= play.eventN or ball.eventT ~= play.eventT then return nil end
        if host.preparePose then return host.preparePose(state, ball, plan) end
        return plan.attack
    end
    function assist.RenderMovement()
        local play, plan = assist.Play, assist.Plan
        if not alive or not assist.Enabled or not play or not plan or play.clicked then
            releaseMovement()
            if sprintOwned and host.sprint then host.sprint(false); sprintOwned = nil end
            return
        end
        local state = host.readState()
        local allowed = state and host.allowed(state)
        if not allowed or not state then releaseMovement(); return end
        if state.airborne then
            moveOwner = nil
            if sprintOwned and host.sprint then host.sprint(false); sprintOwned = nil end
            return
        end
        local needsSprint = host.baseWalkSpeed and plan.profile.startSpeed > host.baseWalkSpeed() * 1.2
        if needsSprint and not sprintOwned and host.sprint then
            sprintOwned = true
            if not host.sprint(true) then sprintOwned = nil; assist.Cancel("Native sprint adapter unavailable"); return end
        elseif not needsSprint and sprintOwned then host.sprint(false); sprintOwned = nil end
        local direction
        if play.jumped then direction = plan.profile.startSpeed > 2 and plan.direction or Vector3.zero
        else
            local delta = flat(plan.launch - state.rootPosition)
            local remaining = plan.jumpAt - host.now()
            local speed = math.max(1, math.min(plan.profile.startSpeed, state.humanoid.WalkSpeed or 16))
            if plan.profile.startSpeed > 2 and remaining > delta.Magnitude / speed + 0.15 then
                direction = Vector3.zero
            elseif delta.Magnitude > assist.Config.PositionTolerance then direction = delta.Unit
            elseif plan.profile.startSpeed > 2 and remaining <= 0.06 then direction = plan.direction
            else direction = Vector3.zero end
        end
        moveOwner = state
        state.humanoid:Move(direction, false)
        assist.Metrics.GroundMoves += 1
    end
    function assist.SafeRender()
        local ok, message = pcall(assist.RenderMovement)
        if not ok then assist.Enabled, assist.Wanted = false, false; assist.Metrics.Errors += 1; assist.Cancel("Movement error: " .. tostring(message)) end
    end
    local function click(state)
        local point = host.pointer()
        if not point then assist.Cancel("Move cursor away from menus before spiking"); return end
        local play = assist.Play
        play.clicked = true -- Set before calling the adapter; never retry a partial click.
        pendingMouse = {manager = assist.Manager, x = point.X, y = point.Y, releaseAt = host.now() + 0.03}
        host.recordAutoShot(state)
        local ok = pcall(function() assist.Manager:SendMouseButtonEvent(point.X, point.Y, 0, true, host.game, 0) end)
        assist.Metrics.Clicks += 1
        if not ok then assist.Cancel("Spike input failed"); return end
        report("AWAIT_RESULT", "One spike sent; awaiting own launch")
    end
    function assist.Tick()
        if not alive then return end
        local now, state = host.now(), host.readState()
        if pendingMouse and now >= pendingMouse.releaseAt then releaseInputs() end
        if pendingJump and now >= pendingJump then releaseInputs(true) end
        if assist.Recording then
            recordJump(state, now)
            host.status("CALIBRATING / jumps " .. #assist.Profiles .. "/2 | accepted spikes " .. #assist.HitSamples .. "/2")
            return
        end
        local play = assist.Play
        if not play then
            if not assist.Wanted or not assist.Config.AutoRearm or now < rearmAt then return end
            if not assist.Enabled then
                if now < enableRetryAt or not assist.SetEnabled(true) then return end
            end
            if pendingMouse or pendingJump or sprintOwned or not state or state.airborne
                or host.manualActive and host.manualActive() then return end
            local allowed, reason = host.allowed(state)
            if not allowed then report("PAUSED", reason or "Waiting for gameplay"); return end
            assist.Arm()
            return
        end
        local allowed, reason
        if state then allowed, reason = host.allowed(state) end
        if (not allowed and not (play.clicked and reason == "game action blocked"))
            or not state or state.character ~= play.character or host.signature(state) ~= play.signature then
            assist.Cancel(reason or "Character/settings changed"); return
        end
        if state.net.court ~= play.net.court then assist.Cancel("Court changed"); return end
        if not assist.ProfileReady(play.signature, now) then
            assist.Enabled = false
            assist.Cancel("Calibration expired")
            report("WAIT_CALIBRATION", "Full assist ON; calibration expired or character changed")
            return
        end
        local timeoutAt, timeout = play.ballAt or play.at, play.ballAt and assist.Config.PlaySeconds or assist.Config.ArmSeconds
        if (play.ballAt or not assist.Config.AutoRearm) and now - timeoutAt > timeout then
            assist.Cancel("Play timed out"); return
        end
        if play.clicked then
            if now - play.clickAt > 1.5 then assist.Cancel("No own spike confirmation"); end
            return
        end
        if not play.jumped then
            if state.airborne then assist.Cancel("Unexpected jump / manual override"); return end
            if play.ball then
                local current = host.ball(play.ball)
                if not current then assist.Cancel("Ball removed / dead"); return end
                if play.eventN ~= current.eventN or play.eventT ~= current.eventT then
                    if play.confirmed then assist.Cancel("Ball changed before takeoff"); return end
                    if current.confirmed then
                        play.confirmed, play.eventN, play.eventT = true, current.eventN, current.eventT
                        play.eventWaitAt = nil
                        local plan = assist.Plan
                        if plan and plan.flight.setPower and current.setPower and plan.flight.setPower ~= current.setPower then
                            assist.Plan = nil
                        elseif plan then
                            plan.flight = table.clone(plan.flight)
                            plan.flight.confirmed, plan.flight.eventN, plan.flight.eventT = true, current.eventN, current.eventT
                        end
                        lastPlanAt = -math.huge
                        log("set_event_adopted", {eventN = current.eventN, eventT = current.eventT})
                    else
                        if not play.eventWaitAt then
                            play.eventWaitAt = now
                            log("set_event_pending", {eventN = current.eventN, eventT = current.eventT,
                                owner = current.owner, kind = current.kind})
                        end
                        if now - play.eventWaitAt > assist.Config.EventGrace then
                            assist.Cancel("Set event was not identified within grace window"); return
                        end
                    end
                end
            end
            if not play.eventWaitAt and now - lastPlanAt >= 1 / assist.Config.PlanHz then
                lastPlanAt = now
                local plan
                if play.confirmed and assist.Plan then
                    local attack = host.attack(state, assist.Plan)
                    if attack and not attack.blockRisk then plan = assist.Plan; plan.attack = attack end
                else
                    local flights = host.flights(state)
                    plan = retainPlan(state, now, flights) or choosePlan(state, now, flights)
                end
                if not assist.Play then return end
                assist.Plan = plan
                assist.Trace[#assist.Trace + 1] = {time = now, root = state.rootPosition, motion = state.motion,
                    launch = plan and plan.launch, jumpAt = plan and plan.jumpAt, contactAt = plan and plan.contactAt,
                    age = plan and plan.age, profileSpeed = plan and plan.profile.startSpeed, confirmed = play.confirmed}
                while #assist.Trace > 80 do table.remove(assist.Trace, 1) end
                if not plan then releaseMovement(); report("ARMED", "No reachable clear contact; waiting"); return end
                local flight = plan.flight
                if not play.ball then log("contact_plan", {jumpIn = plan.jumpAt - now, contactIn = plan.contactAt - now,
                    anticipated = not flight.confirmed}) end
                play.ballAt = play.ballAt or now
                play.ball, play.eventN, play.eventT, play.confirmed = flight.ball, flight.eventN, flight.eventT, flight.confirmed
                report("APPROACH", "Moving to measured takeoff window")
            end
            local plan = assist.Plan
            if plan and now >= plan.jumpAt - 0.012 then
                local speed = flat(state.motion).Magnitude
                local calibrated = plan.profile.startSpeed
                local speedMatches = calibrated > 2 and math.abs(speed - calibrated) <= math.max(1.5, calibrated * 0.25)
                    and flat(state.motion).Unit:Dot(plan.direction) > 0.9 or calibrated <= 2 and speed <= 2
                if flat(state.rootPosition - plan.launch).Magnitude > assist.Config.PositionTolerance or not speedMatches then
                    assist.Metrics.RunupMisses += 1
                    log("runup_missed", {speed = speed, requiredSpeed = calibrated,
                        distance = flat(state.rootPosition - plan.launch).Magnitude})
                    assist.Plan = nil; lastPlanAt = -math.huge; releaseMovement(); releaseInputs()
                    report("ARMED", "Approach missed timing; recomputing"); return
                end
                play.jumped, play.jumpAt = true, now
                pendingJump = now + 0.04
                if not host.jump(state) then assist.Cancel("Native jump adapter declined"); return end
                assist.Metrics.Jumps += 1
                log("jump_sent", {contactAt = plan.contactAt, launch = plan.launch, profileSpeed = calibrated})
                report("WINDUP", "One normal jump; native motion owns flight")
            end
            return
        end
        if not state.floorAir then
            if now - play.jumpAt > (assist.Plan.profile.takeoffAt + 0.2) then assist.Cancel("Native jump failed or landed"); end
            return
        end
        moveOwner = nil -- Never issue movement commands once airborne.
        local ball = host.ball(play.ball)
        if not ball then assist.Cancel("Ball removed / dead"); return end
        if play.confirmed and not ball.confirmed then assist.Cancel("Setter no longer owns this set"); return end
        if ball.confirmed and not play.confirmed then
            play.confirmed, play.eventN, play.eventT = true, ball.eventN, ball.eventT
            play.eventWaitAt = nil
            log("set_event_adopted", {eventN = ball.eventN, eventT = ball.eventT})
        elseif ball.eventN ~= play.eventN or ball.eventT ~= play.eventT then
            if play.confirmed then assist.Cancel("Ball changed after takeoff"); return end
            play.eventWaitAt = play.eventWaitAt or now
            if now - play.eventWaitAt > assist.Config.EventGrace then
                assist.Cancel("Set event was not identified after takeoff"); return
            end
        end
        if not play.confirmed then
            if now > assist.Plan.contactAt + 0.15 then assist.Cancel("Anticipated set did not occur"); end
            return
        end
        local lead = assist.HitLead()
        if not lead then assist.Cancel("Hit timing calibration expired"); return end
        local future = host.contactFuture(state, ball, lead)
        if future and host.poseReady(state, assist.Plan.attack) then
            local safe = host.attackNow(state, ball)
            if safe then
                play.clickAt = now
                click(state)
            elseif now > assist.Plan.contactAt + 0.12 then assist.Cancel("No safe attack within contact window") end
        elseif now > assist.Plan.contactAt + 0.12 then assist.Cancel("Contact window missed; no automatic spike") end
    end
    function assist.SafeTick()
        local ok, message = pcall(assist.Tick)
        if not ok then assist.Metrics.Errors += 1; assist.Enabled, assist.Wanted = false, false; assist.Cancel("Controller error: " .. tostring(message)) end
    end
    function assist.Destroy()
        if not alive then return end
        assist.Enabled, assist.Wanted, assist.Recording, alive = false, false, false, false
        assist.Cancel("Closed")
        host.unbindMovement()
    end
    return assist
end
