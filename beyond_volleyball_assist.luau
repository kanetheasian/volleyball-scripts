    local function emergency(ball,c,revision,reason)
        if c.force or not config.AutoSpikeEmergencySet or not host.emergency then return false end
        local goal=host.emergency(ball,c,c.airborne and c.facingDirection or nil,reason)
        if not emergencyGoal(goal)then return false end
        job={ball=ball,revision=revision or 0,character=c.character,created=now(),emergency=true,
            goal=goal,reason=reason,play=c.receivedPlay or config.AutoSetPlay,point=c.position,
            contact=goal.window.contact,contactAt=now()+(goal.contactDelay or goal.window.enter),rotationLocked=c.airborne==true}
        api.Busy=true;api.Move=Vector3.zero
