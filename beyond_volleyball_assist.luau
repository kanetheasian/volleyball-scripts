-- Account-scoped named profiles and explicit autoload preference.
local function createProfileLibrary(host)
    local Core,fs=host.core,host.fs or {}
    local folder="BVLAssist/"..tostring(host.userId)
    local path=folder.."/library.json"
    local store={Data={Version=2,Profiles={},Selected="",AutoLoad=""},Path=path}
    store.Available=type(fs.readfile)=="function" and type(fs.writefile)=="function" and type(fs.makefolder)=="function"
    local function snapshot(values)
        local config=Core.Defaults()
        local ok,reason=Core.Import(config,values)
        if not ok then return nil,reason end
        return config
    end
    local function nameOf(value)
        if type(value)~="string" then return nil,"Enter a profile name" end
        local name=value:match("^%s*(.-)%s*$")
        if #name==0 or #name>40 or name:find("[%c]") then return nil,"Use a profile name from 1 to 40 characters" end
        return name
    end
    local function readFile(file)
        if type(fs.readfile)~="function" then return nil end
        if fs.isfile and not fs.isfile(file) then return nil end
        local ok,value=pcall(fs.readfile,file)
        return ok and value or nil
    end
    local function decode(encoded)
        local data=host.decode(encoded)
        assert(type(data)=="table" and data.Version==2 and type(data.Profiles)=="table","Invalid profile library")
        local clean={Version=2,Profiles={},Selected="",AutoLoad=""}
        for key,entry in pairs(data.Profiles) do
            local name=nameOf(key)
            assert(name and name==key and type(entry)=="table","Invalid profile entry")
            local config,reason=snapshot(entry.Config);assert(config,reason)
            clean.Profiles[name]={Config=config,UpdatedAt=tonumber(entry.UpdatedAt) or 0}
        end
        if type(data.Selected)=="string" and clean.Profiles[data.Selected] then clean.Selected=data.Selected end
        if type(data.AutoLoad)=="string" and clean.Profiles[data.AutoLoad] then clean.AutoLoad=data.AutoLoad end
        return clean
    end
    local function commit(data)
        if not store.Available then return false,"Executor file storage is unavailable" end
        if store.ReadError then return false,store.ReadError end
        local ok,err=pcall(function()
            for _,directory in ipairs({"BVLAssist",folder}) do
                if not fs.isfolder or not fs.isfolder(directory) then fs.makefolder(directory) end
            end
            local previous=readFile(path)
            if previous then fs.writefile(path..".bak",previous) end
            fs.writefile(path,host.encode(data))
        end)
        if not ok then return false,tostring(err) end
        store.Data=data
        return true
    end
    local encoded=readFile(path)
    if encoded then
        local ok,data=pcall(decode,encoded)
        if not ok then
            local backup=readFile(path..".bak")
            if backup then ok,data=pcall(decode,backup) end
            if ok then store.Recovered=true end
        end
        if ok then store.Data=data else store.ReadError="Could not read profile library; existing files were preserved" end
    else
        local legacy=readFile("BVLAssist/"..tostring(host.userId)..".json")
        if legacy then
            local ok,values=pcall(function()
                local data=host.decode(legacy)
                assert(data.Version==1,"Unsupported legacy profile")
                local config,reason=snapshot(data.Config);assert(config,reason);return config
            end)
            if ok then
                local data={Version=2,Profiles={["Imported profile"]={Config=values,UpdatedAt=0}},Selected="Imported profile",AutoLoad=""}
                local saved=commit(data)
                if not saved then store.Data=data end
            end
        end
    end
    function store.Names()
        local names={}
        for name in pairs(store.Data.Profiles) do names[#names+1]=name end
        table.sort(names,function(a,b)return a:lower()<b:lower()end)
        return names
    end
    function store.Save(name,values)
        local valid,reason=nameOf(name);if not valid then return false,reason end
        local config,err=snapshot(values);if not config then return false,err end
        local data=table.clone(store.Data);data.Profiles=table.clone(data.Profiles)
        data.Profiles[valid]={Config=config,UpdatedAt=host.now and host.now() or 0};data.Selected=valid
        return commit(data)
    end
    function store.Select(name)
        if not store.Data.Profiles[name] then return false,"Choose a saved profile" end
        local data=table.clone(store.Data);data.Selected=name;return commit(data)
    end
    function store.Load(name)
        local entry=store.Data.Profiles[name]
        if not entry then return nil,"Choose a saved profile" end
        return snapshot(entry.Config)
    end
    function store.SetAutoload(enabled)
        local name=store.Data.Selected
        if enabled and not store.Data.Profiles[name] then return false,"Save or select a profile first" end
        local data=table.clone(store.Data);data.AutoLoad=enabled and name or "";return commit(data)
    end
    function store.Delete(name)
        if not store.Data.Profiles[name] then return false,"Choose a saved profile" end
        local data=table.clone(store.Data);data.Profiles=table.clone(data.Profiles);data.Profiles[name]=nil
        if data.Selected==name then data.Selected="" end
        if data.AutoLoad==name then data.AutoLoad="" end
        return commit(data)
    end
    function store.AutoloadConfig()
        if store.Data.AutoLoad=="" then return nil end
        return store.Load(store.Data.AutoLoad)
    end
    return store
end

-- Visual-only forecast tracking. No live ball, movement or action state is modified.
local function createVisualForecast(host)
    local Core,stepPhysics=host.core,host.stepPhysics
    local tracker={States={},FrameStep=1/60}
    local function vector(value)
        return value and Core.Finite(value.X) and Core.Finite(value.Y) and Core.Finite(value.Z)
    end
    local function snapshot(ball)
        return {Position=ball.Position,Velocity=ball.Velocity,Acceleration=ball.Acceleration or Vector3.zero,Spin=ball.Spin or Vector3.zero}
    end
    local function sameForces(a,b)
        return a and (a.Spin-(b.Spin or Vector3.zero)).Magnitude<0.0001
            and (a.Acceleration-(b.Acceleration or Vector3.zero)).Magnitude<0.0001
    end
    local function pendingSpin(state,ball,now)
        return state.kind=="Spike" and now<(state.spinPendingUntil or -math.huge)
            and (ball.Spin or Vector3.zero).Magnitude<0.0001
    end
    function tracker.Frame(dt)
        if not Core.Finite(dt) or dt<1/300 or dt>1/25 then return end
        tracker.FrameEstimate=tracker.FrameEstimate and tracker.FrameEstimate+(dt-tracker.FrameEstimate)*0.2 or dt
        dt=tracker.FrameEstimate
        local closest,distance=1/60,math.huge
        for _,candidate in ipairs({1/30,1/60,1/120,1/144,1/240})do
            local difference=math.abs(candidate-dt)
            if difference<distance then closest,distance=candidate,difference end
        end
        tracker.FrameStep=closest
    end
    function tracker.Reset(id)
        tracker.States[id]=nil
    end
    function tracker.Clear()
        table.clear(tracker.States)
    end
    function tracker.Observe(id,packet,now)
        if not id or not packet or not vector(packet.Position) or not vector(packet.Velocity) then return end
        local state=tracker.States[id] or {lastDraw=-math.huge,changingUntil=-math.huge}
        if packet.Kind then
            state.kind=packet.Kind
            state.spinPendingUntil=packet.Kind=="Spike" and now+0.5 or -math.huge
            state.contactUntil=now+((packet.Kind=="Spike" or packet.Kind=="Serve") and 0.35 or 0)
        end
        local previous=state.packet
        if previous and Core.Finite(packet.Time) and Core.Finite(previous.Time) then
            local elapsed=packet.Time-previous.Time
            if elapsed<=0 then return end -- Ignore duplicated/reordered unreliable packets.
            if elapsed<=0.35 then
                local expected=snapshot(previous)
                local time=0
                while time<elapsed do
                    local dt=math.min(tracker.FrameStep,elapsed-time)
                    expected.Position,expected.Velocity=stepPhysics(expected,dt)
                    time+=dt
                end
                local spin=packet.Spin or Vector3.zero
                local acceleration=packet.Acceleration or Vector3.zero
                local velocityError=(packet.Velocity-expected.Velocity).Magnitude
                local spinChange=(spin-previous.Spin).Magnitude
                local spinForceChange=(spin-previous.Spin):Cross(packet.Velocity).Magnitude
                local accelerationChange=(acceleration-previous.Acceleration).Magnitude
                if velocityError>2 or spinChange>math.max(0.5,previous.Spin.Magnitude*0.1) or spinForceChange>3 or accelerationChange>3 then
                    state.changingUntil=now+0.8
                end
                state.velocityError=velocityError
            end
        end
        state.packet=snapshot(packet);state.packet.Time=packet.Time
        state.dirty=true
        tracker.States[id]=state
    end
    function tracker.NeedsRefresh(id,ball,now)
        local state=tracker.States[id]
        if not state or state.dirty then return true end
        if not sameForces(state.drawPhysics,ball) or state.spinPending~=pendingSpin(state,ball,now) then return true end
        local curved=(ball.Spin or Vector3.zero).Magnitude>2 or (ball.Spin or Vector3.zero):Cross(ball.Velocity).Magnitude>3
        local interval=(curved or now<state.changingUntil) and 1/45 or 1/20
        return now-state.lastDraw>=interval
    end
    function tracker.Trace(ball,seconds,floorY,net)
        local dt=tracker.FrameStep
        local sim=snapshot(ball)
        local points={sim.Position}
        local radius=ball.Radius or 1.1
        for index=1,math.ceil(seconds/dt)do
            local h=math.min(dt,seconds-(index-1)*dt)
            local nextPosition,nextVelocity=stepPhysics(sim,h)
            local floorAlpha
            if sim.Position.Y<=floorY and sim.Velocity.Y<=0 then
                return {Points=points,Landing=Vector3.new(sim.Position.X,floorY,sim.Position.Z),Time=(index-1)*dt}
            end
            if sim.Position.Y>=floorY and nextPosition.Y<=floorY then
                floorAlpha=(sim.Position.Y-floorY)/math.max(sim.Position.Y-nextPosition.Y,1e-9)
            end
            local alpha=net and net.part and Core.SphereBoxEntry(sim.Position,nextPosition,net.part.CFrame,net.part.Size,radius)
            if alpha and alpha<=1e-7 then
                local localStart=net.part.CFrame:PointToObjectSpace(sim.Position)
                local localEnd=net.part.CFrame:PointToObjectSpace(nextPosition)
                -- A server-confirmed rebound may start on the collision skin. Let it leave the net.
                if localStart.Z*(localEnd.Z-localStart.Z)>0 and math.abs(localEnd.Z)>math.abs(localStart.Z)then alpha=nil end
            end
            if alpha and (not floorAlpha or alpha<floorAlpha)then
                local contact=sim.Position:Lerp(nextPosition,alpha)
                points[#points+1]=contact
                return {Points=points,NetContact=contact,NetHit=true,Time=(index-1)*dt+h*alpha}
            end
            if floorAlpha then
                local contact=sim.Position:Lerp(nextPosition,floorAlpha)
                points[#points+1]=contact
                return {Points=points,Landing=contact,Time=(index-1)*dt+h*floorAlpha}
            end
            sim.Position,sim.Velocity=nextPosition,nextVelocity
            points[#points+1]=nextPosition
        end
        return {Points=points,Time=seconds,HorizonLimited=true}
    end
    function tracker.GetLandingDecision(id,ball,net,now)
        local state=tracker.States[id] or {lastDraw=-math.huge,changingUntil=-math.huge}
        local floorY=net.floorY+(ball.Radius or 1)
        local cached=state.boundary
        if cached and not state.dirty and now-cached.at<1/60 and math.abs(cached.floorY-floorY)<0.01
            and cached.changingUntil==state.changingUntil and cached.contactUntil==state.contactUntil
            and sameForces(cached.physics,ball) and (cached.physics.Velocity-ball.Velocity).Magnitude<0.5
            and (ball.Position-cached.position).Magnitude<2 then return cached end
        local forecast=Core.Predict(ball,stepPhysics,6,floorY,tracker.FrameStep)
        local landing=forecast.Landing
        local previous=state.lastLanding
        if not landing or not previous or (landing-previous).Magnitude>1 then state.landingStableSince=now end
        if landing and previous and (landing-previous).Magnitude>2 then
            state.changingUntil=now+0.8;state.display=nil
        end
        state.lastLanding=landing
        local out=landing and not Core.InCourt(landing,net,-(ball.Radius or 1)) or false
        local gap=0
        if landing then
            local offset=landing-net.courtCenter
            gap=math.max(math.abs(offset:Dot(net.axis))-net.halfWidth-(ball.Radius or 1),
                math.abs(offset:Dot(net.normal))-net.halfDepth-(ball.Radius or 1))
        end
        local uncertain=pendingSpin(state,ball,now) or not landing or now<(state.contactUntil or -math.huge) or now<(state.changingUntil or -math.huge)
            or now-(state.landingStableSince or now)<0.15 or out and gap<2
        local decision={Landing=landing,Time=forecast.Time,Status=uncertain and "uncertain" or out and "out" or "in",
            SkipOut=out and not uncertain,Uncertain=uncertain,OutsideDistance=gap,at=now,floorY=floorY,position=ball.Position,
            changingUntil=state.changingUntil,contactUntil=state.contactUntil,physics=snapshot(ball),SpinPending=pendingSpin(state,ball,now)}
        state.boundary=decision;tracker.States[id]=state
        return decision
    end
    local function distanceToSegment(point,a,b)
        local delta=b-a
        local length=delta:Dot(delta)
        if length<1e-9 then return (point-a).Magnitude end
        return (point-(a+delta*math.clamp((point-a):Dot(delta)/length,0,1))).Magnitude
    end
    -- Repeatedly split the worst chord, so a looping curve cannot alias into a straight line.
    function tracker.Polyline(points,maximum,tolerance)
        if #points<=maximum+1 then return points end
        local function interval(first,last)
            local error,index=0,nil
            for i=first+1,last-1 do
                local value=distanceToSegment(points[i],points[first],points[last])
                if value>error then error,index=value,i end
            end
            return {first=first,last=last,error=error,index=index}
        end
        local intervals={interval(1,#points)}
        while #intervals<maximum do
            local selected,worst=nil,tolerance or 0.08
            for i,item in ipairs(intervals)do if item.index and item.error>worst then selected,worst=i,item.error end end
            if not selected then break end
            local item=table.remove(intervals,selected)
            intervals[#intervals+1]=interval(item.first,item.index)
            intervals[#intervals+1]=interval(item.index,item.last)
        end
        table.sort(intervals,function(a,b)return a.first<b.first end)
        local output={points[1]}
        for _,item in ipairs(intervals)do output[#output+1]=points[item.last]end
        return output
    end
    function tracker.Forecast(id,ball,seconds,floorY,now,renderPosition,net)
        local state=tracker.States[id] or {changingUntil=-math.huge}
        local changing=now<(state.changingUntil or -math.huge) or now<(state.contactUntil or -math.huge)
        local spin=(ball.Spin or Vector3.zero).Magnitude
        local spinPending=pendingSpin(state,ball,now)
        local curved=spin>8 or (ball.Spin or Vector3.zero):Cross(ball.Velocity).Magnitude>12
        local dt=tracker.FrameStep
        -- Render the complete current forecast, even while server spin is still arriving.
        seconds=math.max(seconds,12)
        local forecast=tracker.Trace(ball,seconds,floorY,net)
        local previousLanding=state.target and state.target.forecast.Landing
        if forecast.Landing and previousLanding and (forecast.Landing-previousLanding).Magnitude>2 then
            state.changingUntil=now+0.8;state.display=nil;changing=true
        end
        local horizon=forecast.Time or seconds
        local last=#forecast.Points
        local points={}
        local offset=vector(renderPosition) and renderPosition-ball.Position or Vector3.zero
        if offset.Magnitude>6 then offset=Vector3.zero end
        for index=1,last do
            local time=(index-1)*dt
            points[index]=forecast.Points[index]+offset*math.max(0,1-time/0.15)
        end
        local polyline=tracker.Polyline(points,curved and 128 or 64,curved and 0.035 or 0.08)
        forecast.DisplayPoints=polyline
        forecast.ShortPreview=false
        forecast.PreviewSeconds=math.min(horizon,forecast.Time or seconds)
        forecast.Changing=changing
        forecast.Curved=curved
        forecast.SpinPending=spinPending
        forecast.Step=dt
        forecast.EstimatedLanding=changing or spinPending or forecast.HorizonLimited==true
        -- Keep time-indexed simulation points for presentation. Adaptive chord indices
        -- change with curve phase and must not be used to match successive frames.
        state.segmentCount=math.max(state.segmentCount or 0,curved and 128 or math.max(8,#polyline-1))
        state.target={forecast=forecast,at=now,duration=forecast.Time or seconds,
            horizon=forecast.PreviewSeconds,maximum=state.segmentCount}
        if state.drawPhysics and not sameForces(state.drawPhysics,ball) then state.display=nil end
        state.drawPhysics=snapshot(ball);state.spinPending=spinPending
        state.lastDraw=now;state.dirty=false
        tracker.States[id]=state
        return forecast
    end
    local function sample(points,step,duration,time)
        if time<=0 or #points==1 then return points[1] end
        if time>=duration then return points[#points] end
        local index=math.min(math.floor(time/step)+1,#points-1)
        local span=math.min(step,duration-(index-1)*step)
        return points[index]:Lerp(points[index+1],math.clamp((time-(index-1)*step)/math.max(span,1e-9),0,1))
    end
    local function sampleHistory(display,time)
        if time<=display.horizon then return sample(display.points,display.step,display.horizon,time)end
        if time-display.horizon>0.1 then return nil end
        local points=display.points
        if #points<2 or display.endsAtLanding then return points[#points]end
        return points[#points]+(points[#points]-points[#points-1])*(time-display.horizon)/display.step
    end
    function tracker.Present(id,now,renderPosition)
        local state=tracker.States[id]
        local target=state and state.target
        if not target then return nil end
        local forecast=target.forecast
        local age=math.max(0,now-target.at)
        local horizon=math.max(0,target.horizon-age)
        local previous=nil -- New forecasts replace old geometry immediately; no stale-flight blending.
        local elapsed=previous and math.max(0,now-previous.at) or 0
        local alpha=previous and 1-math.exp(-elapsed/0.045) or 1
        local start=sample(forecast.Points,forecast.Step,target.duration,age)
        -- A large authoritative correction must snap instead of trailing an old arc.
        if previous then
            local old=sample(previous.points,previous.step,previous.horizon,elapsed)
            if elapsed>0.2 or (old-start).Magnitude>6 then previous=nil;alpha=1 end
        end
        if previous then
            local remaining=math.max(0,previous.horizon-elapsed)
            horizon=math.min(math.max(0,target.duration-age),remaining+(horizon-remaining)*alpha)
        end
        local count=horizon>0 and target.maximum or 0
        local step=count>0 and horizon/count or 1
        local points={}
        for index=0,count do
            local time=index*step
            local desired=sample(forecast.Points,forecast.Step,target.duration,age+time)
            if previous then
                local old=sampleHistory(previous,elapsed+time)
                if old then desired=old:Lerp(desired,alpha)end
            end
            points[index+1]=desired
        end
        local landing=forecast.Landing
        if landing and previous and previous.landing then landing=previous.landing:Lerp(landing,alpha) end
        state.display={at=now,points=points,step=step,horizon=horizon,landing=landing,
            endsAtLanding=forecast.Landing~=nil and not forecast.ShortPreview}
        local displayed={}
        local offset=vector(renderPosition) and renderPosition-points[1] or Vector3.zero
        if offset.Magnitude>6 then offset=Vector3.zero end
        for index,point in ipairs(points)do
            displayed[index]=point+offset*math.max(0,1-(index-1)*step/0.15)
        end
        return {DisplayPoints=displayed,Landing=landing,Time=forecast.Time and math.max(0,forecast.Time-age),
            NetHit=forecast.NetHit,NetContact=forecast.NetContact,HorizonLimited=forecast.HorizonLimited,
            Changing=forecast.Changing,ShortPreview=forecast.ShortPreview,EstimatedLanding=forecast.EstimatedLanding,
            SpinPending=forecast.SpinPending,
            PreviewSeconds=horizon,Step=forecast.Step}
    end
    return tracker
end

-- Automatic setter: native walking/actions, copied ball forecasts, confirmed-hit feedback.
local function createAutoSet(host)
    local Core,stepPhysics,config=host.core,host.stepPhysics,host.config
    local leadPlanner=Core.CreateSetPlanner(config)
    local api={History={},Flights={},SpikeFlights={},BotSlopes={},AttackMargins={},Models={Ground={},Air={},BackGround={},BackAir={},AirTilt={},BackAirTilt={}},Move=Vector3.zero,Busy=false}
    local job,lastPlan,lastRequest,lastTarget=nil,-math.huge,-math.huge,0
    local fakeStreak,backStreak=0,0
    local lastSprint=-math.huge
    local planningDeadline
    local function budgetSpent()
        if planningDeadline and host.now()>=planningDeadline then api.PlanningBudgetHit=true;return true end
        return false
    end
    local function flat(v)return Vector3.new(v.X,0,v.Z)end
    local seeds={{1,2.259,26.13},{2,4.255,25.439},{3,6.337,24.746},{6,12.8,22.66},{7,15.28,21.96},{8,17.025,21.448},{10,22.641,20.052},{11,25.678,19.352},{15,39.654,16.532}}
    for _,s in ipairs(seeds)do api.Models.Ground[#api.Models.Ground+1]={power=s[1],horizontal=s[2],vertical=s[3],estimated=true}end
    api.Models.Air={{power=3,horizontal=6.913,vertical=19.159,estimated=true},
        {power=4,horizontal=9.411,vertical=18.554,estimated=true},{power=15,horizontal=61.9983,vertical=5.4037,estimated=true}}
    api.Models.AirTilt={{power=15,pitch=-0.348823,horizontal=61.3383,vertical=-17.2441,referenceHorizontal=61.9983,referenceVertical=5.4037,estimated=true},
        {power=15,pitch=0.348613,horizontal=57.815,vertical=26.3611,referenceHorizontal=61.9983,referenceVertical=5.4037,estimated=true}}
    api.Models.BackAirTilt={{power=15,pitch=-0.346896,horizontal=59.3521,vertical=-15.4357,referenceHorizontal=62.7637,referenceVertical=5.5138,estimated=true},
        {power=15,pitch=0.348687,horizontal=59.2133,vertical=26.7282,referenceHorizontal=62.7637,referenceVertical=5.5138,estimated=true}}
    local seedGround,seedAir=table.clone(api.Models.Ground),table.clone(api.Models.Air)
    api.HeightModels={Ground={},Air={},AirGlide={},BackGround={},BackAir={},BackAirGlide={}}
    api.HeightModelVersion=3
    local function status(message)api.Status=message end
    function api.IsBusy()return api.Busy end
    local function release(reason)
        if job and job.entry and not job.entry.launch and (job.entry.status=="Set requested" or job.entry.status=="Spike requested") then
            job.entry.status="Set unconfirmed: "..(reason or "Attempt ended")
        end
        job=nil;api.Busy=false;api.Move=Vector3.zero;api.FakeOutState=nil;api.Sprinting=false
        host.release()
        status(reason or "Waiting for a receive")
    end
    function api.Cancel(reason)release(reason or "Paused")end
    function api.GetMove(position,speed,dt)
        if not job or job.requested or job.jumpIssued and not job.glideCharging then api.Move=Vector3.zero;return api.Move end
        if job.glideCharging then api.Move=job.glideDirection;return api.Move end
        local distance=flat(job.point-position).Magnitude
        if distance<=(job.stoppedAt and 1.5 or 1)then
            job.stoppedAt=job.stoppedAt or host.now();api.Move=Vector3.zero
        else
            job.stoppedAt=nil
            local delta=flat(job.point-position)
            local braking=math.max(0.5,math.max(1,speed or 1)*math.clamp(dt or 1/60,1/240,0.05)*1.5)
            api.Move=delta.Unit*math.min(1,math.max(0,distance-0.85)/braking)
        end
        return api.Move
    end
    local function sprint(context,distance)
        api.Sprinting=false
        if not config.AutoSetSprint or not host.sprint or context.state or context.airborne or distance<=math.max(8,context.speed*0.22)then return end
        api.Sprinting=true
        if host.now()-lastSprint<0.18 then return end
        lastSprint=host.now()
        local speed,accepted=host.sprint()
        if Core.Finite(speed) and speed>0 then context.speed=speed end
        if accepted then api.SprintBursts=(api.SprintBursts or 0)+1 end
    end
    function api.DecoyPoint(position,realPoint,candidates)
        local heading=flat(realPoint-position)
        if heading.Magnitude<0.1 then return nil end
        heading=heading.Unit
        local best,dot=nil,math.cos(math.rad(35))
        for _,point in ipairs(candidates or {})do
            local direction=flat(point-position)
            if direction.Magnitude>1 and direction.Unit:Dot(heading)<dot then best,dot=point,direction.Unit:Dot(heading)end
        end
        return best or position+Vector3.new(-heading.Z,0,heading.X)*20
    end
    function api.ObserveRemoved(id)
        local entry=api.Flights[id]
        if entry then entry.status="Ball removed before target contact";api.Flights[id]=nil end
        api.SpikeFlights[id]=nil
        if job and job.ballId==id then release("Ball removed")end
    end
    local function interpolate(model,power)
        local a,b=model[1],model[#model]
        for i=1,#model-1 do if power>=model[i].power and power<=model[i+1].power then a,b=model[i],model[i+1];break end end
        local alpha=a.power==b.power and 0 or math.clamp((power-a.power)/(b.power-a.power),0,1)
        return a.horizontal+(b.horizontal-a.horizontal)*alpha,a.vertical+(b.vertical-a.vertical)*alpha
    end
    local function frontVelocity(power,air)
        local horizontal,vertical=interpolate(api.Models.Ground,power)
        if air and #api.Models.Air>=2 and power>=api.Models.Air[1].power and power<=api.Models.Air[#api.Models.Air].power then
            return interpolate(api.Models.Air,power)
        end
        if air and #api.Models.Air>0 then
            local sample
            for _,value in ipairs(api.Models.Air)do if not sample or math.abs(value.power-power)<math.abs(sample.power-power)then sample=value end end
            local h,v=interpolate(api.Models.Ground,sample.power)
            horizontal=math.max(0.1,horizontal+sample.horizontal-h)
            vertical+=sample.vertical-v
        end
        return horizontal,vertical
    end
    local function velocityAt(power,air,backward)
        local h,v=frontVelocity(power,air)
        if not backward then return h,v end
        local model=air and api.Models.BackAir or api.Models.BackGround
        if #model>=2 and power>=model[1].power and power<=model[#model].power then return interpolate(model,power)end
        local nearest
        for _,sample in ipairs(model)do if not nearest or math.abs(sample.power-power)<math.abs(nearest.power-power)then nearest=sample end end
        if nearest then
            local fh,fv=frontVelocity(nearest.power,air)
            return math.max(0.1,h+nearest.horizontal-fh),v+nearest.vertical-fv
        end
        return h,v
    end
    function api.PitchedVelocity(power,air,backward,pitch,seedOnly)
        local h,v=velocityAt(power,air,backward)
        pitch=math.clamp(pitch or 0,-math.rad(20),math.rad(20))
        if not air or math.abs(pitch)<0.001 then return h,v end
        for _,sample in ipairs(backward and api.Models.BackAirTilt or api.Models.AirTilt)do
            if not seedOnly and not sample.estimated and math.abs(sample.power-power)<0.1 and math.abs(sample.pitch-pitch)<0.02 then
                return sample.horizontal,sample.vertical
            end
        end
        local horizontal,vertical=h*math.cos(pitch)-v*math.sin(pitch),h*math.sin(pitch)+v*math.cos(pitch)
        local nearest
        for _,sample in ipairs(backward and api.Models.BackAirTilt or api.Models.AirTilt)do
            if (not seedOnly or sample.estimated) and sample.pitch*pitch>0 and (not nearest or math.abs(sample.power-power)<math.abs(nearest.power-power))then nearest=sample end
        end
        if nearest then
            local refH,refV=nearest.referenceHorizontal,nearest.referenceVertical
            if refH and refV then
                local fraction=math.min(1,math.abs(pitch/nearest.pitch))
                local scale=math.clamp(math.sqrt(h*h+v*v)/math.max(1,math.sqrt(refH*refH+refV*refV)),0,1.5)*fraction
                horizontal+=(nearest.horizontal-(refH*math.cos(nearest.pitch)-refV*math.sin(nearest.pitch)))*scale
                vertical+=(nearest.vertical-(refH*math.sin(nearest.pitch)+refV*math.cos(nearest.pitch)))*scale
            end
        end
        return math.max(0.1,horizontal),vertical
    end
    -- Normal jump sets interpolate local observations instead of transporting a residual
    -- from a different power and a potentially outdated neutral reference.
    function api.NormalVelocity(power,air,backward,pitch,height,glide)
        if host.contactHeightAware and Core.Finite(height)then
            pitch=air and math.clamp(pitch or 0,-math.rad(20),math.rad(20)) or 0
            local key=backward and (air and "BackAir"or"BackGround")or(air and "Air"or"Ground")
            if air and glide then key=backward and "BackAirGlide"or"AirGlide"end
            local bucket=api.HeightModels[key][power]or{}
            local samples={}
            for _,sample in ipairs(bucket)do
                if math.abs(sample.height-height)<=1 and host.now()-sample.time<=3600 then
                    local present
                    for i,s in ipairs(samples)do
                        if math.abs(s.pitch-sample.pitch)<math.rad(0.25)then
                            present=true
                            if math.abs(sample.height-height)<math.abs(s.height-height)or sample.time>s.time and math.abs(sample.height-height)<=math.abs(s.height-height)+0.15 then samples[i]=sample end
                            break
                        end
                    end
                    if not present then samples[#samples+1]=sample end
                end
            end
            table.sort(samples,function(a,b)return a.pitch<b.pitch end)
            for i,s in ipairs(samples)do
                if math.abs(s.pitch-pitch)<math.rad(0.25)then return s.horizontal,s.vertical,true end
                local nextSample=samples[i+1]
                if nextSample and nextSample.pitch-s.pitch<=math.rad(10)+0.0001 and s.pitch<=pitch and pitch<=nextSample.pitch then
                    local alpha=(pitch-s.pitch)/(nextSample.pitch-s.pitch)
                    return s.horizontal+(nextSample.horizontal-s.horizontal)*alpha,s.vertical+(nextSample.vertical-s.vertical)*alpha,true
                end
            end
            local nearby
            for _,s in ipairs(samples)do
                if math.abs(s.pitch-pitch)<=math.rad(2)
                    and (not nearby or math.abs(s.pitch-pitch)<math.abs(nearby.pitch-pitch))then nearby=s end
            end
            if nearby then
                local delta=pitch-nearby.pitch
                return math.max(0.1,nearby.horizontal*math.cos(delta)-nearby.vertical*math.sin(delta)),
                    nearby.horizontal*math.sin(delta)+nearby.vertical*math.cos(delta),false
            end
            local h,v=interpolate(seedGround,power)
            if air then
                if power>=seedAir[1].power and power<=seedAir[#seedAir].power then h,v=interpolate(seedAir,power)
                else
                    local nearest=seedAir[1]
                    for _,s in ipairs(seedAir)do if math.abs(s.power-power)<math.abs(nearest.power-power)then nearest=s end end
                    local gh,gv=interpolate(seedGround,nearest.power)
                    h=math.max(0.1,h+nearest.horizontal-gh);v+=nearest.vertical-gv
                end
            end
            return math.max(0.1,h*math.cos(pitch)-v*math.sin(pitch)),h*math.sin(pitch)+v*math.cos(pitch),false
        end
        if not air then return api.PitchedVelocity(power,false,backward,pitch)end
        pitch=math.clamp(pitch or 0,-math.rad(20),math.rad(20))
        local samples={}
        local neutral=backward and api.Models.BackAir or api.Models.Air
        for _,sample in ipairs(neutral)do
            if not sample.estimated and math.abs(sample.power-power)<0.1 then
                samples[#samples+1]={pitch=0,horizontal=sample.horizontal,vertical=sample.vertical}
            end
        end
        for _,sample in ipairs(backward and api.Models.BackAirTilt or api.Models.AirTilt)do
            if not sample.estimated and math.abs(sample.power-power)<0.1 then samples[#samples+1]=sample end
        end
        table.sort(samples,function(a,b)return a.pitch<b.pitch end)
        local nearest
        for index,sample in ipairs(samples)do
            if math.abs(sample.pitch-pitch)<math.rad(0.25)then return sample.horizontal,sample.vertical,true end
            local following=samples[index+1]
            if following and following.pitch-sample.pitch<=math.rad(10)+0.0001 and sample.pitch<=pitch and pitch<=following.pitch then
                local alpha=(pitch-sample.pitch)/(following.pitch-sample.pitch)
                return sample.horizontal+(following.horizontal-sample.horizontal)*alpha,
                    sample.vertical+(following.vertical-sample.vertical)*alpha,true
            end
            if not nearest or math.abs(sample.pitch-pitch)<math.abs(nearest.pitch-pitch)then nearest=sample end
        end
        if nearest and math.abs(nearest.pitch-pitch)<=math.rad(5)then
            local delta=pitch-nearest.pitch
            return math.max(0.1,nearest.horizontal*math.cos(delta)-nearest.vertical*math.sin(delta)),
                nearest.horizontal*math.sin(delta)+nearest.vertical*math.cos(delta),false
        end
        local horizontal,vertical=api.PitchedVelocity(power,true,backward,pitch,true)
        return horizontal,vertical,false
    end
    local function botContact(origin,direction,horizontal,vertical,target,ballRadius,acceleration)
        local targetVelocity=flat(target.velocity or Vector3.zero)
        local targetAcceleration=flat(target.acceleration or Vector3.zero)
        local relative=direction*horizontal-targetVelocity
        local relativeSpeed=relative.Magnitude
        if relativeSpeed<0.1 and targetAcceleration.Magnitude<0.05 then return nil end
        local relativeDirection=relativeSpeed>=0.1 and relative.Unit or direction
        local radius=target.radius+ballRadius
        if target.hitboxFrame and target.hitboxSize then
            local frame,size=target.hitboxFrame,target.hitboxSize
            radius=(math.abs(frame.RightVector:Dot(relativeDirection))*size.X+math.abs(frame.UpVector:Dot(relativeDirection))*size.Y
                +math.abs(frame.LookVector:Dot(relativeDirection))*size.Z)/2+ballRadius
        end
        local delta=target.position-origin
        local along=flat(delta):Dot(relativeDirection)
        local first=math.max(0,(along-radius)/math.max(0.1,relativeSpeed))
        local last=math.min(3.5,(along+radius)/math.max(0.1,relativeSpeed))
        if targetAcceleration.Magnitude>=0.05 then first=0;last=3.5 end
        local velocity=direction*horizontal+Vector3.new(0,vertical,0)
        local function at(t)return origin+velocity*t+Vector3.new(0,0.5*acceleration*t*(t+1/60),0)end
        if target.hitboxFrame and target.hitboxSize then
            -- Split the local parabola at box-plane crossings. Only the intervals
            -- inside the expanded box need a rounded-corner distance root search.
            local frame,size=target.hitboxFrame,target.hitboxSize
            local offset=origin-frame.Position
            local axes={frame.RightVector,frame.UpVector,-frame.LookVector}
            local half={size.X/2,size.Y/2,size.Z/2}
            local coefficients={}
            local start=math.max(0,first-0.01)
            local cuts={start,last}
            local function root(a,b,c)
                if math.abs(a)<1e-9 then
                    if math.abs(b)>1e-9 then local t=-c/b;if t>start and t<last then cuts[#cuts+1]=t end end
                else
                    local discriminant=b*b-4*a*c
                    if discriminant>=0 then
                        local d=math.sqrt(discriminant)
                        for _,t in ipairs({(-b-d)/(2*a),(-b+d)/(2*a)})do if t>start and t<last then cuts[#cuts+1]=t end end
                    end
                end
            end
            for index,axis in ipairs(axes)do
                local gravity=0.5*acceleration*axis.Y
                local a=gravity-0.5*targetAcceleration:Dot(axis)
                local b=(velocity-targetVelocity):Dot(axis)+gravity/60
                local c=offset:Dot(axis)
                coefficients[index]={a,b,c}
                for _,bound in ipairs({half[index]+ballRadius,half[index]})do
                    root(a,b,c-bound);root(a,b,c+bound)
                end
            end
            table.sort(cuts)
            local function distance(t,expanded)
                local sum=0
                for index,p in ipairs(coefficients)do
                    local value=math.abs((p[1]*t+p[2])*t+p[3])
                    if expanded and value>half[index]+ballRadius+1e-7 then return false end
                    local gap=math.max(0,value-half[index]);sum+=gap*gap
                end
                return expanded and true or sum-ballRadius*ballRadius
            end
            for index=1,#cuts-1 do
                local lo,hi=cuts[index],cuts[index+1]
                if hi>lo+1e-9 and distance((lo+hi)/2,true)then
                    if distance(lo)<=1e-8 then return at(lo),lo end
                    local low,high=lo,nil
                    for sample=1,8 do
                        local t=lo+(hi-lo)*sample/8
                        if distance(t)<=0 then high=t;break end
                        low=t
                    end
                    if not high then
                        local a,b=lo,hi
                        for _=1,14 do
                            local x,y=a+(b-a)/3,b-(b-a)/3
                            if distance(x)<distance(y)then b=y else a=x end
                        end
                        local minimum=(a+b)/2
                        if distance(minimum)<=0 then low,high=lo,minimum end
                    end
                    if high then
                        for _=1,18 do local mid=(low+high)/2;if distance(mid)<=0 then high=mid else low=mid end end
                        return at(high),high
                    end
                end
            end
            return nil
        end
        local previous=first
        for time=first,last+1/60,1/60 do
            local position=at(math.min(time,last))
            if (position-target.position-targetVelocity*math.min(time,last)-targetAcceleration*(0.5*math.min(time,last)^2)).Magnitude<=radius then
                local low,high=previous,math.min(time,last)
                for _=1,7 do local mid=(low+high)/2;if (at(mid)-target.position-targetVelocity*mid-targetAcceleration*(0.5*mid^2)).Magnitude<=radius then high=mid else low=mid end end
                return at(high),high
            end
            previous=time
        end
    end
    function api.Landing(origin,velocity,acceleration,floorY,ballRadius)
        local gravity=math.max(1,-(acceleration or -25))
        local height=math.max(0,origin.Y-(floorY or 0.5)-(ballRadius or 1.1))
        local vertical=velocity.Y-gravity/120
        local time=(vertical+math.sqrt(vertical*vertical+2*gravity*height))/gravity
        return origin+flat(velocity)*time+Vector3.new(0,-height,0),time
    end
    function api.PlayPlacement(origin,target,playName)
        local play=Core.SetPlay(playName)
        if playName=="Quick" and target.livePlayer and target.net then
            local point=Core.QuickSetPoint(target.approachPosition or target.position,target.net,origin,target.velocity,target.spikeRadius)
            return point and point+Vector3.new(0,config.AutoSetAttackLift or 0,0)
        elseif playName=="Normal" and target.livePlayer and target.net then
            local side=target.setSide or Core.Side(target.approachPosition or target.position,target.net) or Core.Side(origin,target.net)
            local ownOrigin=side and target.net.center+target.net.normal*side or origin
            local point=Core.NormalSetPoint(target.approachPosition or target.position,target.net,ownOrigin)
            if point and target.attackBand then
                local center=target.fixedPlacement or target.attackCenter or point
                local depth=(center-target.net.center):Dot(target.net.normal)*side
                center+=target.net.normal*side*(math.clamp(depth,3,4)-depth)
                local across=(center-target.net.center):Dot(target.net.axis)
                local edge=math.max(0,target.net.halfWidth-1.6)
                center+=target.net.axis*(math.clamp(across,-edge,edge)-across)
                point=Vector3.new(center.X,target.attackBand.ideal,center.Z)
            end
            return point
        elseif playName=="Normal" and target.radius and target.net and math.abs((target.position-target.net.center):Dot(target.net.normal))<=8 then
            -- Preserve the authored bot's lateral/height marker; use the same own-side lane as player sets.
            local point=Core.SetAimPoint(target.position,target.net,origin,Core.SetPlays.Normal.netInset)
            return point and Vector3.new(point.X,target.position.Y,point.Z)
        elseif playName=="Pipe" then
            local net=target.net
            if not net then return nil,"Pipe needs a verified court" end
            local side=Core.Side(origin,net)
            local depth=side and net.attackLines and net.attackLines[side]
            if not depth then return nil,"Pipe needs the court's attack-line marker" end
            local approach=target.approachPosition or target.position
            if (approach-net.center):Dot(net.normal)*side<depth then return nil,"Pipe needs a spiker behind the attack line" end
            local lateral=math.clamp((approach-net.center):Dot(net.axis),-net.halfWidth+2,net.halfWidth-2)
            local landingDepth=math.max(2.5,depth-play.netwardOffset)
            local point=net.center+net.axis*lateral+net.normal*side*landingDepth
            return Vector3.new(point.X,net.floorY,point.Z)
        elseif playName=="Short" then
            local net=target.net
            if not net then return nil,"Short needs a verified court" end
            local side=Core.Side(origin,net)
            if not side then return nil end
            local approach=target.approachPosition or target.position
            local across=(origin-net.center):Dot(net.axis)
            local shift=math.clamp((approach-origin):Dot(net.axis),-play.landingDistance,play.landingDistance)
            local lateral=math.clamp(across+shift,-net.halfWidth+2,net.halfWidth-2)
            local point=net.center+net.axis*lateral+net.normal*side*play.netInset
            return Vector3.new(point.X,net.floorY,point.Z)
        end
        return target.position
    end
    function api.StabilizeAttackTarget(state,target,origin,now)
        if not target.livePlayer or not target.attackBand or not target.net then return state,target end
        local raw=table.clone(target);raw.fixedPlacement=nil
        local desired=api.PlayPlacement(origin,raw,"Normal")
        if config.SetLeadEnabled~=false then
            local shift=math.clamp(flat(target.velocity or Vector3.zero):Dot(target.net.axis)*math.min(config.TargetLead or 0.18,0.25),-2,2)
            desired+=target.net.axis*shift
        end
        local across=(desired-target.net.center):Dot(target.net.axis)
        local edge=math.max(0,target.net.halfWidth-1.6)
        desired+=target.net.axis*(math.clamp(across,-edge,edge)-across)
        local identity=target.object or target.name
        if not state or state.identity~=identity then
            state={identity=identity,point=desired,anchor=desired,band=table.clone(target.attackBand),updated=now}
        else
            local dt=math.clamp(now-state.updated,0,0.15)
            local shift=math.clamp((desired-(state.anchor or state.point)):Dot(target.net.axis),-2,2)
            desired=(state.anchor or state.point)+target.net.axis*shift
            local delta=(desired-state.point):Dot(target.net.axis)
            if math.abs(delta)>0.35 then
                local rate=math.max(6,config.SetAimCorrectionSpeed or 4)
                state.point+=target.net.axis*math.clamp(delta,-rate*dt,rate*dt)
            end
            state.updated=now
        end
        local stable=table.clone(target)
        stable.fixedPlacement=state.point;stable.attackCenter=state.point;stable.attackBand=state.band
        return state,stable
    end
    function api.ReaimCenteredDelivery(choice,origin,target,acceleration,ballRadius)
        if not choice or not choice.centered or not target.fixedPlacement or not choice.horizontal or choice.horizontal<=0 then return nil end
        local horizontal,vertical,measured=choice.horizontal,choice.vertical,choice.measuredLaunch
        if host.contactHeightAware then
            horizontal,vertical,measured=api.NormalVelocity(choice.power,choice.launchAir==true,choice.launchBack==true,
                choice.pitch or 0,origin.Y,choice.launchGlide==true)
        end
        local point=target.fixedPlacement
        local side=target.setSide or Core.Side(target.approachPosition or target.position,target.net) or Core.Side(origin,target.net)
        local depth=side and (point-target.net.center):Dot(target.net.normal)*side
        if not depth or depth<3-0.001 or depth>4+0.001 then return nil end
        local delta=flat(point-origin)
        if delta.Magnitude<0.5 then return nil end
        local time=delta.Magnitude/horizontal
        local height=origin.Y+vertical*time+0.5*acceleration*time*(time+1/60)
        local band=target.attackBand
        if time< (choice.recovery and 0.6 or 1) or time>Core.SetPlays.Normal.tempo+0.4 or height<band.minimum or height>band.maximum then return nil end
        if target.upperEntry then
            local sphere={position=Vector3.new(point.X,band.center,point.Z),radius=target.spikeRadius or 3.5}
            local contact=botContact(origin,delta.Unit,horizontal,vertical,sphere,ballRadius,acceleration)
            if not contact or contact.Y<band.minimum then return nil end
        end
        local peakTime=math.clamp(vertical/math.max(1,-acceleration),0,time)
        local peak=origin.Y+vertical*peakTime+0.5*acceleration*peakTime*(peakTime+1/60)
        if peak>math.max(origin.Y,band.maximum+Core.SetPlays.Normal.arc)+0.01 then return nil end
        local landing,landingTime=api.Landing(origin,delta.Unit*horizontal+Vector3.new(0,vertical,0),acceleration,target.net.floorY,ballRadius)
        if flat(landing-point):Dot(delta.Unit)<0.25 then return nil end
        if (origin-target.net.center):Dot(target.net.normal)*side<=Core.SetPlays.Normal.netInset+2.5
            and (landing-target.net.center):Dot(target.net.normal)*side<(ballRadius or 1.1)+0.35 then return nil end
        local result=table.clone(choice)
        result.point=point;result.contact=Vector3.new(point.X,height,point.Z);result.predictedAttackHeight=height
        result.time=time;result.error=math.abs(height-band.ideal);result.landing=landing;result.landingTime=landingTime
        result.predictionOrigin=origin
        result.horizontal=horizontal;result.vertical=vertical;result.measuredLaunch=measured==true
        result.landingDistance=flat(landing-origin).Magnitude;result.landingError=flat(landing-point).Magnitude
        return result
    end
    function api.ChoosePower(origin,target,maximum,air,acceleration,ballRadius,playName,backward,recovery)
        if target.hitboxFrame and target.velocity and (target.predictionLead or 0)>0 then
            target=table.clone(target)
            local lead=math.clamp(target.predictionLead,0,2.8)
            local accel=flat(target.acceleration or Vector3.zero)
            local offset=flat(target.velocity)*lead+accel*(0.5*lead^2)
            target.position+=offset;target.hitboxFrame+=offset
            target.velocity+=accel*lead
        end
        playName=playName or config.AutoSetPlay or "Normal"
        local play=Core.SetPlay(playName)
        if recovery and playName=="Normal" then play=table.clone(play);play.minFlightTime=target.recoveryMinFlightTime or 0.6 end
        local best
        local placement,reason=api.PlayPlacement(origin,target,playName)
        if not placement then return nil,reason end
        local direction=flat(placement-origin)
        if direction.Magnitude<0.5 then return nil end
        local distance=direction.Magnitude
        ballRadius=ballRadius or 1.1
        local maximumPower=math.floor(math.min(maximum or 15,play.maxPower or 30,30))
        local loftPitches={0}
        if playName=="Normal" and air and host.pitch then
            if target.livePlayer and target.attackBand or target.radius and target.net then
                for angle=2.5,20,2.5 do loftPitches[#loftPitches+1]=-math.rad(angle);loftPitches[#loftPitches+1]=math.rad(angle)end
            else for angle=5,20,5 do loftPitches[#loftPitches+1]=math.rad(angle)end end
        end
        local minimumAttackHeight
        if playName=="Normal" and target.net then
            minimumAttackHeight=target.net.topY+ballRadius+2
            if target.radius then minimumAttackHeight=math.max(minimumAttackHeight,target.position.Y+math.min(1,target.radius*0.25))
            else minimumAttackHeight=math.max(minimumAttackHeight,target.net.topY+Core.SetPlays.Normal.contactLift-1)end
        end
        local maximumAttackHeight
        if minimumAttackHeight and target.livePlayer and target.attackBand then
            minimumAttackHeight=target.attackBand.minimum;maximumAttackHeight=target.attackBand.maximum
        end
        local attackMargin=minimumAttackHeight and (target.object and api.AttackMargins[target.object] or 1.5) or 0
        if maximumAttackHeight then attackMargin=0 end
        if playName=="Normal" and target.radius and target.net and math.abs((target.position-target.net.center):Dot(target.net.normal))<=8 then
            local upperContact=target.hitboxFrame and target.hitboxSize
            minimumAttackHeight=math.max(target.net.topY+ballRadius+0.5,
                target.position.Y+target.radius*(upperContact and 0.65 or 0.4)+(upperContact and (config.AutoSetAttackLift or 0)or 0))
            attackMargin=0
        end
        local planningHeight=minimumAttackHeight and minimumAttackHeight+(recovery and 0 or attackMargin)
        local launchModel=backward and (air and api.Models.BackAir or api.Models.BackGround) or (air and api.Models.Air or api.Models.Ground)
        local tiltModel=backward and api.Models.BackAirTilt or api.Models.AirTilt
        local function measuredLaunch(power,pitch)
            local model=air and math.abs(pitch)>0.001 and tiltModel or launchModel
            for _,s in ipairs(model)do
                if not s.estimated and math.abs(s.power-power)<0.1 and (not s.pitch or math.abs(s.pitch-pitch)<0.02)then return true end
            end
            return false
        end
        local function trajectory(power,heading,horizontal,vertical)
            local landing,landingTime=api.Landing(origin,heading*horizontal+Vector3.new(0,vertical,0),acceleration,target.net and target.net.floorY,ballRadius)
            local landingDistance=flat(landing-origin).Magnitude
            local landingError=flat(landing-placement).Magnitude
            if playName=="Short" and landingDistance>play.maxLandingDistance then return nil end
            if playName=="Short" then
                local net=target.net
                local depth=(landing-net.center):Dot(net.normal)*(Core.Side(origin,net) or 1)
                if depth<ballRadius+0.25 or depth>play.netInset+play.netTolerance then return nil end
            end
            if playName=="Pipe" and landingError>play.landingTolerance then return nil end
            if playName=="Pipe" then
                local net=target.net
                local side=Core.Side(origin,net)
                local approach=target.approachPosition or target.position
                if (landing-approach):Dot(net.normal)*side>0 then return nil end
            end
            if (playName=="Short" or playName=="Pipe") and target.net
                and (not Core.InCourt(landing,target.net) or Core.Side(landing,target.net)~=Core.Side(origin,target.net)) then return nil end
            if playName=="Normal" and target.livePlayer and target.attackBand and target.net then
                local side=target.setSide or Core.Side(target.approachPosition or target.position,target.net) or Core.Side(origin,target.net)
                if side and (origin-target.net.center):Dot(target.net.normal)*side<=Core.SetPlays.Normal.netInset+2.5
                    and (landing-target.net.center):Dot(target.net.normal)*side<ballRadius+0.35 then return nil end
            end
            local score=play.preferredPower and math.abs(power-math.min(play.preferredPower,maximumPower))*play.powerWeight or 0
            if playName=="Short" then score+=landingError*2
            elseif playName=="Pipe" then
                score+=landingError*3
                if target.radius then
                    local net=target.net
                    local side=Core.Side(origin,net)
                    local line=net.attackLines[side]
                    local approach=target.approachPosition or target.position
                    local depth=(approach-net.center):Dot(net.normal)*side
                    local placementDepth=(placement-net.center):Dot(net.normal)*side
                    local preferred=placementDepth+math.min(2.5,math.max(0,depth-line-1.5))
                    score+=math.max(0,preferred-(landing-net.center):Dot(net.normal)*side)*15
                end
            end
            return {landing=landing,landingTime=landingTime,landingError=landingError,landingDistance=landingDistance,score=score}
        end
        if target.radius and target.net then
            local net=target.net
            local side=Core.Side(target.position,net) or 1
            local slope=api.BotSlopes[target.object] or target.slope or 1.1
            local aimPoints={}
            if playName=="Pipe" then
                for _,depth in ipairs({0,1,2,3,4})do
                    for _,lateral in ipairs({0,-1.5,1.5})do
                        aimPoints[#aimPoints+1]=placement+net.normal*side*depth+net.axis*lateral
                    end
                end
            elseif playName=="Normal" and math.abs((target.position-net.center):Dot(net.normal))<=8 then aimPoints[1]=placement
            else
                for _,inset in ipairs({0,0.8,1.6})do aimPoints[#aimPoints+1]=placement-net.normal*side*inset end
            end
            local botPitches=loftPitches
            if playName=="Quick" and air and host.pitch and target.hitboxFrame then botPitches={0,math.rad(5),math.rad(10)}end
            local compact=playName=="Normal" and air and host.pitch and target.hitboxFrame~=nil
            if compact then botPitches={0,-math.rad(5),math.rad(5),-math.rad(10),math.rad(10),-math.rad(15),math.rad(15),-math.rad(20),math.rad(20)}end
            for pitchIndex,pitch in ipairs(botPitches)do
            for power=1,maximumPower do
                if budgetSpent()then return best end
                local horizontal,vertical=api.PitchedVelocity(power,air,backward,pitch)
                local calibrated
                if playName=="Normal" or host.contactHeightAware then horizontal,vertical,calibrated=api.NormalVelocity(power,air,backward,pitch,origin.Y,target.setterGlide)end
                if host.contactHeightAware and playName=="Normal" and air and not calibrated and math.abs(pitch)>math.rad(10)+0.0001 then continue end
                for _,point in ipairs(aimPoints)do
                    if config.SetLeadEnabled~=false and target.hitboxFrame and target.velocity then
                        local base=point
                        for _=1,2 do
                            local time=flat(point-origin).Magnitude/math.max(0.1,horizontal)
                            time=math.min(time,1.65)
                            local shift=math.clamp(target.velocity:Dot(net.axis)*time+(target.acceleration or Vector3.zero):Dot(net.axis)*(0.5*time^2),-10,10)
                            point=base+net.axis*shift
                        end
                    end
                    local heading=flat(point-origin)
                    if heading.Magnitude>0.5 then
                        local flight=trajectory(power,heading.Unit,horizontal,vertical)
                        local contact,time
                        if flight then contact,time=botContact(origin,heading.Unit,horizontal,vertical,target,ballRadius,acceleration or -25)end
                        local centerTime,centerHeight,centerReady
                        local centeredBot=playName=="Normal" and target.hitboxFrame
                            and math.abs((target.position-net.center):Dot(net.normal))<=8
                        if centeredBot then
                            centerTime=heading.Magnitude/horizontal
                            centerHeight=origin.Y+vertical*centerTime+0.5*(acceleration or -25)*centerTime*(centerTime+1/60)
                            centerReady=centerHeight>=target.position.Y+target.radius*0.4 and centerHeight<=target.position.Y+target.radius+ballRadius*0.35
                        end
                        if contact and (not play.minFlightTime or time>=play.minFlightTime)
                            and (not planningHeight or contact.Y>=planningHeight)
                            and (not centeredBot or centerReady)
                            and (playName~="Normal" or (contact-net.center):Dot(net.normal)*side>=ballRadius+0.35)then
                            local depth=math.abs((contact-net.center):Dot(net.normal))
                            local clearance=contact.Y-net.topY-ballRadius-depth*slope-0.15
                            if playName=="Pipe" and clearance<0.35 then continue end
                            local behind=math.max(0,flat(contact-target.position-flat(target.velocity or Vector3.zero)*time-flat(target.acceleration or Vector3.zero)*(0.5*time^2)):Dot(heading.Unit))
                            local peakTime=math.clamp(vertical/math.max(1,-(acceleration or -25)),0,time)
                            local peak=origin.Y+vertical*peakTime+0.5*(acceleration or -25)*peakTime*(peakTime+1/60)
                            local arc=math.max(0,peak-contact.Y)
                            local tempoScore=math.abs(time-play.tempo)*play.tempoWeight+math.abs(arc-play.arc)*play.arcWeight
                            local score=math.max(0,0.8-clearance)*30-math.min(clearance,1.6)*3+behind*2+tempoScore+flight.score+math.abs(pitch)*2
                            local unsupported=playName=="Normal" and air and math.abs(pitch)>math.rad(10)+0.0001 and not calibrated
                            if playName=="Normal" or playName=="Quick" then
                                local extra=playName=="Normal"and target.hitboxFrame and (config.AutoSetAttackLift or 0)or 0
                                local ideal=math.max(planningHeight or -math.huge,
                                    math.min(target.position.Y+target.radius+ballRadius*0.35,target.position.Y+target.radius*0.95+extra))
                                score+=math.abs((centerHeight or contact.Y)-ideal)*12
                            end
                            local learned=measuredLaunch(power,pitch)
                            if (air or host.contactHeightAware) and playName=="Normal" then learned=calibrated==true end
                            local better=not best
                            if best then
                                if unsupported~=best.uncalibratedTilt then better=not unsupported
                                elseif playName=="Normal" and learned~=best.measuredLaunch then better=learned
                                elseif playName=="Quick" and power~=best.power then better=math.abs(power-math.min(play.preferredPower,maximumPower))<math.abs(best.power-math.min(play.preferredPower,maximumPower))
                                else better=score<best.score end
                            end
                            if better then best={power=power,time=time,error=math.abs(contact.Y-target.position.Y),
                                score=score,point=point,contact=contact,clearance=clearance,horizontal=horizontal,vertical=vertical,
                                uncalibratedTilt=unsupported,predictionOrigin=origin,measuredLaunch=learned,
                                centerTime=centerTime,centerHeight=centerHeight,
                                arc=arc,play=playName,pitch=pitch,minimumAttackHeight=minimumAttackHeight,attackMargin=attackMargin,estimated=true,landing=flight.landing,landingTime=flight.landingTime,
                                landingError=flight.landingError,landingDistance=flight.landingDistance,placement=placement}end
                        end
                    end
                end
            end
            if best and (playName~="Normal" and playName~="Quick" or playName=="Quick" and pitchIndex>=#botPitches or compact and pitchIndex>=5)then break end
            end
            return best,not best and play.minFlightTime and "Normal needs a high attack contact and at least one second of flight" or nil
        end
        local tiltQuick=false
        if air and host.pitch~=nil and playName=="Quick" and target.livePlayer and target.net then
            local h,v=velocityAt(math.min(maximumPower,play.preferredPower),true,backward)
            local time=distance/math.max(0.1,h)
            local predicted=origin.Y+v*time+0.5*(acceleration or -25)*time*time
            tiltQuick=flat((target.approachPosition or target.position)-origin).Magnitude<=target.net.halfWidth*0.7
                or predicted>placement.Y+math.max(1,(target.spikeRadius or 3.5)*0.4)
        end
        local pitches=loftPitches
        if tiltQuick then for angle=-20,20,2 do if angle~=0 then pitches[#pitches+1]=math.rad(angle)end end end
        for _,pitch in ipairs(pitches)do
        for power=1,maximumPower do
            if budgetSpent()then return best end
            local horizontal,vertical,calibrated
            if playName=="Normal" or host.contactHeightAware then horizontal,vertical,calibrated=api.NormalVelocity(power,air,backward,pitch,origin.Y,target.setterGlide)
            else horizontal,vertical=api.PitchedVelocity(power,air,backward,pitch)end
            if maximumAttackHeight and host.contactHeightAware and air and not recovery and not calibrated and math.abs(pitch)>math.rad(0.25)then continue end
            if host.contactHeightAware and playName=="Normal" and air and not calibrated and math.abs(pitch)>math.rad(10)+0.0001 then continue end
            if horizontal>0.1 then
                local time=distance/horizontal
                local movingTarget=placement
                if config.SetLeadEnabled~=false and not target.fixedPlacement then
                    if target.net then
                        local _,shift=leadPlanner.LeadSetPoint(target.approachPosition or target.position,target.velocity or Vector3.zero,target.net,origin,math.min(time,0.6))
                        movingTarget+=target.net.axis*(shift or 0)
                    else
                        movingTarget+=(target.velocity or Vector3.zero)*math.min(time,0.6)
                    end
                end
                if playName=="Short" then
                    local shift=math.clamp((movingTarget-origin):Dot(target.net.axis),-play.landingDistance,play.landingDistance)
                    movingTarget=placement+target.net.axis*(shift-(placement-origin):Dot(target.net.axis))
                end
                local length=flat(movingTarget-origin).Magnitude
                time=length/horizontal
                local height=origin.Y+vertical*time+0.5*(acceleration or -25)*time*time
                local playerContact
                local entryContact,entryTime
                if maximumAttackHeight then
                    local center=Vector3.new(movingTarget.X,target.attackBand.center,movingTarget.Z)
                    local sphere={position=Vector3.new(center.X,target.attackBand.center,center.Z),radius=target.spikeRadius or 3.5}
                    entryContact,entryTime=botContact(origin,flat(movingTarget-origin).Unit,horizontal,vertical,sphere,ballRadius,acceleration or -25)
                    height=origin.Y+vertical*time+0.5*(acceleration or -25)*time*(time+1/60)
                    playerContact=entryContact and Vector3.new(movingTarget.X,height,movingTarget.Z)
                end
                local desiredHeight=(playName=="Short" or playName=="Pipe") and (target.contactY or target.position.Y) or movingTarget.Y
                if tiltQuick then desiredHeight=math.max(desiredHeight,target.net.topY+3.5+play.attackHeightRaise+(config.AutoSetAttackLift or 0))end
                if tiltQuick and target.airborne and target.spikeCenter then
                    desiredHeight=math.clamp(target.spikeCenter.Y+(target.velocity and target.velocity.Y or 0)*time-0.5*(target.gravity or 50)*time*time+(target.spikeRadius or 3.5)*0.25+play.attackHeightRaise+(config.AutoSetAttackLift or 0),
                        target.net.topY+3+play.attackHeightRaise+(config.AutoSetAttackLift or 0),target.net.topY+6+play.attackHeightRaise+(config.AutoSetAttackLift or 0))
                end
                local error=math.abs(height-desiredHeight)
                local peakTime=math.clamp(vertical/math.max(1,-(acceleration or -25)),0,time)
                local peak=origin.Y+vertical*peakTime+0.5*(acceleration or -25)*peakTime*peakTime
                local flight=trajectory(power,flat(movingTarget-origin).Unit,horizontal,vertical)
                local uncalibratedTilt=playName=="Normal" and air and math.abs(pitch)>math.rad(10)+0.0001 and not calibrated
                if playName=="Quick" and target.livePlayer and target.net
                    and (time>play.maxFlightTime or height<target.net.topY+ballRadius+1)then flight=nil end
                if planningHeight and height<planningHeight then flight=nil end
                if maximumAttackHeight and height>maximumAttackHeight then flight=nil end
                if maximumAttackHeight and peak>math.max(origin.Y,maximumAttackHeight+Core.SetPlays.Normal.arc)+0.01 then flight=nil end
                if maximumAttackHeight and not playerContact then flight=nil end
                if target.upperEntry and entryContact and entryContact.Y<(planningHeight or -math.huge)then flight=nil end
                if maximumAttackHeight and flight then
                    local heading=flat(movingTarget-origin).Unit
                    if flat(flight.landing-movingTarget):Dot(heading)<0.25 then flight=nil end
                end
                if maximumAttackHeight and time>Core.SetPlays.Normal.tempo+0.4 then flight=nil end
                if play.minFlightTime and time<play.minFlightTime then flight=nil end
                if flight then
                    local measured=measuredLaunch(power,pitch)
                    if playName=="Normal" and (air or host.contactHeightAware) then measured=calibrated==true end
                    local score=(playName=="Pipe" and 0 or error*8)+math.abs(time-play.tempo)*(maximumAttackHeight and 12 or play.tempoWeight)+math.abs(math.max(0,peak-desiredHeight)-play.arc)*play.arcWeight+flight.score+math.abs(pitch)*2
                    if maximumAttackHeight and not measured then score+=30 end
                    if playName=="Normal" and target.livePlayer then
                        score+=math.max(0,power-10)^2*1.5+math.max(0,vertical+(acceleration or -25)*time)
                    end
                    local powerGap=playName=="Quick" and math.abs(power-math.min(play.preferredPower,maximumPower)) or nil
                    local contactReachable=not tiltQuick or error<=math.max(1,(target.spikeRadius or 3.5)*0.4)
                    local better=not best
                    if best then
                        if maximumAttackHeight and uncalibratedTilt~=best.uncalibratedTilt then better=not uncalibratedTilt
                        elseif maximumAttackHeight and measured~=best.measuredLaunch then better=measured
                        elseif tiltQuick and contactReachable~=best.contactReachable then better=contactReachable
                        elseif tiltQuick and not contactReachable then better=error<best.error
                        elseif powerGap then better=powerGap<best.preferredPowerGap or powerGap==best.preferredPowerGap and score<best.score
                        else better=score<best.score end
                    end
                    if better then best={power=power,time=time,error=error,score=score,point=movingTarget,preferredPowerGap=powerGap,
                        horizontal=horizontal,vertical=vertical,play=playName,pitch=pitch,closeQuick=tiltQuick,contactReachable=contactReachable,desiredContactHeight=desiredHeight,
                        minimumAttackHeight=minimumAttackHeight,maximumAttackHeight=maximumAttackHeight,attackMargin=attackMargin,predictedAttackHeight=height,contact=playerContact,
                        predictionOrigin=origin,uncalibratedTilt=uncalibratedTilt,
                        entryContact=entryContact,entryTime=entryTime,centered=maximumAttackHeight~=nil,measuredLaunch=measured,
                        launchAir=air==true,launchBack=backward==true,launchGlide=target.setterGlide==true,
                        estimated=math.abs(pitch)>0.001 or air and #api.Models.Air<2 or false,
                        landing=flight.landing,landingTime=flight.landingTime,landingError=flight.landingError,
                        landingDistance=flight.landingDistance,placement=placement}end
                end
            end
        end
        if best and playName=="Normal" and not maximumAttackHeight then break end
        end
        return best,not best and play.minFlightTime and "Normal needs a high attack contact and at least one second of flight" or nil
    end
    function api.ChooseRecovery(origin,target,maximum,air,acceleration,ballRadius,playName,backward)
        if playName=="Short" then maximum=math.min(maximum or 15,Core.SetPlay("Short").maxPower)end
        if playName=="Normal" then
            target=table.clone(target);target.recoveryMinFlightTime=0.95
            if target.attackBand then
                target.attackBand=table.clone(target.attackBand)
                target.attackBand.minimum=math.min(target.attackBand.minimum,target.attackBand.recoveryMinimum or target.attackBand.minimum)
                target.upperEntry=false
            end
        end
        local choice=api.ChoosePower(origin,target,maximum,air,acceleration,ballRadius,"Normal",backward,true)
        if choice then choice.recovery=true;choice.recoveryEstimated=not choice.measuredLaunch;choice.requestedPlay=playName end
        return choice
    end
    function api.ChooseDelivery(origin,target,maximum,air,acceleration,ballRadius,playName,backward)
        local choice,reason=api.ChoosePower(origin,target,maximum,air,acceleration,ballRadius,playName,backward)
        if choice or reason then return choice,reason end
        if playName~="Normal" then
            choice=api.ChooseRecovery(origin,target,maximum,air,acceleration,ballRadius,playName,backward)
            if choice then return choice end
        end
        return nil,reason
    end
    function api.EmergencyTarget(context)
        return {name="Deep corner set",position=context.net.center,net=context.net,fallback=true,emergencyOnly=true}
    end
    function api.IsDeepHitter(target)
        if not target.livePlayer or not target.approachPosition or not target.net or target.airborne then return false end
        local side=Core.Side(target.approachPosition,target.net)
        local line=side and target.net.attackLines and target.net.attackLines[side]
        local depth=side and (target.approachPosition-target.net.center):Dot(target.net.normal)*side or 0
        return line~=nil and depth>math.max(line+6,target.net.halfDepth*0.65)
    end
    function api.HitterCanArrive(target,choice,lead)
        if not choice or not api.IsDeepHitter(target)then return true end
        local distance=flat((choice.contact or choice.point)-target.approachPosition).Magnitude
        local speed=math.max(16,target.speed or 0,flat(target.velocity or Vector3.zero).Magnitude)
        local runTime=math.max(0,distance-(target.spikeRadius or 3.5))/speed
        return runTime+0.2<=math.max(0,lead or 0)+(choice.time or 0)+0.5
    end
    function api.ChooseEmergency(origin,net,maximum,air,acceleration,ballRadius,reason,side,forcedHeading)
        side=side or Core.Side(origin,net)
        if not side then return nil end
        acceleration=acceleration or -25;ballRadius=ballRadius or 1.1
        local margin=math.max(3.5,ballRadius+2)
        local cornerAcross,cornerDepth=net.halfWidth-margin-2,net.halfDepth-margin-2
        if cornerAcross<=0 or cornerDepth<=0 then return nil end
        local across=(origin-net.center):Dot(net.axis)
        local depth=(origin-net.center):Dot(net.normal)*side
        local pitches={0}
        if air and host.pitch then for angle=2.5,20,2.5 do pitches[#pitches+1]=math.rad(angle);pitches[#pitches+1]=-math.rad(angle)end end
        local requiredClearance=host.cornerClearance and host.cornerClearance(net,side) or 1
        requiredClearance=Core.Finite(requiredClearance) and math.max(1,requiredClearance) or 1
        local frontDepth=math.min(8,net.halfDepth*0.2)
        local preferred=across>=0 and -1 or 1
        local best,bestEffort
        -- Opposite lateral corner is the farthest on the opponent's baseline.
        for _,cornerSide in ipairs({preferred})do
                local corner=net.center+net.axis*cornerSide*cornerAcross-net.normal*side*cornerDepth
                local point=corner
                local delta=flat(point-origin)
                if forcedHeading and flat(forcedHeading).Magnitude>0.1 then
                    delta=flat(forcedHeading).Unit*math.max(1,delta.Magnitude);point=origin+delta
                end
                if delta.Magnitude>0.5 then
                    local heading=delta.Unit
                    for _,pitch in ipairs(pitches)do
                        for power=1,math.floor(math.clamp(maximum or 15,0,30))do
                            if budgetSpent()then return best or bestEffort end
                local h,v=api.NormalVelocity(power,air,false,pitch,origin.Y)
                            local landing,time=api.Landing(origin,heading*h+Vector3.new(0,v,0),acceleration,net.floorY,ballRadius)
                            local landingDepth=(landing-net.center):Dot(net.normal)*side
                            local landingAcross=math.abs((landing-net.center):Dot(net.axis))
                            local inBounds=Core.InCourt(landing,net,margin)
                            local clearance=depth<=ballRadius and origin.Y-ballRadius-(net.topY or net.center.Y) or math.huge
                            local forward=-heading:Dot(net.normal)*side*h
                            if forward>0 and landingDepth< -margin then
                                for _,edge in ipairs({ballRadius,0,-ballRadius})do
                                    local crossing=(depth-edge)/forward
                                    if crossing>=0 and crossing<=time then
                                        local height=origin.Y+v*crossing+0.5*acceleration*crossing*(crossing+1/60)
                                        clearance=math.min(clearance,height-ballRadius-(net.topY or net.center.Y))
                                    end
                                end
                            else clearance=-math.huge end
                            local frontClearance=clearance
                            if forward>0 and landingDepth<=-frontDepth then
                                local crossing=(depth+frontDepth)/forward
                                if crossing>=0 and crossing<=time then
                                    local height=origin.Y+v*crossing+0.5*acceleration*crossing*(crossing+1/60)
                                    frontClearance=math.min(frontClearance,height-ballRadius-(net.topY or net.center.Y))
                                else frontClearance=-math.huge end
                            else frontClearance=-math.huge end
                            local loftValidated=frontClearance>=requiredClearance
                            local cornerError=flat(landing-corner).Magnitude
                            if inBounds and landingDepth<=-net.halfDepth*0.75 and landingAcross>=net.halfWidth*0.7
                                and cornerError<=math.max(3.5,ballRadius*2) and loftValidated then
                                local score=cornerError+math.abs(pitch)*2
                                if not best or time<best.time-0.001 or math.abs(time-best.time)<=0.001 and score<best.score then
                                    best={power=power,pitch=pitch,point=point,placement=corner,landing=landing,landingTime=time,time=time,
                                        horizontal=h,vertical=v,play="Deep corner",recovery=true,emergency=true,
                                        emergencyReason=reason or "Selected hitter unavailable",safeLanding=true,clearance=clearance,
                                        frontClearance=frontClearance,requiredClearance=requiredClearance,loftValidated=true,
                                        score=score,cornerError=cornerError,cornerValidated=true,bestEffortCorner=false,landingInBounds=true,
                                        landingDistance=flat(landing-origin).Magnitude}
                                end
                            end
                            -- Keep a native set available even when the ideal corner cannot be reached.
                            local opposite=landingDepth< -margin
                            local safeOpponent=opposite and inBounds and clearance>=0.35
                            local boundsError=math.max(0,landingAcross-net.halfWidth+margin)
                                +math.max(0,math.abs(landingDepth)-net.halfDepth+margin)
                            local clearanceError=Core.Finite(clearance) and math.max(0,0.35-clearance) or 20
                            local landingRank=safeOpponent and loftValidated and 0 or safeOpponent and 1 or inBounds and 2 or 3
                            local loftError=Core.Finite(frontClearance) and math.max(0,requiredClearance-frontClearance) or 20
                            local effortScore=clearanceError*1000+loftError*100+boundsError*100+cornerError+time*2+math.abs(pitch)*2
                            if not bestEffort or landingRank<bestEffort.landingRank
                                or landingRank==bestEffort.landingRank and effortScore<bestEffort.score then
                                bestEffort={power=power,pitch=pitch,point=point,placement=corner,landing=landing,landingTime=time,time=time,
                                    horizontal=h,vertical=v,play="Deep corner",recovery=true,emergency=true,
                                    emergencyReason=reason or "Selected hitter unavailable",safeLanding=safeOpponent,clearance=clearance,
                                    frontClearance=frontClearance,requiredClearance=requiredClearance,loftValidated=loftValidated,
                                    score=effortScore,landingRank=landingRank,landingInBounds=inBounds,
                                    cornerError=cornerError,cornerValidated=false,bestEffortCorner=true,
                                    landingDistance=flat(landing-origin).Magnitude}
                            end
                        end
                    end
                end
        end
        return best or bestEffort
    end
    function api.ResolveDelivery(origin,target,context,ball,air,play,backward,lead,reason,unavailableFor)
        if not target.emergencyOnly then
            local choice,why=api.ChooseDelivery(origin,target,context.maxPower,air,ball.Acceleration.Y,ball.Radius,play,backward)
            if choice and not choice.uncalibratedTilt and api.HitterCanArrive(target,choice,lead)then return choice end
            if not choice or not choice.recovery or choice.uncalibratedTilt then
                local recovery=api.ChooseRecovery(origin,target,context.maxPower,air,ball.Acceleration.Y,ball.Radius,play,backward)
                if recovery and (not choice or not recovery.uncalibratedTilt) and api.HitterCanArrive(target,recovery,lead)then return recovery end
            end
            if choice and api.HitterCanArrive(target,choice,lead)then return choice end
            if budgetSpent()then return nil,"Delivery search deferred within planner budget"end
            reason=choice and "Hitter cannot reach the attack lane in time" or why or "No usable hitter trajectory"
        end
        local heading=context.airborne and context.facingDirection or nil
        if heading and backward then heading=-heading end
        return api.ChooseEmergency(origin,context.net,context.maxPower,air,ball.Acceleration.Y,ball.Radius,
            reason or "Selected hitter unavailable",Core.Side(context.position,context.net),heading)
    end
    function api.SaveIntercept(ball,context,mode,play)
        local spikeGlideSpeed=context.glideSpeed
        context=table.clone(context);context.glideSpeed=nil
        local preferSpike=config.AutoSetSpikeDump and mode~="Ground"and context.spikePosition and context.spikeRadius
        if context.dump or preferSpike then
            local side=Core.Side(context.position,context.net)or 1
            local across=(context.position-context.net.center):Dot(context.net.axis)
            context.targetFacingPoint=context.net.center+context.net.axis*(across>=0 and -1 or 1)*(context.net.halfWidth-5.5)
                -context.net.normal*side*(context.net.halfDepth-5.5)
        end
        if preferSpike and not context.airborne and not context.state then
            local spikeContext=table.clone(context)
            spikeContext.glideSpeed=config.AutoSetGlide and spikeGlideSpeed or nil
            spikeContext.spikeApproach=true
            spikeContext.setPosition=context.spikePosition;spikeContext.setOffset=context.spikePosition-context.position
            spikeContext.radius=context.spikeRadius
            local spike=api.PlanDumpIntercept(ball,spikeContext)or api.PlanIntercept(ball,spikeContext,"Jump",play)
            if spike and spike.jump then
                spike.emergency=true;spike.dumpApproach=true
                spike.spikePreferred=Core.CloseDump(spike.contact,context.net,Core.Side(context.position,context.net))
                spike.jumpReason=spike.spikePreferred and "Jump: preferred native spike dump contact"or "Jump: far receive set dump contact"
                return spike
            end
        end
        local window=api.ContactWindow(ball,context,0.4)
        if window and (context.airborne and context.state=="Jump" and not context.setState or not context.state and window.enter<=0.15)then
            return {point=context.position,contact=window.contact,time=window.enter,jump=context.airborne==true,
                alreadyAirborne=context.airborne==true,travel=0,emergency=true,jumpReason="Save: ball already in native setting reach"}
        end
        local plan=api.PlanIntercept(ball,context,mode,play)
        if mode=="Auto" and not context.airborne then
            local jumpPlan=api.PlanIntercept(ball,context,"Jump",play)
            if jumpPlan and jumpPlan.jump then
                local high=api.ChooseEmergency(jumpPlan.contact,context.net,context.maxPower,true,ball.Acceleration.Y,ball.Radius,
                    "Higher corner contact",Core.Side(context.position,context.net))
                local current=plan and api.ChooseEmergency(plan.contact,context.net,context.maxPower,plan.jump,ball.Acceleration.Y,ball.Radius,
                    "Corner contact",Core.Side(context.position,context.net))
                if high and high.loftValidated and (not (current and current.loftValidated)
                    or high.cornerValidated and not (current and current.cornerValidated)
                    or context.dump and high.cornerValidated and (not current or high.time+0.1<current.time))then
                    plan=jumpPlan;plan.jumpReason="Jump: higher contact clears the opponent front court"
                end
            end
        end
        if plan then plan.emergency=true;plan.jumpReason=plan.jumpReason or "Save: reachable contact without a hitter solution"end
        return plan
    end
    function api.PlanDumpIntercept(ball,context)
        local side=Core.Side(context.position,context.net)
        if not side then return nil end
        local power=context.jumpPower
        if host.predictJump and context.targetFacingPoint then
            local predicted=host.predictJump(Vector3.zero,context.targetFacingPoint,false)
            if Core.Finite(predicted)and predicted>0 then power=predicted end
        end
        if not Core.Finite(power)or power<=0 then return nil end
        local airTime=power/context.gravity+0.08
        local rise=power*airTime-0.5*context.gravity*airTime*airTime
        local centerY=context.groundY+context.setOffset.Y+rise
        local radius=context.radius+(ball.Radius or 1.1)-0.35
        local sim=table.clone(ball)
        local margin=math.max(1.6,context.netMargin or 1.6)
        for index=1,84 do
            if budgetSpent()then return nil end
            sim.Position,sim.Velocity=stepPhysics(sim,1/30)
            local time=index/30
            local jumpAt=time-context.charge-airTime
            if jumpAt<0.04 or sim.Velocity.Y>=0 then continue end
            if sim.Position.Y<context.net.floorY+(ball.Radius or 1.1)then break end
            if not Core.CloseDump(sim.Position,context.net,side)then continue end
            local off=sim.Position-context.net.center
            local depth=off:Dot(context.net.normal)*side
            if depth<-(ball.Radius or 1.1)or sim.Position.Y-(ball.Radius or 1.1)<=context.net.topY+0.15 then continue end
            local point=context.net.center+context.net.axis*off:Dot(context.net.axis)+context.net.normal*side*math.max(margin,depth)
            point=Vector3.new(point.X,context.groundY,point.Z)
            local hand=point+context.setOffset+Vector3.yAxis*rise
            local vertical=sim.Position.Y-centerY
            if vertical<0.5 or vertical>radius*0.88 or (sim.Position-hand).Magnitude>radius then continue end
            local travel=flat(point-context.position).Magnitude/math.max(1,context.speed)+0.15
            if travel<=jumpAt then
                return {point=point,contact=sim.Position,time=time,jump=true,jumpAt=jumpAt,travel=travel,
                    rise=rise,peakContact=true,dumpWaiting=true,nativeJumpPower=power,dumpAirTime=airTime}
            end
        end
    end
    local function planPhysical(ball,context,mode,playName)
        local sim={Position=ball.Position,Velocity=ball.Velocity,Acceleration=ball.Acceleration or Vector3.zero,Spin=ball.Spin or Vector3.zero}
        local ground,jumpPlan,glidePlan
        local radius=context.radius+(ball.Radius or 1)-0.8
        local groundRadius=context.radius+(ball.Radius or 1)-0.15
        local centerY=context.groundY+context.setOffset.Y
        local peak=context.jumpPower^2/(2*context.gravity)
        local side=Core.Side(context.position,context.net)
        local netMargin=math.max(1.6,context.netMargin or 1.6)
        if not side or radius<=0 then return nil end
        for index=1,84 do
            if budgetSpent()then break end
            local dt=1/30
            sim.Position,sim.Velocity=stepPhysics(sim,dt)
            local time=index*dt
            if sim.Position.Y<context.net.floorY+(ball.Radius or 1)then break end
            local depthFromNet=flat(sim.Position-context.net.center):Dot(context.net.normal)*side
            local aboveNet=not context.net.topY or sim.Position.Y-(ball.Radius or 1)>=context.net.topY+0.1
            if math.abs(depthFromNet)<(ball.Radius or 1)+0.1 and not aboveNet then break end
            if sim.Velocity.Y<0 and (context.allowOutside or Core.InCourt(sim.Position,context.net,-radius+0.5))
                and (depthFromNet>0 or aboveNet and depthFromNet>=-radius+netMargin)then
                local point=Vector3.new(sim.Position.X-context.setOffset.X,context.groundY,sim.Position.Z-context.setOffset.Z)
                local net=context.net
                local offset=flat(point-net.center)
                local across=context.allowOutside and offset:Dot(net.axis) or math.clamp(offset:Dot(net.axis),-net.halfWidth+0.5,net.halfWidth-0.5)
                local depth=(context.allowOutside and math.max(netMargin,offset:Dot(net.normal)*side) or math.clamp(offset:Dot(net.normal)*side,netMargin,net.halfDepth-0.5))*side
                local bounded=net.center+net.axis*across+net.normal*depth
                point=Vector3.new(bounded.X,context.groundY,bounded.Z)
                local horizontalGap=flat(sim.Position-(point+context.setOffset)).Magnitude
                local verticalReach=math.sqrt(math.max(0,radius*radius-horizontalGap*horizontalGap))
                local groundReach=math.sqrt(math.max(0,groundRadius*groundRadius-horizontalGap*horizontalGap))
                local distance=flat(point-context.position).Magnitude
                local travel=distance/math.max(context.speed,1)+0.12
                local dy=sim.Position.Y-centerY
                if not ground and time>=(context.minimumInterceptTime or 0) and horizontalGap<groundRadius and dy>=-groundReach*0.2 and dy<=groundReach and travel<=time then
                    ground={point=point,contact=sim.Position,time=time,jump=false,travel=travel}
                end
                local rise=dy-verticalReach*0.85
                local overNet=depthFromNet<=0
                if (not jumpPlan or not glidePlan and config.AutoSetGlide and context.glideSpeed) and time>=(context.minimumInterceptTime or 0) and horizontalGap<radius and rise>=1.5 and rise<=peak*0.98
                    and (not overNet or centerY+rise>(context.net.topY or 0)+0.25)then
                    local airTime=(context.jumpPower-math.sqrt(math.max(0,context.jumpPower^2-2*context.gravity*rise)))/context.gravity
                    local nearNet=math.abs(depthFromNet)<radius+3 and (not context.net.topY or sim.Position.Y>context.net.topY)
                    local takeoffLead=nearNet and math.clamp(0.22+(context.ping or 0)*2,0.22,0.35) or 0
                    local jumpAt=time-context.charge-airTime-takeoffLead
                    local apexTime=context.jumpPower/context.gravity
                    local apexJumpAt=time-context.charge-apexTime
                    if not glidePlan and config.AutoSetGlide and mode~="Ground" and not nearNet and not context.airborne
                        and not context.manualSteering and (context.glideSpeed or 0)>0 and (context.approachSpeed or 0)>0 and distance>3 then
                        local direction=flat(point-context.position).Unit
                        local times={airTime}
                        if math.abs(dy-peak)<=verticalReach then table.insert(times,1,apexTime)end
                        for _,glideAirTime in ipairs(times)do
