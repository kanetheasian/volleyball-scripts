    -- Arc is the apex-to-contact drop in studs; flight time also prevents
    -- a short rising/flat contact from masquerading as the selected Normal.
    -- These limits apply to court and last-contact recovery as well.
    local normalArcTargets={Low=1.25,Medium=2.75,High=8}
    local normalArcLimits={Low={0.8,2.25,0.85},Medium={1.8,5.5,1.25},High={4.5,12,1.6}}
    function api.NormalFlightLimit()return config.AutoSetNormalArc=="High"and 2.4 or 1.9 end
    function api.NormalArcCeiling()return host.normalFloat and config.AutoSetNormalArc=="High"and 12 or Core.SetPlays.Normal.arc end
    function api.PreserveNormalBand()return host.normalFloat and config.AutoSetNormalArc~="Low"end
    function api.NormalArcPreferred(lofted,arc,time)
        if not host.normalFloat then return true end
        local limits=normalArcLimits[config.AutoSetNormalArc]or normalArcLimits.Medium
        return lofted==true and Core.Finite(arc)and Core.Finite(time)
            and arc>=limits[1]and arc<=limits[2]and time>=limits[3]and time<=api.NormalFlightLimit()
    end
    function api.NormalArcValid(lofted,arc,time,minimumTime)
        if api.NormalArcPreferred(lofted,arc,time)then return true end
        -- Keep a selected-hitter set available when native physics cannot
        -- produce the requested tempo. Recovery must still descend from a
        -- real apex and give the hitter approach time; never use a flat rocket.
        return lofted==true and Core.Finite(arc)and Core.Finite(time)
            and arc>=1.8 and time>=(minimumTime or 1.1)and time<=api.NormalFlightLimit()
    end
    function api.PreferNormalProfile(lofted,arc,time,best)
        if not host.normalFloat or not best then return nil end
        local preferred=api.NormalArcPreferred(lofted,arc,time)
        local previous=api.NormalArcPreferred(best.normalLofted,best.normalArc,best.normalFlightTime or best.time)
        if preferred~=previous then return preferred end
    end
    function api.NormalPlayerPaceValid(target,horizontal)
        return not(target and target.livePlayer and host.normalPlayerMaxHorizontal)
            or Core.Finite(horizontal)and horizontal<=host.normalPlayerMaxHorizontal
    end
    function api.NormalDeliveryValid(choice,target)
        return choice and api.NormalPlayerPaceValid(target,choice.horizontal)
            and api.NormalArcValid(choice.normalLofted,choice.normalArc,choice.normalFlightTime or choice.time,choice.normalPaceMinimum)
    end
    function api.PreferNormalArc(arc,height,best)
        if not host.normalFloat or not best or not best.normalArc then return nil end
        local desired=normalArcTargets[config.AutoSetNormalArc]or normalArcTargets.Medium
        local gap=math.abs(arc-desired)-math.abs(best.normalArc-desired)
        local previousHeight=best.predictedAttackHeight or best.contact and best.contact.Y
        if not previousHeight then return nil end
        if gap< -0.15 then return true end
        if gap>0.15 then return false end
        return nil
    end
    function api.PreferNormalComfort(comfortable,height,best)
        if comfortable==best.normalComfort then return nil end
        local other=best.predictedAttackHeight or best.contact and best.contact.Y
        if not Core.Finite(height)or not Core.Finite(other)then return nil end
        if comfortable and height>=other-0.75 then return true end
        if best.normalComfort and other>=height-0.75 then return false end
        return nil
    end
    function api.PreferMaxBuff(candidate,height,frontPenalty,best)
        if not best or candidate==best.maxBuffPredicted then return nil end
        local other=best.predictedAttackHeight or best.contact and best.contact.Y
        if not Core.Finite(height)or not Core.Finite(other)then return nil end
        if candidate and height>=other-0.25 and (not frontPenalty or not best.frontEntryPenalty or frontPenalty<=best.frontEntryPenalty+4)then return true end
        if best.maxBuffPredicted and other>=height-0.25 and (not frontPenalty or not best.frontEntryPenalty or best.frontEntryPenalty<=frontPenalty+4)then return false end
        return nil
    end
    function api.RefinedNormalPitches(origin,target,maximum,acceleration,backward)
        local point=api.PlayPlacement(origin,target,"Normal")
        if not point or not target.attackBand then return {}end
        local distance=flat(point-origin).Magnitude
        local desired=math.clamp(target.attackBand.ideal-0.05,target.attackBand.minimum,target.attackBand.maximum)
        local found={}
        local refineDeadline=host.planningBudget and host.now and host.now()+math.min(0.003,host.planningBudget*0.25)
        local function evaluate(power,pitch)
            local h,v=api.DeliveryVelocity(origin,target,power,true,backward,pitch,true)
            if not h or h<=0.1 then return nil end
            local time=distance/h
            if time>3.5 or time<0.1 then return nil end
            return origin.Y+v*time+0.5*acceleration*time*(time+1/60),time,v
        end
        for power=1,maximum do
            if budgetSpent()or refineDeadline and host.now()>=refineDeadline then break end
            local previousPitch,previousHeight
            for degree=-20,20,5 do
                local pitch=math.rad(degree)
                local height=evaluate(power,pitch)
                if height and previousHeight and(height-desired)*(previousHeight-desired)<=0 then
                    local lo,hi,lowHeight=previousPitch,pitch,previousHeight
                    for _=1,7 do
                        local middle=(lo+hi)*0.5
                        local y=evaluate(power,middle)
                        if not y then break end
                        if (y-desired)*(lowHeight-desired)<=0 then hi=middle else lo=middle;lowHeight=y end
                    end
                    local angle=(lo+hi)*0.5
                    local y,time,v=evaluate(power,angle)
                    if y and time>=0.85 and time<=api.NormalFlightLimit() and math.abs(y-desired)<=0.1 then
                        local lofted=api.NormalLoft(origin,v,acceleration,time)
                        local _,arc=api.NormalLoft(origin,v,acceleration,time)
                        if api.NormalArcValid(lofted,arc,time)then found[#found+1]={pitch=angle,score=math.abs(time-1.5)+math.abs(angle)*0.2}end
                    end
                end
                previousPitch,previousHeight=pitch,height
            end
        end
        table.sort(found,function(a,b)return a.score<b.score end)
        local result={}
        for _,candidate in ipairs(found)do
            local duplicate=false
            for _,pitch in ipairs(result)do if math.abs(pitch-candidate.pitch)<math.rad(0.1)then duplicate=true;break end end
            if not duplicate then result[#result+1]=candidate.pitch;if #result>=4 then break end end
        end
        return result
    end
    function api.BotAttackWindowHeight(origin,target,heading,horizontal,vertical,acceleration,ballRadius,entryTime)
        if not host.normalAttackHeight or origin.Y-target.net.floorY<13
            or flat(target.position-origin).Magnitude>28 then return nil end
        -- Native contact can occur after the continuous overlap first reaches
        -- the outside of the Spike hitbox. Check the ball deeper in its path.
        local time=entryTime+0.12
        local point=origin+heading*horizontal*time+Vector3.yAxis*(vertical*time+0.5*acceleration*time*(time+1/60))
        local motion=flat(target.velocity or Vector3.zero)*time+flat(target.acceleration or Vector3.zero)*(0.5*time^2)
        if not Core.BoxBallOverlap(target.hitboxFrame:PointToObjectSpace(point-motion),target.hitboxSize,
            ballRadius*(host.nativeBotBallRadiusFactor or 1))then
            return -math.huge
        end
        return point.Y
    end
    function api.BotAttackWindowReady(height,target)
        return height~=nil and height>=target.net.floorY+host.normalAttackHeight+0.15
    end
    function api.RefreshBotDelivery(choice,origin,target,air,backward,acceleration,ballRadius)
        if not choice or not choice.botHeightLimited or not target.hitboxFrame or not target.hitboxSize
            or not target.nativeSetCenter or not host.nativeSetLaunch then return nil end
        local h,v=api.DeliveryVelocity(origin,target,choice.power,air,backward,choice.pitch or 0,true,choice.point)
        local paceLimit=math.max(22,math.min(26,flat(choice.point-origin).Magnitude/1.25))
        if not Core.Finite(h)or h<=0.1 or not Core.Finite(v)or host.normalFloat and not choice.contactSave and h>paceLimit then return nil end
        local heading=flat(choice.point-origin)
        if heading.Magnitude<0.1 then return nil end
        local radius=ballRadius or 1.1
        local contact,time=botContact(origin,heading.Unit,h,v,target,radius,acceleration)
        if not contact or contact.Y<choice.minimumAttackHeight
            or time<(choice.contactSave and 0.05 or math.max(choice.minimumFlightTime or 0,0.85))
            or time>(choice.contactSave and 2.8 or api.NormalFlightLimit())then return nil end
        local windowHeight=air and not choice.contactSave
            and api.BotAttackWindowHeight(origin,target,heading.Unit,h,v,acceleration,radius,time)or nil
        local windowReady=api.BotAttackWindowReady(windowHeight,target)
        if contact.Y>choice.maximumAttackHeight and not windowReady then return nil end
        local side=Core.Side(origin,target.net)
        if not side or(contact-target.net.center):Dot(target.net.normal)*side<(ballRadius or 1.1)+0.35 then return nil end
        local lofted,arc,arrival=api.NormalLoft(origin,v,acceleration,time)
        if not api.NormalArcValid(lofted,arc,time,choice.normalPaceMinimum)then return nil end
        if not lofted and not choice.contactSave then return nil end
        local result=table.clone(choice)
        result.horizontal=h;result.vertical=v;result.predictionOrigin=origin;result.contact=contact;result.time=time
        result.attackWindowHeight=windowHeight;result.attackWindowReady=windowReady
        result.normalFlightTime=time;result.normalArc=arc;result.arrivalVertical=arrival
        result.normalComfort=api.NormalComfort(true,arc,time);result.maxBuffPredicted=Core.MaxSetSpikeBuffEligible(air,time)
        result.launchAir=air==true;result.launchBack=backward==true;result.launchGlide=target.setterGlide==true
        result.nativePoseRefreshed=true
        result.landing,result.landingTime=api.Landing(origin,heading.Unit*h+Vector3.yAxis*v,acceleration,target.net.floorY,ballRadius)
        return result
    end
    function api.RefineBotDelivery(choice,origin,target,air,backward,acceleration,ballRadius)
        local current=api.RefreshBotDelivery(choice,origin,target,air,backward,acceleration,ballRadius)
        for _=1,2 do
            if not current or not current.preferredAttackHeight or current.attackWindowReady then break end
            local error=current.contact.Y-current.preferredAttackHeight
            if math.abs(error)<0.025 then break end
            local p=current.pitch or 0
            local adjacent=table.clone(current)
            adjacent.pitch=math.clamp(p+math.rad(error>0 and -0.5 or 0.5),-math.rad(20),math.rad(20))
            if math.abs(adjacent.pitch-p)<1e-6 then break end
            adjacent=api.RefreshBotDelivery(adjacent,origin,target,air,backward,acceleration,ballRadius)
            if not adjacent then break end
            local derivative=(adjacent.contact.Y-current.contact.Y)/(adjacent.pitch-p)
            if not Core.Finite(derivative)or math.abs(derivative)<0.1 then break end
            local refined=table.clone(current)
            refined.pitch=math.clamp(p-math.clamp(error/derivative,-math.rad(2.5),math.rad(2.5)),-math.rad(20),math.rad(20))
            refined=api.RefreshBotDelivery(refined,origin,target,air,backward,acceleration,ballRadius)
            if not refined or math.abs(refined.contact.Y-current.preferredAttackHeight)>=math.abs(error)then break end
            current=refined;current.botPitchRefined=true
        end
        return current
    end
    function api.ChoosePower(origin,target,maximum,air,acceleration,ballRadius,playName,backward,recovery)
        if target.hitboxFrame and target.velocity and (target.predictionLead or 0)>0 then
            target=table.clone(target)
            local lead=math.clamp(target.predictionLead,0,2.8)
            local accel=flat(target.acceleration or Vector3.zero)
            local offset=flat(target.velocity)*lead+accel*(0.5*lead^2)
            target.position+=offset;target.hitboxFrame+=offset
            target.velocity+=accel*lead
        end
        playName=playName or config.AutoSetPlay or "Normal"
        local play=Core.SetPlay(playName)
        local airPreferred
        if playName=="Normal"and air then play=table.clone(play);play.tempo=math.max(play.tempo or 1.4,1.5)end
        -- Jump height changes launch physics, not the selected play's tempo.
        -- Keep Normal's approach time and attack-height validation in the air.
        if recovery and playName=="Normal" then play=table.clone(play);play.minFlightTime=target.recoveryMinFlightTime or 0.6 end
        if host.normalFloat and playName=="Normal"and not target.courtRecovery then play=table.clone(play);play.minFlightTime=math.max(play.minFlightTime or 0,0.85)end
        if target.contactSave then play=table.clone(play);play.minFlightTime=0.05 end
        local best
        local placement,reason=api.PlayPlacement(origin,target,playName)
        if not placement then return nil,reason end
        local direction=flat(placement-origin)
        if direction.Magnitude<0.5 then return nil end
        local distance=direction.Magnitude
        ballRadius=ballRadius or 1.1
        local maximumPower=math.floor(math.min(maximum or 15,play.maxPower or 30,30))
        local closePower=playName=="Normal"and api.CloseNormalPower(origin,target,maximumPower,backward)
        local normalPaceMinimum=backward and closePower and config.AutoSetNormalArc=="Medium"and 1 or nil
        local loftPitches=target.courtRecovery and target.recoveryPitches or {0}
        if host.normalFloat and playName=="Normal"and air and recovery and target.attackBand and host.pitch and not target.courtRecovery then
            for _,pitch in ipairs(api.RefinedNormalPitches(origin,target,maximumPower,acceleration or -25,backward))do loftPitches[#loftPitches+1]=pitch end
        end
        if playName=="Normal" and air and host.pitch and not target.courtRecovery then
            if target.livePlayer and target.attackBand or target.radius and target.net then
                for angle=2.5,20,2.5 do loftPitches[#loftPitches+1]=-math.rad(angle);loftPitches[#loftPitches+1]=math.rad(angle)end
            else for angle=5,20,5 do loftPitches[#loftPitches+1]=math.rad(angle)end end
        end
        local minimumAttackHeight
        if playName=="Normal" and target.net then
            minimumAttackHeight=target.net.topY+ballRadius+2
            if target.radius then minimumAttackHeight=math.max(minimumAttackHeight,target.position.Y+math.min(1,target.radius*0.25))
            else minimumAttackHeight=math.max(minimumAttackHeight,target.net.topY+Core.SetPlays.Normal.contactLift-1)end
        end
        local maximumAttackHeight
        if minimumAttackHeight and target.livePlayer and target.attackBand then
            minimumAttackHeight=target.attackBand.minimum;maximumAttackHeight=target.attackBand.maximum
        end
        local attackMargin=minimumAttackHeight and (target.object and api.AttackMargins[target.object] or 1.5) or 0
        if maximumAttackHeight then attackMargin=0 end
        if playName=="Normal" and target.radius and target.net and math.abs((target.position-target.net.center):Dot(target.net.normal))<=8 then
            local upperContact=target.hitboxFrame and target.hitboxSize
            minimumAttackHeight=math.max(target.net.topY+ballRadius+0.5,
                target.position.Y+target.radius*(upperContact and 0.65 or 0.4)+(upperContact and (config.AutoSetAttackLift or 0)or 0))
            attackMargin=0
        end
        if target.contactSave and target.radius and target.hitboxFrame then
            minimumAttackHeight=math.max(target.net.topY+ballRadius+0.25,target.position.Y-target.radius+ballRadius*0.35)
            attackMargin=0
        end
        local planningHeight=minimumAttackHeight and minimumAttackHeight+(recovery and 0 or attackMargin)
        local launchModel=backward and (air and api.Models.BackAir or api.Models.BackGround) or (air and api.Models.Air or api.Models.Ground)
        local tiltModel=backward and api.Models.BackAirTilt or api.Models.AirTilt
        local function measuredLaunch(power,pitch)
            local model=air and math.abs(pitch)>0.001 and tiltModel or launchModel
            for _,s in ipairs(model)do
