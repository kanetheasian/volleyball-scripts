    api.AutoSetHost={core=Core,stepPhysics=ballUtils.stepPhysics,config=config,now=os.clock,contactHeightAware=true,planningBudget=0.012,minimumFacingObservation=1/30,jumpFirst=true,normalFloat=true,courtRecovery=true,adaptiveAirSetLead=true,contactRecovery=true,idleFacing=true,smoothApproach=true,risingSetWindow=true,trackArmedSetAim=true,nativeBotBallRadiusFactor=0.5,normalBotContactTrim=0,normalAttackHeight=18,normalClosePower=3,normalCloseBackPower=4,normalCloseRange=16,normalPlayerNetMargin=2.5,normalPlayerMaxHorizontal=22,
