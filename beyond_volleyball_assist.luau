    assert(game.PlaceId==104505597931201 or game.GameId==10763804431,"This script targets Beyond Volleyball League")
    local requireModule=require
    do
        local ok,native=pcall(function()return getrenv()end)
        if ok and type(native)=="table"and type(native.require)=="function"then requireModule=native.require end
    end
    local previous=env.BVLAssist
    local enabled=not previous or not previous.Config or previous.Config.PreviewSet~=false
    local api={Version="0.8.117",Mode="PreviewOnly",Alive=true,Config={PreviewSet=enabled,AutoSet=false,VisualDistance=180},Errors={},Connections={},Controls={}}
    local refreshing=false
    function api.Set(key,value)
        if key~="PreviewSet"then return false,"This executor supports preview viewing only"end
        if type(value)~="boolean"then return false,"Preview Set needs a boolean"end
        api.Config.PreviewSet=value
        if api.SharedSetPreview then api.SharedSetPreview.Enabled=value end
        return true
    end
    function api.RefreshControls()
        if api.Controls.PreviewSet then refreshing=true;api.Controls.PreviewSet:Set(api.Config.PreviewSet);refreshing=false end
    end
    function api.Pause()api.Set("PreviewSet",false);api.RefreshControls()end
    function api.Destroy()
        if not api.Alive then return end
        api.Alive=false
        if api.SharedSetPreview then api.SharedSetPreview.Destroy();api.SharedSetPreview=nil end
        for _,connection in ipairs(api.Connections)do connection:Disconnect()end
        if api.Rayfield then pcall(function()api.Rayfield:Destroy()end)end
        if env.BVLAssist==api then env.BVLAssist=nil end
    end
    if previous and type(previous.Destroy)=="function"then previous.Destroy()end
    env.BVLAssist=api
    local ok,problem=xpcall(function()
        api.SharedSetPreview=host.start({assist=api,role="spiker",integrated=true,requireModule=requireModule,
            enabled=function()return api.Config.PreviewSet end})
        local source=host.prepare(game:HttpGet("https://sirius.menu/rayfield"))
        local run,compileError=loadstring(source)
        assert(run,compileError)
        local rayfield=run();api.Rayfield=rayfield
        local window=rayfield:CreateWindow({Name="BVL Preview • v"..api.Version,LoadingTitle="BVL Preview",LoadingSubtitle="Shared set previews",
            ShowText="BVL",Theme="Default",ToggleUIKeybind=Enum.KeyCode.RightShift,ConfigurationSaving={Enabled=false},
            Discord={Enabled=false},KeySystem=false,DisableRayfieldPrompts=true})
        api.Window=window
        local overview=window:CreateTab("Overview","home")
        overview:CreateParagraph({Title="Preview-only mode",Content="Watch shared set trajectories and contact markers. Automatic setting, aiming and movement are unavailable in this executor."})
        local status=overview:CreateParagraph({Title="Shared preview",Content="Connecting…"})
        local visuals=window:CreateTab("Visuals","eye")
        api.Controls.PreviewSet=visuals:CreateToggle({Name="Preview Set",CurrentValue=enabled,Callback=function(value)
            if not refreshing then api.Set("PreviewSet",value)end
        end})
        overview:CreateButton({Name="Unload",Callback=api.Destroy})
        local lastUpdate=-math.huge
        api.Connections[#api.Connections+1]=game:GetService("RunService").Heartbeat:Connect(function()
            if not api.Alive or os.clock()-lastUpdate<0.6 then return end
            lastUpdate=os.clock()
            local preview=api.SharedSetPreview;local link=preview and preview.CloudLink
            local text=not api.Config.PreviewSet and "Preview Set is off"or link and link.State=="Connected"and "Connected — waiting for a shared set"or "Connecting to shared preview…"
            if api.Config.PreviewSet and preview and preview.Plan then text="Connected — showing shared set"end
            if api.Config.PreviewSet and link and link.LastError then text="Preview connection unavailable — retrying"end
            if preview and preview.Error then text="Preview error: "..tostring(preview.Error)end
            status:Set({Title="Shared preview",Content=text})
        end)
    end,function(problem)return debug and debug.traceback and debug.traceback(tostring(problem),2)or tostring(problem)end)
    if not ok then api.Destroy();error("BVL preview startup failed: "..tostring(problem),0)end
    return api
end

local function selectStartupMode(host)
