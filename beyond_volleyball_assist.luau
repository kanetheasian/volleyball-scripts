local function createCloudPreviewLink(host)
    local link={Alive=true,State="Connecting",Stats={Published=0,Reads=0,Imported=0,Errors=0,Reconnects=0}}
    local identity=host.identity
    if not identity.clientId then identity.clientId=host.makeClientId()end
    local joining=false
    local imported={}
    local lastActive,lastAck=false,nil
    local function decode(response)
        local value=host.decode(response.Body)
        assert(type(value)=="table","Invalid shared-preview response")
        return value
    end
    local function session()
        if identity.token then return identity.token end
        if joining then return nil end
        joining=true
        local ok,result=pcall(function()
            local response=host.request({Url=host.url.."/session",Method="POST",Headers={["Content-Type"]="application/json"},
                Body=host.encode({place=host.place,job=host.job,user=host.user,clientId=identity.clientId}),Timeout=3})
            assert(response.StatusCode==200,"Shared preview connection unavailable ("..tostring(response.StatusCode)..")")
            local value=decode(response)
            assert(type(value.token)=="string"and #value.token==64 and value.token:match("^[a-f0-9]+$"),"Invalid shared-preview session")
            return value.token
        end)
        joining=false
        if not ok then error(result,0)end
        identity.token=result
        return result
    end
    local function call(method,body)
        local key=session()
        if not key then return nil end
        local response=host.request({Url=host.url.."/frames",Method=method,
            Headers={Authorization="Bearer "..key,["Content-Type"]="application/json"},Body=body and host.encode(body),Timeout=3})
        if response.StatusCode==401 then identity.token=nil;link.Stats.Reconnects+=1;link.State="Connecting";return nil end
        if method=="POST"and response.StatusCode==409 then return true end
        assert(response.StatusCode==200,"Shared preview request failed ("..tostring(response.StatusCode)..")")
        link.State="Connected";link.LastError=nil
        return decode(response)
    end
    function link.StepPublish()
        if not host.enabled()and not lastActive then return true end
        if not host.enabled()and not identity.token then lastActive=false;return true end
        local frame=host.export()
        local ack=frame.confirmedBall and (tostring(frame.session)..":"..tostring(frame.confirmedBall))
        if frame.clear and not lastActive and (not ack or ack==lastAck)then return true end
        local result=call("POST",frame)
        if not result then return nil end
        lastActive=not frame.clear;lastAck=ack or lastAck;link.Stats.Published+=1
        return true
    end
    function link.StepRead()
        if not host.enabled()then return true end
        local result=call("GET")
        if not result then return nil end
        assert(type(result.frames)=="table"and #result.frames<=32,"Invalid shared-preview list")
        link.Stats.Reads+=1
        if host.hasLocalPlan and host.hasLocalPlan()then return true end
        local frame=host.select(result.frames,link.SelectedSender)
        if not frame then return true end
        local previous=imported[frame.setter]
        if previous and previous.session==frame.session and frame.sequence<=previous.sequence then return true end
        if host.import(frame)then
            imported[frame.setter]={session=frame.session,sequence=frame.sequence}
            link.SelectedSender=not frame.clear and frame.setter or nil
            link.Stats.Imported+=1
        end
        return true
    end
    function link.Destroy()link.Alive=false end
    if host.spawn then
        for _,method in ipairs({link.StepPublish,link.StepRead})do
            host.spawn(function()
                local failures=0
                while link.Alive and host.alive()do
                    local started=host.clock()
                    local ok,err=pcall(method)
                    if ok then failures=0 else
                        failures+=1;link.LastError=tostring(err);link.State="Disconnected";link.Stats.Errors+=1
                    end
                    local interval=ok and (host.enabled()and 0.12 or 0.4)or math.min(2,0.25*2^math.min(3,failures))
                    host.wait(math.max(0.02,interval-(host.clock()-started)))
                end
            end)
        end
    end
    return link
end

