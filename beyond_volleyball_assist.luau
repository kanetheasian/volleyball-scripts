        end
        local jumpPlan,airChoice=deliveryIntercept("Jump")
        if jumpPlan and not jumpPlan.jump then jumpPlan=nil end
        local side=Core.Side(context.position,context.net)
        local reach=context.radius+(ball.Radius or 1.1)+(context.netMargin or 1.6)
        local depth=jumpPlan and side and (jumpPlan.contact-context.net.center):Dot(context.net.normal)*side
        local netSave=not ground and jumpPlan and depth and depth<=reach
