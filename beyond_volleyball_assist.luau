                        local contact,time
                        if flight then contact,time=botContact(origin,heading.Unit,horizontal,vertical,target,ballRadius,acceleration or -25)end
                        local centerTime,centerHeight,centerReady
                        local centeredBot=playName=="Normal" and target.hitboxFrame
                            and math.abs((target.position-net.center):Dot(net.normal))<=8
                        local normalIdeal,contactCeiling,windowHeight,windowReady
                        if centeredBot and host.normalBotContactTrim then
                            local nativeMaximum=target.position.Y+target.radius+ballRadius*0.35
                            normalIdeal=math.max(planningHeight or -math.huge,
                                math.min(nativeMaximum,target.position.Y+target.radius*0.95+(config.AutoSetAttackLift or 0))
                                -host.normalBotContactTrim)
