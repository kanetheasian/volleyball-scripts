    local function releaseReceiveForJump(stateMachine)
        if not config.ReceiveJumpCancel or stateMachine~=machine or not lastOwnReceive or lastOwnReceive.character~=player.Character
            or os.clock()-lastOwnReceive.time>1.1 then return false end
        local current=machine:GetCurrent()
        if not current or current.Name~="Receive" or machine.Locked and machine.Locked.Value then return false end
        local part,humanoid=getRoot()
        local disabled=actionClient._inputService.DisableInputs
        if not part or not humanoid or humanoid.Health<=0 or humanoid.Sit or part.Anchored or humanoid.FloorMaterial==Enum.Material.Air
            or UIS:GetFocusedTextBox() or GuiService.MenuIsOpen or player:GetAttribute("Spec_NoAction")
            or disabled and disabled:GetState()==true then return false end
        if type(jump.CanEnter)=="function" then local ok,can=pcall(jump.CanEnter,jump);if not ok or not can then return false end end
        if type(machine.GoTo)~="function" then return false end
        local ok,ended=pcall(machine.GoTo,machine,nil)
        if not ok or ended==false or machine:GetCurrent() then return false end
        api.LastReceiveJump={receiveAt=lastOwnReceive.time,requestedAt=os.clock(),buffered=pendingReceiveJump~=nil,character=player.Character}
        lastOwnReceive=nil;pendingReceiveJump=nil;clearReceiveAim()
        return true
    end
    api.Patches[#api.Patches + 1] = Core.Patch(actionClient, "_request", function(original)
        return function(self, stateMachine, name, ...)
            if stateMachine==machine then
                if name=="Receive" and api.Alive and config.AutoReceive then beginReceivePower()
                elseif name~="Receive"then clearReceivePower("Next action")end
            end
            if api.Alive then local ok, err = pcall(beforeRequest, name); if not ok then report("aim", err) end end
            local released=false
            if api.Alive and stateMachine==machine then
                local current=machine:GetCurrent()
                if name=="Receive" and (not current or current.Name~="Receive")then lastOwnReceive=nil;pendingReceiveJump=nil end
                if name=="Jump" and config.ReceiveJumpCancel and current and current.Name=="Receive" then
                    released=releaseReceiveForJump(stateMachine)
                    if not released then pendingReceiveJump={time=os.clock(),character=player.Character}end
                end
            end
            local result=table.pack(pcall(original,self,stateMachine,name,...))
            if not result[1]then clearReceivePower("Native request failed");error(result[2],0)end
            if stateMachine==machine and name=="Receive" and receivePowerLease then
                local entered=machine:GetCurrent()
                local accepted=result[2]~=false and (result[2]==true or entered and entered.Name=="Receive")
                if not accepted then clearReceivePower("Receive rejected")
                elseif entered and entered.Name=="Receive"then receivePowerLease.seen=true end
            end
            if released and api.LastReceiveJump then
                local entered=machine:GetCurrent()
                api.LastReceiveJump.accepted=entered and entered.Name=="Jump" or result[2]==true
                api.LastReceiveJump.completedAt=os.clock()
            end
            return table.unpack(result,2,result.n)
        end
    end)
