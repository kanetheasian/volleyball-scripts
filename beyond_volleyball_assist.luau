        if gravity<=0 or height<=0 then return nil end
        local time=(incoming.Y+math.sqrt(incoming.Y^2+2*gravity*height))/gravity
        local landing=Vector3.new(contact.X,context.net.floorY+context.radius,contact.Z)+velocity*time
        local outside=not Core.InCourt(landing,context.net,-context.radius)
        return{landing=landing,scoring=outside or Core.Side(landing,context.net)==-(context.side or Core.Side(context.origin,context.net)),estimated=true}
