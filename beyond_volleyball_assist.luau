            return nil,"Unsettled tilt command"
        end
        if context.autoSpikeAttack and row.poseAtImpact==false then
            return nil,"Request pose is not contact pose"
        end
        local dh=math.abs(row.height-(context.origin.Y-context.net.floorY))
        if row.power~=context.power or dh>(context.contactHeightTolerance or 2.5) then return nil,"Power or ball height" end
        local scoped=context.calibrationScope~=nil
        if scoped and (row.calibrationScope~=context.calibrationScope or row.character~=context.character)then return nil,"Kit or character" end
        if context.gliding~=nil and row.gliding~=nil and context.gliding~=row.gliding then return nil,"Standing or glide motion"end
        if context.gliding and row.glideSpeed and context.glideSpeed
            and math.abs(row.glideSpeed-context.glideSpeed)>math.max(3,row.glideSpeed*0.25)then return nil,"Glide speed"end
        if context.now-row.time>600 and not((context.cornerOnly or context.dumpAttack or context.autoSpikeAttack)and scoped and context.character~=nil)then return nil end
