    end
    function api.ContactWindow(ball,context,horizon)
        local sim={Position=ball.Position,Velocity=ball.Velocity,Acceleration=ball.Acceleration or Vector3.zero,Spin=ball.Spin or Vector3.zero}
        local radius=context.radius+(ball.Radius or 1.1)
        local window
        local dt=1/120
        for index=0,math.ceil(horizon/dt)do
            local time=index*dt
            local center=context.setPosition
            if context.airborne then
                local velocity=context.velocity or Vector3.new(0,context.verticalVelocity or 0,0)
                local dy=velocity.Y*time-0.5*context.gravity*time*time
                dy=math.max(dy,context.groundY+context.setOffset.Y-center.Y)
                center+=Vector3.new(velocity.X*time,dy,velocity.Z*time)
            end
            local inside=(sim.Position-center).Magnitude<=radius
            if inside and not window then window={enter=time,contact=sim.Position}end
            if window and not inside then window.exit=time;return window end
            sim.Position,sim.Velocity=stepPhysics(sim,dt)
        end
        if window then window.exit=horizon end
        return window
    end
    function api.NearbyGroundOnly(context,target,ground,jumpPlan)
        local contact=ground and ground.contact or jumpPlan and jumpPlan.contact
        if not contact then return false end
        local net=context.net
        local side=Core.Side(context.position,net)
        local line=side and net.attackLines and net.attackLines[side]
        local depth=side and (contact-net.center):Dot(net.normal)*side or 0
