            local offset=landing-net.courtCenter
            gap=math.max(math.abs(offset:Dot(net.axis))-net.halfWidth-(ball.Radius or 1),
                math.abs(offset:Dot(net.normal))-net.halfDepth-(ball.Radius or 1))
        end
        local uncertain=pendingSpin(state,ball,now) or not landing or now<(state.contactUntil or -math.huge) or now<(state.changingUntil or -math.huge)
            or now-(state.landingStableSince or now)<0.15 or out and gap<2
        local decision={Landing=landing,Time=forecast.Time,Status=uncertain and "uncertain" or out and "out" or "in",
            SkipOut=out and not uncertain,Uncertain=uncertain,OutsideDistance=gap,at=now,floorY=floorY,position=ball.Position,
            changingUntil=state.changingUntil,contactUntil=state.contactUntil,physics=snapshot(ball),SpinPending=pendingSpin(state,ball,now)}
