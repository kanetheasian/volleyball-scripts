                        if c.airborne then
                            local w=host.contactWindow(v.ball,c,0.5)
                            plan=w and{point=c.position,contact=w.contact,time=w.enter,jumpAt=0,glide=c.nativeGlide,glideDirection=Vector3.zero,score=1000-w.enter}or nil
                        end
