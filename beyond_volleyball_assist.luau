        local direction=flat(pose.LookVector)
        if direction.Magnitude<0.1 or packet.Velocity.Magnitude<5 then return false end
        direction=direction.Unit
        local row={power=power,pitch=math.asin(math.clamp(pose.LookVector.Y,-1,1)),
            height=packet.Position.Y-net.floorY,rootHeight=pose.Position.Y-net.floorY,
            verticalSpeed=contactState and contactState.verticalSpeed,contactLead=contactState and contactState.contactLead,
            poseAtImpact=contactState and contactState.poseAtImpact==true,
            poseLag=contactState and contactState.poseLag,contactPitch=contactState and contactState.contactPitch,
            commandPitch=contactState and contactState.commandPitch,
