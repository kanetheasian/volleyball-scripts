            if actual then maxError=math.max(maxError,(row.point-actual).Magnitude)end
        end
        local timing=confirmed.launchAt-predicted.launchAt
        local marker=predicted.attackMarker
        local actualMarker=marker and pointAt(confirmed,predicted.launchAt+marker.flightTime-confirmed.launchAt)
        return {ballId=predicted.ballId,revision=predicted.revision,predictedPower=predicted.power,power=confirmed.power,
            originError=(predicted.path[1].point-confirmed.path[1].point).Magnitude,maxPathError=maxError,
            calibrated=predicted.previewCalibrated==true,sampleCount=predicted.previewSampleCount,
            markerPathError=actualMarker and (marker.point-actualMarker).Magnitude,
            launchTimeError=timing,predictedType=predicted.setType,setType=confirmed.setType,
            material=maxError>1.5 or math.abs(timing)>0.15 or predicted.power~=confirmed.power or predicted.setType~=confirmed.setType}
    end
    function api.HitterProfile(body,reach)
        local result=table.clone(body)
        if reach and reach.character==body.character then
            result.groundCenterY=reach.groundCenter or result.groundCenterY
            if not body.nativeJump and reach.jumpRise then
                result.jumpPower=math.sqrt(2*body.gravity*math.clamp(reach.jumpRise,0,20))
                result.reachMeasured=reach.recentRises~=nil
