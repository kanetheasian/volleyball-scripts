                    local gap=(future-c.spikePosition).Magnitude
                    local glideReach=noWalk and config.AutoSpikeGlide and((c.glideSpeed or 0)*0.45+(c.chargeSpeed or c.speed or 0)*c.charge)or 0
                    local reach=c.spikeRadius+(v.ball.Radius or 1.1)+2+glideReach
