                local selected=table.clone(target);selected.setterGlide=false;selected.deliveryLead=plan.time
                if context.setOffset then selected.nativeSetCenter=plan.point+context.setOffset+Vector3.yAxis*plan.rise end
                local choice=api.ChooseDelivery(plan.contact,selected,context.maxPower,true,ball.Acceleration.Y,ball.Radius,"Normal",backward)
                if not choice and not budgetSpent()then
                    choice=api.ChooseRecovery(plan.contact,selected,context.maxPower,true,ball.Acceleration.Y,ball.Radius,"Normal",backward)
                end
