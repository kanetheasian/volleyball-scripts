        if mode=="Auto" and not context.airborne then
            local jumpPlan=api.PlanIntercept(ball,context,"Jump",play)
            if jumpPlan and jumpPlan.jump then
                local high=api.ChooseEmergency(jumpPlan.contact,context.net,context.maxPower,true,ball.Acceleration.Y,ball.Radius,
                    "Higher corner contact",Core.Side(context.position,context.net),nil,jumpPlan.glide==true,context.dump==true)
                local current=plan and api.ChooseEmergency(plan.contact,context.net,context.maxPower,plan.jump,ball.Acceleration.Y,ball.Radius,
                    "Corner contact",Core.Side(context.position,context.net),nil,plan.glide==true,context.dump==true)
