        end
        if plan then plan.emergency=true;plan.jumpReason=plan.jumpReason or "Save: reachable contact without a hitter solution"end
        return plan
    end
    function api.DumpGlideDirections(context)
        local forward=context.targetFacingPoint and flat(context.targetFacingPoint-context.position)
            or -context.net.normal*(Core.Side(context.position,context.net)or 1)
        if forward.Magnitude<0.1 then forward=-context.net.normal*(Core.Side(context.position,context.net)or 1)end
        forward=forward.Unit
        local right=Vector3.new(-forward.Z,0,forward.X)
        return {forward,(forward+right).Unit,right,(-forward+right).Unit,
            -forward,(-forward-right).Unit,-right,(forward-right).Unit},forward
    end
