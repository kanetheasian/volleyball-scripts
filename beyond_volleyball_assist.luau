    end
    function Core.MiddleReceivePoint(position,net,depth)
        local side=net and Core.Side(position,net)
        if not side then return nil end
        local attack=net.attackLines and net.attackLines[side]
        local maximum=math.max(2,math.min(net.halfDepth-1,attack and attack*0.75 or 12))
        local point=net.center+net.normal*side*math.clamp(depth or 6,2,maximum)
        return Vector3.new(point.X,position.Y,point.Z)
