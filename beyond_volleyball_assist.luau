    local function tiltReserve(model,context)
        local exact=not context.samplePoseOptional and model and Core.Finite(model.rootHeight)and Core.Finite(model.verticalSpeed)
            and Core.Finite(context.rootHeight)and Core.Finite(context.verticalSpeed)
            and math.abs(model.rootHeight-context.rootHeight)<=0.4 and math.abs(model.verticalSpeed-context.verticalSpeed)<=3
