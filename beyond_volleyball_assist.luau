            if playName=="Normal" and target.livePlayer and target.attackBand and target.net then
                local side=target.setSide or Core.Side(target.approachPosition or target.position,target.net) or Core.Side(origin,target.net)
                if side and not(target.courtRecovery and target.recoveryFront or target.contactSave or target.strictEntry)
                    and (origin-target.net.center):Dot(target.net.normal)*side<=Core.SetPlays.Normal.netInset+2.5
                    and (landing-target.net.center):Dot(target.net.normal)*side<ballRadius+0.35 then return nil end
            end
            local score=play.preferredPower and math.abs(power-math.min(play.preferredPower,maximumPower))*play.powerWeight or 0
            if playName=="Short" then score+=landingError*2
            elseif playName=="Pipe" then
                score+=landingError*3
                if target.radius then
                    local net=target.net
