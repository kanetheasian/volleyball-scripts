            defensePlan.accepted=true;defensePlan.confirmed=true;defensePlan.confirmedAt=os.clock()
            defensePlan.confirmedContact=packet.Position
            defensePlan.confirmedVelocity=packet.Velocity
            if defensePlan.targetPoint and typeof(packet.Velocity)=="Vector3" and typeof(packet.Position)=="Vector3"then
                local desired=flat(defensePlan.targetPoint-packet.Position)
                local outgoing=flat(packet.Velocity)
                if desired.Magnitude>0.01 and outgoing.Magnitude>0.01 then
                    defensePlan.directionError=math.deg(math.acos(math.clamp(desired.Unit:Dot(outgoing.Unit),-1,1)))
                end
            end
        end
