            api.ApplyConfig(api.DefaultConfig);api.LoadedProfile=nil;refreshLibrary();notify("Defaults restored")
        end})
        local lastStatus, previousStatus = 0, ""
        connect(RunService.Heartbeat,function()
            if not api.Alive or os.clock()-lastStatus<0.6 or not rayfield:IsVisible() or rayfield:IsTransitioning() then return end
            lastStatus=os.clock()
            local text=string.format("State: %s  •  Balls: %d  •  Courts: %d\nStamina: %s/%s  •  Power: %s\nLast assist: %s  •  Target point: %s\nAim: %s\nDefense: %s",
                api.NativeState or "Idle",api.BallCount or 0,api.CourtCount or 0,tostring(movement.Stamina.Value),tostring(player:GetAttribute("MaxStamina")),
                tostring(actionClient._power.Value),api.LastAction or "none",pinnedPoint and "pinned" or "not pinned",
                api.AimReason or "idle",api.DefenseReason or "paused")
            if config.AutoReceiveMove then text..="\nReceive movement: "..(api.ReceiveMoveReason or "Waiting for medium/hard ball")end
            if config.ReceiveAim then text..="\nReceive destination: "..(config.ReceiveAimMode=="Middle front" and "Middle front" or config.ReceiveTarget)end
            if next(api.Errors) then local scope,message=next(api.Errors); text..="\n"..scope..": "..message end
            if config.AutoServeSpin then text..="\nServe spin: "..(api.ServeSpinStatus or "Waiting for next toss")end
            if config.AutoSpike then
                text..="\nAuto Spike: "..config.AutoSetPlay.." • "..autoSpike.Status
                local p=autoSpike.LastPlan
                if p and p.shot then text..="\n"..p.shot..(p.calibrated and " • measured estimate"or " • uncalibrated estimate")end
            else text..="\nAuto Set: "..((config.AutoSet or api.AutoSetOverride) and "On" or "Off").." • "..config.AutoSetPlay.." → "..selectedHitterLabel()end
            text..="\nMovement lead: "..(config.SetLeadEnabled and "On" or "Off")
            if config.AutoSetSpikeDump then
                text..="\nSpike dump: "..tostring(api.SpikeCalibrationCount()).." confirmed samples"
                if api.SpikeDumpDebug then text..=" • "..api.SpikeDumpDebug.stage end
                if api.SpikeCalibrationSaveStatus then text..="\n"..api.SpikeCalibrationSaveStatus end
            end
            if not config.AutoSpike and(config.AutoSet or api.AutoSetOverride)then
                local recovery=autoSet.IsBusy() and autoSet.LastPlan and autoSet.LastPlan.recovery and " • recovery set" or ""
                text..="\nAuto Set ["..config.AutoSetPlay..recovery..(api.DumpHeld and " • HOLD DUMP" or api.AutoSetOverride and " • HOLD OVERRIDE" or "").."] → "..config.AutoSetTarget..": "..(autoSet.Status or "Waiting for team first touch")
                if autoSet.IsBusy() and autoSet.LastPlan and autoSet.LastPlan.jumpReason then text..="\n"..autoSet.LastPlan.jumpReason end
                if autoSet.IsBusy() and autoSet.LastPlan and autoSet.LastPlan.waitReason then text..="\n"..autoSet.LastPlan.waitReason end
                if autoSet.IsBusy() and autoSet.LastPlan and autoSet.LastPlan.emergency then
                    text..="\n"..autoSet.LastPlan.deliveryPlay..": "..(autoSet.LastPlan.emergencyReason or "Hitter unavailable")
                if autoSet.LastPlan.bestEffortCorner then text..=" • best-effort corner"end
                if autoSet.LastPlan.loftValidated==false then text..=" • reduced-height fallback"end
                if autoSet.LastPlan.safeLanding==false then text..=" • landing unvalidated"end
                end
            end
            if text~=previousStatus then status:Set({Title="Live status",Content=text}); previousStatus=text end
        end)
    end,debug.traceback)
    if not ok then api.Destroy(); error("BVL GUI startup failed: "..tostring(err)) end
