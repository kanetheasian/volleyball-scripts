                if host.contactHeightAware and playName=="Normal" and air and not recovery and not calibrated and math.abs(pitch)>math.rad(0.25)then continue end
                if host.contactHeightAware and playName=="Normal" and air and not calibrated and math.abs(pitch)>math.rad(host.normalFloat and 20 or 10)+0.0001 then continue end
                for _,point in ipairs(aimPoints)do
                    if config.SetLeadEnabled~=false and target.hitboxFrame and target.velocity then
                        local base=point
                        for _=1,2 do
                            local time=flat(point-origin).Magnitude/math.max(0.1,horizontal)
                            time=math.min(time,1.65)
                            local shift=math.clamp(target.velocity:Dot(net.axis)*time+(target.acceleration or Vector3.zero):Dot(net.axis)*(0.5*time^2),-10,10)
