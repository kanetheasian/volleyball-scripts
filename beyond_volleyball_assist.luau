        -- Re-solving from a continually changing lead point discarded valid
        -- rising-ball contacts before the 60 ms preparation could finish.
        if at>job.contactAt+(job.requested and 0.4 or 0.12)then release("Emergency corner window passed");return end
        prepare(c,goal)
        if not c.airborne and host.face then host.face(goal.point,false)end
        job.preparedAt=job.preparedAt or at
