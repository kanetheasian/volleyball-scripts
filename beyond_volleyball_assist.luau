    function tracker.Forecast(id,ball,seconds,floorY,now,renderPosition,net)
        local state=tracker.States[id] or {changingUntil=-math.huge}
        local changing=now<(state.changingUntil or -math.huge) or now<(state.contactUntil or -math.huge)
        local spin=(ball.Spin or Vector3.zero).Magnitude
