    end
    function api.Update(plan,now)
        if not plan then api.Current=nil;pending=nil;lastSeen=nil;return nil end
        lastSeen=now
        if not same(pending,plan)then pending=plan;pendingAt=now end
        if api.Current and same(api.Current,plan)then
            api.Current.seenAt=now
