        local side=Core.Side(context.position,net)
        local line=side and net.attackLines and net.attackLines[side]
        local depth=side and (contact-net.center):Dot(net.normal)*side or 0
        if jumpPlan and side then depth=math.max(depth,(jumpPlan.contact-net.center):Dot(net.normal)*side)end
