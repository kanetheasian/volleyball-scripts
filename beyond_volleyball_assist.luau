        motionSamples[target.UserId]=sample
        local spike=character:FindFirstChild("Spike")
        local net=spike and courtAt(part.Position,true)
        local reach=hitterReachSamples[target.UserId]
        if spike and net then
            if not reach or reach.character~=character then reach={character=character};hitterReachSamples[target.UserId]=reach end
            local groundY=net.floorY+(humanoid.HipHeight or 2.5)+part.Size.Y/2
            local grounded=part.Position.Y<=groundY+0.75 and math.abs(part.AssemblyLinearVelocity.Y)<2
            reach=Core.SampleHitterReach(reach,grounded,spike.Position.Y,groundY,part.Position.Y,
                part.AssemblyLinearVelocity.Y,workspace.Gravity,humanoid.JumpHeight or 7.2)
            hitterReachSamples[target.UserId]=reach
            local side=Core.Side(part.Position,net)
            local depth=side and (spike.Position-net.center):Dot(net.normal)*side
            if depth and depth>=0 and depth<=Core.SetPlays.Normal.netInset then reach.attackDepth=math.clamp(depth,1,Core.SetPlays.Normal.netInset)end
        end
        return {player=target,position=sample.position,velocity=sample.velocity,reach=reach}
