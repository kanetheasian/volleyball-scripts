            local position=(play=="Short" or play=="Pipe") and sample.position
                or play=="Quick" and Core.QuickSetPoint(sample.position,net,context.position)
                or play=="Normal" and Core.NormalSetPoint(sample.position,net,context.position)
                or setPlanner.SetAimPoint(sample.position,net,context.position)
            local character=sample.player.Character
            local spike=character and character:FindFirstChild("Spike")
            local root=character and character:FindFirstChild("HumanoidRootPart")
            local humanoid=character and character:FindFirstChildOfClass("Humanoid")
            local band
            if sample.reach and spike then
                band=Core.PlayerAttackBand(sample.reach.groundCenter,sample.reach.jumpRise or humanoid and humanoid.JumpHeight or 7.2,
                    spike.Size.X/2,net.topY,1.1,config.AutoSetAttackLift)
