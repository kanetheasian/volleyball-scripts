        if name=="Serve"or api.IsServing()then
            clearAim();clearReceiveAim();clearSpikeAim();spikeSwingLocked=false
            if autoSet.IsBusy()then autoSet.Cancel("Serving: aim paused")end
            api.AimReason="Aim paused during serve";return
