                if host.nativeSetLaunch and context.setOffset then selected.nativeSetCenter=(plan.contactPoint or plan.point)+context.setOffset+Vector3.yAxis*(plan.rise or 0)end
                local delivery=api.ChooseHitterRecovery(plan.contact,selected,math.min(context.maxPower or 15,4),plan.jump,ball.Acceleration.Y,ball.Radius,playName,backward)
                if delivery and api.HitterCanArrive(selected,delivery,plan.time)then
                    if rememberRecovery(plan,delivery)then return plan,delivery end
                end
            end
            for i=#recoveryPlans,1,-1 do
                if budgetSpent()then break end
                local plan=recoveryPlans[i]
                local selected=table.clone(target);selected.setterGlide=plan.glide==true;selected.deliveryLead=plan.time
                if host.nativeSetLaunch and context.setOffset then selected.nativeSetCenter=(plan.contactPoint or plan.point)+context.setOffset+Vector3.yAxis*(plan.rise or 0)end
                local delivery=target.attackBand.recoveryMinimum and api.ChooseRecovery(plan.contact,selected,context.maxPower,plan.jump,ball.Acceleration.Y,ball.Radius,playName,backward)
                delivery=delivery or api.ChooseHitterRecovery(plan.contact,selected,context.maxPower,plan.jump,ball.Acceleration.Y,ball.Radius,playName,backward)
                if delivery and api.HitterCanArrive(selected,delivery,plan.time)then
