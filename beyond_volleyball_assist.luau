        if (key=="SpikeAim" and not validated) or key=="SpikeMode" or key=="AimMargin"
            or (key=="TakeoffAim" and not validated and not config.SpikeAim) then clearSpikeAim()end
        if key=="AutoReceive" and not validated then clearReceivePower("Auto Receive disabled")end
        if key=="ShowSpikeDirection" and not validated and hideSpikeDirections then hideSpikeDirections()end
        if key=="ReceiveJumpCancel" and not validated then lastOwnReceive=nil;pendingReceiveJump=nil end
        if key=="AutoReceiveMove" and validated then config.ReceiveMoveSprint=true;config.ReceiveSolidOnly=true end
        if (key=="AutoReceive" or key=="AutoReceiveMove") and not validated then clearReceiveMove("Receive movement disabled")end
        if key=="AutoSet" or key=="AutoSetJumpMode" or key=="AutoSetGlide" then autoSet.Cancel("Setting changed")end
        if key=="AutoSetAttackLift" then autoSet.Cancel("Attack height changed")end
        if key=="AutoSetPlayers" and not table.find(validated,config.AutoSetTarget)then config.AutoSetTarget=validated[1] or "None" end
        if key=="AutoSetTarget" and validated~="None" and validated~="" and not table.find(config.AutoSetPlayers,validated)then
            config.AutoSetPlayers=table.clone(config.AutoSetPlayers);table.insert(config.AutoSetPlayers,validated)
        end
        if (key=="AutoSetTarget" or key=="AutoSetPlay" or key=="AutoSetPlayers") and autoSet.IsBusy() then
            local applied,reason=pcall(function()autoSet.Tick(autoSetContext())end)
            if not applied then report("auto set selection",reason)end
        end
        if key=="AutoServeSpin" and not validated then cancelServeSpin("Disabled")end
        if key == "TiltEnabled" and not validated then clearTilt() end
        if (key == "SetAim" or key == "BackAim" or key == "ReceiveAim" or key == "TakeoffAim" or key=="SpikeAim") and not validated then clearAim() end
        if key=="SetLeadEnabled" then clearAim() end
        if (key=="ReceiveAim" and not validated) or key=="ReceiveTarget" or key=="ReceiveAimMode" or key=="ReceiveZoneDepth" then clearReceiveAim() end
        if identitySetter and entryIdentity then identitySetter(entryIdentity)end
        if key=="AutoSetPlay" and api.RefreshPlayPanel then api.RefreshPlayPanel()end
        if key=="ServeSpinPreset" and api.Controls and api.Controls.ServeSpinPreset then api.Controls.ServeSpinPreset:Set(validated)end
        if (key=="AutoSetTarget" or key=="AutoSetPlayers") and api.RefreshAutoSetTargets then api.RefreshAutoSetTargets()end
        return true, validated
    end
