            if goal then job.goal=goal end
        end
        if job.goal then
            if prepareDue or c.airborne or job.jumpIssued and not job.airborne then prepare(c,job.goal)end
            api.LastPlan.shot=job.goal.shot;api.LastPlan.pitch=job.goal.pitch;api.LastPlan.power=job.goal.power
            api.LastPlan.aim=job.goal.point;api.LastPlan.calibrated=job.goal.calibrated
            api.LastPlan.nativeEstimated=job.goal.nativeEstimated==true;api.LastPlan.confidence=job.goal.confidence
            api.LastPlan.aimDirection=job.goal.direction;api.LastPlan.aimHeadingLocked=c.airborne==true
            api.LastPlan.netCrossing=job.goal.netCrossing
            api.LastPlan.toolAvailable=job.goal.tool~=nil;api.LastPlan.blockPrediction=job.goal.blockPrediction
        end
