    local function aim(point, backward, airborne,hold)
        if api.IsServing()then return false end
        local part, humanoid = getRoot()
        if not part or not humanoid or not point then return false end
        local yaw = Core.FlatFacing(part.Position, point, backward)
        local facing = yaw and Core.YawOnlyFrame(part.CFrame,part.Position+yaw.LookVector)
        if not facing then return false end
        if airborne and jump._tilt and jump._tilt.Parent and jump._originCframe then
            jump._originCframe = Core.YawOnlyFrame(jump._originCframe,jump._originCframe.Position+yaw.LookVector)
            jump:_refreshTilt()
            if autoTiltObject==jump and jump._tiltRot==autoTiltWritten then
                local tilted=jump._tilt.CFrame
                facing=CFrame.new(part.Position)*(tilted-tilted.Position)
            end
            part.CFrame=facing
        else
            if aimLease then pcall(aimLease);aimLease=nil end
            -- SetValue returns the game's cleanup lease; never write Humanoid.AutoRotate.
            aimLease = movement.Look:SetValue(facing)
            part.CFrame = facing
            local token = {}; aimToken = token
            if not hold then task.delay(0.18, function() if api.Alive and aimToken == token then clearAim() end end) end
        end
        return true
    end
