    function Core.Validate(key, value)
        local spec = Core.Schema[key]
        if not spec then return false, "Unknown setting" end
        if key=="AutoSetPlayers" then
            if type(value)~="table" then return false,"Choose players from the list" end
            local result,seen={},{}
            for index,name in pairs(value)do
                if type(index)~="number" or index%1~=0 or index<1 or index>#value or type(name)~="string" or #name==0 or #name>64 or name=="None" then return false,"Invalid player list" end
            end
