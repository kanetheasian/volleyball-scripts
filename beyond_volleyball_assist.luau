        if not character or not Core.Finite(elapsed)or elapsed<0.01 or elapsed>0.35 or not Core.Finite(now)then return false end
        if api.NativeSetStartupCharacter~=character then
            table.clear(api.NativeSetStartupLead);table.clear(api.NativeSetStartupAt);table.clear(api.NativeSetStartupSamples)
