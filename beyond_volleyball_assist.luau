            end
            if band and play=="Normal"then band=Core.UpperAttackBand(band,net.antennaTop,1.1)end
            local attackCenter=Core.NormalSetPoint(sample.position,net,context.position)
            if attackCenter and sample.reach and sample.reach.attackDepth then
