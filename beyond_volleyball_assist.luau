    local function serveReady(other,root)
        local character=other.Character
        local humanoid=character and character:FindFirstChildOfClass("Humanoid")
        local animator=humanoid and humanoid:FindFirstChildOfClass("Animator")
        if animator then
            for _,track in ipairs(animator:GetPlayingAnimationTracks()) do
                local id=track.Animation and track.Animation.AnimationId:match("%d+")
                if track.IsPlaying and track.WeightCurrent>0.05 and id and serveAnimationIds[id] then return true,"serve_animation" end
            end
        end
        for id,ball in pairs(ballService.RenderedBallMap._map)do
            if Core.SpawnServeReady(ball,other,root.Position,ballEvents[id]~=nil)then return true,"spawned_ball",id end
        end
        return false
    end
    local function updateServeFacing()
        local viewer,humanoid=getRoot()
        if not config.ShowOpponentServe or not viewer or not humanoid or humanoid.Health<=0 then hideServeFacing();return end
        local net=courtAt(viewer.Position,true)
        if not net then hideServeFacing();return end
        if serveCourt~=net.part then hideServeFacing();serveCourt=net.part end
        local now=os.clock()
        local function eligible(other)
            local character=other and other.Character
            local root=character and character:FindFirstChild("HumanoidRootPart")
            local hum=character and character:FindFirstChildOfClass("Humanoid")
            local otherCourt=root and courtAt(root.Position,true)
            return other~=player and other and other.Parent==Players and root and hum and hum.Health>0
                and otherCourt and otherCourt.part==net.part
                and Core.ServeSourceEligible(viewer.Position,root.Position,net),root
        end
        if not serveScanAt or now-serveScanAt>=0.1 then
            serveScanAt=now
            local candidates={}
            for _,other in ipairs(Players:GetPlayers()) do
                local valid,root=eligible(other)
                if valid then
                    local ready,source,ballId=serveReady(other,root)
                    if ready then candidates[#candidates+1]={player=other,distance=(root.Position-viewer.Position).Magnitude,source=source,ballId=ballId}end
                end
            end
            table.sort(candidates,function(a,b)return a.distance<b.distance end)
            local selected=candidates[1]
            for _,entry in ipairs(candidates) do if entry.player==serving then selected=entry;break end end
            if selected then
                serving,serveCharacter,serveReadyAt=selected.player,selected.player.Character,now
                serveSource,serveBallId=selected.source,selected.ballId
            end
            serveObservedReady=selected~=nil
        end
        local valid,root=eligible(serving)
        if not valid or serving.Character~=serveCharacter
            or not Core.KeepServeFacing(serveReadyAt,now,serveObservedReady,config.ServeFacingGraceSeconds) then
            serveFacingPart.Transparency=1;api.LastServe=nil
            serving,serveCharacter,serveReadyAt=nil,nil,nil
