        local function receiveMotion(time)
            if context.receiveMovePoint then
                local delta=flat(context.receiveMovePoint-origin)
                local length=delta.Magnitude
                if length<0.01 then return Vector3.zero end
                return delta.Unit*math.min(length,math.max(0,context.speed or 0)*time)
            end
            return (context.motion or Vector3.zero)*time
        end
        while time<config.DiveHorizon do
            local dt=math.min(1/120,config.DiveHorizon-time)
            local a=sim.Position
            local b,velocity=stepPhysics(sim,dt)
            local finish=time+dt
            local grounded=b.Y<=floor
            if grounded then local alpha=math.clamp((a.Y-floor)/math.max(a.Y-b.Y,1e-8),0,1);b=a:Lerp(b,alpha);finish=time+dt*alpha end
            local sa=flat(a-net.center):Dot(net.normal)*side
            local sb=flat(b-net.center):Dot(net.normal)*side
            if sa<0 and sb>=0 then
                local cross=a:Lerp(b,-sa/(sb-sa))
                if math.abs(flat(cross-net.center):Dot(net.axis))<=net.halfWidth+(ball.Radius or 1)
                    and cross.Y<=net.topY+(ball.Radius or 1) then return nil,"net blocks ball" end
            end
            local lo,hi=0,1
            if sa<=0.05 and sb<=0.05 then lo,hi=1,0
            elseif sa<=0.05 then lo=(0.05-sa)/(sb-sa)
            elseif sb<=0.05 then hi=(0.05-sa)/(sb-sa) end
            if lo<=hi and finish>time then
                if context.receive and not receive then
                    local motionA,motionB=receiveMotion(time),receiveMotion(finish)
                    local alpha=Core.SphereBoxEntry(a-motionA,b-motionB,context.receive.CFrame,context.receive.Size,ball.Radius or 1,lo,hi)
                    if alpha then
                        local point=a:Lerp(b,alpha)
                        local eta=time+(finish-time)*alpha
                        local motion=receiveMotion(eta)
                        if flat(point-(origin+motion)).Magnitude<=config.ReceiveRange then
                            local localPoint=context.receive.CFrame:PointToObjectSpace(point-motion)
                            local xLimit=math.min(1.5,context.receive.Size.X*0.25)
                            local zLimit=math.min(1.5,context.receive.Size.Z*0.25)
                            local solid=math.abs(localPoint.X)<=xLimit and (context.kind~="Spike" or math.abs(localPoint.Z)<=zLimit)
                            receive={Action="Receive",Contact=point,ETA=eta,ResponseLead=receiveLead,Solid=solid,LocalContact=localPoint}
                        end
                    end
                end
                local hardHit=context.kind~="Set" and context.kind~="Receive" and context.kind~="Dive" and context.kind~="Bump"
                if config.AutoDive and hardHit and geometry and not dive and speed>=config.DiveMinSpeed and finish>=response then
                    local direction=flat(a:Lerp(b,(lo+hi)/2)-origin)
                    if direction.Magnitude>0.05 then
                        direction=direction.Unit
                        local frame=CFrame.lookAt(origin,origin+direction)*geometry.offset
                        local travelA=Core.DiveTravel(geometry.speed,geometry.coast,geometry.decay,time-response)
                        local travelB=Core.DiveTravel(geometry.speed,geometry.coast,geometry.decay,finish-response)
                        local start=math.max(lo,(response-time)/(finish-time))
                        if start<=hi then
                            local alpha=Core.SphereBoxEntry(a-direction*travelA,b-direction*travelB,frame,geometry.size,ball.Radius or 1,start,hi)
                            if alpha then
                                local contact=a:Lerp(b,alpha)
                                local distance=flat(contact-origin).Magnitude
                                if distance<=config.DiveRange+geometry.size.Z/2+(ball.Radius or 1) then
                                    dive={Action="Dive",Contact=contact,Direction=direction,ETA=time+(finish-time)*alpha,ResponseLead=response}
                                end
                            end
                        end
                    end
                end
            end
            if grounded then break end
            sim.Position,sim.Velocity=b,velocity
            time=finish
        end
        -- A speculative edge receive must not consume the remaining dive window
        -- when the current movement plan cannot reach its center in time.
        local move=context.receiveMovePlan
        local lateMove=context.receiveMoveActive and (not move or move.ReachPending==true
            or not Core.Finite(move.Travel) or not Core.Finite(move.ETA) or move.Travel>move.ETA)
        local immediateReceive=receive and receive.ETA<=receiveLead and (receive.Solid or not context.centeredReceive)
            and Core.SphereNearPart(context.receive,receive.Contact,ball.Radius or 1)
        if dive and lateMove and not immediateReceive then
