        visualForecast.Reset(packet.Id)
        local liveBall=ballService.RenderedBallMap._map[packet.Id]
        visualForecast.Observe(packet.Id,{Time=packet.Time,Position=packet.Position,Velocity=packet.Velocity,
            Acceleration=packet.Acceleration or liveBall and liveBall.Acceleration,
            Spin=packet.Spin or liveBall and liveBall.Spin,Kind=instance and instance.Name},os.clock())
        if liveBall and typeof(packet.Position)=="Vector3" and typeof(packet.Velocity)=="Vector3" then
            local viewer,_,character=getRoot()
