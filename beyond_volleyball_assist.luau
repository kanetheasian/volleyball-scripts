    local function updateVolumes(character)
        local live = {}
        api.AntennaZoneCount=0;api.AntennaZones={}
        for name,key in pairs({Set="SettingHitbox",Spike="SpikeHitbox",Receive="ReceiveHitbox"}) do
            if config[key] then
                local part = character:FindFirstChild(name)
                if part and part:IsA("BasePart") then
                    live[part] = true
                    if not volumes[part] then
                        local sphere=part.Shape==Enum.PartType.Ball
                        local box = Instance.new(sphere and "SphereHandleAdornment" or "BoxHandleAdornment")
                        box.Name, box.Adornee, box.AlwaysOnTop, box.ZIndex = ({Set="Setting hitbox",Spike="Spike hitbox",Receive="Receive hitbox"})[name], part, true, 1
                        box.Color3=({Set=Color3.fromRGB(83,190,255),Spike=Color3.fromRGB(255,157,95),Receive=Color3.fromRGB(85,235,172)})[name]
                        box.Transparency, box.Parent = 0.82, folder
                        volumes[part] = box
                    end
                    if volumes[part]:IsA("SphereHandleAdornment") then volumes[part].Radius=part.Size.X/2 else volumes[part].Size = part.Size end
                end
            end
        end
        if config.AntennaHitbox then
            local root=character:FindFirstChild("HumanoidRootPart")
            refreshCourts()
            for _,net in ipairs(courts)do
                local offset=type(ballUtils.getAntennaOffset)=="function"and ballUtils.getAntennaOffset(net.part)
                if root and net.part.Parent and Core.Finite(offset)and offset>0
                    and(root.Position-net.center).Magnitude<=config.VisualDistance then
                    local entry=volumes[net.part]
                    if not entry then
                        entry=Instance.new("Folder");entry.Name="Antenna zones • "..net.court.Name
                        entry.Parent=folder;volumes[net.part]=entry
                    end
                    live[net.part]=true
                    -- Native wide-crossing checks use the net's local X and
                    -- per-net antenna offset, including resized center courts.
                    -- These finite panels depict that otherwise unbounded plane.
                    for _,side in ipairs({-1,1})do
                        local name="Antenna illegal zone "..side
                        local box=entry:FindFirstChild(name)
                        if not box then
                            box=Instance.new("BoxHandleAdornment")
                            box.Name,box.Adornee,box.AlwaysOnTop,box.ZIndex=name,net.part,false,1
                            box.Color3,box.Transparency=Color3.fromRGB(255,65,75),0.92
                            box.Parent=entry
                        end
                        box.Size=Vector3.new(32,50,0.25)
                        box.CFrame=CFrame.new(side*(offset+16),net.floorY-net.center.Y+25,0)
                        local corners={Vector3.new(-16,-25,0),Vector3.new(16,-25,0),Vector3.new(16,25,0),Vector3.new(-16,25,0)}
                        for i,corner in ipairs(corners)do
                            local line=box:FindFirstChild("Edge"..i)
                            if not line then
                                line=Instance.new("LineHandleAdornment")
                                line.Name,line.Adornee,line.AlwaysOnTop,line.ZIndex="Edge"..i,net.part,false,2
                                line.Color3,line.Thickness,line.Transparency=Color3.fromRGB(255,65,75),2,0
                                line.Parent=box
                            end
                            local start=box.CFrame:PointToWorldSpace(corner)
                            local finish=box.CFrame:PointToWorldSpace(corners[i%4+1])
                            line.CFrame=CFrame.lookAt(start,finish);line.Length=(finish-start).Magnitude
                        end
                        api.AntennaZoneCount+=1
                        api.AntennaZones[#api.AntennaZones+1]={court=net.court.Name,net=net.part,offset=offset,side=side,
                            frame=net.part.CFrame*box.CFrame,size=box.Size}
                    end
                end
            end
        end
        for part, box in pairs(volumes) do if not live[part] then box:Destroy(); volumes[part] = nil end end
    end
    local function updateLabels()
        local live = {}
        local now,viewer=os.clock(),getRoot()
        for actor,sample in pairs(spikeHeights)do
            local character=sample.player and actor.Character or actor
            local current=actor.Parent and character==sample.character and now-sample.time<=3
            if not current then spikeHeights[actor]=nil end
            local visible=current and config.ShowSpikeHeight and viewer and(viewer.Position-sample.position).Magnitude<=config.VisualDistance
            local entry=spikeHeightLabels[actor]
            if visible then
                if not entry then
                    local anchor=newPart("SpikeHeightContact",Color3.fromRGB(255,230,140))
                    local tag=Instance.new("BillboardGui")
                    tag.Name,tag.Adornee,tag.AlwaysOnTop="SpikeHeight",anchor,false
                    tag.Size,tag.StudsOffset=UDim2.fromOffset(180,24),Vector3.new(0,0.8,0)
                    local text=Instance.new("TextLabel")
                    text.Size,text.BackgroundTransparency=UDim2.fromScale(1,1),1
                    text.TextSize,text.Font,text.TextStrokeTransparency=14,Enum.Font.GothamBold,0.2
                    text.TextColor3=Color3.fromRGB(255,230,140);text.Parent=tag;tag.Parent=anchor
                    entry={anchor=anchor,tag=tag,text=text};spikeHeightLabels[actor]=entry
                end
                entry.anchor.CFrame=CFrame.new(sample.position)
                entry.tag.MaxDistance=config.VisualDistance;entry.tag.Enabled=true
                entry.text.Text=string.format("%.0f Studs",sample.height)
            elseif entry then
                entry.anchor:Destroy();spikeHeightLabels[actor]=nil
            end
        end
        for other,sample in pairs(playerPowers)do
            if other.Parent~=Players or not Core.ObservedPowerText(sample,other.Character,os.clock())then playerPowers[other]=nil end
        end
        if config.PlayerLabels then
            for _, other in ipairs(Players:GetPlayers()) do
                local char = other.Character
                local head = char and char:FindFirstChild("Head")
                local text=api.GetPlayerPower(other)
                if other ~= player and head and text then
                    live[other] = true
                    local label = labels[other]
                    if not label or label.Adornee ~= head then
                        if label then label:Destroy() end
                        label = Instance.new("BillboardGui")
                        label.Name, label.Adornee, label.AlwaysOnTop, label.MaxDistance = "PlayerInfo", head, true, config.VisualDistance
                        label.Size, label.StudsOffset = UDim2.fromOffset(64,26), Vector3.new(0,2,0)
                        local text = Instance.new("TextLabel")
                        text.Size, text.BackgroundTransparency, text.TextColor3 = UDim2.fromScale(1,1), 1, Color3.new(1,1,1)
                        text.TextSize, text.Font, text.TextStrokeTransparency, text.Parent = 16, Enum.Font.GothamBold, 0.25, label
                        label.Parent, labels[other] = folder, label
                    end
                    label.MaxDistance = config.VisualDistance
                    label.Enabled=text~=nil
                    label.TextLabel.Text=text or ""
                end
            end
        end
        for other, label in pairs(labels) do if not live[other] then label:Destroy(); labels[other] = nil end end
    end
    local function defense(balls, part, humanoid, character,dt,preview)
        api.Metrics.DefenseFrames+=1
        if (not receiveFocused and config.BackgroundMode~=true and not (config.AutoReceive and config.AutoReceiveMove)) or UIS:GetFocusedTextBox() or GuiService.MenuIsOpen or humanoid.Health <= 0 or humanoid.FloorMaterial == Enum.Material.Air
            or humanoid.Sit or part.Anchored or player:GetAttribute("Spec_NoAction") or setAim then
            if not preview then clearReceiveMove(not receiveFocused and not config.AutoReceiveMove and "Window not focused" or UIS:GetFocusedTextBox() and "Typing"
                or GuiService.MenuIsOpen and "Menu open" or player:GetAttribute("Spec_NoAction") and "Native actions disabled"
                or humanoid.FloorMaterial==Enum.Material.Air and "Waiting for ground" or "Receive movement paused")end;return
        end
        local inputDisabled=actionClient._inputService.DisableInputs
        if inputDisabled and inputDisabled:GetState()==true then if not preview then clearReceiveMove("Native inputs disabled")end;return end
        local current = machine:GetCurrent()
        if current and current.Name~="Receive" then if not preview then clearReceiveMove("Native action in progress")end;return end
        local net=courtAt(part.Position,true)
        if not net then api.DefenseReason="No verified court";if not preview then clearReceiveMove("No verified court")end;return end
        if os.clock()-pingAt>0.25 then pingAt=os.clock();local ok,value=pcall(function() return player:GetNetworkPing() end);if ok then ping=math.clamp(value,0,0.2) end end
        local receivePart,divePart=character:FindFirstChild("Receive"),character:FindFirstChild("Dive")
        if not receivePart or not divePart then if not preview then clearReceiveMove("Waiting for receive geometry")end;return end
        local diveSpeed=45+(traitUtils.getBoost("Dive_Force_Added") or 0)
        local setSpeed=movement:GetSetSpeed()
        local context={ready=true,net=net,rootPosition=part.Position,motion=part.AssemblyLinearVelocity,
            receiving=current and current.Name=="Receive",receive=receivePart,ping=ping,dt=dt,floorY=net.floorY,
            speed=setSpeed,margin=math.max(part.Size.X,part.Size.Z)/2+0.25,
            dive={offset=part.CFrame:ToObjectSpace(divePart.CFrame),size=divePart.Size,speed=diveSpeed,coast=0.1,decay=0.125+setSpeed/45}}
        local camera=workspace.CurrentCamera
        local aimPoint,aimMode=receiveAimPoint(part,net)
        context.receive={CFrame=Core.ReceiveFacingFrame(part.CFrame,receivePart.CFrame,
            camera and camera.CFrame.LookVector,aimPoint),Size=receivePart.Size}
        context.receiveFacing=aimPoint and (aimMode=="Middle front" and "middle front" or "teammate") or camera and "camera" or "current"
        context.receiveTargetPoint=aimPoint
        local planConfig=config
        if preview then planConfig=table.clone(config);planConfig.AutoReceive=true;planConfig.AutoDive=true;planConfig.AutoReceiveMove=true end
        local best,chosen,reason,preAimCandidate,preAimBall,preAimRevision,moveBest,moveBall,moveRevision,moveReason
        local moveAllowed=preview or config.AutoReceive and config.AutoReceiveMove and not receiveMovementBlocked()
        if not preview then api.ReceiveSprinting=false end
        for _, ball in pairs(balls) do
            if not ball._dying and not ball._rolling and typeof(ball.Position) == "Vector3" and typeof(ball.Velocity)=="Vector3" then
                local ballCourt=courtAt(ball.Position,true)
                local event=ballEvents[ball.Id]
                local attempted=attempts[ball]
                local revision=event and event.revision or 0
                local retry=attempted and attempted.revision==revision and attempted.action=="Receive"
                    and (attempted.count or 1)<2 and not current and os.clock()>=(attempted.retryAt or math.huge)
                    and not (event and event.owner==player)
                local fresh=not attempted or attempted.revision~=revision or retry
                if ballCourt and ballCourt.court==net.court and (fresh or moveAllowed and receiveMoveJob and receiveMoveJob.ballId==ball.Id) then
                    context.ownTouch=event and event.owner==player
                    context.kind=event and event.kind or (typeof(ball._lastHit)=="Instance" and ball._lastHit.Name or ball._lastHit)
                    context.hitSpeed=event and event.hitSpeed
                    -- RenderedBallMap is already advanced by the native client. Do not age it again.
                    local predicted=ball
                    local bounds=visualForecast.GetLandingDecision(ball.Id,ball,net,os.clock())
                    if config.SkipOutBalls and bounds.SkipOut then reason="Predicted out • letting it pass"
                    else
                        local receiveMoveCandidate
                        if moveAllowed then
                            local candidate,whyMove=Core.PlanReceiveMove(planConfig,context,predicted,ballUtils.stepPhysics)
                            local probe,sprintAccepted
                            if not preview and config.ReceiveMoveSprint and (not current or current.Name=="Receive") and os.clock()-lastReceiveSprint>=0.18 then
                                probe=candidate
                                if not probe then
                                    local probeContext=table.clone(context);probeContext.probe=true
                                    probe=Core.PlanReceiveMove(planConfig,probeContext,predicted,ballUtils.stepPhysics)
                                end
                                if probe and probe.Distance>math.max(4,context.speed*0.12)then
                                    local path=flat(probe.Point-part.Position)
                                    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
                                    params.FilterDescendantsInstances={character,folder};params.RespectCanCollide=true
                                    if not workspace:Raycast(part.Position,path,params)then
                                        lastReceiveSprint=os.clock()
                                        local speed,accepted=requestNativeSprint("ReceiveSprintReason")
                                        sprintAccepted=accepted
                                        if Core.Finite(speed)and speed>0 then context.speed=speed;context.dive.decay=0.125+speed/45 end
                                        if accepted then api.ReceiveSprinting=true;api.ReceiveSprintBursts=(api.ReceiveSprintBursts or 0)+1 end
                                        candidate,whyMove=Core.PlanReceiveMove(planConfig,context,predicted,ballUtils.stepPhysics)
                                    end
                                end
                            end
                            if not candidate and not preview and config.ReceiveMoveSprint then
                                local counter=movement.SprintUnits or actionClient._activeSprints
                                local units=counter and counter.Value
                                if sprintAccepted or Core.Finite(units)and units>0 then
                                    local probeContext=table.clone(context);probeContext.probe=true
                                    probe=Core.PlanReceiveMove(planConfig,probeContext,predicted,ballUtils.stepPhysics)
                                    if probe and probe.ETA>=0.15 and probe.Travel<=probe.ETA*1.6 then
                                        candidate=probe;candidate.ReachPending=true
                                        whyMove="Pursuing center while native sprint ramps"
                                    end
                                end
                            end
                            moveReason=whyMove or moveReason
                            receiveMoveCandidate=candidate
                            if candidate and (not moveBest or candidate.ETA<moveBest.ETA)then
                                candidate.Landing=bounds.Landing;moveBest,moveBall,moveRevision=candidate,ball,revision
                            end
                        end
                        local plan,why,receiveCandidate
                        context.centeredReceive=config.AutoReceiveMove and config.ReceiveSolidOnly~=false
                        context.receiveMoveActive=moveAllowed
                        context.receiveMovePlan=moveAllowed and receiveMoveCandidate or nil
                        context.receiveMovePoint=moveAllowed and (receiveMoveCandidate and receiveMoveCandidate.Point or part.Position) or nil
                        if fresh then plan,why,receiveCandidate=Core.PlanDefense(planConfig,context,predicted,ballUtils.stepPhysics)end
                        receiveCandidate=receiveCandidate or plan and plan.Action=="Receive" and plan
                        if receiveCandidate and receiveCandidate.ETA<=config.ReceiveAimPreSeconds
                            and (not preAimCandidate or receiveCandidate.ETA<preAimCandidate.ETA) then
                            preAimCandidate,preAimBall,preAimRevision=receiveCandidate,ball,revision
                        end
                        reason=why
                        if plan and (not best or plan.Action=="Receive" and best.Action~="Receive"
                            or plan.Action==best.Action and plan.ETA<best.ETA) then best,chosen=plan,ball end
                    end
                end
            end
        end
        api.DefenseReason=reason or "Waiting for incoming ball"
        if preview then return best,reason,context,moveBest,moveReason end
        if moveBest then
            local direction=flat(moveBest.Point-part.Position)
            local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances={character,folder};params.RespectCanCollide=true
            if direction.Magnitude>0.25 and workspace:Raycast(part.Position,direction,params)then
                clearReceiveMove("Receive path obstructed")
            else
                receiveMoveJob={ballId=moveBall.Id,revision=moveRevision,point=moveBest.Point,updated=os.clock(),character=character}
                api.ReceiveMove=Core.ReceiveMoveDirection(part.Position,moveBest.Point,context.speed,dt)
                api.ReceiveMovePlan={ballId=moveBall.Id,revision=moveRevision,point=moveBest.Point,contact=moveBest.Contact,
                    landing=moveBest.Landing,eta=moveBest.ETA,travel=moveBest.Travel,distance=moveBest.Distance,
                    centerError=moveBest.CenterError,heightError=moveBest.HeightError,speed=context.speed,facing=context.receiveFacing,
                    reachable=moveBest.Reachable,reachPending=moveBest.ReachPending==true}
                api.ReceiveMoveReason=direction.Magnitude>0.15 and (moveBest.ReachPending and "Pursuing receive center • late arrival predicted" or "Running to centered receive") or "Centered for receive"
            end
        else clearReceiveMove(moveAllowed and (moveReason or "Waiting for reachable medium/hard ball") or (receiveMovementBlocked() or "Receive movement off"))end
        if config.ReceiveAim and preAimCandidate then prepareReceiveAim(preAimBall.Id,preAimRevision,preAimCandidate.ETA) end
        if best then
            if os.clock()-lastDefense<0.03 then return end
            local choice=best.Action
            if choice=="Receive" and config.ReceiveAim then
                if api.ReceiveAimState then
                    receiveAim.contactAt=os.clock()+best.ETA;receiveAim.responseLead=best.ResponseLead
                    api.ReceiveAimState.ready=Core.ReceiveAimReady(config,receiveAim.started,api.ReceiveAimState.error,os.clock(),best.ETA,best.ResponseLead)
                    if not api.ReceiveAimState.ready then api.DefenseReason="Facing teammate before receive";return end
                end
            end
            local accepted=false
            if choice == "Dive" then
                clearReceiveMove("Native dive taking over")
                clearReceiveAim()
                local distance=Core.DiveTravel(diveSpeed,0.1,context.dive.decay,math.max(0,best.ETA-(best.ResponseLead or 0)))
                local destination=part.Position+best.Direction*distance
                if Core.Side(destination,net)~=Core.Side(part.Position,net) then api.DefenseReason="Net blocks dive";return end
                local params=RaycastParams.new()
                params.FilterType=Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances={character,folder}
                params.RespectCanCollide=true
                if distance>0.05 and workspace:Raycast(part.Position,best.Direction*distance,params) then api.DefenseReason="Dive path obstructed";return end
                -- The native dive provider determines the launch direction for this single request.
                local previous = rawget(dive,"_directionProvider")
                local provider = function() return best.Direction end
                dive._directionProvider = provider
                local previousFrame=part.CFrame
                local aimedFrame=Core.YawOnlyFrame(part.CFrame,part.Position+best.Direction)
                if aimedFrame then part.CFrame=aimedFrame end
                defenseRequest=true
                local ok, result = pcall(function() return actionClient:_request(machine,"Dive") end)
                defenseRequest=false
                if rawget(dive,"_directionProvider") == provider then dive._directionProvider = previous end
                local entered=machine:GetCurrent()
                accepted=ok and result~=false and (result==true or entered and entered.Name=="Dive") or false
                if not accepted and aimedFrame and part.CFrame==aimedFrame then part.CFrame=previousFrame end
                if not ok then report("auto dive",result) end
            else
                defenseRequest=true
                local ok,result=pcall(actionClient._request,actionClient,machine,"Receive")
                defenseRequest=false
                local entered=machine:GetCurrent()
                accepted=ok and result~=false and (result==true or entered and entered.Name=="Receive") or false
                if not ok then report("auto receive",result)end
                if config.ReceiveAim and receiveAim then updateReceiveAim()end
            end
            lastDefense=os.clock()
            api.LastDefensePlan={action=choice,eta=best.ETA,responseLead=best.ResponseLead,ping=ping,accepted=accepted,
                contact=best.Contact,direction=best.Direction,ballId=chosen.Id,time=os.clock(),facing=context.receiveFacing,targetPoint=context.receiveTargetPoint,
                solidContact=best.Solid,localContact=best.LocalContact,centerFallback=best.CenterFallback,
                receiveMoveHandoff=best.ReceiveMoveHandoff==true}
            if accepted then
                local event=ballEvents[chosen.Id]
                local revision=event and event.revision or 0
                local prior=attempts[chosen]
                attempts[chosen]={revision=revision,action=choice,count=prior and prior.revision==revision and (prior.count or 1)+1 or 1,
                    retryAt=os.clock()+math.max(0.5,best.ETA+0.2)}
                api.LastAction = choice
                api.DefenseReason=string.format("%s requested • %.0fms predicted contact",choice,best.ETA*1000)
            end
        end
    end
    function api.PreviewDefense()
