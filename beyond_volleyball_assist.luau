    local function release(reason)
        if job then
            api.LastAttempt={ballId=job.ballId,target=job.target and job.target.name,dump=job.dump==true,jumpIssued=job.jumpIssued==true,
                requested=job.requested~=nil,reason=reason,time=host.now(),plan=table.clone(api.LastPlan or{})}
