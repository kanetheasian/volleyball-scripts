            spin=localVector(packet.Spin or ball.Spin or Vector3.zero,direction),
            acceleration=packet.Acceleration or ball.Acceleration or Vector3.new(0,-25,0),time=now,
            character=contactState and contactState.character,calibrationScope=contactState and contactState.calibrationScope,
            gliding=contactState and contactState.gliding,glideSpeed=contactState and contactState.glideSpeed}
