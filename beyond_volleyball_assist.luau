        local start=state.cursor
        local result
        for offset=0,#phases-1 do
            if budgetSpent()then break end
            local index=(start+offset)%#phases+1
            local search=table.clone(context)
            search.preferredSetAirTime=phases[index];search.requireJump=true;search.glideSpeed=nil
