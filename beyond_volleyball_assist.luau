        end
        if receiveAim and receiveAim.ballId==packet.Id then clearReceiveAim() end
        if receiveMoveJob and receiveMoveJob.ballId==packet.Id then clearReceiveMove("Ball touched")end
        local contactPosition=owner and owner.Character and owner.Character:FindFirstChild("HumanoidRootPart")
        contactPosition=contactPosition and contactPosition.Position or instance and instance:IsA("BasePart") and instance.Position or packet.Position
        local contactNet=contactPosition and courtAt(contactPosition,true)
        ballEvents[packet.Id]=Core.TeamTouch(previous,{owner=contactOwner,kind=instance and instance.Name,time=os.clock(),packetTime=packet.Time,
            team=contactNet and contactOwner and teamAt(contactOwner,contactPosition,contactNet),court=contactNet and contactNet.court})
        if typeof(packet.Velocity)=="Vector3" then ballEvents[packet.Id].hitSpeed=packet.Velocity.Magnitude end
        if owner==player and instance.Name=="Set" and typeof(packet.Velocity)=="Vector3" then
            local speed=flat(packet.Velocity).Magnitude
            if speed>0.1 then api.SetFlightSample={time=os.clock(),horizontalSpeed=speed,power=actionClient._power.Value} end
        end
        if owner==player and instance.Name=="Spike" and typeof(packet.Velocity)=="Vector3" and typeof(packet.Position)=="Vector3" then
