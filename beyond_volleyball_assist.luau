            if jumpPlan.contact.Y>=ground.contact.Y+1.5 then return chosen(jumpPlan,jumpPlan.peakContact and "Jump: highest usable contact near apex" or "Jump: highest usable delivery contact")end
            return chosen(ground,"Ground: highest usable delivery contact")
        end
        if playName=="Quick" and groundChoice.power>airChoice.power+2 then return chosen(ground,"Ground: preserves Quick power")end
        if playName=="Short" and groundChoice.landingDistance and airChoice.landingDistance
            and groundChoice.landingDistance+2.5<airChoice.landingDistance then return chosen(ground,"Ground: keeps Short close")end
        local placement=airChoice.placement or airChoice.point or target.position
        local delta=flat(placement-jumpPlan.contact)
        local net=context.net
        local across=math.abs(delta:Dot(net.axis))
        local side=Core.Side(context.position,net)
        local line=side and net.attackLines and net.attackLines[side]
        local depth=side and math.max((jumpPlan.contact-net.center):Dot(net.normal)*side,(ground.contact-net.center):Dot(net.normal)*side) or 0
        local backRow=line~=nil and depth>=line
        local details={distance=delta.Magnitude,across=across,receiveDepth=depth,attackLine=line,backRow=backRow}
        local longSet=across>=net.halfWidth*1.1 or delta.Magnitude>=net.halfWidth*1.4
        if playName~="Short" and longSet then return chosen(jumpPlan,"Jump: long cross-court delivery",details)end
        if playName~="Short" and backRow then return chosen(jumpPlan,"Jump: back-row receive",details)end
        if ground.time-jumpPlan.time>=math.max(0.55,Core.SetPlay(playName).jumpGain)then return chosen(jumpPlan,"Jump: materially earlier contact",details)end
        return chosen(ground,"Ground: nearby receive suits this attack",details)
    end
    function api.OutsideSideline(point,net)
        return point~=nil and net~=nil and net.axis~=nil and Core.Finite(net.halfWidth)
            and math.abs((point-net.center):Dot(net.axis))>net.halfWidth
    end
    function api.ChooseReceiveIntercept(ball,context,target,mode,play,backward)
        local out=api.OutsideSideline(ball.Position,context.net)
        local plan,reason
        if not out then
            plan,reason=api.ChooseIntercept(ball,context,target,mode,play,backward)
            out=plan and api.OutsideSideline(plan.contact,context.net)
            if not out then return plan,reason end
            if backward and plan.deliveryValidated and plan.delivery and not plan.delivery.emergency then
                plan.selectedBackSet=true;plan.sidelineBackPreferred=true;return plan,reason
            end
        end
        local back,why=api.ChooseIntercept(ball,context,target,mode,play,true)
        if back and back.deliveryValidated and back.delivery and not back.delivery.emergency then
            back.selectedBackSet=true;back.sidelineBackPreferred=true;return back,why
        end
        if api.PlanningBudgetHit then return nil,"Sideline back-set search deferred within planner budget"end
        local front,frontReason=api.ChooseIntercept(ball,context,target,mode,play,false)
        if front then front.selectedBackSet=false;front.sidelineBackPreferred=true end
        return front,frontReason or why or reason
    end
    local function addAttempt(entry)
        api.History[#api.History+1]=entry
        if #api.History>20 then table.remove(api.History,1)end
    end
    function api.ForcedDelivery(origin,target,context,ball)
        local playName=config.AutoSetPlay or "Normal"
        local play=Core.SetPlay(playName)
        local selected=target
        if playName=="Pipe"and target.net then
            selected=table.clone(target)
            local side=Core.Side(context.position,target.net)or 1
            local line=target.net.attackLines and target.net.attackLines[side]
            if line then selected.approachPosition=target.position+target.net.normal*side*(line+1-(target.position-target.net.center):Dot(target.net.normal)*side)end
        end
        local point=api.PlayPlacement(origin,selected,playName)or target.position
        if not point then return nil end
        local distance=math.max(0.1,flat(point-origin).Magnitude)
        local best
        for power=1,math.max(1,math.floor(math.min(context.maxPower or 15,play.maxPower or 15)))do
            local h,v=api.NormalVelocity(power,context.airborne==true,false,0,origin.Y,context.nativeGlide==true,playName=="Normal")
            if Core.Finite(h)and h>0 and Core.Finite(v)then
                local time=distance/h
                local height=origin.Y+v*time+0.5*(ball.Acceleration and ball.Acceleration.Y or -25)*time*(time+1/60)
                local error=math.abs(height-point.Y)
                local score=error+math.abs(time-play.tempo)*(play.tempoWeight or 1)
                local lofted,arc=api.NormalLoft(origin,v,ball.Acceleration and ball.Acceleration.Y or -25,time)
                if playName=="Normal"and not api.NormalArcValid(lofted,arc,time)then continue end
                local comfort=playName=="Normal"and api.NormalComfort(lofted,arc,time)or false
                if playName=="Normal"then score+=api.NormalPacePenalty(arc,time)end
                local better=not best or score<best.score
                if best and playName=="Normal"and comfort~=best.normalComfort then
                    if comfort and error<=best.heightError+0.75 then better=true
                    elseif best.normalComfort and best.heightError<=error+0.75 then better=false end
                end
