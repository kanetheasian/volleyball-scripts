        for _,receiver in ipairs(receivers)do
            if receiver.owner==lastOwner then continue end
            local relative=ball.Velocity-receiver.velocity
            local offset=ball.Position-receiver.frame.Position
            if offset.Magnitude>receiver.size.Magnitude/2+radius+relative.Magnitude*0.18+1 then continue end
            local sample=table.clone(ball)
            sample.Acceleration=ball.Acceleration or Vector3.zero
            sample.Spin=ball.Spin or Vector3.zero
            for step=1,6 do
                local position=sample.Position
