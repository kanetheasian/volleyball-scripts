                local rightEdge=blockerXs[i+1].x-blockerXs[i+1].width*0.5
                if rightEdge-leftEdge>=2.5 then
                    local mid=(leftEdge+rightEdge)*0.5
                    if math.abs(mid)<=width then
                        target("Block seam gap",mid,depth*0.75)
                        target("Block seam gap",mid,depth)
                    end
                end
            end
        end
        end
        if context.autoSpikeAttack and math.abs(x)>net.halfWidth-context.radius-0.75 then
            local own=(origin-net.center):Dot(net.normal)*side
            for _,reserve in ipairs({1.25,2.5})do
                local crossing=math.sign(x)*(net.halfWidth-context.radius-reserve)
                local opposite=-math.sign(x)*width
                local d=own*math.abs(opposite-x)/math.max(0.25,math.abs(x-crossing))-own
                if d>=margin and d<=depth then target("Antenna cross",opposite,d)end
            end
            -- Search sharp cross-court routes first when contact is outside the
            -- antenna. Deep targets can land in court while crossing outside it.
            for i,row in ipairs(targets)do
                local d=(row.point-net.center):Dot(net.normal)*side
                local own=(origin-net.center):Dot(net.normal)*side
                local alpha=own/math.max(0.001,own-d)
                local crossing=origin:Lerp(row.point,math.clamp(alpha,0,1))
                row.antennaScore=math.abs((crossing-net.center):Dot(net.axis))+context.radius
                row.antennaOrder=i
            end
            table.sort(targets,function(a,b)
                if math.abs(a.antennaScore-b.antennaScore)>0.001 then return a.antennaScore<b.antennaScore end
                return a.antennaOrder<b.antennaOrder
            end)
        end
        if context.dumpAttack and context.headingDirection and flat(context.headingDirection).Magnitude>0.1 then
            local heading=flat(context.headingDirection).Unit
            for index,row in ipairs(targets)do
                local direction=flat(row.point-origin)
                row.headingScore=direction.Magnitude>0.1 and direction.Unit:Dot(heading)or -1
                row.searchOrder=index
            end
            table.sort(targets,function(a,b)
                if math.abs(a.headingScore-b.headingScore)>0.000001 then return a.headingScore>b.headingScore end
                if (a.name=="Current lane")~=(b.name=="Current lane")then return a.name=="Current lane"end
                return a.searchOrder<b.searchOrder
            end)
        end
        if context.preferTool then
            for i,target in ipairs(targets)do target.toolOrder=i end
            table.sort(targets,function(a,b)
                if(a.name=="Tool attempt")~=(b.name=="Tool attempt")then return a.name=="Tool attempt"end
                return a.toolOrder<b.toolOrder
            end)
        end
        local best,bestTool
        local pitches={-math.rad(20),-math.rad(16),-math.rad(12),-math.rad(8),-math.rad(4),0,math.rad(12),math.rad(20)}
        if context.autoSpikeAttack then
            local own=(origin-net.center):Dot(net.normal)*side
            local degrees=own>12 and{4,8,0,12,2,6,10,16,20,-4,-8,-12,-16,-20}or{-8,-4,-12,0,-16,-20,4,8,12,20}
            pitches={};for _,angle in ipairs(degrees)do pitches[#pitches+1]=math.rad(angle)end
        end
        if context.cornerOnly then pitches={};for angle=-20,20,0.5 do pitches[#pitches+1]=math.rad(angle)end end
        if (context.cornerOnly or context.dumpAttack)and context.requireCalibrated then
            pitches={}
            for _,row in ipairs(pool)do
                if row.power==context.power then
                    local duplicate=false
                    for _,pitch in ipairs(pitches)do if math.abs(pitch-row.pitch)<math.rad(0.25)then duplicate=true;break end end
                    if not duplicate then pitches[#pitches+1]=row.pitch end
                end
            end
            if context.allowPitchInterpolation and #pitches>1 then
                table.sort(pitches)
                local first,last=pitches[1],pitches[#pitches]
                for angle=math.ceil(math.deg(first)/2)*2,math.floor(math.deg(last)/2)*2,2 do pitches[#pitches+1]=math.rad(angle)end
            end
            if context.preferredPitch then table.sort(pitches,function(a,b)return math.abs(a-context.preferredPitch)<math.abs(b-context.preferredPitch)end)end
        end
        for _,pitch in ipairs(pitches)do
            if context.fixedPitch and math.abs(pitch-context.fixedPitch)>math.rad(0.25)then continue end
            if context.deadline and context.clock()>=context.deadline then planner.BudgetExceeded=true;break end
            local model
            if not context.launchVelocity then model=modelFor(context,pitch,pool)end
            if context.launchVelocity and not context.launchVelocity(Vector3.zAxis,pitch)then continue end
            if context.autoSpikeAttack and not context.launchVelocity and not model and math.abs(pitch)>math.rad(0.25)then continue end
            if context.requireCalibrated and not model then continue end
            for _,targetRow in ipairs(targets)do
                if context.deadline and context.clock()>=context.deadline then planner.BudgetExceeded=true;break end
                if context.cornerOnly and model and model.spin.Magnitude<0.001 and model.acceleration.Y<0 then
                    local gravity=-model.acceleration.Y
                    local vertical=model.velocity.Y-gravity/120
                    local height=origin.Y-net.floorY-context.radius
                    local duration=(vertical+math.sqrt(vertical*vertical+2*gravity*height))/gravity
                    local range=flat(model.velocity).Magnitude*duration
                    if not context.dumpAttack and math.abs(range-flat(targetRow.point-origin).Magnitude)>(context.cornerTolerance or 3.5)+0.1 then continue end
                end
                local direction=context.lockedDirection or flat(targetRow.point-origin).Unit
                local flight
                -- Correct measured side spin/bearing before scoring the actual landing, not the requested point.
                for _=1,context.lockedDirection and 0 or 2 do
                    flight=forecast(context,direction,pitch,model)
                    if not flight.Landing then break end
                    local desired=flat(targetRow.point-origin).Unit
                    local actual=flat(flight.Landing-origin)
                    if actual.Magnitude<0.1 then break end
                    actual=actual.Unit
                    local correction=math.atan2(actual:Cross(desired).Y,actual:Dot(desired))
                    if math.abs(correction)<0.000001 then break end
                    direction=CFrame.Angles(0,correction,0):VectorToWorldSpace(direction)
                end
                flight=forecast(context,direction,pitch,model)
                if (context.dumpAttack or context.autoSpikeAttack)and context.headingDirection and context.headingLimit
                    and direction:Dot(flat(context.headingDirection).Unit)<math.cos(context.headingLimit)then continue end
                if context.dumpAttack and context.takeoffDirection and context.takeoffLimit
                    and direction:Dot(flat(context.takeoffDirection).Unit)<math.cos(context.takeoffLimit)then continue end
                local evaluation,rejection=planner.Evaluate(context,flight)
                if evaluation and context.dumpAttack and evaluation.receiverCollision and not context.allowCoveredDump then evaluation=nil;rejection="Receiver lane"end
                if not evaluation and trace then rejection=rejection or "Unknown";trace.flightRejected[rejection]=(trace.flightRejected[rejection]or 0)+1 end
                if evaluation and context.dumpAttack and math.abs(pitch)>math.rad(0.5)then
                    local lower=table.clone(context);lower.origin=context.origin-Vector3.yAxis*tiltReserve(model,context)
                    local clearance,clearanceReason=planner.Evaluate(lower,forecast(lower,direction,pitch,model))
                    if not clearance or clearance.blocked or clearance.receiverCollision and not context.allowCoveredDump then
                        if trace then clearanceReason="Tilt reserve: "..(clearanceReason or "Occupied lane");trace.flightRejected[clearanceReason]=(trace.flightRejected[clearanceReason]or 0)+1 end
                        if context.softFlightMargins then
                            evaluation.safetyPenalty+=12+tiltReserve(model,context)*8
                        else evaluation=nil end
                    elseif clearance.receiverCollision then
                        evaluation.receiverCollision=true;evaluation.openness=math.min(evaluation.openness,clearance.openness)
                    end
                    if evaluation and clearance then evaluation.safetyPenalty=math.max(evaluation.safetyPenalty,clearance.safetyPenalty or 0)end
                end
                if evaluation and context.dumpAttack and evaluation.openness<=0 and trace then
                    trace.receiverCoveredCandidates=(trace.receiverCoveredCandidates or 0)+1
                end
                local spreadChecked=0
                if evaluation and context.validateMeasuredSpread then
                    for _,sample in ipairs(pool)do
                        if math.abs(sample.pitch-pitch)>math.rad(0.25)then continue end
                        if context.deadline and context.clock()>=context.deadline then
                            planner.BudgetExceeded=true;evaluation=nil;break
                        end
                        local alternate,spreadReason=planner.Evaluate(context,forecast(context,direction,pitch,sample))
                        if not alternate or alternate.blocked or context.dumpAttack and alternate.receiverCollision and not context.allowCoveredDump then
                            if trace then spreadReason=spreadReason or "Blocked measured spread";trace.flightRejected[spreadReason]=(trace.flightRejected[spreadReason]or 0)+1 end
                            evaluation=nil;break
                        end
                        if context.dumpAttack then
                            evaluation.openness=math.min(evaluation.openness,alternate.openness)
                            evaluation.receiverCollision=evaluation.receiverCollision or alternate.receiverCollision
                            evaluation.safetyPenalty=math.max(evaluation.safetyPenalty,alternate.safetyPenalty or 0)
                        end
                        spreadChecked+=1
                    end
                    if spreadChecked==0 then evaluation=nil end
                end
                if evaluation and (context.dumpAttack or not context.cornerOnly or flat(flight.Landing-targetRow.point).Magnitude<=(context.cornerTolerance or 3.5))then
                    local landing=flight.Landing
                    local distance=flat(landing-targetRow.point).Magnitude
                    local shot="Open lane"
                    local landingDepth=math.abs((landing-net.center):Dot(net.normal))
                    local lateral=(landing-net.center):Dot(net.axis)
                    if targetRow.name=="Block evade seam" or targetRow.name=="Block evade deep" or targetRow.name=="Block evade sharp" or targetRow.name=="Block seam gap" then
                        shot=targetRow.name
                    elseif math.abs(lateral-x)<4 and math.abs(lateral)>width*0.55 then shot="Line"
                    elseif landingDepth<net.halfDepth*0.4 and math.abs(lateral-x)>net.halfWidth*0.7 then shot="Tight cross"
                    elseif landingDepth>net.halfDepth*0.65 and math.abs(lateral)>width*0.65 then shot="Deep corner"
                    elseif math.abs(lateral-x)>net.halfWidth*0.45 and math.abs(lateral)>width*0.5 then shot="Cross"end
                    local attackBonus=shot=="Tight cross" and 8 or shot=="Cross" and 4 or shot=="Line" and 5 or shot=="Deep corner" and 5
                        or (targetRow.name:find("Block evade") or targetRow.name:find("Block seam")) and 8 or 0
                    local score=evaluation.openness*2-(flight.Time or 3.5)*12-distance*0.12
                        +attackBonus+(model and 3 or -4)+math.min(1,math.abs(lateral)/width)*12
                    if context.autoSpikeAttack then
                        for _,recent in ipairs(context.recentTargets or{})do
                            score-=math.max(0,8-flat(landing-recent).Magnitude)*0.65
                        end
                    end
                    score-=evaluation.safetyPenalty or 0
                    if context.dumpAttack then score-=distance*2 end
                    if context.preferMeasuredTilt and model and model.pitchInterpolated then score-=20 end
                    local plan={point=landing,targetPoint=targetRow.point,direction=direction,pitch=pitch,roll=0,shot=shot,score=score,
                        flight=flight,netCrossing=evaluation.netCrossing,openness=evaluation.openness,calibrated=model~=nil and not context.launchVelocity,
                        nativeEstimated=context.launchVelocity~=nil,
                        confidence=context.launchVelocity and "Native flight estimate"or model and "Measured launch estimate" or "Uncalibrated launch estimate",
                        contact=context.origin,power=context.power,margin=context.margin,net=net,edge=math.sign(lateral),
                        measuredSpreadChecked=spreadChecked,receiverCovered=evaluation.receiverCollision==true,safetyPenalty=evaluation.safetyPenalty or 0,netBrushRisk=evaluation.netBrushRisk}
                    if context.dumpAttack then plan.launchModel=model end
                    plan.glideMeasured=model and model.gliding==true or false
                    if model and Core.Finite(model.rootHeight)then plan.contactHeightOffset=model.height-model.rootHeight end
                    plan.contactOffsetTolerance=context.contactOffsetTolerance
                    plan.pitchInterpolated=model and model.pitchInterpolated==true or false
                    if plan.pitchInterpolated then plan.confidence="Interpolated measured tilt estimate"end
                    if model and (context.cornerOnly or context.dumpAttack)and context.rootHeight then
                        plan.contactInterpolated=math.abs(model.rootHeight-context.rootHeight)>0.4
                            or math.abs(model.verticalSpeed-context.verticalSpeed)>3
                        if plan.contactInterpolated then plan.confidence="Nearby measured contact estimate"end
                    end
                    if not evaluation.blocked then
                        local better=not best or score>best.score
                        if best and context.dumpAttack and plan.receiverCovered~=best.receiverCovered then better=not plan.receiverCovered
                        elseif best and context.preferLowTilt and(not context.softFlightMargins or math.abs(plan.safetyPenalty-best.safetyPenalty)<0.5)then
                            if plan.pitchInterpolated~=best.pitchInterpolated then better=not plan.pitchInterpolated
                            elseif math.abs(math.abs(pitch)-math.abs(best.pitch))>math.rad(0.25)then better=math.abs(pitch)<math.abs(best.pitch)end
                        end
                        if better then best=plan end
                    elseif evaluation.tool and(model or context.allowEstimatedTool)then
                        plan.shot="Tool attempt";plan.tool=evaluation.tool;plan.score=score-30
                        if not bestTool or plan.score>bestTool.score then bestTool=plan end
                    end
                end
            end
        end
        if context.preferTool and bestTool then return bestTool end
        if best then return best end
        if not context.dumpAttack and bestTool and (context.preferTool or (bestTool.tool and bestTool.tool.rebound and bestTool.tool.rebound.scoring)) then
            return bestTool
        end
        return nil
    end
    return planner
end

local function createSpikeCache(host)
    local fs=host.fs or {}
    local folder="BVLAssist/"..tostring(host.userId)
    local dumpSet=host.kind=="dump-set"
    local cache={Path=folder..(dumpSet and "/dump-set-calibration.json"or "/spike-calibration.json")}
    cache.Available=type(fs.readfile)=="function"and type(fs.writefile)=="function"and type(fs.makefolder)=="function"
    local function finite(value,limit)
        return type(value)=="number"and value==value and math.abs(value)<=limit
    end
    local function packVector(value,limit)
        if (type(value)~="table"and typeof(value)~="Vector3")or not finite(value.X,limit)or not finite(value.Y,limit)or not finite(value.Z,limit)then return nil end
        return {X=value.X,Y=value.Y,Z=value.Z}
    end
    local function packRow(row)
        if dumpSet then
            if type(row)~="table"or not finite(row.power,100)or row.power<=0
                or not finite(row.pitch,math.rad(80))or not finite(row.dumpCommandPitch,math.rad(20))
                or not finite(row.height,80)or row.height<=0 or not finite(row.horizontal,600)or row.horizontal<=0
                or not finite(row.vertical,600)or type(row.gliding)~="boolean"then return nil end
            return{power=row.power,pitch=row.pitch,dumpCommandPitch=row.dumpCommandPitch,height=row.height,
                horizontal=row.horizontal,vertical=row.vertical,gliding=row.gliding}
        end
        if type(row)~="table"or not finite(row.power,100)or row.power<=0
            or not finite(row.pitch,math.rad(80))or not finite(row.height,80)or row.height<=0
            or not finite(row.rootHeight,80)or not finite(row.verticalSpeed,200)then return nil end
        local velocity=packVector(row.velocity,600)
        local spin=packVector(row.spin,600)
        local acceleration=packVector(row.acceleration,600)
        if not velocity or velocity.Z<=0 or not spin or not acceleration then return nil end
        if row.gliding~=nil and type(row.gliding)~="boolean"or row.glideSpeed~=nil and(not finite(row.glideSpeed,200)or row.glideSpeed<0)then return nil end
        if row.contactLead~=nil and(not finite(row.contactLead,0.3)or row.contactLead<0.04)then return nil end
        if row.poseAtImpact~=nil and type(row.poseAtImpact)~="boolean"then return nil end
        if row.poseLag~=nil and(not finite(row.poseLag,0.25)or row.poseLag<0)then return nil end
        if row.contactPitch~=nil and not finite(row.contactPitch,math.rad(80))then return nil end
        return {power=row.power,pitch=row.pitch,height=row.height,rootHeight=row.rootHeight,
            verticalSpeed=row.verticalSpeed,contactLead=row.contactLead,poseAtImpact=row.poseAtImpact,poseLag=row.poseLag,contactPitch=row.contactPitch,
            commandPitch=finite(row.commandPitch,math.rad(80))and row.commandPitch or nil,
            velocity=velocity,spin=spin,acceleration=acceleration,gliding=row.gliding,glideSpeed=row.glideSpeed}
    end
    function cache.Load(scope,signature,character,now)
        if not cache.Available or not character then return {}end
        local ok,encoded=pcall(function()
            if fs.isfile and not fs.isfile(cache.Path)then return nil end
            return fs.readfile(cache.Path)
        end)
        if not ok or not encoded then return {}end
        local decoded,data=pcall(host.decode,encoded)
        if not decoded or type(data)~="table"or data.Version~=1 or type(data.Rows)~="table"
            or #data.Rows>48 or not finite(data.SavedAt,1e12)then
            cache.ReadError="Spike calibration file is unreadable; preserved existing file";return {}
        end
        if data.Scope~=scope or data.Signature~=signature then
            data=type(data.Banks)=="table"and data.Banks[scope.."::"..signature]or nil
            if not data then return {}end
            if type(data)~="table"or data.Scope~=scope or data.Signature~=signature or type(data.Rows)~="table"
                or #data.Rows>48 or not finite(data.SavedAt,1e12)then
                cache.ReadError="Saved build calibration is unreadable; preserved existing file";return {}
            end
        end
        local age=host.wallTime()-data.SavedAt
        if age<0 or age>86400 then return {}end
        local rows={}
        for _,value in ipairs(data.Rows)do
            local row=packRow(value)
            if not row or not finite(value.CapturedAt,1e12)then cache.ReadError="Spike calibration contains invalid samples; preserved existing file";return {}end
            local sampleAge=host.wallTime()-value.CapturedAt
            if sampleAge<0 or sampleAge>86400 then continue end
            if not dumpSet then
                for _,key in ipairs({"velocity","spin","acceleration"})do
                    local v=row[key];row[key]=Vector3.new(v.X,v.Y,v.Z)
                end
            end
            row.time=now;row.character=character;row.calibrationScope=scope;row.restored=true;row.capturedAt=value.CapturedAt
            rows[#rows+1]=row
        end
        return rows
    end
    function cache.Save(models,scope,signature,character)
        if not cache.Available then return false,"Executor storage unavailable; spike samples last for this session"end
        if cache.ReadError then return false,cache.ReadError end
        local rows={}
        for index=math.max(1,#models-47),#models do
            local model=models[index]
            if model.character==character and model.calibrationScope==scope then
                local row=packRow(model)
                if row then
                    model.capturedAt=model.capturedAt or host.wallTime()
                    if host.wallTime()-model.capturedAt>=0 and host.wallTime()-model.capturedAt<=86400 then
                        row.CapturedAt=model.capturedAt;rows[#rows+1]=row
                    end
                end
            end
        end
        if #rows==0 then return false,"No confirmed spike samples to save"end
        local ok,err=pcall(function()
            for _,directory in ipairs({"BVLAssist",folder})do
                if not fs.isfolder or not fs.isfolder(directory)then fs.makefolder(directory)end
            end
            local banks={}
            local old
            if fs.readfile and(not fs.isfile or fs.isfile(cache.Path))then
                local read,encoded=pcall(fs.readfile,cache.Path)
                if read then local decoded,value=pcall(host.decode,encoded);if decoded then old=value end end
            end
            if type(old)=="table"and old.Version==1 then
                for key,bank in pairs(type(old.Banks)=="table"and old.Banks or{})do
                    if type(bank)=="table"and type(bank.Rows)=="table"and #bank.Rows<=48 and finite(bank.SavedAt,1e12)then banks[key]=bank end
                end
                if type(old.Scope)=="string"and type(old.Signature)=="string"and type(old.Rows)=="table"and #old.Rows<=48
                    and finite(old.SavedAt,1e12)then
                    banks[old.Scope.."::"..old.Signature]={Scope=old.Scope,Signature=old.Signature,SavedAt=old.SavedAt,Rows=old.Rows}
                end
            end
            local current=scope.."::"..signature
            banks[current]={Scope=scope,Signature=signature,SavedAt=host.wallTime(),Rows=rows}
            local keys={};for key in pairs(banks)do keys[#keys+1]=key end
            table.sort(keys,function(a,b)
                if(a==current)~=(b==current)then return a==current end
                if banks[a].SavedAt~=banks[b].SavedAt then return banks[a].SavedAt>banks[b].SavedAt end
                return a<b
            end)
            for i=9,#keys do banks[keys[i]]=nil end
            fs.writefile(cache.Path,host.encode({Version=1,Scope=scope,Signature=signature,SavedAt=host.wallTime(),Rows=rows,Banks=banks}))
        end)
        return ok,not ok and tostring(err)or nil
    end
    return cache
end

local function createCodeRedeemer(host)
    local api={Running=false,LastRun=nil}
    local generation=0
    function api.Start()
        if api.Running then return false,"Code redemption is already running."end
        if not host.alive()then return false,"BVL Assist is unloaded."end
        local ok,service,available=pcall(host.native)
        if not ok or not service or type(service.Redeem)~="function"or type(available)~="table"then
            return false,"The native code service is not ready. Wait for the game to load, then try again."
        end
        local codes,seen={},{}
        for _,code in ipairs(available)do
            if type(code)=="string"and #code>=2 and #code<=30 and not code:find("%s")and not seen[code]then
                seen[code]=true;codes[#codes+1]=code
            end
        end
        table.sort(codes)
        if #codes==0 then return false,"The game currently lists no unexpired codes."end
        generation+=1
        local token=generation
        local run={submitted=0,redeemed=0,rejected=0,errors=0,total=#codes,status="Running",results={}}
        api.LastRun=run;api.Running=true
        host.spawn(function()
            local completed,failure=xpcall(function()
                for index,code in ipairs(codes)do
                    if token~=generation or not host.alive()then run.status="Cancelled";break end
                    local success,accepted,message=pcall(service.Redeem,service,code)
                    run.submitted+=1
                    run.results[#run.results+1]={code=code,success=success and accepted==true,
                        message=tostring(success and message or accepted),requestError=not success}
                    if not success then run.errors+=1
                    elseif accepted==true then run.redeemed+=1
                    else run.rejected+=1 end
                    if index<#codes then host.wait(1.5)end
                end
                if run.status=="Running"then run.status="Finished"end
            end,function(message)return tostring(message)end)
            if not completed then run.status="Submission failed";run.error=failure end
            if api.LastRun==run then api.Running=false end
            if host.alive()then
                host.notify(string.format("%s: %d redeemed, %d rejected, %d request errors (%d/%d checked).",
                    run.status,run.redeemed,run.rejected,run.errors,run.submitted,run.total))
            end
        end)
        return true,"Redeeming the game's current codes."
    end
    function api.Cancel()
        if api.Running then generation+=1 end
    end
    return api
end

local function createSetPreview(host)
    local api={Revision=0,Current=nil,Samples={},ContactSamples={}}
    local pending,pendingAt,lastSeen
    local function flat(v)return Vector3.new(v.X,0,v.Z)end
    local function angle(a,b)
        return math.atan2(a.X*b.Z-a.Z*b.X,a:Dot(b))
    end
    local function mode(plan)
        return tostring(plan.power)..":"..tostring(plan.launchAir)..":"..tostring(plan.launchBack)..":"..tostring(plan.launchGlide)
    end
    local function median(values)
        table.sort(values)
        local n=#values
        return n%2==1 and values[(n+1)/2]or (values[n/2]+values[n/2+1])/2
    end
    local function advanceContact(plan,delay)
        return plan.origin+plan.incomingVelocity*delay+plan.acceleration*(0.5*delay*(delay+1/60))
    end
    function api.ObserveContact(plan,actual,now)
        if not plan or plan.contactProjected and plan.phase~="Armed"or not plan.incomingVelocity or not plan.acceleration then return false end
        local best,error
        for i=0,90 do
            local delay=i/200
            local gap=(advanceContact(plan,delay)-actual.origin).Magnitude
            if not error or gap<error then best,error=delay,gap end
        end
        if error>0.75 or best>=(plan.contactProjected and 0.25 or 0.45)then return false end
        local shift=actual.launchAt and plan.launchAt and actual.launchAt-plan.launchAt
        if plan.contactProjected and shift and math.abs(shift)>0.2 then return false end
        api.ContactSamples[#api.ContactSamples+1]={air=plan.launchAir==true,time=now,delay=best,height=plan.origin.Y,
            projected=plan.contactProjected==true,key=mode(plan),incoming=plan.incomingVelocity.Unit,timeShift=shift}
        if #api.ContactSamples>48 then table.remove(api.ContactSamples,1)end
        return true
    end
    function api.CorrectContact(plan,now)
        if not plan or plan.contactProjected and plan.phase~="Armed"or not plan.incomingVelocity or not plan.acceleration then return plan end
