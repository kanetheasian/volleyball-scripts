        return close and not backRow,{hitterDistance=distance,nearbyLimit=net.halfWidth*0.7,receiveDepth=depth,attackLine=line,backRow=backRow}
    end
    function api.ChooseIntercept(ball,context,target,mode,playName,backward)
        if host.predictJump then context=table.clone(context);context.targetFacingPoint=target.position;context.backwardSet=backward end
        local planningStarted=host.now and host.now()or 0
        local function budgetSpent()return host.planningBudget and host.now()-planningStarted>=host.planningBudget end
        local boundedPlayer=playName=="Normal" and target.livePlayer and target.attackBand
