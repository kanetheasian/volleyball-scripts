    function Core.UpgradeReceiveMove(values)
        values=table.clone(values)
        if values.ReceiveMoveRevision==nil then
            for key,old in pairs({ReceiveMoveMinSpeed=55,ReceiveMoveMaxDistance=24,ReceiveMoveHorizon=2})do
                if values[key]==old then values[key]=Core.Schema[key][1]end
            end
            values.ReceiveMoveRevision=2
        end
        return values
    end
    function Core.Import(config, values)
        if type(values) ~= "table" then return false, "Invalid profile" end
        values=Core.UpgradeSpikeAim(Core.UpgradeReceiveMove(values))
        if values.ReceiveAim==true and values.ReceiveAimMode==nil then values.ReceiveAimMode="Teammate"end
        -- Upgrade the former default in old saved profiles; preserve deliberate new tuning.
        if type(values.ContactVolumes)=="boolean" then
            for _,key in ipairs({"SettingHitbox","SpikeHitbox","ReceiveHitbox"}) do if values[key]==nil then values[key]=values.ContactVolumes end end
        end
        local validated = {}
        for key in pairs(Core.Schema) do
            if values[key] ~= nil then
                local ok, value = Core.Validate(key, values[key])
                if not ok then return false, key .. ": " .. value end
                validated[key] = value
            end
        end
        for key, value in pairs(validated) do config[key] = value end
        if values.AutoSetPlayers==nil and values.AutoSetTarget and values.AutoSetTarget~="None" and values.AutoSetTarget~="" then config.AutoSetPlayers={values.AutoSetTarget}end
        return true
    end
    function Core.UpgradeSpikeAim(values)
        values=table.clone(values)
        if values.SpikeAimRevision~=3 then
            if values.AimMargin==nil or values.AimMargin==6 or values.SpikeAimRevision==nil and values.AimMargin==1.5 then values.AimMargin=2 end
            values.SpikeAimRevision=3
        end
        return values
    end
    function Core.CopyLaunchModels(models)
        local copy={}
        for key,rows in pairs(models or {})do
            if type(rows)=="table" and #rows>0 then
                copy[key]={}
                for index,row in ipairs(rows)do copy[key][index]=table.clone(row)end
            end
        end
        return copy
    end
    local touchKinds={Receive=true,Dive=true,Bump=true,Set=true,SetBack=true,Spike=true}
    function Core.TeamTouch(previous,event)
        if previous and event.packetTime and previous.packetTime and event.packetTime<previous.packetTime then return previous end
        if previous and event.packetTime and event.packetTime==previous.packetTime and event.owner==previous.owner and event.kind==previous.kind then return previous end
        local result=table.clone(event)
        result.revision=(previous and previous.revision or 0)+1
        if not event.team and previous and event.kind~="Base" and event.kind~="Floor" and event.kind~="Wall" and event.kind~="Block" then result.team=previous.team;result.court=previous.court end
        local same=previous and previous.team==result.team and previous.court==result.court
        local count=same and previous.teamTouches or 0
        if event.kind=="Serve" or event.kind=="Base" or event.kind=="Floor" or event.kind=="Wall" then count=0
        elseif touchKinds[event.kind] and event.team then count+=1 end
        result.teamTouches=count
        return result
    end
    function Core.AutoSetEligible(candidate,override)
        if candidate.used or candidate.ball._dying or candidate.ball._rolling then return false end
        if override then return true end
        if candidate.kind=="Block" then
            return not candidate.own and candidate.sameTeam==false and candidate.blockRebound==true
        end
        return not candidate.own and candidate.sameTeam==true and candidate.teamTouches==1 and touchKinds[candidate.kind]==true
    end
    function Core.ReturningBlock(ball,position,net)
        if not ball or not ball.Position or not ball.Velocity or not net then return false end
        local side=Core.Side(position,net)
        if not side then return false end
        local depth=(ball.Position-net.center):Dot(net.normal)*side
        local velocity=ball.Velocity:Dot(net.normal)*side
        return depth>=0 or velocity>0.01
    end
    function Core.PowerText(value)
        if not Core.Finite(value) or value<0 then return nil end
        return "P"..string.format("%.0f",value)
    end
    function Core.RecordPlayerPower(samples,owner,character,value,now)
        if not owner then return false end
        if not character or not Core.Finite(value) or value<0 or not Core.Finite(now) then
            samples[owner]=nil
            return false
        end
        samples[owner]={character=character,value=value,at=now,source="replicated_hit"}
        return true
    end
    function Core.ObservedPowerText(sample,character,now)
        if not sample or sample.source~="replicated_hit" or not character or sample.character~=character
            or not Core.Finite(now) or not Core.Finite(sample.at) or now<sample.at or now-sample.at>8 then return nil end
        return Core.PowerText(sample.value)
    end
    function Core.ServeSpinPoint(config)
        if config.ServeSpinPreset=="Float" then return 0.5,0.5 end
        local side=config.ServeSpinPreset=="Topspin Left" and -1 or 1
        return math.clamp(0.5+side*config.ServeSpinSideOffset,0,1),
            math.clamp(0.5+config.ServeSpinVerticalOffset,0,1)
    end
    function Core.StepServeSpin(spin,config)
        if not spin or not spin.X or not spin.Y or not spin.Complete or type(spin.Activate)~="function" then
            return false,"Serve minigame unavailable"
        end
        if spin.Complete.Value then return false,"Serve spin already selected" end
        local x,y=Core.ServeSpinPoint(config)
        local before={x=spin.X.Value,y=spin.Y.Value}
        spin.X.Value=x
        if not spin._horizontalLock then
            spin:Activate()
            return true,{x=x,y=y,before=before,preset=config.ServeSpinPreset,phase="horizontal"}
        end
        spin.Y.Value=y
        spin:Activate()
        if not spin.Complete.Value then return false,"Native minigame did not complete" end
        return true,{x=x,y=y,before=before,preset=config.ServeSpinPreset,phase="complete"}
    end
    function Core.ServeSourceEligible(viewer, source, net)
        local offset=source-net.courtCenter
        local ownSide,sourceSide=Core.Side(viewer,net),Core.Side(source,net)
        return ownSide~=nil and sourceSide~=nil and ownSide~=sourceSide
            and math.abs(offset:Dot(net.axis))<=net.halfWidth+20
            and math.abs(offset:Dot(net.normal))<=net.halfDepth+30
    end
    function Core.KeepServeFacing(lastReady,now,ready,grace)
        return ready==true or (lastReady~=nil and now>=lastReady and now-lastReady<=grace)
    end
    function Core.SpawnServeReady(ball,creator,source,touched)
        if not ball or not creator or ball.Creator~=creator or touched or ball._lastHit or ball._dying or ball._rolling or ball._filtered
            or not ball.Position or not source then return false end
        local offset=ball.Position-source
        return Vector3.new(offset.X,0,offset.Z).Magnitude<=8 and offset.Y>=-2 and offset.Y<=30
    end
    function Core.ServeFacingSegment(source,look,floorY,length)
        local direction=Vector3.new(look.X,0,look.Z)
        if direction.Magnitude<0.001 or length<=0 then return nil end
        local start=Vector3.new(source.X,floorY+0.13,source.Z)
        return start,start+direction.Unit*length
    end
    function Core.SpikeDirectionSegment(position,look,length)
        local heading=look
        if heading.Magnitude<0.001 or not Core.Finite(length) or length<=0 then return nil end
        return position,position+heading.Unit*length
    end
    function Core.HeadingError(current,point)
        local desired=Vector3.new(point.X-current.Position.X,0,point.Z-current.Position.Z)
        local look=Vector3.new(current.LookVector.X,0,current.LookVector.Z)
        if desired.Magnitude<0.01 or look.Magnitude<0.01 then return 180 end
        return math.deg(math.acos(math.clamp(look.Unit:Dot(desired.Unit),-1,1)))
    end
    function Core.ReceiveAimReady(config,started,errorDegrees,now,eta,responseLead)
        local urgent=eta~=nil and responseLead~=nil and eta<=responseLead
        return started~=nil and errorDegrees<=config.ReceiveAimMaxError and (urgent or now-started>=config.ReceiveAimSettleSeconds)
    end
    -- Restore inherited methods as inherited methods; never overwrite a later owner's patch.
    function Core.Patch(object, key, makeWrapper)
        local own, original = rawget(object, key), object[key]
        assert(type(original) == "function", "Missing native method " .. key)
        local wrapper = makeWrapper(original)
        object[key] = wrapper
        local released = false
        return function()
            if released then return end
            released = true
            if rawget(object, key) == wrapper then object[key] = own end
        end
    end
    function Core.JumpPower(nativePower, enabled, multiplier)
        if not enabled or not Core.Finite(nativePower) or nativePower <= 0 then return nativePower end
        return nativePower * math.sqrt(multiplier)
    end
    function Core.FlatFacing(position, target, backward)
        local direction = Vector3.new(target.X - position.X, 0, target.Z - position.Z)
        if direction.Magnitude < 0.01 then return nil end
        return CFrame.lookAt(position, position + direction * (backward and -1 or 1))
    end
    local function flat(v) return Vector3.new(v.X, 0, v.Z) end
    function Core.Side(position, net)
        local side = flat(position-net.center):Dot(net.normal)
        return math.abs(side)>=0.15 and math.sign(side) or nil
    end
    function Core.MiddleReceivePoint(position,net,depth)
        local side=net and Core.Side(position,net)
        if not side then return nil end
        local attack=net.attackLines and net.attackLines[side]
        local maximum=math.max(2,math.min(net.halfDepth-1,attack and attack*0.75 or 12))
        local point=net.center+net.normal*side*math.clamp(depth or 6,2,maximum)
        return Vector3.new(point.X,position.Y,point.Z)
    end
    function Core.InCourt(position, net, margin)
        local offset = flat(position-net.courtCenter)
        return math.abs(offset:Dot(net.axis)) <= net.halfWidth-(margin or 0)+0.0001
            and math.abs(offset:Dot(net.normal)) <= net.halfDepth-(margin or 0)+0.0001
    end
    function Core.NearbySpikeCourt(position,courts,maximum)
        local best,distance,second
        for _,net in ipairs(courts)do
            if Core.InCourt(position,net)then return net end
            local offset=flat(position-net.courtCenter)
            local across=math.max(0,math.abs(offset:Dot(net.axis))-net.halfWidth)
            local deep=math.max(0,math.abs(offset:Dot(net.normal))-net.halfDepth)
            local gap=math.sqrt(across*across+deep*deep)
            if gap<=(maximum or 10)then
                if not distance or gap<distance then second=distance;best,distance=net,gap
                elseif not second or gap<second then second=gap end
            end
        end
        return best and (not second or second-distance>0.5) and best or nil
    end
    function Core.SetAimPoint(position, net, origin, inset)
        local side = Core.Side(origin,net)
        if not side then return nil end
        local along = math.clamp(flat(position-net.center):Dot(net.axis),-net.halfWidth,net.halfWidth)
        return net.center + net.axis*along + net.normal*side*math.clamp(inset or 0.2,0,net.halfDepth-1)
    end
    function Core.NormalSetPoint(position,net,origin)
        local point=Core.SetAimPoint(position,net,origin,Core.SetPlays.Normal.netInset)
        if not point then return nil end
        return Vector3.new(point.X,(net.topY or net.center.Y)+Core.SetPlays.Normal.contactLift,point.Z)
    end
    function Core.PlayerAttackBand(groundCenter,jumpRise,radius,netTop,ballRadius,heightLift)
        local center=groundCenter+math.clamp(jumpRise,0,20)
        local lift=math.clamp(heightLift or 0,0,1.5)
        local baseMinimum=math.max(netTop+(ballRadius or 1.1)+0.5,center+radius*0.65)
        local maximum=math.max(baseMinimum,center+radius+(ballRadius or 1.1)*0.35)
        local minimum=math.min(maximum,baseMinimum+lift)
        return {minimum=minimum,ideal=math.clamp(center+radius*0.95+lift,minimum,maximum),maximum=maximum,center=center}
    end
    function Core.AntennaTop(net,parts)
        local tops={}
        local edge=net.part and net.part.Size.X/2 or net.halfWidth
        for _,part in ipairs(parts)do
            local f,s=part.CFrame,part.Size
            local height=math.abs(f.RightVector.Y)*s.X+math.abs(f.UpVector.Y)*s.Y+math.abs(f.LookVector.Y)*s.Z
            local width=math.abs(f.RightVector:Dot(net.axis))*s.X+math.abs(f.UpVector:Dot(net.axis))*s.Y+math.abs(f.LookVector:Dot(net.axis))*s.Z
            local thick=math.abs(f.RightVector:Dot(net.normal))*s.X+math.abs(f.UpVector:Dot(net.normal))*s.Y+math.abs(f.LookVector:Dot(net.normal))*s.Z
            local offset=part.Position-net.center
            local across=offset:Dot(net.axis)
            local top=part.Position.Y+height/2
            if width<=0.6 and thick<=0.6 and height>=0.5 and top>net.topY+1.5
                and math.abs(offset:Dot(net.normal))<0.4 and math.abs(across)>=math.max(net.halfWidth-1,edge-4)
                and math.abs(across)<=edge+1 then
                local side=math.sign(across);tops[side]=math.max(tops[side]or -math.huge,top)
            end
        end
        if tops[-1]and tops[1]and math.abs(tops[-1]-tops[1])<=0.5 then return math.max(tops[-1],tops[1])end
    end
    function Core.UpperAttackBand(band,antennaTop,ballRadius)
        local result=table.clone(band)
        result.recoveryMinimum=band.minimum
        result.preferredMinimum=math.max(band.minimum,band.ideal-0.5,antennaTop and antennaTop+0.15 or -math.huge)
        result.minimum=math.min(band.maximum,result.preferredMinimum)
        result.ideal=math.clamp(math.max(band.ideal,result.minimum),result.minimum,result.maximum)
        result.heightLimited=result.preferredMinimum>band.maximum
        result.unreachable=band.minimum>band.maximum
        return result
    end
    function Core.SampleHitterReach(reach,grounded,centerY,groundY,rootY,velocityY,gravity,defaultRise)
        reach=reach or {}
        defaultRise=math.clamp(defaultRise or 7.2,0,20)
        reach.groundCenter=reach.groundCenter or centerY-math.max(0,rootY-groundY)
        if grounded then
            reach.groundCenter=centerY
            if reach.airRise then
                local history=reach.recentRises or {defaultRise,defaultRise}
                history[#history+1]=math.clamp(reach.airRise,0,20)
                if #history>3 then table.remove(history,1)end
                reach.recentRises=history
                local sorted=table.clone(history);table.sort(sorted)
                reach.jumpRise=sorted[math.ceil(#sorted/2)]
                reach.airRise=nil
            end
        else
            local rise=centerY-reach.groundCenter
            if rise>0.75 then
                local projected=rise+math.max(0,velocityY)^2/(2*math.max(1,gravity))
                reach.airRise=math.max(reach.airRise or 0,projected)
            end
        end
        reach.jumpRise=reach.jumpRise or defaultRise
        return reach
    end
    function Core.SampleBotMotion(previous,object,position,now)
        local points={}
        if previous and previous.object==object and now-previous.time<=0.35
            and flat(position-previous.position).Magnitude<=8 then
            for _,p in ipairs(previous.points)do if now-p.time<=0.55 then points[#points+1]=p end end
        else previous=nil end
        local last=points[#points]
        if not last or flat(position-last.position).Magnitude>0.005 or now-last.time>=0.2 then
            points[#points+1]={position=flat(position),time=now}
        end
        local velocity,acceleration=Vector3.zero,Vector3.zero
        last=points[#points]
        if #points>=3 and last.time-points[1].time>=0.15 then
            local sums={0,0,0,0,0};local ys={Vector3.zero,Vector3.zero,Vector3.zero}
            for _,p in ipairs(points)do
                local t=p.time-last.time;local power=1
                for i=1,5 do sums[i]+=power;if i<=3 then ys[i]+=p.position*power end;power*=t end
            end
            local m={{sums[1],sums[2],sums[3]},{sums[2],sums[3],sums[4]},{sums[3],sums[4],sums[5]}}
            local valid=true
            for col=1,3 do
                local pivot=m[col][col]
                if math.abs(pivot)<1e-8 then valid=false;break end
                for j=col,3 do m[col][j]/=pivot end;ys[col]/=pivot
                for row=1,3 do if row~=col then
                    local factor=m[row][col]
                    for j=col,3 do m[row][j]-=factor*m[col][j]end;ys[row]-=ys[col]*factor
                end end
            end
            if valid then
                acceleration=ys[3]*2
                if acceleration.Magnitude>8 then acceleration=acceleration.Unit*8 end
                velocity=ys[2]+acceleration*math.min(0.15,now-last.time)
            end
        elseif #points>=2 then
            local first=points[1];local dt=last.time-first.time
            if dt>0 then velocity=(last.position-first.position)/dt end
        end
        if velocity.Magnitude>45 then velocity=Vector3.zero;acceleration=Vector3.zero end
        if now-last.time>0.2 then velocity=Vector3.zero;acceleration=Vector3.zero end
        return {object=object,position=position,time=now,points=points,velocity=velocity,acceleration=acceleration}
    end
    function Core.LimitAirTurn(current,anchor,desired,dt,rate,limit)
        local a=flat(anchor.LookVector).Unit
        local b=flat(current.LookVector).Unit
        local d=flat(desired.LookVector).Unit
        local function angle(x,y)return math.atan2(x:Cross(y).Y,math.clamp(x:Dot(y),-1,1))end
        local nowAngle=angle(a,b)
        local desiredAngle=math.clamp(angle(a,d),-math.rad(limit),math.rad(limit))
        local step=math.rad(rate)*math.clamp(dt,0,0.1)
        local nextAngle=nowAngle+math.clamp(desiredAngle-nowAngle,-step,step)
        local frame=CFrame.lookAt(current.Position,current.Position+a)*CFrame.Angles(0,nextAngle,0)
        local result=Core.YawOnlyFrame(current,current.Position+frame.LookVector)
        return result,math.abs(angle(frame.LookVector,d))>math.rad(0.5)
    end
    function Core.QuickSetPoint(position,net,origin,velocity,spikeRadius)
        local point=Core.SetAimPoint(position,net,origin,Core.SetPlays.Quick.netInset)
        if not point then return nil end
        local side=Core.Side(origin,net)
        local depth=side and (position-net.center):Dot(net.normal)*side
        local line=side and net.attackLines and net.attackLines[side]
        if depth and depth>0 and (not line or depth<line)then
            local forward=math.min(0,(velocity or Vector3.zero):Dot(net.normal)*side)*0.25
            local clearance=math.clamp((spikeRadius or 3.5)*0.5,1.5,2.5)
            local attackDepth=math.min(Core.SetPlays.Quick.netInset,math.max(0.25,depth+forward-clearance))
            attackDepth=math.min(attackDepth,math.max(0.25,depth-0.25))
            local lateral=(position-net.center):Dot(net.axis)
            point=net.center+net.axis*math.clamp(lateral,-net.halfWidth,net.halfWidth)+net.normal*side*attackDepth
        end
        return Vector3.new(point.X,(net.topY or net.center.Y)+Core.SetPlays.Quick.contactLift,point.Z)
    end
    function Core.CreateSetPlanner(config)
        local planner={Config=config}
        planner.SetAimPoint=function(position,net,origin) return Core.SetAimPoint(position,net,origin,config.SetNetInset) end
        installSetTargetLead(planner)
        return planner
    end
    -- Same edge candidates and openness score used by VRS's takeoff target selection.
    function Core.EdgeTargets(origin, net, margin)
        local side = Core.Side(origin,net)
        if not side then return {} end
        margin = math.max(margin or 1.5,1.25)
        local targets = {}
        if net.halfWidth<=margin or net.halfDepth<=margin*2 then return targets end
        for _,edge in ipairs({-1,1}) do
            for _,fraction in ipairs({0.08,0.18,0.28,0.55,0.82}) do
                targets[#targets+1] = {edge=edge,point=net.center + net.axis*(edge*(net.halfWidth-margin))
                    -net.normal*(side*math.clamp(net.halfDepth*fraction,margin,net.halfDepth-margin))}
            end
        end
        return targets
    end
    -- A point inside the court is not sufficient: the shot continues along its heading.
    -- Bound that heading at both the net and far baseline; between them X is linear.
    function Core.SpikeCourtCorridor(origin,heading,net,margin,ownSide)
        local side=ownSide or Core.Side(origin,net)
        if not side then return nil end
        local direction=flat(heading)
        if direction.Magnitude<0.001 then return nil end
        direction=direction.Unit
        local forward=-direction:Dot(net.normal)*side
        if forward<=0.001 then return nil end
        local depth=flat(origin-net.center):Dot(net.normal)*side
        local along=flat(origin-net.center):Dot(net.axis)
        local lateral=direction:Dot(net.axis)
        local xNet=along+lateral*depth/forward
        local xBack=along+lateral*(depth+net.halfDepth)/forward
        local width=net.halfWidth-(margin or 6)
        if width<=0 or math.abs(xNet)>width+0.0001 or math.abs(xBack)>width+0.0001 then return nil end
        return {netX=xNet,backX=xBack,clearance=net.halfWidth-math.max(math.abs(xNet),math.abs(xBack)),
            netDistance=depth/forward,backDistance=(depth+net.halfDepth)/forward}
    end
    function Core.SpikeNetEntry(origin,heading,net,margin,side)
        side=side or Core.Side(origin,net)
        local direction=flat(heading)
        if not side or direction.Magnitude<0.001 then return nil end
        direction=direction.Unit
        local forward=-direction:Dot(net.normal)*side
        if forward<=0.001 then return nil end
        local offset=flat(origin-net.center)
        local depth=offset:Dot(net.normal)*side
        local x=offset:Dot(net.axis)+direction:Dot(net.axis)*depth/forward
        local width=net.halfWidth-(margin or 6)
        if width<=0 or math.abs(x)>width+0.0001 then return nil end
        return {netX=x,clearance=net.halfWidth-math.abs(x),netDistance=depth/forward}
    end
    function Core.CourtSpikeTarget(origin,net,defenders,margin,opponents,ownSide,originMargin)
        local side=ownSide or Core.Side(origin,net)
        margin=margin or 6
        if not side or not Core.InCourt(origin,net,-(originMargin or 0)) or net.halfWidth<=margin or net.halfDepth<=margin*2 then return nil end
        local best,score
        local ownDepth=flat(origin-net.center):Dot(net.normal)*side
        local goalDepth=math.clamp(net.halfDepth*0.90,margin,net.halfDepth-margin)
        local along=flat(origin-net.center):Dot(net.axis)
        local outside=not Core.InCourt(origin,net)
        for _,fraction in ipairs({-1,1,-0.8,0.8,-0.45,0.45,0}) do
            for _,depth in ipairs(outside and {margin,math.max(margin,net.halfDepth*0.12),math.max(margin,net.halfDepth*0.28),goalDepth}or{goalDepth})do
            local xBack=fraction*(net.halfWidth-margin)
            local x=outside and xBack or along+(xBack-along)*(ownDepth+goalDepth)/(ownDepth+net.halfDepth)
            local point=net.center+net.axis*x-net.normal*side*depth
            local corridor
            if outside then corridor=Core.SpikeNetEntry(origin,point-origin,net,margin,side)
            else corridor=Core.SpikeCourtCorridor(origin,point-origin,net,margin,side)end
            local goal={edge=math.sign(xBack),point=point,corridor=corridor,margin=margin,
                shot=outside and "Sideline cross"or math.abs(fraction)>=0.8 and "Deep corner" or "Open lane",
                source=outside and "Sideline takeoff fallback"or "Takeoff edge fallback",
                confidence="Uncalibrated heading estimate",calibrated=false}
            if corridor and Core.InCourt(point,net,margin) then
            local openness = 50
            for _,position in ipairs(defenders) do openness=math.min(openness,flat(position-goal.point).Magnitude) end
            local blockRisk=0
            for _,other in ipairs(opponents or {})do
                if other.blocking then
                    local block=other.blockPosition or other.position
                    local blockX=(block-net.center):Dot(net.axis)
                    local blockDepth=-(block-net.center):Dot(net.normal)*side
                    local rayX=along+(x-along)*(ownDepth+blockDepth)/(ownDepth+depth)
                    if blockDepth>=-3 and blockDepth<=12 and math.abs(rayX-blockX)<(other.blockWidth or 5)/2+1.5 then blockRisk+=100 end
                end
            end
            local value = openness*0.7-flat(goal.point-origin).Magnitude*0.025+math.abs(fraction)*8-blockRisk
            if not score or value>score then best,score=goal,value end
            end
            end
        end
        return best
    end
    function Core.SpikeContact(ball,stepPhysics,hand,velocity,jumpPower,gravity,radius,takeoff)
        local best,bestScore
        local sim=table.clone(ball)
        sim.Acceleration=ball.Acceleration or Vector3.zero;sim.Spin=ball.Spin or Vector3.zero
        local vertical=takeoff and jumpPower or velocity.Y
        local horizon=takeoff and math.clamp(2*jumpPower/math.max(1,gravity),0.24,1.4) or 0.24
        local dt=1/60
        for index=0,math.ceil(horizon/dt)do
            local eta=math.min(index*dt,horizon)
            local predictedHand=hand+Vector3.new(velocity.X,0,velocity.Z)*eta
                +Vector3.yAxis*(vertical*eta-gravity*eta*eta/2)
            local gap=(sim.Position-predictedHand).Magnitude
            local score=gap+eta*0.15
            if gap<=radius and (not bestScore or score<bestScore)then
                best={position=sim.Position,eta=eta,gap=gap};bestScore=score
            end
            if index*dt>=horizon then break end
            sim.Position,sim.Velocity=stepPhysics(sim,math.min(dt,horizon-index*dt))
        end
        return best
    end
    function Core.YawOnlyFrame(current,point)
        local facing = Core.FlatFacing(current.Position,point,false)
        local previous = flat(current.LookVector)
        if not facing or previous.Magnitude<0.001 then return nil end
        local oldYaw = CFrame.lookAt(Vector3.zero,previous.Unit)
        return facing * oldYaw:Inverse() * (current-current.Position)
    end
    -- Continuous sweep prevents a fast spike crossing a whole hitbox between samples.
    function Core.SegmentBoxEntry(a,b,frame,size,radius,minimum,maximum)
        a,b=frame:PointToObjectSpace(a),frame:PointToObjectSpace(b)
        local delta,lo,hi=b-a,minimum or 0,maximum or 1
        for _,axis in ipairs({"X","Y","Z"}) do
            local half=size[axis]/2+(radius or 0)
            if math.abs(delta[axis])<1e-8 then
                if math.abs(a[axis])>half then return nil end
            else
                local enter,leave=(-half-a[axis])/delta[axis],(half-a[axis])/delta[axis]
                if enter>leave then enter,leave=leave,enter end
                lo,hi=math.max(lo,enter),math.min(hi,leave)
                if lo>hi then return nil end
            end
        end
        return lo
    end
    -- Exact swept sphere vs box, including rounded corners of the Minkowski sum.
    function Core.SphereBoxEntry(a,b,frame,size,radius,minimum,maximum)
        a,b=frame:PointToObjectSpace(a),frame:PointToObjectSpace(b)
        local delta,half=b-a,size/2
        local lo,hi=minimum or 0,maximum or 1
        if lo>hi then return nil end
        local times={lo,hi}
        for _,axis in ipairs({"X","Y","Z"}) do
            if math.abs(delta[axis])>1e-9 then
                for _,sign in ipairs({-1,1}) do
                    local t=(sign*half[axis]-a[axis])/delta[axis]
                    if t>lo and t<hi then times[#times+1]=t end
                end
            end
        end
        table.sort(times)
        for i=1,#times-1 do
            local first,last=times[i],times[i+1]
            local middle=(first+last)/2
            local aa,bb,cc=0,0,-radius*radius
            for _,axis in ipairs({"X","Y","Z"}) do
                local position=a[axis]+delta[axis]*middle
                if math.abs(position)>half[axis] then
                    local offset=a[axis]-math.sign(position)*half[axis]
                    aa+=delta[axis]^2;bb+=2*offset*delta[axis];cc+=offset^2
                end
            end
            if aa*first*first+bb*first+cc<=1e-8 then return first end
            if aa>1e-9 then
                local discriminant=bb*bb-4*aa*cc
                if discriminant>=0 then
                    local t=(-bb-math.sqrt(discriminant))/(2*aa)
                    if t>=first-1e-8 and t<=last+1e-8 then return math.clamp(t,first,last) end
                end
            end
        end
        return nil
    end
    function Core.DiveResponseLead(config,ping,dt)
        return math.clamp(math.clamp(ping or 0,0,0.2)+math.clamp(dt or 1/60,1/240,0.05)
            +config.DiveLatencyPadding,0.025,config.DiveMaxResponseLead)
    end
    -- BVL holds launch velocity for LAUNCH_COAST then TimedTween decays linearly.
    function Core.DiveTravel(speed,coast,decay,time)
        local t=math.max(0,time)
        local after=math.clamp(t-coast,0,decay)
        return speed*(math.min(t,coast)+after-after*after/(2*decay))
    end
    function Core.SphereNearPart(part, point, radius, extra)
        local p, half = part.CFrame:PointToObjectSpace(point), part.Size / 2
        local x = math.max(math.abs(p.X) - half.X, 0)
        local y = math.max(math.abs(p.Y) - half.Y, 0)
        local z = math.max(math.abs(p.Z) - half.Z, 0)
        return x*x + y*y + z*z <= (radius + (extra or 0))^2
    end
    -- Use the game's step function on a COPY, including spin. Never advance the live ball table.
    function Core.Predict(ball, stepPhysics, seconds, floorY, timeStep)
        local dt = timeStep or 1/60
        local sim = {Position = ball.Position, Velocity = ball.Velocity,
            Acceleration = ball.Acceleration or Vector3.zero, Spin = ball.Spin or Vector3.zero}
        local points, elapsed, landing, landingTime = {sim.Position}, 0, nil, nil
        if sim.Position.Y <= floorY and sim.Velocity.Y <= 0 then
            return {Points = points, Landing = Vector3.new(sim.Position.X, floorY, sim.Position.Z), Time = 0}
        end
        for _ = 1, math.ceil(seconds / dt) do
            local h = math.min(dt, seconds - elapsed)
            if h <= 0 then break end
            local previous = sim.Position
            local position, velocity = stepPhysics(sim, h)
            if previous.Y >= floorY and position.Y <= floorY then
                local alpha = math.clamp((previous.Y - floorY) / math.max(previous.Y - position.Y, 1e-8), 0, 1)
                landing = previous:Lerp(position, alpha)
                landingTime = elapsed + h * alpha
                points[#points + 1] = landing
                break
            end
            sim.Position, sim.Velocity = position, velocity
            elapsed += h
            points[#points + 1] = position
        end
        return {Points = points, Landing = landing, Time = landingTime}
    end
    function Core.AdvanceBall(ball,stepPhysics,seconds)
        local copy=table.clone(ball)
        copy.Acceleration=ball.Acceleration or Vector3.zero
        copy.Spin=ball.Spin or Vector3.zero
        local elapsed=0
        while elapsed<seconds do
            local dt=math.min(1/120,seconds-elapsed)
            copy.Position,copy.Velocity=stepPhysics(copy,dt)
            elapsed+=dt
        end
        return copy
    end
    function Core.ReceiveResponseLead(config,ping,dt)
        return math.clamp(config.ReactionLead+math.clamp(ping or 0,0,0.2)
            +2*math.clamp(dt or 1/60,1/240,0.05)+(config.ReceiveActivationPadding or 0.035)+(config.BallLeadSeconds or 0)
            +(config.ReceiveTurnLead or 0.12),0.06,0.45)
    end
    function Core.ReceiveFacingFrame(rootFrame,receiveFrame,cameraLook,targetPoint)
        local point=targetPoint
        if not point and cameraLook then point=rootFrame.Position+flat(cameraLook)end
        local facing=point and Core.YawOnlyFrame(rootFrame,point)
        return facing and facing*rootFrame:ToObjectSpace(receiveFrame) or receiveFrame
    end
    function Core.PlanReceiveMove(config,context,ball,stepPhysics)
        if not config.AutoReceive or not config.AutoReceiveMove or not context.ready or not context.receive or not context.net
            or context.ownTouch or ball._dying or ball._rolling then return nil,"movement unavailable" end
        local kind=context.kind
        if kind=="Base"or kind=="Floor"or kind=="Wall"then
            return nil,"rally surface contact"
        end
        local net,origin=context.net,context.rootPosition
        local side=Core.Side(origin,net)
        local speed=context.speed or 0
        if not side or speed<=0 then return nil,"movement unavailable" end
        local floor=(context.floorY or net.floorY)+(ball.Radius or 1)
        if ball.Position.Y<=floor then return nil,"grounded" end
        local sim={Position=ball.Position,Velocity=ball.Velocity,Acceleration=ball.Acceleration or Vector3.zero,Spin=ball.Spin or Vector3.zero}
        local offset=context.receive.CFrame.Position-origin
        local halfY=context.receive.Size.Y/2+(ball.Radius or 1)
        local margin=context.margin or 1.25
        local best,pursuit
        local dt=1/120
        for index=1,math.ceil(config.ReceiveMoveHorizon/dt)do
            local previous=sim.Position
            sim.Position,sim.Velocity=stepPhysics(sim,dt)
            local point,time=sim.Position,index*dt
            if point.Y<=floor then break end
            local upper=context.receive.CFrame.Position.Y+halfY
            if previous.Y>upper and point.Y<=upper then
                local fraction=(previous.Y-upper)/math.max(previous.Y-point.Y,1e-8)
                point=previous:Lerp(point,fraction);time=(index-1+fraction)*dt
            elseif previous.Y>context.receive.CFrame.Position.Y and point.Y<=context.receive.CFrame.Position.Y then
                local fraction=(previous.Y-context.receive.CFrame.Position.Y)/math.max(previous.Y-point.Y,1e-8)
                point=previous:Lerp(point,fraction);time=(index-1+fraction)*dt
            end
            local a,b=(previous-net.center):Dot(net.normal)*side,(point-net.center):Dot(net.normal)*side
            if a<0 and b>=0 then
                local crossing=previous:Lerp(point,-a/(b-a))
                if math.abs((crossing-net.center):Dot(net.axis))<=net.halfWidth+(ball.Radius or 1)
                    and crossing.Y<=net.topY+(ball.Radius or 1)then return nil,"net blocks ball"end
            end
            if b>0 and sim.Velocity.Y<=0 and math.abs(point.Y-context.receive.CFrame.Position.Y)<=halfY then
                local target=point-offset
                local delta=flat(target-net.center)
                local x=math.clamp(delta:Dot(net.axis),-net.halfWidth+margin,net.halfWidth-margin)
                local z=math.clamp(delta:Dot(net.normal)*side,math.max(2,margin),net.halfDepth-margin)*side
                target=net.center+net.axis*x+net.normal*z
                target=Vector3.new(target.X,origin.Y,target.Z)
                local distance=flat(target-origin).Magnitude
                local buffer=math.max(0.06,2*(context.dt or 1/60))
                local travel=distance/speed+buffer
                local translated={CFrame=CFrame.new(target-origin)*context.receive.CFrame,Size=context.receive.Size}
                local centerError=flat(point-translated.CFrame.Position).Magnitude
                if distance<=config.ReceiveMoveMaxDistance and centerError<=0.35 and Core.InCourt(target,net,margin)
                    and Core.SphereNearPart(translated,point,ball.Radius or 1,-0.25)then
                    local heightError=math.abs(point.Y-translated.CFrame.Position.Y)
                    local score=context.probe and travel/math.max(time,0.01)+heightError*0.1 or heightError*4+time*0.1+travel*0.05
                    local candidate={Point=target,Contact=point,ETA=time,Travel=travel,Distance=distance,Score=score,
                        CenterError=centerError,HeightError=heightError,Reachable=travel<=time,ReachPending=travel>time}
                    if context.probe or travel<=time then
                        if not best or score<best.Score then best=candidate end
                    elseif not pursuit or score<pursuit.Score then
                        pursuit=candidate
                    end
                end
            end
        end
        return best or pursuit,best and "centered receive intercept" or pursuit and "Pursuing receive center • late arrival predicted" or "no receive-center path on own court"
    end
    function Core.ReceiveMoveDirection(position,target,speed,dt)
        local delta=flat(target-position)
        if delta.Magnitude<=0.15 then return Vector3.zero end
        return delta.Unit*math.min(1,delta.Magnitude/math.max(0.5,math.max(0,speed or 0)*math.clamp(dt or 1/60,1/240,0.05)*1.5))
    end
    function Core.PlanDefense(config,context,ball,stepPhysics)
        if not context.ready or not context.net or ball._dying or ball._rolling or context.ownTouch then return nil,"unavailable" end
        local net,origin=context.net,context.rootPosition
        local side=Core.Side(origin,net)
        if not side then return nil,"net center" end
        local speed=ball.Velocity.Magnitude
        local incoming=flat(ball.Position-origin):Dot(flat(ball.Velocity))<0 or ball.Velocity.Y< -1
        if speed<0.1 or not incoming then return nil,"not incoming" end
        if (ball.Position-origin).Magnitude>math.max(36,speed*config.DiveHorizon+config.DiveRange+12) then return nil,"too far" end
        local floor=context.floorY+(ball.Radius or 1)
        if ball.Position.Y<=floor then return nil,"grounded" end
        local response=Core.DiveResponseLead(config,context.ping,context.dt)
        local receiveLead=Core.ReceiveResponseLead(config,context.ping,context.dt)
        local sim={Position=ball.Position,Velocity=ball.Velocity,Acceleration=ball.Acceleration or Vector3.zero,Spin=ball.Spin or Vector3.zero}
        local time,receive,dive=0,nil,nil
        local geometry=context.dive
        local function receiveMotion(time)
            if context.receiveMovePoint then
                local delta=flat(context.receiveMovePoint-origin)
                local length=delta.Magnitude
                if length<0.01 then return Vector3.zero end
                return delta.Unit*math.min(length,math.max(0,context.speed or 0)*time)
            end
            return (context.motion or Vector3.zero)*time
        end
        while time<config.DiveHorizon do
            local dt=math.min(1/120,config.DiveHorizon-time)
            local a=sim.Position
            local b,velocity=stepPhysics(sim,dt)
            local finish=time+dt
            local grounded=b.Y<=floor
            if grounded then local alpha=math.clamp((a.Y-floor)/math.max(a.Y-b.Y,1e-8),0,1);b=a:Lerp(b,alpha);finish=time+dt*alpha end
            local sa=flat(a-net.center):Dot(net.normal)*side
            local sb=flat(b-net.center):Dot(net.normal)*side
            if sa<0 and sb>=0 then
                local cross=a:Lerp(b,-sa/(sb-sa))
                if math.abs(flat(cross-net.center):Dot(net.axis))<=net.halfWidth+(ball.Radius or 1)
                    and cross.Y<=net.topY+(ball.Radius or 1) then return nil,"net blocks ball" end
            end
            local lo,hi=0,1
            if sa<=0.05 and sb<=0.05 then lo,hi=1,0
            elseif sa<=0.05 then lo=(0.05-sa)/(sb-sa)
            elseif sb<=0.05 then hi=(0.05-sa)/(sb-sa) end
            if lo<=hi and finish>time then
                if context.receive and not receive then
                    local motionA,motionB=receiveMotion(time),receiveMotion(finish)
                    local alpha=Core.SphereBoxEntry(a-motionA,b-motionB,context.receive.CFrame,context.receive.Size,ball.Radius or 1,lo,hi)
                    if alpha then
                        local point=a:Lerp(b,alpha)
                        local eta=time+(finish-time)*alpha
                        local motion=receiveMotion(eta)
                        if flat(point-(origin+motion)).Magnitude<=config.ReceiveRange then
                            local localPoint=context.receive.CFrame:PointToObjectSpace(point-motion)
                            local xLimit=math.min(1.5,context.receive.Size.X*0.25)
                            local zLimit=math.min(1.5,context.receive.Size.Z*0.25)
                            local solid=math.abs(localPoint.X)<=xLimit and (context.kind~="Spike" or math.abs(localPoint.Z)<=zLimit)
                            receive={Action="Receive",Contact=point,ETA=eta,ResponseLead=receiveLead,Solid=solid,LocalContact=localPoint}
                        end
                    end
                end
                local hardHit=context.kind~="Set" and context.kind~="Receive" and context.kind~="Dive" and context.kind~="Bump"
                if config.AutoDive and hardHit and geometry and not dive and speed>=config.DiveMinSpeed and finish>=response then
                    local direction=flat(a:Lerp(b,(lo+hi)/2)-origin)
                    if direction.Magnitude>0.05 then
                        direction=direction.Unit
                        local frame=CFrame.lookAt(origin,origin+direction)*geometry.offset
                        local travelA=Core.DiveTravel(geometry.speed,geometry.coast,geometry.decay,time-response)
                        local travelB=Core.DiveTravel(geometry.speed,geometry.coast,geometry.decay,finish-response)
                        local start=math.max(lo,(response-time)/(finish-time))
                        if start<=hi then
                            local alpha=Core.SphereBoxEntry(a-direction*travelA,b-direction*travelB,frame,geometry.size,ball.Radius or 1,start,hi)
                            if alpha then
                                local contact=a:Lerp(b,alpha)
                                local distance=flat(contact-origin).Magnitude
                                if distance<=config.DiveRange+geometry.size.Z/2+(ball.Radius or 1) then
                                    dive={Action="Dive",Contact=contact,Direction=direction,ETA=time+(finish-time)*alpha,ResponseLead=response}
                                end
                            end
                        end
                    end
                end
            end
            if grounded then break end
            sim.Position,sim.Velocity=b,velocity
            time=finish
        end
        -- A speculative edge receive must not consume the remaining dive window
        -- when the current movement plan cannot reach its center in time.
        local move=context.receiveMovePlan
        local lateMove=context.receiveMoveActive and (not move or move.ReachPending==true
            or not Core.Finite(move.Travel) or not Core.Finite(move.ETA) or move.Travel>move.ETA)
        local immediateReceive=receive and receive.ETA<=receiveLead and (receive.Solid or not context.centeredReceive)
            and Core.SphereNearPart(context.receive,receive.Contact,ball.Radius or 1)
        if dive and lateMove and not immediateReceive then
            dive.ReceiveMoveHandoff=true
            return dive,"Receive movement too late • diving",receive
        end
        -- Keep receive priority when walking can still make the centered contact,
        -- or when a solid immediate catch is already inside the native volume.
        if receive then
            if context.centeredReceive and not receive.Solid then
                local deadline=math.max(receiveLead*0.75,(config.ReceiveTurnLead or 0.12)+(context.ping or 0)
                    +2*(context.dt or 1/60)+(config.ReceiveActivationPadding or 0.035))
                if receive.ETA>deadline then return nil,"Centering before receive: outside contact predicted",receive end
                receive.CenterFallback=true
            end
            if config.AutoReceive and not context.receiving and receive.ETA<=receiveLead then return receive,"receive entry" end
            return nil,"receive can reach",receive
        end
        if dive then return dive,"intercept" end
        return nil,"outside dive reach"
    end
    return Core
end

-- Narrow presentation fixes for classic Rayfield; no game state is accessed.
local function prepareRayfieldSource(source)
    source = source:gsub("\r\n", "\n")
    local function replaceOnce(old, replacement)
        local startAt, endAt = source:find(old, 1, true)
        assert(startAt, "Rayfield presentation compatibility: missing " .. old:sub(1, 70))
        assert(not source:find(old, endAt + 1, true), "Rayfield presentation compatibility: ambiguous anchor")
        source = source:sub(1, startAt - 1) .. replacement .. source:sub(endAt + 1)
    end
    -- Scope the position fix to Unhide, preserving upstream additions to its prologue.
    local unhideAnchor = "local function Unhide()\n"
    local unhideStart, unhideHeaderEnd = source:find(unhideAnchor, 1, true)
    assert(unhideStart and not source:find(unhideAnchor, unhideHeaderEnd + 1, true),
        "Rayfield presentation compatibility: missing or ambiguous Unhide function")
    local unhideEnd = assert(source:find("\nend", unhideHeaderEnd + 1, true),
        "Rayfield presentation compatibility: missing Unhide boundary")
    local positionAnchor = "\n\tMain.Position = UDim2.new(0.5, 0, 0.5, 0)"
    local positionStart, positionEnd = source:find(positionAnchor, unhideHeaderEnd, true)
    assert(positionStart and positionEnd < unhideEnd,
        "Rayfield presentation compatibility: missing Unhide position reset")
    local duplicate = source:find(positionAnchor, positionEnd + 1, true)
    assert(not duplicate or duplicate > unhideEnd,
        "Rayfield presentation compatibility: ambiguous Unhide position reset")
    source = source:sub(1, positionStart - 1)
        .. "\n\t-- Keep the position last assigned by Rayfield's drag controller."
        .. source:sub(positionEnd + 1)
    replaceOnce("\n\tdragBar.Position = useMobileSizing and UDim2.new(0.5, 0, 0.5, dragOffsetMobile) or UDim2.new(0.5, 0, 0.5, dragOffset)\n",
        "\n\tdragBar.Position = Main.Position + UDim2.fromOffset(0, useMobileSizing and dragOffsetMobile or dragOffset)\n")
    local fadeStart = assert(source:find("local function setElementsVisible(show)", 1, true), "Rayfield element fade function missing")
    local fadeEnd = assert(source:find("-- Sets tab button visibility", fadeStart, true), "Rayfield element fade boundary missing")
    local fade = [=[local elementFadeTargets = {}
