    end
    local function sprint(context,distance)
        api.Sprinting=false
        if not config.AutoSetSprint or not host.sprint or context.state or context.airborne or distance<=math.max(8,context.speed*0.22)then return end
        api.Sprinting=true
        if host.now()-lastSprint<0.18 then return end
        lastSprint=host.now()
        local speed,accepted=host.sprint()
        if Core.Finite(speed) and speed>0 then context.speed=speed end
        if accepted then api.SprintBursts=(api.SprintBursts or 0)+1 end
    end
    function api.DecoyPoint(position,realPoint,candidates)
        local heading=flat(realPoint-position)
        if heading.Magnitude<0.1 then return nil end
        heading=heading.Unit
        local best,dot=nil,math.cos(math.rad(35))
        for _,point in ipairs(candidates or {})do
            local direction=flat(point-position)
            if direction.Magnitude>1 and direction.Unit:Dot(heading)<dot then best,dot=point,direction.Unit:Dot(heading)end
        end
        return best or position+Vector3.new(-heading.Z,0,heading.X)*20
    end
    function api.ObserveRemoved(id)
        local entry=api.Flights[id]
        if entry then entry.status="Ball removed before target contact";api.Flights[id]=nil end
        api.SpikeFlights[id]=nil
        if job and job.ballId==id then release("Ball removed")end
