        if not boundedPlayer and not validate then
            local selected=table.clone(target);selected.setterGlide=jumpPlan.glide==true
            airChoice=airChoice or api.ChooseDelivery(jumpPlan.contact,selected,context.maxPower,true,ball.Acceleration.Y,ball.Radius,playName,backward)
            groundChoice=groundChoice or ground and api.ChooseDelivery(ground.contact,target,context.maxPower,false,ball.Acceleration.Y,ball.Radius,playName,backward)
        end
        if not ground then return airChoice and chosen(jumpPlan,netSave and "Jump: over-net receive save" or "Jump: airborne contact required") or nil end
        if not airChoice then return chosen(ground,"Ground: no usable airborne delivery")end
        if not groundChoice then return chosen(jumpPlan,"Jump: ground cannot deliver this attack")end
        if playName=="Normal" and groundChoice.recovery and not airChoice.recovery and not airChoice.uncalibratedTilt then
            return chosen(jumpPlan,"Jump: preserves the selected Normal delivery tempo")
        end
        if playName=="Normal" and groundChoice.measuredLaunch and airChoice.measuredLaunch==false then
            return chosen(ground,"Ground: calibrated delivery is more reliable than an unmeasured jump")
        end
        if boundedPlayer then
            if jumpPlan.contact.Y>=ground.contact.Y+1.5 then return chosen(jumpPlan,jumpPlan.peakContact and "Jump: highest usable contact near apex" or "Jump: highest usable delivery contact")end
            return chosen(ground,"Ground: highest usable delivery contact")
        end
        if airChoice.recovery and not groundChoice.recovery then return chosen(ground,"Ground: preserves selected attack")end
        if playName=="Quick" and groundChoice.power>airChoice.power+2 then return chosen(ground,"Ground: preserves Quick power")end
        if playName=="Short" and groundChoice.landingDistance and airChoice.landingDistance
            and groundChoice.landingDistance+2.5<airChoice.landingDistance then return chosen(ground,"Ground: keeps Short close")end
        local placement=airChoice.placement or airChoice.point or target.position
        local delta=flat(placement-jumpPlan.contact)
        local net=context.net
        local across=math.abs(delta:Dot(net.axis))
        local side=Core.Side(context.position,net)
        local line=side and net.attackLines and net.attackLines[side]
        local depth=side and math.max((jumpPlan.contact-net.center):Dot(net.normal)*side,(ground.contact-net.center):Dot(net.normal)*side) or 0
        local backRow=line~=nil and depth>=line
        local details={distance=delta.Magnitude,across=across,receiveDepth=depth,attackLine=line,backRow=backRow}
        local longSet=across>=net.halfWidth*1.1 or delta.Magnitude>=net.halfWidth*1.4
        if playName~="Short" and longSet then return chosen(jumpPlan,"Jump: long cross-court delivery",details)end
        if playName~="Short" and backRow then return chosen(jumpPlan,"Jump: back-row receive",details)end
        if ground.time-jumpPlan.time>=math.max(0.55,Core.SetPlay(playName).jumpGain)then return chosen(jumpPlan,"Jump: materially earlier contact",details)end
