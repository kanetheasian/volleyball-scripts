            local locked=api.CheckTakeoff(job.ball,physical,job.contactAt-at,job.glideDirection,job.glide,job.lateCharge)
            local reachable=not locked and api.PlanMotion(job.ball,physical)
            if not locked and not reachable and not c.force then
                local ball,revision=job.ball,job.revision
                release("Ball outside current approach reach")
                if not noWalk and emergency(ball,c,revision,"Manual movement left no reachable Spike")then tickEmergency(c,at)end
                return
            end
            if reachable and(reachable.jumpAt>0.1 or flat(job.point-c.position).Magnitude>1.25 and not c.manualSteering and not noWalk)then
                job.point=reachable.point;job.contact=reachable.contact;job.contactAt=at+reachable.time
                job.jumpAt=at+reachable.jumpAt;job.glide=reachable.glide;job.glideDirection=reachable.glideDirection
                job.lateCharge=reachable.lateCharge;job.timingPhase=reachable.timingPhase or job.timingPhase
                job.contactOffset=reachable.contactOffset;job.desiredContactOffset=reachable.desiredContactOffset
                job.plannedAt=at;publish();status("Adapting jump to current movement");return
            end
            if locked then
                job.contact=locked.contact;job.contactOffset=locked.contactOffset
                api.LastPlan.contact=locked.contact;api.LastPlan.contactOffset=locked.contactOffset
                api.LastPlan.takeoffLocked=true
            elseif reachable then
                job.point=reachable.point;job.contact=reachable.contact;job.contactAt=at+reachable.time
                job.glide=reachable.glide;job.glideDirection=reachable.glideDirection;job.lateCharge=reachable.lateCharge
                job.contactOffset=reachable.contactOffset;job.desiredContactOffset=reachable.desiredContactOffset
                publish()
            end
            if host.request("Jump",false)then
                job.jumpIssued=true;job.jumpRequestedAt=at
                api.LastPlan.phase="Charge";api.LastPlan.jumpIssued=true;api.LastPlan.jumpRequestedAt=at
                status(job.glide and "Gliding attack: jump charge"or "Attack jump charge")
            else status("Native Jump rejected; waiting")end
            return
        end
        if c.airborne then
            api.LastPlan.phase=job.requested and "Spike armed"or "Airborne"
            local due=(not job.preview or c.force)and(window and window.enter<=lead or c.force and remaining<=lead)
            if due and not c.setState and(not job.requested or at-job.requested>=0.12)then
