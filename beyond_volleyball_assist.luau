    updateReceiveAim=function()
        if not receiveAim then return end
        local part,humanoid=getRoot()
        local current=machine:GetCurrent()
        if not api.Alive or not config.ReceiveAim or setAim or not part or not humanoid or humanoid.Health<=0
            or humanoid.Sit or part.Anchored or humanoid.FloorMaterial==Enum.Material.Air or UIS:GetFocusedTextBox() or GuiService.MenuIsOpen
            or os.clock()>=receiveAim.expires or current and current.Name~="Receive" then clearReceiveAim();return end
        local point=receiveAim.mode=="Middle front" and receiveAim.point or receiveAimPoint(part)
        if not point then clearReceiveAim();return end
        local facing=Core.YawOnlyFrame(part.CFrame,point)
