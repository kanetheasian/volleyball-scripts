        return Core.AddSetPoseSample(model.samples,{bias=packet.InstanceFrame.Position-predicted,
            pitchBias=math.asin(math.clamp(packet.InstanceFrame.LookVector.Y,-1,1))-math.asin(math.clamp(request.rootFrame.LookVector.Y,-1,1)),
            height=request.rootFrame.Position.Y-request.groundY,verticalSpeed=request.velocity.Y,
