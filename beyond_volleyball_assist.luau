            local side=Core.Side(context.position,context.net)or 1
            local across=(context.position-context.net.center):Dot(context.net.axis)
            context.targetFacingPoint=context.net.center+context.net.axis*(across>=0 and -1 or 1)*(context.net.halfWidth-5.5)
                -context.net.normal*side*(context.net.halfDepth-5.5)
