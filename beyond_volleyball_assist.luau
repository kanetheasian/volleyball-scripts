    function api.ChooseRisingSetIntercept(ball,context,target,backward)
        if context.airborne or context.dump or not host.risingSetWindow or not target.livePlayer or not target.attackBand then return nil end
        local deadline,hit=planningDeadline,api.PlanningBudgetHit
        local now=host.now and host.now()or 0
        local reserve=host.planningBudget and math.min(.003,host.planningBudget*.25)
        planningDeadline=reserve and math.min(deadline or math.huge,now+reserve)or deadline
        api.PlanningBudgetHit=false
