                        local alpha=(at-a.time)/(b.time-a.time)
                        return a.position+(b.position-a.position)*alpha,{lag=poseLag,lagApplied=true,history=true}
                    end
                end
            end
            local predicted=context.nativeSetFrame.Position+velocity*time-Vector3.yAxis*(.5*(context.gravity or 50)*time*time)
            local handFloor=context.groundY+(context.nativeSetFrame.Position.Y-context.position.Y)
            predicted=Vector3.new(predicted.X,math.max(handFloor,predicted.Y),predicted.Z)
