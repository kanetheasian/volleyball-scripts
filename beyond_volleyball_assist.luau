                end
                if authoredBot and fallback and (not fallbackDelivery or fallbackDelivery.uncalibratedTilt) then
                    local selected=table.clone(target);selected.predictionLead=fallback.time
                    local recovery=api.ChooseRecovery(fallback.contact,selected,context.maxPower,fallback.jump,ball.Acceleration.Y,ball.Radius,playName,backward)
                    if not fallbackDelivery or recovery and not recovery.uncalibratedTilt then fallbackDelivery=recovery end
                end
                if fallbackDelivery then fallback.deliveryValidated=true;fallback.delivery=fallbackDelivery end
                return fallback,fallbackDelivery
            end
            local search=table.clone(context)
            local previous=-math.huge
            report[kind]={}
            for attempt=1,9 do
                if attempt>1 and budgetSpent()then return nil end
                local plan=api.PlanIntercept(ball,search,kind,playName)
                if not plan or plan.time<=previous then return nil end
                local selected=table.clone(target);selected.setterGlide=plan.glide==true
                local delivery,why=api.ChooseDelivery(plan.contact,selected,context.maxPower,plan.jump,ball.Acceleration.Y,ball.Radius,playName,backward)
                if not delivery and target.attackBand.recoveryMinimum then
                    delivery=api.ChooseRecovery(plan.contact,selected,context.maxPower,plan.jump,ball.Acceleration.Y,ball.Radius,playName,backward)
                end
                report[kind][#report[kind]+1]={time=plan.time,height=plan.contact.Y,usable=delivery~=nil,reason=why}
