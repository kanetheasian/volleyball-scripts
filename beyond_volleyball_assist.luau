    local function refreshCourts()
        if os.clock()-courtRefresh<0.5 then return end
        courtRefresh=os.clock(); courts={}
        for _,model in ipairs(CollectionService:GetTagged("Court")) do
            local net,base=model:FindFirstChild("Net"),model:FindFirstChild("Base")
            if net and base and net:IsA("BasePart") and base:IsA("BasePart") then
                local axis=flat(net.CFrame.RightVector)
                if axis.Magnitude>0.9 then
                    axis=axis.Unit
                    local normal=Vector3.new(-axis.Z,0,axis.X)
                    local width=math.abs(axis:Dot(base.CFrame.RightVector))*base.Size.X+math.abs(axis:Dot(base.CFrame.LookVector))*base.Size.Z
                    local depth=math.abs(normal:Dot(base.CFrame.RightVector))*base.Size.X+math.abs(normal:Dot(base.CFrame.LookVector))*base.Size.Z
                    local attackLines={}
                    local builds=model:FindFirstChild("Builds")
                    local lines=builds and builds:FindFirstChild("Lines")
                    if lines then
                        for _,line in ipairs(lines:GetChildren())do
                            if line.Name=="AttackLine" and line:IsA("BasePart")then
                                local offset=(line.Position-net.Position):Dot(normal)
                                if math.abs(offset)>0.5 then attackLines[offset>0 and 1 or -1]=math.abs(offset)end
                            end
                        end
                    end
                    local court={part=net,court=model,base=base,center=net.Position,courtCenter=base.Position,
                        axis=axis,normal=normal,halfWidth=math.min(width,net.Size.X)/2,halfDepth=depth/2,
                        attackLines=attackLines,
                        maxTeamTouches=model.GetAttribute and model:GetAttribute("MaxTouches")or 3,
                        topY=net.Position.Y+net.Size.Y/2,floorY=math.max(base.Position.Y+base.Size.Y/2,0.5)}
                    if antennaHeights[model]==nil then
                        local nets=builds and builds:FindFirstChild("Nets");local parts={}
                        for _,p in ipairs(nets and nets:GetDescendants()or{})do if p:IsA("BasePart")then parts[#parts+1]=p end end
                        antennaHeights[model]=Core.AntennaTop(court,parts)or false
                    end
                    court.antennaTop=antennaHeights[model]or nil
                    courts[#courts+1]=court
                end
            end
        end
        api.CourtCount=#courts
    end
    local function courtAt(position,allowOutside)
        refreshCourts()
        local best,distance
        for _,net in ipairs(courts) do
            if Core.InCourt(position,net) then return net end
            local offset=flat(position-net.center)
            local along=math.clamp(offset:Dot(net.axis),-net.halfWidth,net.halfWidth)
            local gap=(offset-net.axis*along).Magnitude
            if allowOutside and gap<net.halfDepth+20 and (not distance or gap<distance) then best,distance=net,gap end
        end
        return best
    end
