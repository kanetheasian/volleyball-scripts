    function api.Cancel(reason)release(reason or "Paused")end
    function api.GetTakeoffMove(character)
        if not job or job.character~=character or not config.AutoSetGlide
            or not(config.AutoSet or job.dump or job.override)or not job.glide or not job.jumpIssued
            or not job.glideCharging or job.airborneSeen or job.requested
            or not job.glideChargeUntil or host.now()>job.glideChargeUntil then return nil end
        local direction=job.glideDirection
        if not direction or not Core.Finite(direction.Magnitude)or flat(direction).Magnitude<0.1 then return nil end
