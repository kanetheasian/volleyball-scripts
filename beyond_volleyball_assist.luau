            end
            local groundCenter=sample.reach and sample.reach.groundCenter
                or root and humanoid and net.floorY+(humanoid.HipHeight or 2.5)+root.Size.Y/2+1.5
            local hitterAirborne=humanoid and root and(root.Position.Y>net.floorY+humanoid.HipHeight+root.Size.Y/2+.75)
            local attackForward=Core.SetAttackForward(spike and spike.CFrame.LookVector,net,Core.Side(context.position,net),hitterAirborne)
            return {name=name,object=sample.player,position=position,approachPosition=sample.position,
                attackBand=band,setSide=Core.Side(context.position,net),
                upperEntry=play=="Normal",
                attackCenter=attackCenter,frontOffset=play=="Normal"and math.min(2,(spike and spike.Size.X/2 or 3.5)*0.5)or nil,
                attackForward=attackForward,strictEntry=play=="Normal",
                attackMotion=spike and root and{center=spike.Position,velocity=root.AssemblyLinearVelocity,
                    gravity=workspace.Gravity,groundCenter=groundCenter,airborne=hitterAirborne==true}or nil,
                velocity=sample.velocity,speed=humanoid and humanoid.WalkSpeed,index=1,net=net,contactY=net.topY+2,livePlayer=true,
                spikeCenter=spike and spike.Position,spikeRadius=spike and spike.Size.X/2,gravity=workspace.Gravity,
                airborne=humanoid and root and (root.Position.Y>net.floorY+humanoid.HipHeight+root.Size.Y/2+0.75 or math.abs(root.AssemblyLinearVelocity.Y)>2)}
        end
