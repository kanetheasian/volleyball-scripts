        local function libraryOptions()local options=profiles.Names();return #options>0 and options or {"No saved profiles"}end
        local function refreshLibrary()
            if not profileDropdown or not autoloadToggle or not libraryStatus then return end
            refreshing=true
            profileDropdown:Refresh(libraryOptions(),true)
            profileDropdown:Set({selected~="" and selected or "No saved profiles"})
            autoloadToggle:Set(profiles.Data.AutoLoad~="" and profiles.Data.AutoLoad==selected)
