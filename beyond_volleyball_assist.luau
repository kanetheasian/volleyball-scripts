                        local glideDir=noWalk and(toward.Magnitude>0.1 and toward.Unit or Vector3.zero)or(c.moveDirection or Vector3.zero)
                        best={point=c.position,contact=future,time=c.charge+0.2,jumpAt=0,
                            glide=config.AutoSpikeGlide and glideDir.Magnitude>0.1,
                            glideDirection=glideDir,score=-gap}
