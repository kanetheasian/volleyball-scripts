    end
    local function same(a,b)
        return a and b and a.ballId==b.ballId and a.target==b.target and a.play==b.play
            and a.delivery==b.delivery and a.power==b.power and a.setType==b.setType
            and (a.origin-b.origin).Magnitude<=0.35
            and (a.origin-b.origin).Magnitude+(a.velocity-b.velocity).Magnitude*math.clamp(math.max(a.flightTime or 1.5,b.flightTime or 1.5),0.4,2)<=0.75
            and ((not a.attackPoint and not b.attackPoint)or a.attackPoint and b.attackPoint and (a.attackPoint-b.attackPoint).Magnitude<=0.5)
    end
    function api.BuildFlight(plan)
        local result=table.clone(plan);result.path={}
        local ball={Position=plan.origin,Velocity=plan.velocity,Acceleration=plan.acceleration,Spin=plan.spin or Vector3.zero}
        local duration=math.clamp((plan.flightTime or 1.5)+0.7,0.4,3.5)
        for i=0,math.ceil(duration*60)do
            if i%3==0 then result.path[#result.path+1]={point=ball.Position,time=i/60}end
            if i>0 and ball.Position.Y<plan.floorY+plan.radius then break end
            ball.Position,ball.Velocity=host.stepPhysics(ball,1/60)
        end
