                and flat(attackPoint-target.approachPosition).Magnitude>(target.spikeRadius or 3.5)+math.max(1,target.speed or 16)*0.6
            if ball.Position and ball.Velocity and stepPhysics then
                local sim={Position=ball.Position,Velocity=ball.Velocity,Acceleration=ball.Acceleration or Vector3.zero,Spin=ball.Spin or Vector3.zero}
                local forecast={}
