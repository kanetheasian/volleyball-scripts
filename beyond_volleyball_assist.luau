    end
    function api.Calibrate(plan,now)
        if not plan or not plan.incomingVelocity then return plan end
        local h=flat(plan.velocity);local incoming=flat(plan.incomingVelocity)
        if h.Magnitude<1 or incoming.Magnitude<1 then return plan end
        local matches={}
        for _,s in ipairs(api.Samples)do
            local height=math.abs(plan.origin.Y-s.height)
            local pitch=math.abs((plan.pitch or 0)-s.pitch)
            local speed=(Vector3.new(h.Magnitude,plan.velocity.Y,0)-Vector3.new(s.h,s.v,0)).Magnitude
            if s.key==mode(plan)and(s.contactBasis or 0)==(plan.contactProjected and 1 or 0)+(plan.contactDelay and 2 or 0)
                and now-s.time>=0 and now-s.time<=600 and height<=1.2 and pitch<=math.rad(2.5)
                and speed<=2.5 and h.Unit:Dot(s.heading)>=math.cos(math.rad(12))
                and incoming.Unit:Dot(s.incoming)>=math.cos(math.rad(10))then
                matches[#matches+1]={sample=s,score=height+pitch*20+speed*0.25}
            end
        end
        table.sort(matches,function(a,b)return a.score<b.score end)
        if #matches<3 then return plan end
        local first=matches[1].sample
        if math.abs(first.dh)>2 or math.abs(first.dv)>2 then return plan end
        local dh,dv,turn,along,dy,total=0,0,0,0,0,0
        for i=1,math.min(4,#matches)do
            local row=matches[i];local s=row.sample
            if math.abs(s.dh-first.dh)>0.75 or math.abs(s.dv-first.dv)>0.75 or math.abs(s.dy-first.dy)>0.5
                or math.abs(s.turn-first.turn)>math.rad(1)then return plan end
            local weight=1/(0.2+row.score)
            dh+=s.dh*weight;dv+=s.dv*weight;turn+=s.turn*weight;along+=s.along*weight;dy+=s.dy*weight;total+=weight
        end
