        job.airborne=true;job.takeoffAt=now();job.takeoffDirection=c.facingDirection;job.rotationLocked=true
        if c.nativeGlide~=nil then job.glide=c.nativeGlide;api.LastPlan.glide=c.nativeGlide end
        if c.nativeGlideVelocity and flat(c.nativeGlideVelocity).Magnitude>0.1 then
