        if isSelf and kind=="Spike"then
            consumed[job.ball]=job.revision
            local row={time=now(),ballId=packet.Id,revision=job.revision,confirmed=true,
                position=packet.Position,velocity=packet.Velocity,plan=table.clone(api.LastPlan)}
            row.contactOffset=packet.InstanceFrame and packet.Position.Y-packet.InstanceFrame.Position.Y or nil
