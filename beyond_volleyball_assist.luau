                        landing=flight.landing,landingTime=flight.landingTime,landingError=flight.landingError,
                        landingDistance=flight.landingDistance,placement=placement}end
                end
            end
        end
        if best and(quick and best.contactReachable or playName=="Normal"and not maximumAttackHeight)then break end
        end
        if resume then resume.cursor=0 end
        return best,not best and play.minFlightTime and "Normal needs a high attack contact and at least one second of flight" or nil
    end
    function api.ChooseRecovery(origin,target,maximum,air,acceleration,ballRadius,playName,backward)
        -- Preserve Quick tempo with the full legal tilt search before saving it
        -- as a slower Normal. Neither pass changes the selected hitter.
        if playName=="Quick"then
            local quick=api.ChoosePower(origin,target,maximum,air,acceleration,ballRadius,"Quick",backward,true)
            if quick then quick.quickRecovery=true;quick.requestedPlay="Quick";return quick end
        end
        if playName=="Short" then maximum=math.min(maximum or 15,Core.SetPlay("Short").maxPower)end
        if playName=="Normal" then
            target=table.clone(target);target.recoveryMinFlightTime=host.normalFloat and 0.85 or 0.95
            if target.attackBand then
                target.attackBand=table.clone(target.attackBand)
                if not api.PreserveNormalBand()then target.attackBand.minimum=math.min(target.attackBand.minimum,target.attackBand.recoveryMinimum or target.attackBand.minimum)end
                target.upperEntry=target.frontOffset~=nil
            end
        end
        local choice=api.ChoosePower(origin,target,maximum,air,acceleration,ballRadius,"Normal",backward,true)
        if choice then choice.recovery=true;choice.recoveryEstimated=not choice.measuredLaunch;choice.requestedPlay=playName end
        return choice
    end
    function api.ChooseCourtRecovery(origin,target,maximum,air,acceleration,ballRadius,backward)
        if not target.livePlayer or not target.attackBand or not target.net or target.emergencyOnly then return nil end
        local rescue=table.clone(target)
        rescue.attackBand=table.clone(target.attackBand)
        rescue.courtRecovery=true;rescue.upperEntry=true;rescue.recoveryFront=target.frontOffset~=nil
        rescue.recoveryMinFlightTime=0.4;rescue.recoveryMaxFlightTime=3.5;rescue.recoveryArc=10
        -- Try the native neutral pose with every legal power before depending on
        -- a last-frame tilt change. Preferred upper contact gets the first pass.
        local choice=api.ChoosePower(origin,rescue,maximum,air,acceleration,ballRadius,"Normal",backward,true)
        local upper=choice~=nil
        if not choice and air and not backward and not budgetSpent()then
            rescue.recoveryPitches=host.pitch and api.RefinedNormalPitches(origin,rescue,maximum,acceleration or -25,backward)or{}
            for _,pitch in ipairs({math.rad(5),math.rad(10),math.rad(15),math.rad(20)})do table.insert(rescue.recoveryPitches,pitch)end
            choice=api.ChoosePower(origin,rescue,maximum,air,acceleration,ballRadius,"Normal",backward,true)
            upper=choice~=nil;rescue.recoveryPitches=nil
        end
        if not choice and rescue.recoveryFront and not budgetSpent()then
            rescue.recoveryFront=false
            choice=api.ChoosePower(origin,rescue,maximum,air,acceleration,ballRadius,"Normal",backward,true)
            upper=choice~=nil
        end
        if not choice and not api.PreserveNormalBand()and not budgetSpent()then
            rescue.attackBand.minimum=math.min(rescue.attackBand.minimum,
                math.max(target.net.topY+(ballRadius or 1.1)+0.25,rescue.attackBand.center-(target.spikeRadius or 3.5)*0.25))
            choice=api.ChoosePower(origin,rescue,maximum,air,acceleration,ballRadius,"Normal",backward,true)
        end
        if air and not backward and not upper and not budgetSpent()then
            local lower=choice
            local minimum=rescue.attackBand.minimum
            rescue.attackBand.minimum=target.attackBand.minimum
            rescue.recoveryPitches={math.rad(10),math.rad(20)}
            local higher=api.ChoosePower(origin,rescue,maximum,air,acceleration,ballRadius,"Normal",backward,true)
            if higher then choice=higher;upper=true
            else
                rescue.attackBand.minimum=minimum
                choice=lower
                if not choice and not budgetSpent()then
                    rescue.recoveryPitches={-math.rad(10),math.rad(10),math.rad(20)}
                    choice=api.ChoosePower(origin,rescue,maximum,air,acceleration,ballRadius,"Normal",backward,true)
                end
            end
        end
        if choice then
            choice.recovery=true;choice.courtRecovery=true;choice.upperCoverage=upper;choice.centered=false
            choice.planeTime=choice.time;choice.time=choice.entryTime or choice.time
            choice.minimumFlightTime=0.4;choice.maximumFlightTime=3.5;choice.maximumArc=10
            choice.recoveryBand=rescue.attackBand;choice.requestedPlay="Normal"
        end
        return choice
    end
    function api.ChooseDelivery(origin,target,maximum,air,acceleration,ballRadius,playName,backward)
        if playName=="Normal"and host.normalBotContactTrim and target.hitboxFrame and target.nativeSetCenter then
            local native=api.ChooseRecovery(origin,target,maximum,air,acceleration,ballRadius,playName,backward)
            if native then
                if host.nativeSetModelReady and host.nativeSetModelReady(air,backward)then
                    native.uncalibratedTilt=false;native.nativePoseSolved=true
                end
                return native
            end
        end
        local choice,reason=api.ChoosePower(origin,target,maximum,air,acceleration,ballRadius,playName,backward)
        if choice or reason then return choice,reason end
        if playName~="Normal" then
            choice=api.ChooseRecovery(origin,target,maximum,air,acceleration,ballRadius,playName,backward)
            if choice then return choice end
        end
        return nil,reason
    end
    function api.ChooseHitterRecovery(origin,target,maximum,air,acceleration,ballRadius,playName,backward)
        if playName~="Normal" or not target.livePlayer or not target.attackBand or not target.net then return nil end
        -- A short receive can make the preferred upper-band, one-second arc impossible.
        -- Keep the selected lane and a physically reachable attack band before giving up.
        local recovery=table.clone(target)
        recovery.attackBand=table.clone(target.attackBand)
        recovery.attackBand.minimum=api.PreserveNormalBand()and target.attackBand.minimum or math.min(recovery.attackBand.minimum,
            math.max(target.net.topY+(ballRadius or 1.1)+0.5,
                recovery.attackBand.center-(target.spikeRadius or 3.5)+(ballRadius or 1.1)*0.35))
        if target.frontOffset then recovery.attackBand.minimum=math.max(recovery.attackBand.minimum,target.attackBand.center+(target.spikeRadius or 3.5)*0.65)end
        if recovery.attackBand.minimum>recovery.attackBand.maximum then return nil end
        recovery.upperEntry=target.frontOffset~=nil;recovery.recoveryMinFlightTime=host.normalFloat and 0.85 or 0.35
        recovery.recoveryMaxFlightTime=host.normalFloat and api.NormalFlightLimit()or 2.2;recovery.recoveryArc=math.max(7,api.NormalArcCeiling())
        local choice=api.ChoosePower(origin,recovery,maximum,air,acceleration,ballRadius,"Normal",backward,true)
        local high=recovery.attackBand.recoveryMinimum or target.attackBand.minimum
        if target.fixedPlacement and not target.frontOffset and(not choice or not choice.normalLofted or(choice.predictedAttackHeight or -math.huge)<high)then
            local side=target.setSide or Core.Side(target.approachPosition or target.position,target.net)
            if side then
                local depth=(target.fixedPlacement-target.net.center):Dot(target.net.normal)*side
                for _,offset in ipairs({-0.25,0.25,-0.5,0.5})do
                    if budgetSpent()then break end
                    local nextDepth=math.clamp(depth+offset,target.frontOffset and 1 or 3,4)
                    if math.abs(nextDepth-depth)<0.01 then continue end
                    local shifted=table.clone(recovery)
                    shifted.fixedPlacement=target.fixedPlacement+target.net.normal*side*(nextDepth-depth)
                    shifted.attackCenter=shifted.fixedPlacement
                    local alternative=api.ChoosePower(origin,shifted,math.min(maximum or 15,4),air,acceleration,ballRadius,"Normal",backward,true)
                    if alternative and alternative.normalLofted and(not choice or not choice.normalLofted
                        or(alternative.predictedAttackHeight or -math.huge)>(choice.predictedAttackHeight or -math.huge))then
                        alternative.depthAdjustment=nextDepth-depth;choice=alternative
                        if(choice.predictedAttackHeight or -math.huge)>=high then break end
                    end
                end
            end
        end
        if choice then
            choice.recovery=true;choice.hitterRecovery=true;choice.minimumFlightTime=host.normalFloat and 0.85 or 0.35
            choice.maximumFlightTime=host.normalFloat and api.NormalFlightLimit()or 2.2;choice.maximumArc=math.max(7,api.NormalArcCeiling())
            choice.recoveryBand=recovery.attackBand;choice.recoveryEstimated=not choice.measuredLaunch
            choice.requestedPlay=playName
        end
        return choice
    end
    function api.EmergencyTarget(context)
        return {name="Deep corner set",position=context.net.center,net=context.net,fallback=true,emergencyOnly=true}
    end
    function api.IsDeepHitter(target)
        if not target.livePlayer or not target.approachPosition or not target.net or target.airborne then return false end
        local side=Core.Side(target.approachPosition,target.net)
        local line=side and target.net.attackLines and target.net.attackLines[side]
        local depth=side and (target.approachPosition-target.net.center):Dot(target.net.normal)*side or 0
        return line~=nil and depth>math.max(line+6,target.net.halfDepth*0.65)
    end
    function api.HitterCanArrive(target,choice,lead)
        if not choice then return false end
        if not target.livePlayer or not target.approachPosition then return true end
        local destination=choice.contact or choice.point
        if not destination or not Core.Finite(destination.X)or not Core.Finite(destination.Y)or not Core.Finite(destination.Z)then return false end
        local distance=flat(destination-target.approachPosition).Magnitude
        if distance<=(target.spikeRadius or 3.5)then return true end
        local speed=math.max(1,target.speed or 16,flat(target.velocity or Vector3.zero).Magnitude)
        local runTime=math.max(0,distance-(target.spikeRadius or 3.5))/speed
        return runTime+0.12<=math.max(0,lead or 0)+(choice.time or 0)+0.05
    end
    function api.ChooseEmergency(origin,net,maximum,air,acceleration,ballRadius,reason,side,forcedHeading,glide,hard,onlyCorners)
        side=side or Core.Side(origin,net)
        if not side then return nil end
        acceleration=acceleration or -25;ballRadius=ballRadius or 1.1
        local margin=math.max(3.5,ballRadius+2)
        local cornerAcross,cornerDepth=net.halfWidth-margin-2,net.halfDepth-margin-2
        if cornerAcross<=0 or cornerDepth<=0 then return nil end
        local across=(origin-net.center):Dot(net.axis)
        local depth=(origin-net.center):Dot(net.normal)*side
        local pitches={0}
        if air and host.pitch then for angle=2.5,20,2.5 do pitches[#pitches+1]=math.rad(angle);pitches[#pitches+1]=-math.rad(angle)end end
        if air and host.pitch and host.contactHeightAware then
            local bank=api.HeightModels[glide and "AirGlide"or "Air"]
            for power,rows in pairs(bank)do
                if power>(maximum or 15)then continue end
                for _,sample in ipairs(rows)do
                    local observedPitch=hard and sample.dumpCommandPitch or sample.pitch
                    if not Core.Finite(observedPitch)or math.abs(observedPitch)>math.rad(20)
                        or math.abs(sample.height-origin.Y)>1 or host.now()-sample.time>3600 then continue end
                    local present=false
                    for _,pitch in ipairs(pitches)do if math.abs(pitch-observedPitch)<math.rad(0.25)then present=true;break end end
                    if not present then pitches[#pitches+1]=observedPitch end
                end
            end
        end
        local requiredClearance=not hard and host.cornerClearance and host.cornerClearance(net,side) or 1
        requiredClearance=Core.Finite(requiredClearance) and math.max(1,requiredClearance) or 1
        local frontDepth=math.min(8,net.halfDepth*0.2)
        local preferred=across>=0 and -1 or 1
        local best,bestEffort
        -- Opposite lateral corner is the farthest on the opponent's baseline.
        for _,cornerSide in ipairs(hard and(onlyCorners and{preferred,-preferred}or{preferred,0,-preferred})or {preferred})do
                local corner=net.center+net.axis*cornerSide*cornerAcross-net.normal*side*cornerDepth
                local point=corner
                local delta=flat(point-origin)
                if forcedHeading and flat(forcedHeading).Magnitude>0.1 then
                    delta=flat(forcedHeading).Unit*math.max(1,delta.Magnitude);point=origin+delta
                end
                if delta.Magnitude>0.5 then
                    local heading=delta.Unit
                    for _,pitch in ipairs(pitches)do
                        for power=1,math.floor(math.clamp(maximum or 15,0,30))do
                            if budgetSpent()then return best or bestEffort end
                            local h,v,measured=api.NormalVelocity(power,air,false,pitch,origin.Y,glide==true,hard and "Dump"or nil)
                            if host.contactHeightAware and air and math.abs(pitch)>0.001 and not measured then continue end
                            heading=delta.Unit;point=origin+delta
                            if hard and not forcedHeading then
                                local _,flightTime=api.Landing(origin,net.axis*h+Vector3.yAxis*v,acceleration,net.floorY,ballRadius)
                                local range=h*flightTime
                                for _,targetDepth in ipairs({cornerDepth,net.halfDepth-margin-5})do
                                    local forwardDistance=depth+targetDepth
                                    if forwardDistance>0 and range>=forwardDistance then
                                        local lateral=math.sqrt(math.max(0,range*range-forwardDistance*forwardDistance))
                                        local left,right=across-lateral,across+lateral
                                        local desired=(corner-net.center):Dot(net.axis)
                                        local x=math.abs(left-desired)<math.abs(right-desired)and left or right
                                        if math.abs(x)<=net.halfWidth-margin then
                                            local baseline=net.center+net.axis*x-net.normal*side*targetDepth
                                            local aim=flat(baseline-origin)
                                            if aim.Magnitude>0.5 then heading=aim.Unit;point=baseline;break end
                                        end
                                    end
                                end
                            end
                            local landing,time=api.Landing(origin,heading*h+Vector3.new(0,v,0),acceleration,net.floorY,ballRadius)
                            local landingDepth=(landing-net.center):Dot(net.normal)*side
                            local landingAcross=math.abs((landing-net.center):Dot(net.axis))
                            local inBounds=Core.InCourt(landing,net,margin)
                            local boundsLanding=landing
                            if host.contactHeightAware and air then
                                -- Native dump feedback can be faster/higher than an unmatched seed.
                                -- Reserve flight distance instead of treating an estimated edge landing as safe.
                                local deepMeasured=measured and(depth>net.halfDepth*0.6 or power>=13 and math.abs(pitch)>0.001)
                                local upperH,upperV=h,v
                                if hard and measured then
                                    local character,scope
                                    if host.dumpCalibration then character,scope=host.dumpCalibration()end
                                    local bucket=api.HeightModels[glide and "AirGlide"or "Air"][power]or{}
                                    for _,sample in ipairs(bucket)do
                                        if sample.dumpCommandPitch~=nil and math.abs(sample.dumpCommandPitch-pitch)<=math.rad(0.5)
                                            and math.abs(sample.height-origin.Y)<=1.25 and host.now()-sample.time<=3600
                                            and(not host.dumpCalibration or sample.dumpCharacter==character and sample.dumpScope==scope)then
                                            upperH=math.max(upperH,sample.horizontal);upperV=math.max(upperV,sample.vertical)
                                        end
                                    end
                                end
                                boundsLanding=api.Landing(origin+Vector3.yAxis*(deepMeasured and 0.5 or measured and 0.75 or 1.5),
                                    heading*upperH*(deepMeasured and 1.03 or measured and 1.08 or 1.15)
                                        +Vector3.yAxis*(upperV+(deepMeasured and 1 or measured and 3 or 4)),
                                    acceleration,net.floorY,ballRadius)
                            end
                            -- Unmatched launches may use a shorter interior recovery,
                            -- while still reserving their observed flight uncertainty.
                            local estimatedJumpDump=hard and air and not measured
                            local boundsValidated=inBounds and(estimatedJumpDump or Core.InCourt(boundsLanding,net,margin))
                            local clearance=depth<=ballRadius and origin.Y-ballRadius-(net.topY or net.center.Y) or math.huge
                            local forward=-heading:Dot(net.normal)*side*h
                            if forward>0 and landingDepth< -margin then
                                for _,edge in ipairs({ballRadius,0,-ballRadius})do
                                    local crossing=(depth-edge)/forward
                                    if crossing>=0 and crossing<=time then
                                        local height=origin.Y+v*crossing+0.5*acceleration*crossing*(crossing+1/60)
                                        clearance=math.min(clearance,height-ballRadius-(net.topY or net.center.Y))
                                    end
                                end
                            else clearance=-math.huge end
                            local frontClearance=clearance
                            if forward>0 and landingDepth<=-frontDepth then
                                local crossing=(depth+frontDepth)/forward
                                if crossing>=0 and crossing<=time then
                                    local height=origin.Y+v*crossing+0.5*acceleration*crossing*(crossing+1/60)
                                    frontClearance=math.min(frontClearance,height-ballRadius-(net.topY or net.center.Y))
                                else frontClearance=-math.huge end
                            else frontClearance=-math.huge end
                            local loftValidated=frontClearance>=requiredClearance
                            local cornerError=flat(landing-corner).Magnitude
                            local hardValid=hard and boundsValidated and clearance>=0.35
                                and landingDepth<=-(air and net.halfDepth*0.7 or net.halfDepth-margin-6)and h>=(air and 30 or 20)
                                and(not air or power>=math.max(1,math.floor(maximum or 15)-2))
                                and(not onlyCorners or cornerError<=math.max(3.5,ballRadius*2))
                            if hardValid or not hard and boundsValidated and landingDepth<=-net.halfDepth*0.75 and landingAcross>=net.halfWidth*0.7
                                and cornerError<=math.max(3.5,ballRadius*2) and loftValidated then
                                local score=cornerError+math.abs(pitch)*2
                                if hard then score=time+cornerError*0.01 end
                                if not best or hard and score<best.score or not hard and (time<best.time-0.001 or math.abs(time-best.time)<=0.001 and score<best.score)then
                                    best={power=power,pitch=pitch,point=point,placement=corner,landing=landing,landingTime=time,time=time,
                                        horizontal=h,vertical=v,play=hard and cornerSide==0 and "Back line"or "Deep corner",recovery=true,emergency=true,hardDump=hard==true,
                                        predictionOrigin=origin,measuredLaunch=measured==true,estimated=measured~=true,
                                        launchAir=air==true,launchBack=false,launchGlide=glide==true,dumpBoundsValidated=true,
                                        dumpEstimatedRecovery=estimatedJumpDump==true,
                                        emergencyReason=reason or "Selected hitter unavailable",safeLanding=true,clearance=clearance,
                                        frontClearance=frontClearance,requiredClearance=requiredClearance,loftValidated=loftValidated,
                                        score=score,cornerError=cornerError,cornerValidated=cornerSide~=0 and cornerError<=math.max(3.5,ballRadius*2),bestEffortCorner=false,landingInBounds=true,
                                        landingDistance=flat(landing-origin).Magnitude}
                                end
                            end
                            if hard then continue end
                            -- Keep a native set available even when the ideal corner cannot be reached.
                            local opposite=landingDepth< -margin
                            local safeOpponent=opposite and inBounds and clearance>=0.35
                            local boundsError=math.max(0,landingAcross-net.halfWidth+margin)
                                +math.max(0,math.abs(landingDepth)-net.halfDepth+margin)
                            local clearanceError=Core.Finite(clearance) and math.max(0,0.35-clearance) or 20
                            local landingRank=safeOpponent and loftValidated and 0 or safeOpponent and 1 or inBounds and 2 or 3
                            local loftError=Core.Finite(frontClearance) and math.max(0,requiredClearance-frontClearance) or 20
                            local effortScore=clearanceError*1000+loftError*100+boundsError*100+cornerError+time*2+math.abs(pitch)*2
                            if boundsValidated and (not bestEffort or landingRank<bestEffort.landingRank
                                or landingRank==bestEffort.landingRank and effortScore<bestEffort.score)then
                                bestEffort={power=power,pitch=pitch,point=point,placement=corner,landing=landing,landingTime=time,time=time,
                                    horizontal=h,vertical=v,play="Deep corner",recovery=true,emergency=true,
                                    predictionOrigin=origin,measuredLaunch=measured==true,estimated=measured~=true,
                                    launchAir=air==true,launchBack=false,launchGlide=glide==true,dumpBoundsValidated=true,
                                    emergencyReason=reason or "Selected hitter unavailable",safeLanding=safeOpponent,clearance=clearance,
                                    frontClearance=frontClearance,requiredClearance=requiredClearance,loftValidated=loftValidated,
                                    score=effortScore,landingRank=landingRank,landingInBounds=inBounds,
                                    cornerError=cornerError,cornerValidated=false,bestEffortCorner=true,
                                    landingDistance=flat(landing-origin).Magnitude}
                            end
                        end
                    end
                end
        end
        return best or bestEffort
    end
    function api.ChooseContactSave(origin,target,context,ball,air,backward,lead)
        if not target or target.emergencyOnly or not target.net or context.dump then return nil end
        local selected=table.clone(target);selected.contactSave=true;selected.deliveryLead=math.max(0,lead or 0)
        if air and context.airborne and context.nativeSetFrame then
            -- Rescue can select a different overlap time from the abandoned
            -- intercept. Recompute the hand for that same ball-contact instant.
            selected.nativeSetCenter,selected.nativeSetPose=api.DeliverySetPose(context,{jump=true,backSet=backward},
                selected.deliveryLead,origin,ball.Radius)
            selected.contactSavePoseLead=selected.deliveryLead
        end
        if target.attackBand then
            selected.attackBand=table.clone(target.attackBand)
            selected.attackBand.minimum=api.PreserveNormalBand()and target.attackBand.minimum or math.max(target.net.topY+(ball.Radius or 1.1)+0.25,
                target.attackBand.recoveryMinimum or target.attackBand.minimum)
        end
        -- Give an expiring contact a small independent search reserve even when
        -- the preferred-delivery search has consumed this frame's budget.
        local deadline,hit=planningDeadline,api.PlanningBudgetHit
        local started=host.now and host.now()or 0
        local reserve=host.planningBudget and math.min(0.003,host.planningBudget*0.25)
        local recoveryDeadline=reserve and started+reserve
        planningDeadline=reserve and started+reserve*.4 or nil
        api.PlanningBudgetHit=false
        local choice
        local upperBot=host.normalFloat and host.normalBotContactTrim~=nil and api.PreserveNormalBand()
            and selected.radius and selected.hitboxFrame and selected.hitboxSize and selected.nativeSetCenter
        if upperBot then
            -- An expiring native contact still deserves the bot's normal upper
            -- attack band. Search upward tilts first within a bounded reserve;
            -- a neutral low rescue must not hide a reachable higher command.
            selected.contactSave=false;selected.botHeightRescue=true
            planningDeadline=reserve and started+reserve or nil;api.PlanningBudgetHit=false
            choice=api.ChoosePower(origin,selected,context.maxPower,air,ball.Acceleration.Y,ball.Radius,"Normal",backward,true)
            local ready=host.nativeSetModelReady and host.nativeSetModelReady(air,backward)
            if choice and ready then choice.uncalibratedTilt=false;choice.nativePoseSolved=true end
            if choice then
                choice.botUpperSave=true
                choice.botUpperEstimated=choice.uncalibratedTilt==true
            end
            selected.contactSave=true;selected.botHeightRescue=nil
            planningDeadline=reserve and host.now()+reserve*.4 or nil;api.PlanningBudgetHit=false
        end
        if not choice then
            choice=api.ChoosePower(origin,selected,context.maxPower,air,ball.Acceleration.Y,ball.Radius,"Normal",backward,true)
            if choice and upperBot then choice.botHeightFallback=true end
        end
        if not choice and not api.PreserveNormalBand()and selected.livePlayer and selected.attackBand and(not recoveryDeadline or host.now()<recoveryDeadline)then
            -- At the last native contact, upper-band comfort must not make a
            -- reachable selected-hitter save impossible. Try the actual attack
            -- volume after the preferred height, keeping net and arrival gates.
            selected.attackBand.minimum=math.max(target.net.topY+(ball.Radius or 1.1)+.25,
                selected.attackBand.center-(target.spikeRadius or 3.5)+(ball.Radius or 1.1)*.35)
            selected.upperEntry=false
            planningDeadline=recoveryDeadline;api.PlanningBudgetHit=false
            choice=api.ChoosePower(origin,selected,context.maxPower,air,ball.Acceleration.Y,ball.Radius,"Normal",backward,true)
            if choice then choice.contactBandRecovery=true end
        end
        if not choice and api.PreserveNormalBand()and selected.livePlayer and selected.attackBand then
            -- At the final native contact, a lofted set into the hitter's usable
            -- volume is preferable to withholding Set for an unreachable apex.
            -- Keep the net floor, descending arc and approach-time requirements.
            selected.attackBand.minimum=math.max(target.net.topY+(ball.Radius or 1.1)+.5,selected.attackBand.center)
            selected.attackBand.ideal=math.clamp(selected.attackBand.ideal,selected.attackBand.minimum,selected.attackBand.maximum)
            selected.upperEntry=false
            planningDeadline=reserve and host.now()+reserve or nil;api.PlanningBudgetHit=false
            choice=api.ChoosePower(origin,selected,context.maxPower,air,ball.Acceleration.Y,ball.Radius,"Normal",backward,true)
            if choice then choice.contactBandRecovery=true end
        end
        planningDeadline=deadline;api.PlanningBudgetHit=hit
        if not choice or not api.HitterCanArrive(selected,choice,lead)then return nil end
        choice.contactSave=true;choice.recovery=true;choice.minimumFlightTime=0.05;choice.maximumFlightTime=2.8
        choice.contactSavePoseLead=selected.contactSavePoseLead
        choice.recoveryEstimated=not choice.measuredLaunch;choice.requestedPlay="Normal"
        return choice
    end
    function api.ResolveDelivery(origin,target,context,ball,air,play,backward,lead,reason,unavailableFor)
        if target.emergencyOnly and not context.dump then return nil,"Selected hitter unavailable; waiting for selected target"end
        if not target.emergencyOnly then
            target=table.clone(target);target.deliveryLead=math.max(0,lead or 0)
            local coverage
            if host.courtRecovery and play=="Normal"then
                coverage=api.ChooseCourtRecovery(origin,target,context.maxPower,air,ball.Acceleration.Y,ball.Radius,backward)
                if coverage and not api.HitterCanArrive(target,coverage,lead)then coverage=nil end
            end
            local function preferStableCoverage(candidate)
                if coverage and coverage.upperCoverage and not backward and math.abs(candidate.pitch or 0)>math.rad(10)
                    and flat((target.fixedPlacement or target.position)-origin).Magnitude>=25 then return coverage end
                return candidate
            end
            local choice,why=api.ChooseDelivery(origin,target,context.maxPower,air,ball.Acceleration.Y,ball.Radius,play,backward)
            local flatFallback
            if choice and not choice.uncalibratedTilt and api.HitterCanArrive(target,choice,lead)then
                if play=="Normal"and choice.normalLofted==false then flatFallback=choice else return preferStableCoverage(choice) end
            end
            if not choice or not choice.recovery or choice.uncalibratedTilt then
                local recovery=api.ChooseRecovery(origin,target,context.maxPower,air,ball.Acceleration.Y,ball.Radius,play,backward)
                if recovery and (not choice or not recovery.uncalibratedTilt) and api.HitterCanArrive(target,recovery,lead)then
                    if play=="Normal"and recovery.normalLofted==false then flatFallback=flatFallback or recovery else return preferStableCoverage(recovery) end
                end
            end
            if choice and api.HitterCanArrive(target,choice,lead)then
                if play=="Normal"and choice.normalLofted==false then flatFallback=flatFallback or choice else return preferStableCoverage(choice) end
            end
            if budgetSpent()then return flatFallback or coverage,"Delivery search deferred within planner budget"end
            reason=choice and "Hitter cannot reach the attack lane in time" or why or "No usable hitter trajectory"
            local recovery=api.ChooseHitterRecovery(origin,target,context.maxPower,air,ball.Acceleration.Y,ball.Radius,play,backward)
            if recovery and api.HitterCanArrive(target,recovery,lead)then return preferStableCoverage(recovery) end
            if flatFallback then return flatFallback end
            if coverage then return coverage end
            -- Solver failure is not permission to change the player's selected target.
            return nil,reason
        end
        local heading=context.airborne and context.facingDirection or nil
        if heading and backward then heading=-heading end
        return api.ChooseEmergency(origin,context.net,context.maxPower,air,ball.Acceleration.Y,ball.Radius,
            reason or "Selected hitter unavailable",Core.Side(context.position,context.net),heading,context.setterGlide==true,context.dump==true)
    end
    function api.DumpApproachMotion(ball,context)
        if not config.AutoSetGlide or context.manualSteering or(context.glideSpeed or 0)<=0 then return "Standing"end
        -- Held Dump prefers a reachable native glide for close and far receives.
        -- Interception geometry chooses the approach and takeoff time.
        return "Glide"
    end
    function api.EarlyDumpAim(position,net,side)
