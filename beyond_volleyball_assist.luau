                position=packet.Position,velocity=packet.Velocity,reason=job.reason,plan=table.clone(api.LastPlan)}
            if #api.FallbackHistory>40 then table.remove(api.FallbackHistory,1)end
            release("Emergency corner Set confirmed");return
