        return api.Current
    end
    function api.CompareFlight(predicted,confirmed)
        if not predicted or not confirmed or predicted.ballId~=confirmed.ballId then return nil end
        local duration=math.min(predicted.flightTime or 1.5,1.5)
        local function pointAt(plan,time)
            for i=2,#plan.path do
                local a,b=plan.path[i-1],plan.path[i]
                if b.time>=time then return a.point+(b.point-a.point)*((time-a.time)/(b.time-a.time))end
            end
        end
