    local floorParams = RaycastParams.new()
    floorParams.FilterType = Enum.RaycastFilterType.Exclude
    local function floorFor(ball, character)
        local court=courtAt(ball.Position,true)
        if court then return court.floorY+(ball.Radius or 1)end
        floorParams.FilterDescendantsInstances = {character, folder, workspace:FindFirstChild("Balls")}
        local hit = workspace:Raycast(ball.Position + Vector3.new(0, 0.2, 0), Vector3.new(0, -150, 0), floorParams)
        -- Native court Base uses a common plane; a hit on a net/player should not define the court.
        if hit and hit.Normal.Y > 0.95 and hit.Instance.Name == "Base" then return hit.Position.Y + (ball.Radius or 1) end
        local base = workspace:FindFirstChild("Base")
        if base and base:IsA("BasePart") then return base.Position.Y + base.Size.Y/2 + (ball.Radius or 1) end
        return nil
    end
    local function updateBallVisual(id, ball, part, character,contactRefresh)
        local visual = visuals[id]
        if not visual then visual = createVisual(); visuals[id] = visual end
        if (ball.Position-part.Position).Magnitude > config.VisualDistance or ball._dying or ball._rolling
            or not (config.Trajectory or config.Landing) then hideVisual(visual); return end
        local now=os.clock()
        local rendered=not contactRefresh and ball.Instance and ball.Instance:IsA("BasePart") and ball.Instance.Position
        local net=courtAt(ball.Position,true)
        if visualForecast.NeedsRefresh(id,ball,now) then
            local floorY=floorFor(ball,character)
            if not floorY then hideVisual(visual);return end
            visualForecast.Forecast(id,ball,config.ForecastSeconds,floorY,now,nil,net)
        end
        local forecast=visualForecast.Present(id,now,rendered)
        if not forecast then hideVisual(visual);return end
        local boundary=net and visualForecast.GetLandingDecision(id,ball,net,now)
        local landingLabel=visualForecast.LandingLabel(id,ball,net,forecast,now)
        local uncertain=landingLabel=="Unsure"
        local path = forecast.DisplayPoints
        -- The rendered forecast owns its endpoint; a free-flight boundary estimate must not draw through the net.
        local count = #path-1
        for index = 1, count do
            local segment = visual.Segments[index]
            if not segment then segment = newPart("Flight", Color3.fromRGB(121, 177, 255)); visual.Segments[index] = segment end
            local a,b=path[index],path[index+1]
            local length = (b-a).Magnitude
            segment.Transparency = config.Trajectory and length > 0.001 and 0.25 or 1
            segment.Color=forecast.NetHit and Color3.fromRGB(255,115,115) or uncertain and Color3.fromRGB(255,194,99) or landingLabel=="Out" and Color3.fromRGB(255,115,115) or Color3.fromRGB(121,177,255)
            if length > 0.001 then segment.Size = Vector3.new(0.10,0.10,length); segment.CFrame = CFrame.lookAt((a+b)/2,b) end
        end
        for index = count+1, #visual.Segments do visual.Segments[index].Transparency = 1 end
        local landing = forecast.NetContact or forecast.Landing
        visual.Marker.Color=uncertain and Color3.fromRGB(255,194,99) or boundary and boundary.SkipOut and Color3.fromRGB(255,115,115) or Color3.fromRGB(64,231,186)
        visual.Marker.Transparency = config.Landing and landing and 0.35 or 1
        visual.Billboard.Enabled = config.Landing and landing ~= nil
        if landing then
            visual.Marker.CFrame = CFrame.new(landing - Vector3.new(0,(ball.Radius or 1)-0.06,0)) * CFrame.Angles(0,0,math.pi/2)
            visual.Text.Text = landingLabel
        end
    end
    local function updateBallVisuals()
        local part,humanoid,character=getRoot()
        if not part or not humanoid then
            for _,visual in pairs(visuals)do hideVisual(visual)end
            return
        end
        local active,count={},0
        for id,ball in pairs(ballService.RenderedBallMap._map)do
            if typeof(ball.Position)=="Vector3" and typeof(ball.Velocity)=="Vector3" then
                count+=1
                if config.Trajectory or config.Landing then
                    active[id]=true
                    local ok,err=pcall(updateBallVisual,id,ball,part,character)
                    if not ok then report("trajectory",err)end
                end
            end
        end
        for id,visual in pairs(visuals)do
            if not active[id]then
                visual.Marker:Destroy();for _,segment in ipairs(visual.Segments)do segment:Destroy()end
                visuals[id]=nil
            end
        end
        api.BallCount=count
        api.Metrics.VisualFrames+=1
    end
    api.TrajectoryDiagnostics=function(id)
