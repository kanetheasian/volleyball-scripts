    function api.GetMove(position,speed,dt,velocity)
        local moving=job or api.Approach
        if not moving or moving.requested or moving.jumpIssued and not moving.glideCharging then api.Move=Vector3.zero;return api.Move end
        if moving.glideCharging then api.Move=moving.glideDirection;return api.Move end
        local distance=flat(moving.point-position).Magnitude
        local precise=moving.powerPlan and moving.powerPlan.contactSave and not moving.jump
        local stop=precise and 0.2 or 1
        if distance<=(moving.stoppedAt and(precise and 0.4 or 1.5)or stop)then
            moving.stoppedAt=moving.stoppedAt or host.now();api.Move=Vector3.zero
        else
            moving.stoppedAt=nil
            local delta=flat(moving.point-position)
            local braking=math.max(0.5,math.max(1,speed or 1)*math.clamp(dt or 1/60,1/240,0.05)*1.5)
            if host.smoothApproach then
                braking=math.max(braking,math.min(2.5,math.max(1,speed or 1)*0.12))
            end
            if host.risingSetWindow and not moving.glide and moving.play=="Normal"and velocity then
                local closing=math.max(0,flat(velocity):Dot(delta.Unit))
                braking=math.max(braking,math.min(5,closing*.14+.35))
            end
            local amount=math.min(1,math.max(0,distance-(precise and 0.1 or 0.85))/braking)
            local deadline=moving.jumpAt or moving.contactAt
            if host.smoothApproach and deadline then
                local left=deadline-host.now()-0.06
                local needed=left>0 and math.max(0,distance-1)/left/math.max(1,speed or 1)or 1
                amount=math.max(amount,math.min(1,needed))
            end
            api.Move=delta.Unit*amount
        end
