        api.ReceiveAimState={ballId=receiveAim.ballId,started=receiveAim.started,error=receiveAim.error,
            point=point,mode=receiveAim.mode,
            ready=Core.ReceiveAimReady(config,receiveAim.started,receiveAim.error,os.clock(),
                receiveAim.contactAt and math.max(0,receiveAim.contactAt-os.clock()),receiveAim.responseLead)}
        api.Metrics.ReceivePreAimUpdates+=1
