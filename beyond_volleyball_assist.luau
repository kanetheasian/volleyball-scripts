                    fakeStartedAt=job.fakeStartedAt,fakeTurnAt=job.fakeTurnAt,realFacingSince=job.facingAt,
                    net=context.net,predictedContact=power.contact,predictedClearance=power.clearance,
                    requestedPower=power.power,power=power.power,jump=job.jumpIssued==true,glide=job.glide==true,
                    predictedJumpPower=job.nativeJumpPower,actualJumpPower=api.LastPlan.actualJumpPower,
                    uncalibratedTilt=power.uncalibratedTilt,
