    -- Broad defensive settling windows should not hide clear line calls.
    function tracker.LandingLabel(id,ball,net,forecast,now)
        local state=tracker.States[id]
        local landing=forecast and forecast.Landing
        if not state or not net or not landing or forecast.NetHit or forecast.SpinPending then
            if state then state.visualCall=nil end
            return "Unsure"
        end
        local previous=state.visualLanding
        local elapsed=math.max(0,now-(state.visualAt or now))
        local drift=previous and (landing-previous).Magnitude or 0
        state.visualDrift=math.max(drift,(state.visualDrift or 0)*math.exp(-elapsed/0.12))
        state.visualLanding,state.visualAt=landing,now
        local offset=landing-net.courtCenter
        local radius=ball.Radius or 1
        local gap=math.max(math.abs(offset:Dot(net.axis))-net.halfWidth-radius,
            math.abs(offset:Dot(net.normal))-net.halfDepth-radius)
        local margin=0.5+state.visualDrift
        local call=gap>margin and "Out" or gap < -margin and "In" or "Unsure"
        if call~=state.visualCall then state.visualCall,state.visualCallAt=call,now end
        if now-(state.visualCallAt or now)<0.06 then return "Unsure" end
        return call
    end
    local function distanceToSegment(point,a,b)
        local delta=b-a
        local length=delta:Dot(delta)
        if length<1e-9 then return (point-a).Magnitude end
        return (point-(a+delta*math.clamp((point-a):Dot(delta)/length,0,1))).Magnitude
    end
    -- Repeatedly split the worst chord, so a looping curve cannot alias into a straight line.
    function tracker.Polyline(points,maximum,tolerance)
        if #points<=maximum+1 then return points end
        local function interval(first,last)
            local error,index=0,nil
            for i=first+1,last-1 do
                local value=distanceToSegment(points[i],points[first],points[last])
                if value>error then error,index=value,i end
            end
            return {first=first,last=last,error=error,index=index}
        end
        local intervals={interval(1,#points)}
        while #intervals<maximum do
            local selected,worst=nil,tolerance or 0.08
            for i,item in ipairs(intervals)do if item.index and item.error>worst then selected,worst=i,item.error end end
