                    -Vector3.yAxis*(0.5*(context.gravity or 50)*rewind*rewind)
                local handFloor=context.groundY+(context.nativeSetFrame.Position.Y-context.position.Y)
                predicted=Vector3.new(predicted.X,math.max(handFloor,predicted.Y),predicted.Z)
                local reach=(context.radius or 3.9)+(ballRadius or 1.1)+0.35
                if not contact or (contact-predicted).Magnitude<=reach then return predicted end
            end
            return base
        end
        local function median(v)table.sort(v);local n=#v;return n%2==1 and v[(n+1)/2]or(v[n/2]+v[n/2+1])/2 end
        local xs,ys,zs,pitches={},{},{},{}
        for i=1,math.min(9,#rows)do
            local s=rows[i].sample
            xs[#xs+1]=s.bias.X;ys[#ys+1]=s.bias.Y;zs[#zs+1]=s.bias.Z;pitches[#pitches+1]=s.pitchBias
        end
        local bias=Vector3.new(median(xs),median(ys),median(zs));local pitch=median(pitches)
