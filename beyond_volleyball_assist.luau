    function planner.RecentContact(power,now)
        for index=#planner.Models,1,-1 do
            local row=planner.Models[index]
            if row.power==power and now-row.time<=600 and row.height>5 and row.velocity.Z>0
                and math.abs(row.velocity.X)/Vector3.new(row.velocity.X,0,row.velocity.Z).Magnitude<0.26 then
                return row.height
            end
        end
        return nil
    end
    function planner.ContactMatches(plan,ballHeight,rootHeight)
