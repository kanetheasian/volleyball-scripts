    local function collectSpikeDefenders(net,side)
        local defenders,positions={},{}
        for _,other in ipairs(Players:GetPlayers()) do
            local root=other.Character and other.Character:FindFirstChild("HumanoidRootPart")
            local humanoid=other.Character and other.Character:FindFirstChildOfClass("Humanoid")
            if other~=player and root and (not humanoid or humanoid.Health>0) and Core.InCourt(root.Position,net,-6) and Core.Side(root.Position,net)==-side then
                local defender={name=other.Name,position=root.Position,velocity=root.AssemblyLinearVelocity,
                    speed=humanoid and humanoid.WalkSpeed or 24,radius=4}
                for _,block in ipairs(CollectionService:GetTagged("Collision"))do
                    if block.Name=="Block" and block.Parent==other.Character and block:IsA("BasePart")then
                        defender.blocking=true;defender.blockPosition=block.Position
                        defender.blockWidth=math.abs(block.CFrame.RightVector:Dot(net.axis))*block.Size.X
                            +math.abs(block.CFrame.LookVector:Dot(net.axis))*block.Size.Z
                        defender.blockHeight=math.abs(block.CFrame.UpVector.Y)*block.Size.Y
                            +math.abs(block.CFrame.RightVector.Y)*block.Size.X+math.abs(block.CFrame.LookVector.Y)*block.Size.Z
                        defender.blockDepth=math.abs(block.CFrame.RightVector:Dot(net.normal))*block.Size.X
                            +math.abs(block.CFrame.LookVector:Dot(net.normal))*block.Size.Z
                        defender.airborne=humanoid and humanoid.FloorMaterial==Enum.Material.Air
                        break
                    end
                end
                defenders[#defenders+1]=defender;positions[#positions+1]=root.Position
            end
        end
        return defenders,positions
    end
    local function spikePoint(lockedDirection,takeoff)
        api.SpikeTarget=nil
        if config.SpikeMode=="Pinned" then return pinnedPoint end
        if config.SpikeMode=="Mouse" then return mousePoint() end
        local part=getRoot(); if not part then return nil end
        refreshCourts()
        local net=spikeCourt or Core.NearbySpikeCourt(part.Position,courts,10)
        if not net then api.AimReason="No verified court"; return nil end
        local side=spikeOwnSide or Core.Side(part.Position,net); if not side then return nil end
        if (part.Position-net.center):Dot(net.normal)*side< -3.5 then
            api.AimReason="Spike moved beyond its takeoff court";return nil
        end
        local defenders,positions=collectSpikeDefenders(net,side)
        local contact,selectedBall,selectedId,contactEta=part.Position,nil,nil,nil
        local _,humanoid,character=getRoot()
        local spike=character and character:FindFirstChild("Spike")
        local closest=math.huge
        local jumpPower=part.AssemblyLinearVelocity.Y
        if takeoff then
            local ok,value=pcall(jump._calculateJumpPower,jump)
            if ok and Core.Finite(value)then jumpPower=value end
        end
        if spike then
            for id,ball in pairs(ballService.RenderedBallMap._map)do
                local event=ballEvents[id]
                if typeof(ball.Position)=="Vector3" and typeof(ball.Velocity)=="Vector3" and not ball.Dead and not ball.Rolling
                    and (not event or event.owner~=player) and courtAt(ball.Position,true)==net then
                    local prediction=Core.SpikeContact(ball,ballUtils.stepPhysics,spike.Position,part.AssemblyLinearVelocity,
                        jumpPower,workspace.Gravity,spike.Size.X/2+(ball.Radius or 1)+2,takeoff)
                    if prediction and prediction.gap<closest then
                        closest=prediction.gap;contact=prediction.position;selectedBall=ball;selectedId=id;contactEta=prediction.eta
                    end
                end
            end
        end
        local goal=selectedBall and spikePlanner.Plan({origin=contact,net=net,defenders=defenders,margin=config.AimMargin,
            side=side,maxOverNet=(selectedBall.Radius or 1)+2.5,originMargin=10,
            power=actionClient._power.Value,radius=selectedBall.Radius or 1,now=os.clock(),gravity=workspace.Gravity,
            acceleration=selectedBall.Acceleration,contactEta=contactEta,lockedDirection=lockedDirection})
        if goal then goal.ballId=selectedId;goal.contactEta=contactEta;goal.source="Predicted spike contact"end
        if not goal and not lockedDirection and takeoff then
            local height=spikePlanner.RecentContact(actionClient._power.Value,os.clock())
            if height then
                local origin=Vector3.new(part.Position.X,net.floorY+height,part.Position.Z)
                goal=spikePlanner.Plan({origin=origin,net=net,defenders=defenders,margin=config.AimMargin,
                    side=side,maxOverNet=3.5,originMargin=10,
                    power=actionClient._power.Value,radius=1.1,now=os.clock(),gravity=workspace.Gravity})
                if goal then
                    goal.contactEstimated=true;goal.launchCalibrated=goal.calibrated;goal.calibrated=false
                    goal.confidence="Recent contact-height estimate";goal.source="Recent launch takeoff estimate"
                end
            end
        end
        -- Without an impending contact there is no measured launch height to solve from.
        if not goal and not lockedDirection then goal=Core.CourtSpikeTarget(part.Position,net,positions,config.AimMargin,defenders,side,10)end
        if goal then
            local direction=goal.direction or flat(goal.point-part.Position)
            if Core.Side(goal.point,net)~=-side or -direction:Dot(net.normal)*side<=0.001 then
                api.AimReason="Rejected spike heading toward own court";return nil
            end
            goal.court=net.court.Name;goal.net=net;goal.ownSide=side
            api.SpikeTarget=goal
            return goal.point,net,goal
        end
        api.SpikeTarget=nil
        api.AimReason="No clear in-bounds spike forecast at this contact height / power"
        return nil
    end
    local function commitSpikeTakeoff()
        if not api.Alive or not (config.SpikeAim or config.TakeoffAim) or setAim or autoSet and autoSet.IsBusy()
            or jump._blocking.Value or UIS:GetFocusedTextBox() or GuiService.MenuIsOpen then return false end
        local part=getRoot()
        if not part or not jump._originCframe or not jump._tilt then return false end
        local point,net,goal=spikePoint(nil,true)
        if not point then clearSpikeAim();return false end
        local direction=goal and goal.direction or flat(point-part.Position).Unit
        local yaw=CFrame.lookAt(part.Position,part.Position+direction)
        if not spikeTiltOwner then
            spikeTiltOwner=jump;spikeTiltBefore=jump._tiltRot;spikeOriginBefore=jump._originCframe
            spikeBodyOwner=part;spikeBodyBefore=part.CFrame
        end
        spikeLockedYaw=yaw;spikeManualTilt=false
        spikeOriginWritten=yaw
        spikeTiltWritten=CFrame.Angles(goal and goal.pitch or 0,0,goal and goal.roll or 0)
        jump._originCframe=spikeOriginWritten;jump._tiltRot=spikeTiltWritten;jump:_refreshTilt()
        spikeBodyWritten=yaw*spikeTiltWritten;part.CFrame=spikeBodyWritten
        spikePlan=goal or {point=point,net=net};spikePlan.applied=true
        api.LastSpikeTakeoff={point=point,direction=direction,shot=goal and goal.shot,source=goal and goal.source,
            contact=goal and goal.contact,eta=goal and goal.contactEta,ownSide=goal and goal.ownSide,
            court=net and net.court.Name,time=os.clock()}
        lastSpikeUpdate=os.clock();api.Metrics.SpikeYawWrites+=1
        api.AimReason=goal and goal.shot and (goal.shot.." • "..goal.confidence) or "Takeoff heading checked through opponent baseline"
        return true
    end
    local function updateSpikeTilt()
        if not spikePlan or not spikePlan.applied or not spikeLockedYaw or spikeSwingLocked or spikeManualTilt
            or not config.SpikeAim or setAim or autoSet.IsBusy() or jump._blocking.Value
            or UIS:GetFocusedTextBox() or GuiService.MenuIsOpen then return false end
        local previous=api.SpikeTarget
        local point,_,goal=spikePoint(spikeLockedYaw.LookVector)
