                    if authoredBot then selected.predictionLead=plan.time end
                    if validate then delivery,why=api.ChooseDelivery(plan.contact,selected,context.maxPower,plan.jump,ball.Acceleration.Y,ball.Radius,playName,backward)end
                    if delivery and not delivery.uncalibratedTilt then plan.deliveryValidated=true;plan.delivery=delivery;return plan,delivery end
                    if not fallback then fallback,fallbackDelivery=plan,delivery end
                    if not authoredBot then break end
