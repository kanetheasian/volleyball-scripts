    local function updateSpikeDirections()
        local viewer=getRoot()
        local viewerCourt=viewer and courtAt(viewer.Position,true)
        local now,seen=os.clock(),{}
        local courtBalls={}
        if viewerCourt then
            for id,ball in pairs(ballService.RenderedBallMap._map)do
                local net=typeof(ball.Position)=="Vector3"and courtAt(ball.Position,true)
                if net and net.part==viewerCourt.part then courtBalls[id]=ball end
            end
        end
        table.clear(api.SpikeDirections)
        for _,other in ipairs(Players:GetPlayers())do
            seen[other]=true
            local character=other.Character
            local entry=spikeDirectionLines[other]
            if entry and entry.character~=character then entry.line:Destroy();spikeDirectionLines[other]=nil;entry=nil end
            if entry then entry.line.Transparency=1;if entry.stroke then entry.stroke.Visible=false end;if entry.outline then entry.outline.Visible=false end end
            local root=character and character:FindFirstChild("HumanoidRootPart")
            local humanoid=character and character:FindFirstChildOfClass("Humanoid")
            local spike=character and character:FindFirstChild("Spike")
            if config.ShowSpikeDirection and viewer and viewerCourt and root and humanoid and humanoid.Health>0
                and spike and spike:IsA("BasePart") and (root.Position-viewer.Position).Magnitude<=config.VisualDistance then
                local net=courtAt(root.Position,true)
                local ground=net and net.floorY+(humanoid.HipHeight or 0)+root.Size.Y/2
                local airborne=ground and (root.Position.Y>ground+0.5
                    or humanoid.FloorMaterial==Enum.Material.Air and math.abs(root.AssemblyLinearVelocity.Y)>2)
                local spiking=false
                if airborne and net and net.part==viewerCourt.part then
                    if other==player then
                        local sub=jump.SubStateMachine and jump.SubStateMachine:GetCurrent()
                        spiking=machine:GetCurrent()==jump and actionClient:_getAirborneJump()~=nil
                            and not (jump._blocking and jump._blocking.Value)
                            and (not sub or sub.Name~="Block"and sub.Name~="Set"and sub.Name~="SetBack")
                    else
                        entry=entry or {character=character,line=newPart("SpikeDirection_"..other.UserId,Color3.fromRGB(255,230,40)),checked=-math.huge}
                        spikeDirectionLines[other]=entry
                        if now-(entry.checked or -math.huge)>=0.05 then
                            entry.checked=now;entry.spiking=false
                            local animator=humanoid:FindFirstChildOfClass("Animator")
                            for _,track in ipairs(animator and animator:GetPlayingAnimationTracks()or{})do
                                local id=track.Animation and track.Animation.AnimationId:match("%d+")
                                if track.IsPlaying and track.WeightCurrent>0.05 and spikeJumpAnimationIds[id]then entry.spiking=true;break end
                            end
                        end
                        spiking=entry.spiking==true
                    end
                    local block=character:FindFirstChild("Block")
                    local set=character:FindFirstChild("Set")
                    if block and CollectionService:HasTag(block,"Collision")or set and CollectionService:HasTag(set,"Collision")then spiking=false end
                end
                local shot=spikeVisualFlights[other]
                local flightBall=shot and now-shot.time<=3.5 and ballService.RenderedBallMap._map[shot.ballId]
                if flightBall and(flightBall._dying or flightBall._rolling or not ballEvents[shot.ballId]
                    or ballEvents[shot.ballId].owner~=other or ballEvents[shot.ballId].kind~="Spike")then flightBall=nil end
                if spiking or flightBall then
                    local chest=character:FindFirstChild("UpperTorso")or character:FindFirstChild("Torso")
                    local start,finish,ballId,landing,source,calibrated,power
                    if chest and chest:IsA("BasePart")then
                        local origin
                        origin,ballId=Core.SpikeDirectionOrigin(chest.Position,courtBalls,entry and entry.ballId)
                        start,finish=Core.SpikeDirectionSegment(origin,root.CFrame.LookVector,config.SpikeDirectionLength)
                        source=ballId~=nil and "ball_height"or "gameplay_pose"
                        local ball=flightBall or ballId and courtBalls[ballId]
                        if ball and net then
                            entry=entry or {character=character,line=newPart("SpikeDirection_"..other.UserId,Color3.fromRGB(255,230,40))}
                            local aim=entry.forecast
                            local look=root.CFrame.LookVector
                            if not aim or now-aim.time>=0.06 or aim.ball~=ball or aim.confirmed~=(flightBall~=nil)
                                or aim.look:Dot(look)<0.999 then
                                aim={time=now,ball=ball,look=look,confirmed=flightBall~=nil}
                                if flightBall then
                                    local flight=Core.Predict(ball,ballUtils.stepPhysics,3.5,net.floorY+(ball.Radius or 1.1),1/60)
                                    aim.landing=flight.Landing;aim.source="replicated_spike_flight";aim.calibrated=true;aim.power=shot.power
                                else
                                    local observed=playerPowers[other]
                                    power=other==player and actionClient._power.Value
                                        or observed and Core.ObservedPowerText(observed,character,now)and observed.value
                                    local planner=other==player and spikePlanner or spikeVisualModels[other]
                                    local estimate=planner and power and planner.PredictAim({origin=ball.Position,look=look,net=net,
                                        radius=ball.Radius or 1.1,power=power,now=now,character=character,
                                        calibrationScope=other==player and spikeCalibrationScope()or nil,contactHeightTolerance=2.5})
                                    if estimate then aim.landing=estimate.landing;aim.source="measured_spike_landing";aim.calibrated=true;aim.power=power end
                                end
                                entry.forecast=aim
                            end
                            if aim.landing then
                                start=ball.Position;landing=aim.landing
                                finish=Vector3.new(landing.X,net.floorY+0.08,landing.Z)
                                ballId=ball.Id or ballId;source=aim.source;calibrated=aim.calibrated;power=aim.power
                            end
                        end
                    end
                    if start then
                        entry=entry or {character=character,line=newPart("SpikeDirection_"..other.UserId,Color3.fromRGB(255,230,40))}
                        spikeDirectionLines[other]=entry
                        entry.ballId=ballId
                        local length=(finish-start).Magnitude
                        entry.line.Size=Vector3.new(0.18,0.18,length)
                        entry.line.CFrame=CFrame.lookAt((start+finish)*0.5,finish);entry.line.Transparency=1
                        if not entry.stroke then
                            local stroke=Instance.new("LineHandleAdornment")
                            stroke.Name="SpikeAimLine";stroke.Adornee=entry.line
                            stroke.AlwaysOnTop=false;stroke.ZIndex=2;stroke.Thickness=6
                            stroke.Color3=Color3.fromRGB(255,245,60);stroke.Transparency=0
                            stroke.Parent=entry.line;entry.stroke=stroke
                            local outline=Instance.new("LineHandleAdornment")
                            outline.Name="SpikeAimOutline";outline.Adornee=entry.line
                            outline.AlwaysOnTop=false;outline.ZIndex=1;outline.Thickness=10
                            outline.Color3=Color3.fromRGB(15,15,20);outline.Transparency=0
                            outline.Parent=entry.line;entry.outline=outline
                        end
                        local direction=root.CFrame.LookVector
                        entry.stroke.CFrame=CFrame.new(0,0,length/2)
                        entry.stroke.Length=length;entry.stroke.Visible=true
                        entry.stroke.Color3=landing and Color3.fromRGB(255,245,60)or Color3.fromRGB(160,170,185)
                        entry.outline.CFrame=entry.stroke.CFrame
                        entry.outline.Length=length;entry.outline.Visible=true
                        api.SpikeDirections[other]={start=start,finish=finish,source=source,ballId=ballId,line=entry.line,
                            landing=landing,calibrated=calibrated,power=power,
                            shortAim=hitboxUtils.isShortSpike(direction.Y),stroke=entry.stroke,outline=entry.outline}
                    end
                end
            end
        end
        for other,entry in pairs(spikeDirectionLines)do
            if not seen[other]then entry.line:Destroy();spikeDirectionLines[other]=nil end
        end
        for other in pairs(spikeVisualModels)do if not seen[other]then spikeVisualModels[other]=nil;spikeVisualFlights[other]=nil end end
    end
