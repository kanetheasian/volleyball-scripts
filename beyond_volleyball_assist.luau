                    point=best.point,contact=best.contact,contactAt=at+best.time,jumpAt=at+best.jumpAt,
                    glide=best.glide,glideDirection=best.glideDirection,charge=c.charge,airborne=c.airborne,
                    jumpIssued=c.airborne,jumpRequestedAt=c.airborne and at-c.charge or nil,
                    force=c.force,tool=c.tool,plannedAt=at,preview=candidate.preview,previewSource=candidate.source,
                    fromPreview=candidate.preview==true,previewLead=candidate.preview and candidate.launchDelay or nil,
                    play=c.receivedPlay or config.AutoSetPlay,
                    expectedSetAt=candidate.preview and at+(candidate.launchDelay or 0)or nil,
                    contactOffset=best.contactOffset,desiredContactOffset=best.desiredContactOffset,lateCharge=best.lateCharge,
                    overrideOnly=(noWalk and c.force)or not api.Eligible(candidate,false),takeoffDirection=c.airborne and c.facingDirection or nil,
                    rotationLocked=c.airborne==true,timingPhase=best.timingPhase or "Apex"}
                api.Busy=true;api.StagePoint=nil;publish()
                api.LastPlan.preview=job.preview==true
