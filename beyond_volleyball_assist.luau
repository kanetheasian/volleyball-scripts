        if h.Magnitude<1 or incoming.Magnitude<1 or actualH.Magnitude<1 then return false end
        local turn=angle(h.Unit,actualH.Unit)
        if math.abs(turn)>math.rad(6)or (actual.origin-plan.origin).Magnitude>4 then return false end
