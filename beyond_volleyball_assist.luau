    local function landingMargin(context)
        return context.softFlightMargins and context.radius+0.1 or context.landingMargin or context.margin
    end
    function planner.PredictAim(context)
        if not context.look or not context.origin or not context.net or not Core.Finite(context.power)then return nil end
        local direction=flat(context.look)
        if direction.Magnitude<0.01 then return nil end
        local pitch=math.asin(math.clamp(context.look.Unit.Y,-1,1))
