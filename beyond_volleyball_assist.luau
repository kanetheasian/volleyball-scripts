                        Headers={Authorization="Bearer "..transport.token,["Content-Type"]="application/json"},Timeout=2})
                    if not api.Alive then return end
                    if response.StatusCode~=200 and response.StatusCode~=204 then error("Preview HTTP "..tostring(response.StatusCode))end
                    if not setter and response.StatusCode==200 then
                        local payload=json:JSONDecode(response.Body)
                        if api.SourceSession~=payload.session or payload.sequence>api.Received then
                            if not api.Import(payload)then error("Invalid or stale preview snapshot")end
                        end
                    end
                end)
                if ok then failures=0;api.TransportError=nil;api.Stats.NetworkCycles=(api.Stats.NetworkCycles or 0)+1
                else failures+=1;api.TransportError=tostring(err);api.Stats.NetworkErrors=(api.Stats.NetworkErrors or 0)+1 end
                local interval=ok and 0.1 or math.min(2,0.25*2^math.min(3,failures))
                task.wait(math.max(0.01,interval-(os.clock()-started)))
            end
        end)
    else api.Transport=shared and "Shared preview unavailable"or "MCP relay"end
    function api.Destroy()
        if api.CloudLink then api.CloudLink.Destroy()end
        api.Alive=false;connection:Disconnect();if hitConnection then hitConnection:Disconnect()end;folder:Destroy();screen:Destroy()
        if env.BVLSetPreview==api then env.BVLSetPreview=nil end
    end
    return api
end

local function createPreviewViewer(host)
