        local speed=85
        local native=context.launchVelocity and context.launchVelocity(direction,pitch)
        local velocity=native or model and worldVector(model.velocity,direction)
            or direction*(speed*math.cos(pitch))+Vector3.yAxis*(speed*math.sin(pitch))
        if model and not native and (context.cornerOnly or context.dumpAttack or context.autoSpikeAttack)then
            local delta=pitch-(context.autoSpikeAttack and not model.poseAtImpact and model.commandPitch or model.pitch)
            local h,v=model.velocity.Z,model.velocity.Y
            velocity=worldVector(Vector3.new(model.velocity.X,h*math.sin(delta)+v*math.cos(delta),h*math.cos(delta)-v*math.sin(delta)),direction)
        end
        return Core.Predict({Position=context.origin,Velocity=velocity,
            Acceleration=not native and model and model.acceleration or context.acceleration or Vector3.new(0,-25,0),
            Spin=not native and model and worldVector(model.spin,direction) or Vector3.zero},step,3.5,
            context.net.floorY+context.radius,1/60)
