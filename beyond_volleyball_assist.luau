        end
        local base=context.nativeSetFrame.Position+velocity*lead-Vector3.yAxis*(0.5*(context.gravity or 50)*lead*lead)
        local rows={}
        local height=context.position.Y-context.groundY
        for _,s in ipairs(samples or{})do
            if now-s.time>=0 and now-s.time<=600 and s.glide==(context.nativeGlide==true)
                and math.abs(s.height-height)<=1.5 and math.abs(s.verticalSpeed-velocity.Y)<=8
                and s.verticalSpeed*velocity.Y>=-9 and math.abs((s.lead or lead)-lead)<=0.08 then
                rows[#rows+1]={sample=s,score=math.abs(s.height-height)+math.abs(s.verticalSpeed-velocity.Y)*0.08+(now-s.time)*0.0005}
            end
        end
        table.sort(rows,function(a,b)return a.score<b.score end)
