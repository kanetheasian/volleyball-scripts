        if(predicted-serverFrame.Position).Magnitude>.75 then return nil end
        return lag
    end
    function Core.PredictSetPose(samples,context,lead,now,contact,ballRadius,poseLag)
        local velocity=context.velocity or Vector3.zero
        if context.nativeGlide and Core.Finite(poseLag)and poseLag>=0 and poseLag<=.35 then
            local time=lead-poseLag
            local frames=context.nativeSetPoseHistory
