    function api.OnTakeoff(c)
        if not job and config.AutoSpikeMove==false then acquireManualJump(c,true)end
        if not job or job.emergency then return end
        if not job.jumpIssued then
            job.jumpIssued=true;job.jumpRequestedAt=now()-(c.charge or job.charge)
