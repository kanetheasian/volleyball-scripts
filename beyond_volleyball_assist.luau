                    local line=net.attackLines[side]
                    local approach=target.approachPosition or target.position
                    local depth=(approach-net.center):Dot(net.normal)*side
                    local placementDepth=(placement-net.center):Dot(net.normal)*side
                    local preferred=placementDepth+math.min(2.5,math.max(0,depth-line-1.5))
