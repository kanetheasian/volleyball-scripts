            if jumpSet then return jumpSet end
            if host.validateDumpApproach then
                local ground=api.PlanIntercept(ball,context,"Ground",play)
                if ground and not ground.jump then
                    local delivery=api.ChooseEmergency(ground.contact,context.net,context.maxPower,false,ball.Acceleration.Y,ball.Radius,
                        "Spike approach unavailable; hard ground recovery",Core.Side(context.position,context.net),nil,false,true)
