    -- Restore inherited methods as inherited methods; never overwrite a later owner's patch.
    function Core.Patch(object, key, makeWrapper)
        local own, original = rawget(object, key), object[key]
        assert(type(original) == "function", "Missing native method " .. key)
        local wrapper = makeWrapper(original)
        object[key] = wrapper
        local released = false
        return function()
            if released then return end
            released = true
            if rawget(object, key) == wrapper then object[key] = own end
        end
    end
    function Core.JumpPower(nativePower, enabled, multiplier)
        if not enabled or not Core.Finite(nativePower) or nativePower <= 0 then return nativePower end
        return nativePower * math.sqrt(multiplier)
    end
    function Core.DumpJumpPower(model,character,scope,nativePower,now,nearbyGravity)
        if model and model.character==character and model.scope==scope
            and Core.Finite(model.time)and now-model.time>=0 and now-model.time<=3600
            and Core.Finite(model.nativePower)and Core.Finite(model.power)and model.power>0 then
            if math.abs(model.nativePower-nativePower)<=0.15 then return model.power end
            if Core.Finite(nearbyGravity)and nearbyGravity>0 and(model.samples or 0)>=6
                and math.abs(model.nativePower-nativePower)<=2.5 then
                local energy=model.power^2-model.nativePower^2
                if math.abs(energy)<=5*nearbyGravity and nativePower^2+energy>0 then return math.sqrt(nativePower^2+energy)end
            end
        end
        return nativePower
    end
    function Core.SpikeContactLead(models,character,scope,gliding,ping,now,power)
        local rows={}
        for _,row in ipairs(models or{})do
            if row.power==(power or 15) and row.character==character and row.calibrationScope==scope and row.gliding==gliding
                and Core.Finite(row.contactLead)and row.contactLead>=0.04 and row.contactLead<=0.3
                and Core.Finite(row.time)and now-row.time>=0 and now-row.time<=3600 then rows[#rows+1]=row end
        end
        table.sort(rows,function(a,b)return a.time>b.time end)
        local values={}
        for i=1,math.min(7,#rows)do values[#values+1]=rows[i].contactLead end
        if #values==0 then return math.clamp((ping or 0)+0.025,0.04,0.09)end
        table.sort(values)
        return math.clamp(values[math.ceil(#values/2)],0.04,0.18)
    end
    function Core.ObserveDumpJump(observation,height,verticalSpeed,groundY,gravity,now)
        if not observation or not Core.Finite(observation.nativePower)or observation.nativePower<=0
            or not Core.Finite(height)or not Core.Finite(verticalSpeed)or not Core.Finite(groundY)
            or not Core.Finite(gravity)or gravity<=0 or now-observation.start>2.5
            or observation.count>=24 or height-groundY<2 or math.abs(verticalSpeed)>20 then return nil end
        local energy=verticalSpeed^2+2*gravity*(height-groundY)
        local bias=(energy-observation.nativePower^2)/(2*gravity)
        if bias< -2.5 or bias>2.5 then return nil end
        local power=math.sqrt(energy)
        observation.count+=1;observation.sum+=power
        observation.minimum=math.min(observation.minimum,power);observation.maximum=math.max(observation.maximum,power)
        if observation.count<6 or observation.maximum-observation.minimum>0.4 then return nil end
        return {character=observation.character,scope=observation.scope,nativePower=observation.nativePower,
            power=observation.sum/observation.count,time=now,samples=observation.count}
    end
    function Core.FlatFacing(position, target, backward)
        local direction = Vector3.new(target.X - position.X, 0, target.Z - position.Z)
        if direction.Magnitude < 0.01 then return nil end
        return CFrame.lookAt(position, position + direction * (backward and -1 or 1))
