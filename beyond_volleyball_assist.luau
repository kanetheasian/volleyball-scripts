        if jumpPlan and (not ground or ground.time-jumpPlan.time>=Core.SetPlay(playName or config.AutoSetPlay).jumpGain)then return jumpPlan end
        return ground or jumpPlan
    end
    function api.PlanIntercept(ball,context,mode,playName)
        local plan=planPhysical(ball,context,mode,playName)
        if not host.predictJump or not context.targetFacingPoint then return plan end
        local forecast=table.clone(context)
        for _=1,2 do
            if not plan or not plan.jump then break end
            local facing=context.position+flat(context.targetFacingPoint-plan.contact)
            local power=host.predictJump(plan.glide and plan.glideDirection or Vector3.zero,facing,context.backwardSet)
            if not Core.Finite(power)or power<=0 then break end
            plan.nativeJumpPower=power
            if math.abs(power-forecast.jumpPower)<0.15 then break end
            forecast.jumpPower=power
            plan=planPhysical(ball,forecast,mode,playName)
        end
        if plan and plan.jump then plan.nativeJumpPower=forecast.jumpPower end
