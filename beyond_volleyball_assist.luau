    end
    function api.Destroy()release("Unloaded")end
    return api
end

local function createSpikeAim(host)
    local Core,step=host.core,host.stepPhysics
    local planner={Models={},History={},BlockModels=setmetatable({},{__mode="k"})}
    local function flat(v)return Vector3.new(v.X,0,v.Z)end
    local function vector(v)
        return (typeof(v)=="Vector3" or type(v)=="table") and Core.Finite(v.X) and Core.Finite(v.Y) and Core.Finite(v.Z)
    end
    local function localVector(v,forward)
        return Vector3.new(v:Dot(forward:Cross(Vector3.yAxis)),v.Y,v:Dot(forward))
    end
    local function worldVector(v,forward)
        return forward:Cross(Vector3.yAxis)*v.X+Vector3.yAxis*v.Y+forward*v.Z
    end
    function planner.ObserveBlock(actor,frame,incoming,outgoing)
        if not actor or not frame or not vector(incoming)or not vector(outgoing)
            or math.abs(frame.LookVector.Y)>0.08 or math.abs(frame.RightVector.Y)>0.08 then return false end
        local normal=flat(frame.LookVector)
        if normal.Magnitude<0.1 then return false end
        normal=normal.Unit
        local a,b=flat(incoming),flat(outgoing)
        local an,bn=a:Dot(normal),b:Dot(normal)
        local tangent=a-normal*an
        if math.abs(an)<5 or tangent.Magnitude<5 or an*bn>=0 then return false end
        local n,t=-bn/an,(b-normal*bn):Dot(tangent)/tangent:Dot(tangent)
        if not Core.Finite(n)or not Core.Finite(t)or n<0 or n>1.5 or t<0 or t>1.5 then return false end
        local old=planner.BlockModels[actor]
        if old and(math.abs(old.normal-n)>0.12 or math.abs(old.tangent-t)>0.12)then old=nil end
        local count=old and math.min(8,old.count+1)or 1
        planner.BlockModels[actor]={normal=old and old.normal+(n-old.normal)/count or n,
            tangent=old and old.tangent+(t-old.tangent)/count or t,count=count}
        return true
    end
    function planner.ToolRebound(context,contact,incoming,frame,model)
        if not model or model.count<2 or math.abs(frame.LookVector.Y)>0.08 or math.abs(frame.RightVector.Y)>0.08 then return nil end
