    local pendingServeSpin
    local function cancelServeSpin(reason)
        pendingServeSpin=nil
        api.ServeSpinStatus=reason
    end
    local function updateServeSpin()
        local job=pendingServeSpin
        if not job then return end
        if not api.Alive or not config.AutoServeSpin or player.Character~=job.character
            or movement.Character.Value~=job.character then cancelServeSpin("Cancelled");return end
        if job.running then return end
        if not job.spin.Complete or job.spin.Complete.Value then cancelServeSpin("Selection finished");return end
        local now=os.clock()
        if now-job.created>2 then cancelServeSpin("Use manual spin selection");return end
        local current=machine:GetCurrent()
        if not current or current.Name~="Serve" then
            if job.enteredAt then cancelServeSpin("Serve ended")end
            return
        end
        if not job.enteredAt then
            job.enteredAt=now
            local ok,latency=pcall(player.GetNetworkPing,player)
            latency=ok and Core.Finite(latency) and latency or 0
            job.nextAt=now+math.clamp(0.2+latency*2,0.2,0.6)
            api.ServeSpinStatus="Waiting for serve startup"
        end
        if now<job.nextAt then return end
        job.running=true
        task.defer(function()
            if pendingServeSpin~=job then return end
            local active=machine:GetCurrent()
            if not api.Alive or not config.AutoServeSpin or player.Character~=job.character
                or movement.Character.Value~=job.character or not active or active.Name~="Serve" then
                cancelServeSpin("Cancelled");return
            end
            job.selection=job.selection or table.clone(config)
            local ok,completed,result=pcall(Core.StepServeSpin,job.spin,job.selection)
            if pendingServeSpin~=job or not api.Alive then return end
            job.running=false
            if not ok then
                report("serve spin",completed);cancelServeSpin("Use manual spin selection")
            elseif not completed then
                cancelServeSpin("Selection finished")
            elseif result.phase=="horizontal" then
                job.before=result.before
                job.nextAt=os.clock()+0.06
                api.ServeSpinStatus="Horizontal locked; waiting for vertical stop"
            else
                result.before=job.before or result.before
                api.LastServeSpin=result;result.time=os.clock()
                api.Metrics.ServeSpins+=1
                cancelServeSpin("Spin selected; native toss requested")
                print(string.format("[BVL Assist] %s spin: (%.3f, %.3f) -> (%.3f, %.3f)",
                    result.preset,result.before.x,result.before.y,result.x,result.y))
            end
        end)
    end
