        api.Controls.ServeSpinPreset=tabs.Serving:CreatePlayPanel({Name="BVLServeSpinPanel",Prefix="ServeSpin_",
            CurrentValue=config.ServeSpinPreset,Options={"Float","Topspin Left","Topspin Right"},
            Callback=function(name)return api.Set("ServeSpinPreset",name)end})
        tabs.Serving:CreateParagraph({Title="Next toss",Content="Enable, choose a preset, then start a serve at P3 or lower. Wait briefly for serve startup; the two stops run separately. You still aim and hit the toss. Left/right spin presets need gameplay calibration."})
        advanced("Serving")
        number("Serving","ServeSpinSideOffset","Side offset (0–0.45)")
        number("Serving","ServeSpinVerticalOffset","Vertical offset (-0.45–0.45 • negative = upper dot)")
        toggle("Movement","TiltEnabled","Tilt multiplier")
        toggle("Movement","StaminaEnabled","Refill local stamina")
        advanced("Movement")
        number("Movement","JumpMultiplier","Jump height factor (1–4 • default 1.15)")
        number("Movement","TiltMultiplier","Tilt factor (1–4 • default 1.2)")
        toggle("Visuals","Trajectory","Ball flight path • includes spin")
        toggle("Visuals","Landing","Predicted landing and travel time")
        toggle("Visuals","ShowOpponentServe","Opponent serve facing line")
        toggle("Visuals","ShowSpikeDirection","Jumping spiker aim • yellow chest arrow")
        tabs.Visuals:CreateParagraph({Title="Spike direction",Content="Yellow chest arrow follows the root pose used by hits, including pitch and side lean. Steep downward tilt indicates short aim; flatter tilt indicates longer aim. Actual landing also depends on contact height, power and spin. No angle text is shown."})
        toggle("Visuals","SettingHitbox","Setting hitbox")
        toggle("Visuals","SpikeHitbox","Spike hitbox")
        toggle("Visuals","ReceiveHitbox","Receive hitbox")
        toggle("Visuals","PlayerLabels","Last observed hit power • P#")
        tabs.Visuals:CreateParagraph({Title="Power labels",Content="BVL does not broadcast other players' selected power. P# shows each player's last replicated hit power, hidden when unknown or older than 8 seconds."})
        advanced("Visuals")
        tabs.Visuals:CreateParagraph({Title="Full ball path",Content="Every contact refreshes the complete current flight to landing or net contact, with a bounded 12-second forecast. Net rebounds redraw from the next server update. Pending spin or later abilities can still change the predicted path."})
        number("Visuals","VisualDistance","Overlay distance • studs (25–350)")
        number("Visuals","ServeFacingLength","Serve line length • studs (10–200)")
        number("Visuals","SpikeDirectionLength","Chest tilt line length • studs (2–20)")
        number("Visuals","ServeFacingGraceSeconds","Keep line after toss • seconds (0–5)")
        local profileName=""
        local names=profiles.Names()
        local selected=profiles.Data.Selected~="" and profiles.Data.Selected or names[1] or ""
        local profileDropdown,autoloadToggle,libraryStatus
        local function libraryOptions()local options=profiles.Names();return #options>0 and options or {"No saved profiles"}end
        local function refreshLibrary()
            if not profileDropdown or not autoloadToggle or not libraryStatus then return end
            refreshing=true
            profileDropdown:Refresh(libraryOptions(),true)
            profileDropdown:Set({selected~="" and selected or "No saved profiles"})
            autoloadToggle:Set(profiles.Data.AutoLoad~="" and profiles.Data.AutoLoad==selected)
            libraryStatus:Set({Title="Profile library",Content="Startup: "..(profiles.Data.AutoLoad~="" and profiles.Data.AutoLoad or "Off")
                .."\nLoaded: "..(api.LoadedProfile or "Default settings")..(profiles.ReadError and "\n"..profiles.ReadError or "")})
            refreshing=false
        end
        profileDropdown=tabs.Profiles:CreateDropdown({Name="Saved profiles",Options=libraryOptions(),
            CurrentOption={selected~="" and selected or "No saved profiles"},MultipleOptions=false,
            Callback=function(value)
                if refreshing then return end
                local name=type(value)=="table" and value[1] or value
                if not profiles.Data.Profiles[name] then return end
                local ok,reason=profiles.Select(name)
                if ok then selected=name;refreshLibrary() else notify(reason) end
            end})
        local newProfileInput=tabs.Profiles:CreateInput({Name="New profile name",CurrentValue="",PlaceholderText="Name or leave blank to update selected",
            RemoveTextAfterFocusLost=false,Callback=function(value)profileName=value end})
        tabs.Profiles:CreateButton({Name="Save current settings",Callback=function()
            local name=profileName:match("^%s*(.-)%s*$");if name=="" then name=selected end
            local ok,reason=profiles.Save(name,config)
            if ok then selected=profiles.Data.Selected;newProfileInput:Set("");refreshLibrary();notify("Saved "..selected) else notify(reason) end
        end})
        tabs.Profiles:CreateButton({Name="Load selected profile",Callback=function()
            local ok,reason=api.LoadProfile(selected)
            if ok then refreshLibrary();notify("Loaded "..selected) else notify(reason) end
        end})
        autoloadToggle=tabs.Profiles:CreateToggle({Name="Autoload selected profile",CurrentValue=profiles.Data.AutoLoad~="" and profiles.Data.AutoLoad==selected,
            Callback=function(value)
                if refreshing then return end
                local ok,reason=profiles.Select(selected)
                if ok then ok,reason=profiles.SetAutoload(value) end
                if not ok then notify(reason) end
                refreshLibrary()
            end})
        tabs.Profiles:CreateButton({Name="Delete selected profile",Callback=function()
            local ok,reason=profiles.Delete(selected)
            if ok then selected=profiles.Names()[1] or "";refreshLibrary() else notify(reason) end
        end})
        libraryStatus=tabs.Profiles:CreateParagraph({Title="Profile library",Content="Startup: "..(profiles.Data.AutoLoad~="" and profiles.Data.AutoLoad or "Off")})
        refreshLibrary()
        tabs.Profiles:CreateButton({Name="Restore defaults",Callback=function()
            api.ApplyConfig(api.DefaultConfig);api.LoadedProfile=nil;refreshLibrary();notify("Defaults restored")
        end})
        local lastStatus, previousStatus = 0, ""
        connect(RunService.Heartbeat,function()
            if not api.Alive or os.clock()-lastStatus<0.6 or not rayfield:IsVisible() or rayfield:IsTransitioning() then return end
            lastStatus=os.clock()
            local text=string.format("State: %s  •  Balls: %d  •  Courts: %d\nStamina: %s/%s  •  Power: %s\nLast assist: %s  •  Target point: %s\nAim: %s\nDefense: %s",
                api.NativeState or "Idle",api.BallCount or 0,api.CourtCount or 0,tostring(movement.Stamina.Value),tostring(player:GetAttribute("MaxStamina")),
                tostring(actionClient._power.Value),api.LastAction or "none",pinnedPoint and "pinned" or "not pinned",
                api.AimReason or "idle",api.DefenseReason or "paused")
            if config.AutoReceiveMove then text..="\nReceive movement: "..(api.ReceiveMoveReason or "Waiting for medium/hard ball")end
            if config.ReceiveAim then text..="\nReceive destination: "..(config.ReceiveAimMode=="Middle front" and "Middle front" or config.ReceiveTarget)end
            if next(api.Errors) then local scope,message=next(api.Errors); text..="\n"..scope..": "..message end
            if config.AutoServeSpin then text..="\nServe spin: "..(api.ServeSpinStatus or "Waiting for next toss")end
            text..="\nAuto Set: "..((config.AutoSet or api.AutoSetOverride) and "On" or "Off").." • "..config.AutoSetPlay.." → "..selectedHitterLabel()
            text..="\nMovement lead: "..(config.SetLeadEnabled and "On" or "Off")
            if config.AutoSetSpikeDump then
                text..="\nSpike dump: "..tostring(api.SpikeCalibrationCount()).." P15 samples"
                if api.SpikeDumpDebug then text..=" • "..api.SpikeDumpDebug.stage end
                if api.SpikeCalibrationSaveStatus then text..="\n"..api.SpikeCalibrationSaveStatus end
            end
            if config.AutoSet or api.AutoSetOverride then
                local recovery=autoSet.IsBusy() and autoSet.LastPlan and autoSet.LastPlan.recovery and " • recovery set" or ""
                text..="\nAuto Set ["..config.AutoSetPlay..recovery..(api.DumpHeld and " • HOLD DUMP" or api.AutoSetOverride and " • HOLD OVERRIDE" or "").."] → "..config.AutoSetTarget..": "..(autoSet.Status or "Waiting for team first touch")
                if autoSet.IsBusy() and autoSet.LastPlan and autoSet.LastPlan.jumpReason then text..="\n"..autoSet.LastPlan.jumpReason end
                if autoSet.IsBusy() and autoSet.LastPlan and autoSet.LastPlan.waitReason then text..="\n"..autoSet.LastPlan.waitReason end
                if autoSet.IsBusy() and autoSet.LastPlan and autoSet.LastPlan.emergency then
                    text..="\n"..autoSet.LastPlan.deliveryPlay..": "..(autoSet.LastPlan.emergencyReason or "Hitter unavailable")
                if autoSet.LastPlan.bestEffortCorner then text..=" • best-effort corner"end
                if autoSet.LastPlan.loftValidated==false then text..=" • reduced-height fallback"end
                if autoSet.LastPlan.safeLanding==false then text..=" • landing unvalidated"end
                end
            end
            if text~=previousStatus then status:Set({Title="Live status",Content=text}); previousStatus=text end
        end)
    end,debug.traceback)
    if not ok then api.Destroy(); error("BVL GUI startup failed: "..tostring(err)) end
    -- RAYFIELD_UI_END
    return api
end

return createBVLAssist(createCore(installSetTargetLead), function(source) return extendRayfieldSource(prepareRayfieldSource(source)) end, createProfileLibrary, createVisualForecast, createAutoSet, createSpikeAim)
