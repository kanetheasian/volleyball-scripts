        for _,model in ipairs(bots and bots:GetChildren()or{})do
            local name=model:GetAttribute("HitboxName")
            local part=model.FindFirstChild and model:FindFirstChild(name)or model.PrimaryPart
            if model:GetAttribute("Enabled")==true and(name=="Receive"or name=="Block")and part
                and Core.InCourt(part.Position,net,-6)and Core.Side(part.Position,net)==-side then
