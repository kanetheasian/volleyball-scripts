    do
    local serveFacingPart=newPart("OpponentServeFacing",Color3.fromRGB(255,104,204))
    local serving,serveCharacter,serveCourt,serveReadyAt,serveScanAt,serveObservedReady,serveSource,serveBallId
    hideServeFacing=function()
        serveFacingPart.Transparency=1
