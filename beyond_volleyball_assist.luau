        -- or when a solid immediate catch is already inside the native volume.
        if receive then
            if context.centeredReceive and not receive.Solid then
                local deadline=math.max(receiveLead*0.75,(config.ReceiveTurnLead or 0.12)+(context.ping or 0)
                    +2*(context.dt or 1/60)+(config.ReceiveActivationPadding or 0.035))
                if receive.ETA>deadline then return nil,"Centering before receive: outside contact predicted",receive end
                receive.CenterFallback=true
            end
            if config.AutoReceive and not context.receiving and receive.ETA<=receiveLead then return receive,"receive entry" end
            return nil,"receive can reach",receive
        end
        if dive then return dive,"intercept" end
        return nil,"outside dive reach"
    end
    function Core.AddSetPoseSample(samples,sample)
        if not sample.bias or not Core.Finite(sample.bias.Magnitude)or sample.bias.Magnitude>3
            or not Core.Finite(sample.pitchBias)or math.abs(sample.pitchBias)>math.rad(5)
            or not Core.Finite(sample.height)or not Core.Finite(sample.verticalSpeed)
            or not Core.Finite(sample.time)or not Core.Finite(sample.lead)then return false end
        samples[#samples+1]=sample
        if #samples>40 then table.remove(samples,1)end
        return true
    end
    function Core.MeasureSetPoseLag(context,serverFrame)
        if not context.nativeGlide or not context.nativeSetFrame or not serverFrame then return nil end
        local velocity=context.velocity or Vector3.zero
        local horizontal=flat(velocity)
        if horizontal.Magnitude<4 then return nil end
        local frames=context.nativeSetPoseHistory
        local at=context.nativeSetPoseTime
        if frames and Core.Finite(at)then
            local best,bestError
            for i=2,#frames do
                local a,b=frames[i-1],frames[i]
                local delta=b.position-a.position
                if b.time>a.time and at-a.time>=0 and at-b.time<=.35 and delta.Magnitude>.001 then
                    local alpha=math.clamp((serverFrame.Position-a.position):Dot(delta)/delta:Dot(delta),0,1)
                    local error=(a.position+delta*alpha-serverFrame.Position).Magnitude
                    local lag=at-(a.time+(b.time-a.time)*alpha)
                    if lag>=0 and lag<=.35 and(not bestError or error<bestError)then best=lag;bestError=error end
                end
            end
            if best and bestError<=.75 then return best end
        end
