            -- Do not chase the top edge of the tilted box. Leave room for
            -- native pose/arrival differences, then meet the descending ball.
            if context.unconditionalDump then verticalLimit-=0.9 end
            if vertical<0.5 or vertical>verticalLimit then continue end
            local contactPoint=point
            local requestPoint,takeoffPoint=point,nil
            local glideDistance,chargeDistance
            local travel=distance/math.max(1,context.speed)+0.15
            if motion.glide then
                glideDistance=motion.speed*math.max(0,airTime+spikeLead-poseLag)
                -- Short offsets can be contacted behind the moving hand instead
                -- of forcing a walk directly beneath the ball before jumping.
                -- The run-up stops within 0.85 studs of its request point.
                -- Reserve that displacement before shifting contact behind
                -- the ball, or a legal forecast can glide past native reach.
                local horizontalReach=context.contactSize and math.min(context.contactSize.X,context.contactSize.Z)/2+(ball.Radius or 1.1)-0.35
                    or math.sqrt(math.max(0,radius*radius-vertical*vertical))
                local reach=math.max(0,horizontalReach-1)*0.85
                if context.unconditionalDump then reach=math.min(reach,0.75)end
                chargeDistance=(context.chargeSpeed or context.approachSpeed)*context.charge
                local shift=math.clamp(glideDistance+chargeDistance-distance,0,reach)
                contactPoint=point+motion.direction*shift
                takeoffPoint=contactPoint-motion.direction*glideDistance
                requestPoint=takeoffPoint-motion.direction*chargeDistance
                local clientPoint=contactPoint+motion.direction*motion.speed*poseLag
                if(requestPoint-context.net.center):Dot(context.net.normal)*side<margin
                    or(takeoffPoint-context.net.center):Dot(context.net.normal)*side<margin
                    or(contactPoint-context.net.center):Dot(context.net.normal)*side<margin
                    or(clientPoint-context.net.center):Dot(context.net.normal)*side<margin
                    or not context.allowOutside and(not Core.InCourt(requestPoint,context.net,0.5)or not Core.InCourt(takeoffPoint,context.net,0.5))then continue end
                travel=flat(requestPoint-context.position).Magnitude/math.max(1,context.speed)+0.08
            end
            local hand=contactPoint+setOffset+Vector3.yAxis*impactRise
            if context.contactFrame and context.contactSize then
                local offset=shapeFrame:PointToObjectSpace(sim.Position-hand)
                if not Core.BoxBallOverlap(offset,context.contactSize,math.max(0,(ball.Radius or 1.1)-0.35))then continue end
            elseif(sim.Position-hand).Magnitude>radius then continue end
            if travel<=jumpAt then
                local candidate={point=requestPoint,contact=sim.Position,time=time,jump=true,jumpAt=jumpAt,travel=travel,
                    rise=rise,peakContact=true,dumpWaiting=true,nativeJumpPower=motion.nativePower,dumpJumpPower=motion.power,dumpAirTime=airTime,
                    dumpSpikeLead=spikeLead,dumpImpactRise=impactRise,dumpPower=pose and pose.power,dumpPoseLag=poseLag,
                    glide=motion.glide,glideDirection=motion.direction,glideSpeed=motion.glide and motion.speed or nil,
                    contactPoint=motion.glide and contactPoint or nil,takeoffPoint=takeoffPoint,glideDistance=glideDistance,
                    chargeDistance=chargeDistance,glideAirTime=motion.glide and airTime+spikeLead or nil,
                    movementRank=(context.dumpMotion=="Glide"or distance>closeLimit)and not motion.glide and 1 or 0,
                    dumpMeasuredPhase=pose~=nil,dumpContactVerticalSpeed=contact.verticalSpeed}
                if context.unconditionalDump then
                    candidate.apexError=math.abs(airTime-motion.power/context.gravity)
                    candidate.reachMargin=verticalLimit-vertical+0.9
                    candidate.backwardGlide=motion.glide and motion.direction:Dot(-context.net.normal*side)<-0.1 or false
                    candidate.phaseFallback=contact.fallback==true
                    candidate.approachDistance=flat(requestPoint-context.position).Magnitude
                    candidate.glideOctant=motion.octant
                    candidate.aimAlignment=motion.glide and motion.direction:Dot(attackFacing)or 1
                    -- One stud is the maximum aim preference. A shorter
                    -- diagonal approach wins over walking away to manufacture
                    -- a forward/sideways glide with a prettier attack angle.
                    candidate.approachScore=candidate.approachDistance+0.5*(1-candidate.aimAlignment)
                end
                if not host.validateDumpApproach then return candidate end
                candidates[#candidates+1]=candidate
            end
            end
            end
        end
        if context.unconditionalDump then
            local highest=-math.huge
            for _,candidate in ipairs(candidates)do if candidate.glide and not candidate.phaseFallback then highest=math.max(highest,candidate.contact.Y)end end
            if highest==-math.huge then for _,candidate in ipairs(candidates)do highest=math.max(highest,candidate.contact.Y)end end
            for _,candidate in ipairs(candidates)do candidate.contactBand=math.max(0,math.floor((highest-candidate.contact.Y)/1.5))end
        end
        -- Compare the eight approaches within the same high-contact band.
        table.sort(candidates,function(a,b)
            if a.movementRank~=b.movementRank then return a.movementRank<b.movementRank end
            if context.unconditionalDump and a.phaseFallback~=b.phaseFallback then return not a.phaseFallback end
            if context.unconditionalDump and a.contactBand~=b.contactBand then return a.contactBand<b.contactBand end
            if context.unconditionalDump and a.approachScore~=b.approachScore then return a.approachScore<b.approachScore end
            if a.contact.Y~=b.contact.Y then return a.contact.Y>b.contact.Y end
            if context.unconditionalDump then
                if a.apexError~=b.apexError then return a.apexError<b.apexError end
                if a.jumpAt~=b.jumpAt then return a.jumpAt<b.jumpAt end
            end
            if a.time~=b.time then return a.time<b.time end
            return (a.dumpContactVerticalSpeed or 0)>(b.dumpContactVerticalSpeed or 0)
        end)
        -- A long list of rejected P15 heights must not starve a measured
        -- lower-power shot before the receive's takeoff deadline.
        local buckets,powers={},{}
        for _,candidate in ipairs(candidates)do
            local key=candidate.dumpPower or 15
            if not buckets[key]then buckets[key]={};powers[#powers+1]=key end
            buckets[key][#buckets[key]+1]=candidate
        end
        if #powers>1 then
            table.sort(powers,function(a,b)return a>b end)
            local mixed,index={},1
            while #mixed<#candidates do
                for _,power in ipairs(powers)do
                    local candidate=buckets[power][index]
                    if candidate then mixed[#mixed+1]=candidate end
                end
                index+=1
            end
            candidates=mixed
        end
        local count=#candidates
        search.candidates=count
        if count==0 then search.cursor=0;nextRoute(true);api.DumpHeadingPending=glideOnly and not search.glideExhausted;return nil end
        local start=search.cursor%count
        for offset=0,count-1 do
            if budgetSpent()and not context.unconditionalDump then nextRoute();return nil end
            local index=(start+offset)%count+1
            local candidate=candidates[index]
            local goal=host.validateDumpApproach(ball,context,candidate)
            search.cursor=index;search.tested=(search.tested or 0)+1
            if goal then
                if host.predictJump then
                    local actual=host.predictJump(candidate.glideDirection or Vector3.zero,context.position+goal.direction*60,false)
                    if Core.Finite(actual)and actual>0 and math.abs(actual-candidate.nativeJumpPower)>0.15 then
                        search.facingDirection=goal.direction;search.headingUpdates=(search.headingUpdates or 0)+1
                        search.cursor=0;search.routeCursors={};search.routeDone={};search.glideExhausted=nil;api.DumpHeadingPending=true
                        return nil
                    end
                end
                search.cursor=0
                candidate.spikeAimPoint=candidate.contact+goal.direction*60
                candidate.spikePreflightPitch=goal.pitch
                candidate.spikePreflightValidated=true
                return candidate
            end
        end
        search.cursor=0;nextRoute(true);api.DumpHeadingPending=glideOnly and not search.glideExhausted
    end
    local function planPhysical(ball,context,mode,playName)
        local sim={Position=ball.Position,Velocity=ball.Velocity,Acceleration=ball.Acceleration or Vector3.zero,Spin=ball.Spin or Vector3.zero}
        local ground,jumpPlan,glidePlan
        local radius=context.radius+(ball.Radius or 1)-0.8
        local groundRadius=context.radius+(ball.Radius or 1)-0.15
        local centerY=context.groundY+context.setOffset.Y
        local peak=context.jumpPower^2/(2*context.gravity)
        local side=Core.Side(context.position,context.net)
        local netMargin=math.max(1.6,context.netMargin or 1.6)
        if not side or radius<=0 then return nil end
        local dt=context.interceptStep or 1/30
        for index=1,math.ceil(2.8/dt)do
            if budgetSpent()then break end
            if context.interceptForecast then
                local frame=context.interceptForecast[index]
                if not frame then break end
                sim.Position,sim.Velocity=frame.position,frame.velocity
            else sim.Position,sim.Velocity=stepPhysics(sim,dt)end
            local time=index*dt
            if sim.Position.Y<context.net.floorY+(ball.Radius or 1)then break end
            local depthFromNet=flat(sim.Position-context.net.center):Dot(context.net.normal)*side
            local aboveNet=not context.net.topY or sim.Position.Y-(ball.Radius or 1)>=context.net.topY+0.1
            if math.abs(depthFromNet)<(ball.Radius or 1)+0.1 and not aboveNet then break end
            if (sim.Velocity.Y<0 or context.shallowJumpSupport)and (context.allowOutside or Core.InCourt(sim.Position,context.net,-radius+0.5))
                and (depthFromNet>0 or aboveNet and depthFromNet>=-radius+netMargin)then
                local point=Vector3.new(sim.Position.X-context.setOffset.X,context.groundY,sim.Position.Z-context.setOffset.Z)
                local net=context.net
                local offset=flat(point-net.center)
                local across=context.allowOutside and offset:Dot(net.axis) or math.clamp(offset:Dot(net.axis),-net.halfWidth+0.5,net.halfWidth-0.5)
                local depth=(context.allowOutside and math.max(netMargin,offset:Dot(net.normal)*side) or math.clamp(offset:Dot(net.normal)*side,netMargin,net.halfDepth-0.5))*side
                local bounded=net.center+net.axis*across+net.normal*depth
                point=Vector3.new(bounded.X,context.groundY,bounded.Z)
                local horizontalGap=flat(sim.Position-(point+context.setOffset)).Magnitude
                local verticalReach=math.sqrt(math.max(0,radius*radius-horizontalGap*horizontalGap))
                local groundReach=math.sqrt(math.max(0,groundRadius*groundRadius-horizontalGap*horizontalGap))
                local distance=flat(point-context.position).Magnitude
                local travel=distance/math.max(context.speed,1)+0.12
                local dy=sim.Position.Y-centerY
                local standingCenter=Vector3.new(context.position.X,context.groundY,context.position.Z)+context.setOffset
                if host.contactRecovery and not context.dump and not context.airborne and not jumpPlan and mode~="Ground"
                    and time>=(context.minimumInterceptTime or 0)then
                    local apexTime=context.jumpPower/context.gravity
                    local phaseTime=context.preferredSetAirTime or apexTime
                    local phaseRise=context.jumpPower*phaseTime-.5*context.gravity*phaseTime^2
                    local jumpAt=time-context.charge-phaseTime
                    local verticalGap=dy-phaseRise
                    if jumpAt>=0.05 and math.abs(verticalGap)<radius then
                        local delta=flat(sim.Position-standingCenter)
                        local reach=math.max(0,math.sqrt(radius*radius-verticalGap*verticalGap)-0.2)
                        local needed=math.max(0,delta.Magnitude-reach)
                        local edge=Vector3.new(context.position.X,context.groundY,context.position.Z)
                            +(delta.Magnitude>0.01 and delta.Unit*needed or Vector3.zero)
                        local depth=(edge-net.center):Dot(net.normal)*side
                        if depth<netMargin then edge+=net.normal*side*(netMargin-depth)end
                        local gap=flat(sim.Position-(edge+context.setOffset)).Magnitude
                        local arrival=flat(edge-context.position).Magnitude/math.max(context.speed,1)+0.12
                        if arrival+(context.jumpArrivalMargin or 0)<=jumpAt
                            and gap*gap+verticalGap*verticalGap<=radius*radius
                            and(context.allowOutside or Core.InCourt(edge,net,0.5))then
                            jumpPlan={point=edge,contact=sim.Position,time=time,jump=true,jumpAt=jumpAt,
                                travel=arrival,rise=phaseRise,peakContact=context.preferredSetAirTime==nil,edgeContact=true,
                                setAirTime=context.preferredSetAirTime,risingContact=context.preferredSetAirTime~=nil}
                        end
                    end
                end
                if host.courtRecovery and not context.dump and not context.airborne and not ground
                    and time>=(context.minimumInterceptTime or 0)and math.abs(dy)<groundRadius then
                    local delta=flat(sim.Position-standingCenter)
                    local reach=math.max(0,math.sqrt(groundRadius*groundRadius-dy*dy)-0.35)
                    local needed=math.max(0,delta.Magnitude-reach)
                    local rescuePoint=Vector3.new(context.position.X,context.groundY,context.position.Z)
                        +(delta.Magnitude>0.01 and delta.Unit*needed or Vector3.zero)
                    local depth=(rescuePoint-net.center):Dot(net.normal)*side
                    if depth<netMargin then rescuePoint+=net.normal*side*(netMargin-depth)end
                    local reachGap=flat(sim.Position-(rescuePoint+context.setOffset)).Magnitude
                    local arrival=flat(rescuePoint-context.position).Magnitude/math.max(context.speed,1)+0.12
                    if arrival<=time and reachGap*reachGap+dy*dy<=groundRadius*groundRadius
                        and(context.allowOutside or Core.InCourt(rescuePoint,net,0.5))then
                        ground={point=rescuePoint,contact=sim.Position,time=time,jump=false,travel=arrival,groundReachSave=true}
                        if mode=="Ground"then return ground end
                    end
                end
                if context.normalStandingReach and not ground and time>=(context.minimumInterceptTime or 0) and not context.airborne
                    and dy>=-groundRadius*0.2 and (sim.Position-standingCenter).Magnitude<=groundRadius then
                    ground={point=Vector3.new(context.position.X,context.groundY,context.position.Z),contact=sim.Position,time=time,jump=false,travel=0,standingReach=true}
                    if mode=="Ground"then return ground end
                end
                if not ground and time>=(context.minimumInterceptTime or 0) and horizontalGap<groundRadius and dy>=-groundReach*0.2 and dy<=groundReach and travel<=time then
                    ground={point=point,contact=sim.Position,time=time,jump=false,travel=travel}
                    if mode=="Ground" then return ground end
                end
                local rise=dy-verticalReach*0.85
                if context.shallowJumpSupport then
                    local minimumAir=context.minimumJumpSetAirTime or 0.12
                    local earlyRise=context.jumpPower*minimumAir-0.5*context.gravity*minimumAir^2
                    if context.minimumJumpSetAirTime then rise=math.max(1.5,rise,earlyRise)
                    else rise=math.max(1.5,rise,math.min(earlyRise,dy+verticalReach))end
                end
                if context.preferredSetAirTime then
                    local phase=context.preferredSetAirTime
                    rise=context.jumpPower*phase-.5*context.gravity*phase^2
                end
                local overNet=depthFromNet<=0
                if (not jumpPlan or not glidePlan and config.AutoSetGlide and context.glideSpeed) and time>=(context.minimumInterceptTime or 0) and horizontalGap<radius and rise>=1.5 and rise<=peak*0.98
                    and (not context.shallowJumpSupport or rise<=dy+verticalReach)
                    and (not context.preferredSetAirTime or math.abs(dy-rise)<=verticalReach)
                    and (not overNet or centerY+rise>(context.net.topY or 0)+0.25)then
                    local airTime=(context.jumpPower-math.sqrt(math.max(0,context.jumpPower^2-2*context.gravity*rise)))/context.gravity
                    local nearNet=math.abs(depthFromNet)<radius+3 and (not context.net.topY or sim.Position.Y>context.net.topY)
                    local takeoffLead=not context.preferredSetAirTime and nearNet and math.clamp(0.22+(context.ping or 0)*2,0.22,0.35) or 0
                    local jumpAt=time-context.charge-airTime-takeoffLead
                    local apexTime=context.jumpPower/context.gravity
                    local apexJumpAt=time-context.charge-apexTime
                    local ownSideGlide=host.contactRecovery and depthFromNet>=netMargin and aboveNet
                    if not glidePlan and config.AutoSetGlide and mode~="Ground" and (not nearNet or ownSideGlide)and not context.airborne
                        and not context.manualSteering and (context.glideSpeed or 0)>0 and (context.approachSpeed or 0)>0 and distance>3 then
                        local direction=flat(point-context.position).Unit
                        local times={airTime}
                        if not context.preferredSetAirTime and math.abs(dy-peak)<=verticalReach then table.insert(times,1,apexTime)end
                        for _,glideAirTime in ipairs(times)do
                            local requestAt=time-context.charge-glideAirTime
                            local glideDistance=context.glideSpeed*glideAirTime
                            local chargeDistance=(context.chargeSpeed or context.approachSpeed)*context.charge
                            local takeoffPoint=point-direction*glideDistance
                            local requestPoint=takeoffPoint-direction*chargeDistance
                            local runDistance=distance-glideDistance-chargeDistance
                            local runTime=flat(requestPoint-context.position).Magnitude/math.max(context.speed,1)+0.08
                            local minimumRun=context.spikeApproach and -3 or 0
                            if runDistance>=minimumRun and requestAt>=0.05 and runTime+(context.jumpArrivalMargin or 0)<=requestAt
                                and (context.allowOutside or Core.InCourt(requestPoint,net,0.5) and Core.InCourt(takeoffPoint,net,0.5))
                                and (requestPoint-net.center):Dot(net.normal)*side>=netMargin
                                and (takeoffPoint-net.center):Dot(net.normal)*side>=netMargin then
                                glidePlan={point=requestPoint,contactPoint=point,takeoffPoint=takeoffPoint,contact=sim.Position,
                                    time=time,jump=true,jumpAt=requestAt,travel=runTime,glide=true,glideDirection=direction,
                                    glideDistance=glideDistance,chargeDistance=chargeDistance,glideAirTime=glideAirTime,
                                    peakContact=glideAirTime==apexTime,rise=rise,takeoffLead=0}
                                break
                            end
                        end
                    end
                    local peakContact=not context.preferredSetAirTime and not nearNet and math.abs(dy-peak)<=verticalReach and apexJumpAt>=0.05 and travel+(context.jumpArrivalMargin or 0)<=apexJumpAt
                    if peakContact then jumpAt=apexJumpAt;rise=peak;takeoffLead=0 end
                    if not jumpPlan and travel+(context.jumpArrivalMargin or 0)<=jumpAt and jumpAt>=0.05 then
                        jumpPlan={point=point,contact=sim.Position,time=time,jump=true,jumpAt=jumpAt,travel=travel,rise=rise,takeoffLead=takeoffLead,peakContact=peakContact,
                            setAirTime=context.preferredSetAirTime,risingContact=context.preferredSetAirTime~=nil}
                    end
                end
            end
        end
        if mode=="Ground" then return ground end
        -- A glide is useful when it reaches a contact the standing jump cannot.
        -- Do not replace an equally early reachable jump with extra charge/runup
        -- motion that can carry the setter beyond a nearby receive.
        local standingEarlier=host.jumpFirst and not context.dump and jumpPlan and glidePlan and jumpPlan.time<=glidePlan.time+1/30
        if not standingEarlier then jumpPlan=glidePlan or jumpPlan end
        if mode=="Jump"then
            if context.requireJump then return jumpPlan end
            return jumpPlan or ground
        end
        if jumpPlan and (not ground or ground.time-jumpPlan.time>=Core.SetPlay(playName or config.AutoSetPlay).jumpGain)then return jumpPlan end
        return ground or jumpPlan
    end
    function api.PlanIntercept(ball,context,mode,playName)
        if host.courtRecovery and not context.dump and mode~="Ground"and(playName or config.AutoSetPlay)=="Normal"then
            context=table.clone(context);context.shallowJumpSupport=true
            local lead=api.SetActionLead(context,true,context.backwardSet)
            context.minimumJumpSetAirTime=math.max(0.12,lead+math.max(1/15,context.ping or 0))
            context.jumpArrivalMargin=math.max(0.08,(context.ping or 0)*2+1/30)
            if context.preferredSetAirTime then
                local apex=context.jumpPower/context.gravity
                if context.minimumJumpSetAirTime>=apex-.02 then return nil end
                context.preferredSetAirTime=math.clamp(context.preferredSetAirTime,context.minimumJumpSetAirTime,apex-.02)
            end
        end
        local plan=planPhysical(ball,context,mode,playName)
        if not host.predictJump or not context.targetFacingPoint then return plan end
        local forecast=table.clone(context)
        local nativePower
        for _=1,2 do
            if not plan or not plan.jump then break end
            local facing=context.position+flat(context.targetFacingPoint-plan.contact)
            local power=host.predictJump(plan.glide and plan.glideDirection or Vector3.zero,facing,context.backwardSet)
            if not Core.Finite(power)or power<=0 then break end
            nativePower=power
            if context.dumpJumpMotion and host.measuredDumpJump then power=host.measuredDumpJump(power,plan.glide==true)end
            plan.nativeJumpPower=power
            if math.abs(power-forecast.jumpPower)<0.15 then break end
            forecast.jumpPower=power
            plan=planPhysical(ball,forecast,mode,playName)
        end
        if plan and plan.jump then plan.nativeJumpPower=context.dumpJumpMotion and nativePower or forecast.jumpPower end
        return plan
    end
    function api.ContactWindow(ball,context,horizon)
        local sim={Position=ball.Position,Velocity=ball.Velocity,Acceleration=ball.Acceleration or Vector3.zero,Spin=ball.Spin or Vector3.zero}
        local radius=context.radius+(ball.Radius or 1.1)
        local window
        local dt=1/120
        for index=0,math.ceil(horizon/dt)do
            local time=index*dt
            local center=context.setPosition
            if context.airborne then
                local velocity=context.velocity or Vector3.new(0,context.verticalVelocity or 0,0)
                local poseTime=time-(context.poseLag or 0)
                local dy=velocity.Y*poseTime-0.5*context.gravity*poseTime*poseTime
                dy=math.max(dy,context.groundY+context.setOffset.Y-center.Y)
                center+=Vector3.new(velocity.X*poseTime,dy,velocity.Z*poseTime)
            elseif context.predictGroundMotion and context.velocity then
                center+=flat(context.velocity)*time
            end
            local inside
            if context.contactFrame and context.contactSize then
                local offset=context.contactFrame:PointToObjectSpace(sim.Position-center+context.setPosition)
                inside=Core.BoxBallOverlap(offset,context.contactSize,ball.Radius or 1.1)
            else inside=(sim.Position-center).Magnitude<=radius end
            if inside and context.minimumContactY and sim.Position.Y-center.Y<context.minimumContactY then inside=false end
            if inside and not window then window={enter=time,contact=sim.Position}end
            if window and not inside then window.exit=time;return window end
            sim.Position,sim.Velocity=stepPhysics(sim,dt)
        end
        if window then window.exit=horizon end
        return window
    end
    function api.DeliverySetPose(context,plan,lead,launch,ballRadius)
        local pendingTakeoff=context.airborne and plan.jump and lead>0.15 and plan.rise and context.setOffset
            and context.position.Y-context.groundY<0.5 and math.abs((context.velocity or Vector3.zero).Y)<2
            and (context.jumpAirAge or math.huge)<0.08
        if not context.airborne or pendingTakeoff then
            if plan.jump and plan.rise and context.setOffset then
                return (plan.contactPoint or plan.point)+context.setOffset+Vector3.yAxis*plan.rise
            end
            if context.setOffset then return plan.point+context.setOffset end
        end
        if host.predictSetPose then return host.predictSetPose(context,lead,launch,ballRadius,plan.backSet)end
        return context.nativeSetFrame.Position+(context.velocity or Vector3.zero)*lead
            -Vector3.yAxis*(0.5*(context.gravity or 50)*lead*lead)
    end
    function api.PrimeFacing(context,target)
        if context.manualSteering or context.manual then
            if api.PrimedFacing then api.PrimedFacing=nil;if not job then host.release()end end
            return
        end
        local incoming=false
        for _,candidate in ipairs(context.balls or{})do if Core.AutoSetEligible(candidate,false)then incoming=true;break end end
        if not incoming then
            if api.PrimedFacing then api.PrimedFacing=nil;if not job then host.release()end end
            return
        end
        if not host.idleFacing or context.airborne or context.state or context.manualSteering or context.manual
            or not target or target.emergencyOnly or context.dump or context.override then return end
        local point=api.PlayPlacement(context.setPosition,target,config.AutoSetPlay or "Normal")
        if not point then return end
        local direction=flat(point-context.setPosition)
        if direction.Magnitude<0.5 then return end
        direction=direction.Unit
        local facing=context.position+direction*60
        local ready=host.facingReady and host.facingReady(facing,false)==true
        local previous=api.PrimedFacing
        local same=previous and previous.character==context.character and previous.target==target.name
            and previous.play==config.AutoSetPlay and previous.direction:Dot(direction)>=math.cos(math.rad(3))
        host.face(facing,false)
        api.PrimedFacing={character=context.character,target=target.name,play=config.AutoSetPlay,direction=direction,
            since=ready and same and previous.since or host.now(),updated=host.now()}
    end
    function api.ImmediateGroundIntercept(ball,context,target,play,backward)
        if not host.contactRecovery or context.airborne or context.state or not context.setPosition then return nil end
        local probe=table.clone(context);probe.predictGroundMotion=true
        local window=api.ContactWindow(ball,probe,0.4)
        if not window or window.enter>0.15 then return nil end
        local lead=api.SetActionLead(context,false,backward)
        local time=math.max(window.enter,lead+1/120)
        if window.exit<time+1/120 then return nil end
        local origin=Core.AdvanceBall(ball,stepPhysics,time).Position
        local choice=api.ResolveDelivery(origin,target,context,ball,false,play,backward,time)
        if not choice or choice.emergency or not api.HitterCanArrive(target,choice,time)then return nil end
        return {point=Vector3.new(context.position.X,context.groundY,context.position.Z),contact=origin,time=time,
