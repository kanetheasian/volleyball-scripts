        local identity=target.object or target.name
        if not state or state.ballId~=ball.Id or state.target~=identity or state.arc~=config.AutoSetNormalArc then
            state={ballId=ball.Id,target=identity,arc=config.AutoSetNormalArc,cursor=0};api.RisingSetSearch=state
        end
