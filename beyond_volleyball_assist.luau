        if not search or search.ballId~=ball.Id then search={ballId=ball.Id,cursor=0};api.DumpContactSearch=search end
        if search.glideExhausted and host.now and(search.exhaustedAt and host.now()-search.exhaustedAt>0.18
            or search.exhaustedPosition and flat(context.position-search.exhaustedPosition).Magnitude>1.5)then
