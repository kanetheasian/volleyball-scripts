            if net and ball then
                local pose=root and root.CFrame
                local request=api.LastNativeSetRequest
                local requested=request and request.action=="Spike"and request.ballId==packet.Id and os.clock()-request.time<0.8
                if requested then pose=request.rootFrame end
                local observed=spikePlanner.Observe(packet,packet.Power or actionClient._power.Value,pose,ball,net,os.clock(),
                    {verticalSpeed=requested and request.verticalSpeed or root and root.AssemblyLinearVelocity.Y,
                        character=player.Character,calibrationScope=spikeCalibrationScope(),maximumPitch=Core.SpikeDumpPitchLimit(config)})
