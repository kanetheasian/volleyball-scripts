    local function mousePoint()
        local camera = workspace.CurrentCamera
        if not camera then return nil end
        local location = UIS:GetMouseLocation()
        local ray = camera:ScreenPointToRay(location.X, location.Y)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {player.Character, folder}
        local hit = workspace:Raycast(ray.Origin, ray.Direction * 600, params)
        if hit then return hit.Position end
        -- Aim at the court plane when the cursor points through empty court space.
        local part = getRoot()
        if part and ray.Direction.Y < -0.001 then
            local t = (part.Position.Y - 3 - ray.Origin.Y) / ray.Direction.Y
            if t > 0 and t < 600 then return ray.Origin + ray.Direction * t end
        end
        return nil
    end
