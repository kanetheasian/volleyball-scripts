                if context.setOffset then selected.nativeSetCenter=(plan.contactPoint or plan.point)+context.setOffset+Vector3.yAxis*(plan.rise or 0)end
                local choice=api.ChooseRecovery(plan.contact,selected,context.maxPower,plan.jump,ball.Acceleration.Y,ball.Radius,"Normal",backward)
