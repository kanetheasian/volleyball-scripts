            and Core.Finite(lower.rootHeight)and Core.Finite(upper.rootHeight)and Core.Finite(lower.verticalSpeed)and Core.Finite(upper.verticalSpeed)
            and upperRef-lowerRef<=math.rad(25)then
            local alpha=(pitch-lowerRef)/(upperRef-lowerRef)
            best=table.clone(lower);best.pitch=pitch;best.commandPitch=pitch;best.velocity=lower.velocity:Lerp(upper.velocity,alpha)
            best.spin=lower.spin:Lerp(upper.spin,alpha);best.acceleration=lower.acceleration:Lerp(upper.acceleration,alpha)
