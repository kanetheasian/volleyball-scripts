                if context.gliding~=nil and row.gliding==nil then e+=4 end
                if not context.samplePoseOptional and context.rootHeight and Core.Finite(row.rootHeight)then e+=math.abs(row.rootHeight-context.rootHeight)*2 end
                if not context.samplePoseOptional and context.verticalSpeed and Core.Finite(row.verticalSpeed)then e+=math.abs(row.verticalSpeed-context.verticalSpeed)*0.12 end
