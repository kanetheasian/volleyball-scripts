        return forecast and {landing=forecast.Landing,netHit=forecast.NetHit,netContact=forecast.NetContact,
            fullPath=not forecast.ShortPreview,seconds=forecast.Time,points=#forecast.Points,spinPending=forecast.SpinPending}
