-- Account-scoped named profiles and explicit autoload preference.
local function createProfileLibrary(host)
    local Core,fs=host.core,host.fs or {}
    local folder="BVLAssist/"..tostring(host.userId)
    local path=folder.."/library.json"
    local store={Data={Version=2,Profiles={},Selected="",AutoLoad=""},Path=path}
    store.Available=type(fs.readfile)=="function" and type(fs.writefile)=="function" and type(fs.makefolder)=="function"
    local function snapshot(values)
        local config=Core.Defaults()
        local ok,reason=Core.Import(config,values)
        if not ok then return nil,reason end
        return config
    end
    local function nameOf(value)
        if type(value)~="string" then return nil,"Enter a profile name" end
        local name=value:match("^%s*(.-)%s*$")
        if #name==0 or #name>40 or name:find("[%c]") then return nil,"Use a profile name from 1 to 40 characters" end
        return name
    end
    local function windowPosition(value)
        if type(value)~="table"then return nil end
        local clean={}
        for i=1,4 do
            if not Core.Finite(value[i])or math.abs(value[i])>1000000 then return nil end
            clean[i]=value[i]
        end
        return clean
    end
    local function readFile(file)
        if type(fs.readfile)~="function" then return nil end
        if fs.isfile and not fs.isfile(file) then return nil end
        local ok,value=pcall(fs.readfile,file)
        return ok and value or nil
    end
    local function decode(encoded)
        local data=host.decode(encoded)
        assert(type(data)=="table" and data.Version==2 and type(data.Profiles)=="table","Invalid profile library")
        local clean={Version=2,Profiles={},Selected="",AutoLoad=""}
        for key,entry in pairs(data.Profiles) do
            local name=nameOf(key)
            assert(name and name==key and type(entry)=="table","Invalid profile entry")
            local config,reason=snapshot(entry.Config);assert(config,reason)
            clean.Profiles[name]={Config=config,UpdatedAt=tonumber(entry.UpdatedAt) or 0}
            clean.Profiles[name].WindowPosition=windowPosition(entry.WindowPosition)
        end
        if type(data.Selected)=="string" and clean.Profiles[data.Selected] then clean.Selected=data.Selected end
        if type(data.AutoLoad)=="string" and clean.Profiles[data.AutoLoad] then clean.AutoLoad=data.AutoLoad end
        return clean
    end
    local function commit(data,persisted)
        if not store.Available then return false,"Executor file storage is unavailable" end
        if store.ReadError then return false,store.ReadError end
        local ok,err=pcall(function()
            for _,directory in ipairs({"BVLAssist",folder}) do
                if not fs.isfolder or not fs.isfolder(directory) then fs.makefolder(directory) end
            end
            local previous=readFile(path)
            if previous then fs.writefile(path..".bak",previous) end
            fs.writefile(path,host.encode(persisted or data))
        end)
        if not ok then return false,tostring(err) end
        store.Data=data
        return true
    end
    local encoded=readFile(path)
    if encoded then
        local ok,data=pcall(decode,encoded)
        if not ok then
            local backup=readFile(path..".bak")
            if backup then ok,data=pcall(decode,backup) end
            if ok then store.Recovered=true end
        end
        if ok then store.Data=data else store.ReadError="Could not read profile library; existing files were preserved" end
    else
        local legacy=readFile("BVLAssist/"..tostring(host.userId)..".json")
        if legacy then
            local ok,values=pcall(function()
                local data=host.decode(legacy)
                assert(data.Version==1,"Unsupported legacy profile")
                local config,reason=snapshot(data.Config);assert(config,reason);return config
            end)
            if ok then
                local data={Version=2,Profiles={["Imported profile"]={Config=values,UpdatedAt=0}},Selected="Imported profile",AutoLoad=""}
                local saved=commit(data)
                if not saved then store.Data=data end
            end
        end
    end
    function store.Names()
        local names={}
        for name in pairs(store.Data.Profiles) do names[#names+1]=name end
        table.sort(names,function(a,b)return a:lower()<b:lower()end)
        return names
    end
    function store.Save(name,values,position)
        local valid,reason=nameOf(name);if not valid then return false,reason end
        local config,err=snapshot(values);if not config then return false,err end
        local layout
        if position~=nil then
            layout=windowPosition(position)
            if not layout then return false,"Invalid window position"end
        else layout=store.WindowPosition(valid)end
        local data=table.clone(store.Data);data.Profiles=table.clone(data.Profiles)
        data.Profiles[valid]={Config=config,UpdatedAt=host.now and host.now() or 0,WindowPosition=layout};data.Selected=valid
        return commit(data)
    end
    function store.WindowPosition(name)
        local entry=store.Data.Profiles[name]
        return entry and windowPosition(entry.WindowPosition)or nil
    end
    function store.SaveWindowPosition(name,position)
        local entry=store.Data.Profiles[name]
        if not entry then return false,"Choose a saved profile"end
        local layout=windowPosition(position)
        if not layout then return false,"Invalid window position"end
        local data=table.clone(store.Data);data.Profiles=table.clone(data.Profiles)
        data.Profiles[name]=table.clone(entry);data.Profiles[name].WindowPosition=layout
        -- Layout-only writes must not persist settings migrations/defaults in
        -- profiles that the user has not saved, including this profile's config.
        local encoded=readFile(path)
        local persisted
        if encoded then
            local ok,raw=pcall(host.decode,encoded)
            if not ok or type(raw)~="table"or raw.Version~=2 or type(raw.Profiles)~="table"
                or type(raw.Profiles[name])~="table"then return false,"Could not preserve the existing profile library"end
            persisted=raw;persisted.Profiles[name].WindowPosition=table.clone(layout)
        end
        return commit(data,persisted)
    end
    function store.Select(name)
        if not store.Data.Profiles[name] then return false,"Choose a saved profile" end
        local data=table.clone(store.Data);data.Selected=name;return commit(data)
    end
    function store.Load(name)
        local entry=store.Data.Profiles[name]
        if not entry then return nil,"Choose a saved profile" end
        return snapshot(entry.Config)
    end
    function store.SetAutoload(enabled)
        local name=store.Data.Selected
        if enabled and not store.Data.Profiles[name] then return false,"Save or select a profile first" end
        local data=table.clone(store.Data);data.AutoLoad=enabled and name or "";return commit(data)
    end
    function store.Delete(name)
        if not store.Data.Profiles[name] then return false,"Choose a saved profile" end
        local data=table.clone(store.Data);data.Profiles=table.clone(data.Profiles);data.Profiles[name]=nil
        if data.Selected==name then data.Selected="" end
        if data.AutoLoad==name then data.AutoLoad="" end
        return commit(data)
    end
    function store.AutoloadConfig()
        if store.Data.AutoLoad=="" then return nil end
        return store.Load(store.Data.AutoLoad)
    end
    return store
end

-- Visual-only forecast tracking. No live ball, movement or action state is modified.
local function createVisualForecast(host)
    local Core,stepPhysics=host.core,host.stepPhysics
    local tracker={States={},FrameStep=1/60}
    local function vector(value)
        return value and Core.Finite(value.X) and Core.Finite(value.Y) and Core.Finite(value.Z)
    end
    local function snapshot(ball)
        return {Position=ball.Position,Velocity=ball.Velocity,Acceleration=ball.Acceleration or Vector3.zero,Spin=ball.Spin or Vector3.zero}
    end
    local function sameForces(a,b)
        return a and (a.Spin-(b.Spin or Vector3.zero)).Magnitude<0.0001
            and (a.Acceleration-(b.Acceleration or Vector3.zero)).Magnitude<0.0001
    end
    local function pendingSpin(state,ball,now)
        return state.kind=="Spike" and now<(state.spinPendingUntil or -math.huge)
            and (ball.Spin or Vector3.zero).Magnitude<0.0001
    end
    function tracker.Frame(dt)
        if not Core.Finite(dt) or dt<1/300 or dt>1/25 then return end
        tracker.FrameEstimate=tracker.FrameEstimate and tracker.FrameEstimate+(dt-tracker.FrameEstimate)*0.2 or dt
        dt=tracker.FrameEstimate
        local closest,distance=1/60,math.huge
        for _,candidate in ipairs({1/30,1/60,1/120,1/144,1/240})do
            local difference=math.abs(candidate-dt)
            if difference<distance then closest,distance=candidate,difference end
        end
        tracker.FrameStep=closest
    end
    function tracker.Reset(id)
        tracker.States[id]=nil
    end
    function tracker.Clear()
        table.clear(tracker.States)
    end
    function tracker.Observe(id,packet,now)
        if not id or not packet or not vector(packet.Position) or not vector(packet.Velocity) then return end
        local state=tracker.States[id] or {lastDraw=-math.huge,changingUntil=-math.huge}
        if packet.Kind then
            state.kind=packet.Kind
            state.spinPendingUntil=packet.Kind=="Spike" and now+0.5 or -math.huge
            state.contactUntil=now+((packet.Kind=="Spike" or packet.Kind=="Serve") and 0.35 or 0)
        end
        local previous=state.packet
        if previous and Core.Finite(packet.Time) and Core.Finite(previous.Time) then
            local elapsed=packet.Time-previous.Time
            if elapsed<=0 then return end -- Ignore duplicated/reordered unreliable packets.
            if elapsed<=0.35 then
                local expected=snapshot(previous)
                local time=0
                while time<elapsed do
                    local dt=math.min(tracker.FrameStep,elapsed-time)
                    expected.Position,expected.Velocity=stepPhysics(expected,dt)
                    time+=dt
                end
                local spin=packet.Spin or Vector3.zero
                local acceleration=packet.Acceleration or Vector3.zero
                local velocityError=(packet.Velocity-expected.Velocity).Magnitude
                local spinChange=(spin-previous.Spin).Magnitude
                local spinForceChange=(spin-previous.Spin):Cross(packet.Velocity).Magnitude
                local accelerationChange=(acceleration-previous.Acceleration).Magnitude
                if velocityError>2 or spinChange>math.max(0.5,previous.Spin.Magnitude*0.1) or spinForceChange>3 or accelerationChange>3 then
                    state.changingUntil=now+0.8
                end
                state.velocityError=velocityError
            end
        end
