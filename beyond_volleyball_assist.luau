    local function modelFor(context,pitch,pool)
        if context.maximumPitch and math.abs(pitch)>context.maximumPitch+0.0001 then return nil end
        local best,error
        local lower,upper,lowerRef,upperRef,lowerError,upperError
        for _,row in ipairs(pool)do
            local dh=math.abs(row.height-(context.origin.Y-context.net.floorY))
            local reference=context.autoSpikeAttack and not row.poseAtImpact and row.commandPitch or row.pitch
            local dp=math.abs(reference-pitch)
            local sameMode=(math.sin(reference)<=-0.3)==(math.sin(pitch)<=-0.3)
            local angleLimit=(context.cornerOnly or context.dumpAttack or context.autoSpikeAttack)and math.rad(0.25)or math.rad(4)
