            local revised=api.PlanMotion(job.ball,physical)
            job.plannedAt=at;job.needsDeliveryPlan=nil
            if revised then
                job.point=revised.point;job.contact=revised.contact;job.contactAt=at+revised.time
                job.jumpAt=at+revised.jumpAt;job.glide=revised.glide;job.glideDirection=revised.glideDirection
                job.lateCharge=revised.lateCharge;job.timingPhase=revised.timingPhase or job.timingPhase
                job.contactOffset=revised.contactOffset;job.desiredContactOffset=revised.desiredContactOffset
                local isQuickJob=job.play=="Quick"or job.play=="Short"or job.timingPhase=="Quick"or config.AutoSpikeTiming=="Quick"
                if job.preview and not isQuickJob then job.jumpAt=math.max(job.jumpAt,at+(physical.launchDelay or 0))end
