        if not side or depth<=4.5 then return 0 end
        local forward=flat(c.facingDirection)
        if forward.Magnitude<0.1 then return 0 end
        forward=forward.Unit
        local body=flat(c.velocity or Vector3.zero)
        local closing=flat(ball.Velocity-body):Dot(forward)
        if math.abs(forward:Dot(c.net.normal))>=0.75
            or flat(ball.Position-c.spikePosition):Dot(forward)>=-0.5 or closing<=2 then return 0 end
        -- Hold the swing until the ball has caught up to just behind the hand's
        -- centre along the cross direction; a ball hit from behind on a sharp
        -- cross clips the net. Never spend the window's final 70 ms.
        local cap=math.min(0.1,window.exit-window.enter-0.07)
        if cap<=0 then return 0 end
        local acceleration=flat(ball.Acceleration or Vector3.zero)
        for t=window.enter,window.enter+cap,1/120 do
            local position=ball.Position+ball.Velocity*t+acceleration*(0.5*t*t)
            if flat(position-(c.spikePosition+body*t)):Dot(forward)>=-0.35 then
                return math.max(0,t-window.enter)
            end
        end
        return cap
    end
    function api.PeakWindow(ball,c,window)
        if not window or c.force or not c.airborne or not Core.Finite(c.verticalVelocity)
            or not Core.Finite(c.gravity)or c.gravity<=0 then return window end
        -- Aim just before apex in the replicated pose, within real reach.
        local desired=c.verticalVelocity/c.gravity+(c.spikePoseLag or 0)-0.025
        local chosen=math.clamp(desired,window.enter,math.max(window.enter,window.exit-1/120))
        local result=table.clone(window)
        result.reachEnter=window.enter;result.preferredAt=chosen
        result.contact=Core.AdvanceBall(ball,host.stepPhysics,chosen).Position
        result.apexIn=desired;result.apexReachable=desired>=window.enter and desired<=window.exit
        return result
    end
    local function safe(point,c)
        if c.force then return true end
        local n=c.net
        local side=Core.Side(c.position,n)
        -- A set may leave the painted court and still be playable. Only the net
        -- separates the normal approach; reach and timing bound the pursuit.
        return side and(point-n.center):Dot(n.normal)*side>=1.5
    end
    function api.PlanMotion(ball,c)
        if not c.spikePosition or not c.spikeRadius or not c.groundY or not c.charge
            or not Core.Finite(c.jumpPower)or not Core.Finite(c.gravity)or c.gravity<=0 then return nil end
        local input=flat(c.moveDirection or Vector3.zero)
        local offset=c.spikePosition-c.position
        local best
        local poses={}
        local function pose(direction)
            local key=direction.Magnitude<0.1 and "Standing"or string.format("%.4f,%.4f",direction.X,direction.Z)
            if not poses[key]then
                local power,speed=c.jumpPower,c.glideSpeed
                if host.predictJump then
                    local forward=-c.net.normal*(Core.Side(c.position,c.net)or 1)
                    local p,s=host.predictJump(direction,c.position+forward*40,false)
                    if Core.Finite(p)and p>0 then power=p end
                    if Core.Finite(s)and s>=0 then speed=s end
                end
                poses[key]={power=power,speed=speed,direction=direction}
            end
            return poses[key]
        end
        local sim={Position=ball.Position,Velocity=ball.Velocity,Acceleration=ball.Acceleration or Vector3.new(0,-25,0),Spin=ball.Spin or Vector3.zero}
        local dt=1/30
        local started=host.clock and host.clock()
        local deadline=started and started+0.008
        local minHeight=c.force and c.net.floorY+2 or c.net.topY+(ball.Radius or 1.1)+0.3
        local play=c.receivedPlay or config.AutoSetPlay
        local timingPref=config.AutoSpikeTiming or "Dynamic"
        -- Request-to-contact observations include ball travel, not only native
        -- activation. Fast handoffs may be contacted immediately after Set.
        local afterSet=c.launchDelay and not c.force and((play=="Quick"or play=="Short")and 0.04
            or(host.contactLead and host.contactLead(c)or 0.16))or 0
        local samples={}
        for i=1,84 do
            sim.Position,sim.Velocity=host.stepPhysics(sim,dt)
            local t=i*dt+(c.launchDelay or 0)
            if sim.Position.Y<c.net.floorY+(ball.Radius or 1.1)then break end
            if sim.Position.Y>=minHeight and i*dt>=afterSet then
                samples[#samples+1]={position=sim.Position,velocity=sim.Velocity,time=t,step=i}
            end
        end
        local noWalk=config.AutoSpikeMove==false
        local runSpeed=(config.AutoSpikeSprint and not noWalk)and(c.sprintSpeed or(c.speed and c.speed>=10 and math.max(c.speed,40)or c.speed))or c.speed
        if play=="Quick"or play=="Short"or timingPref=="Quick"then
            table.sort(samples,function(a,b)return a.time<b.time end)
        elseif timingPref=="Late"then
            table.sort(samples,function(a,b)return a.time>b.time end)
        elseif timingPref=="Apex"then
            table.sort(samples,function(a,b)
                if math.abs(a.position.Y-b.position.Y)>0.01 then return a.position.Y>b.position.Y end
                return a.time<b.time
            end)
        else
            local playerDist=flat(sim.Position-c.position).Magnitude
            table.sort(samples,function(a,b)
                local aReachable=(a.time-c.charge-0.45)*runSpeed>=playerDist-6
                local bReachable=(b.time-c.charge-0.45)*runSpeed>=playerDist-6
                if aReachable~=bReachable then return aReachable end
                if math.abs(a.position.Y-b.position.Y)>0.01 then return a.position.Y>b.position.Y end
                return a.time<b.time
            end)
        end
        local searched,budget=0,false
        for _,sample in ipairs(samples)do
            if deadline and host.clock()>=deadline then budget=true;break end
            searched+=1
            sim.Position=sample.position
            local t=sample.time
            local toward=flat(sim.Position-offset-c.position)
            local blockPenalty=0
            local blockOpenBonus=0
            if config.AutoSpikeBlockEvade~=false and c.defenders and #c.defenders>0 and c.net then
                local side=Core.Side(c.position,c.net)or 1
                local ballAcross=(sim.Position-c.net.center):Dot(c.net.axis)
                local ballDepth=(sim.Position-c.net.center):Dot(c.net.normal)*side
                if ballDepth<=7 then
                    for _,def in ipairs(c.defenders)do
                        if Core.Side(def.position,c.net)==-side then
                            local defAcross=(def.position-c.net.center):Dot(c.net.axis)
                            local defDepth=math.abs((def.position-c.net.center):Dot(c.net.normal))
                            if defDepth<=8 then
                                local width=def.blockWidth or 6
                                local lateralDist=math.abs(ballAcross-defAcross)
                                if lateralDist<width*0.5+1.2 then
                                    local blockTop=(def.blockPosition and def.blockPosition.Y or(def.position.Y+4))+(def.blockHeight or 5)*0.5
                                    if def.airborne or sim.Position.Y<=blockTop+1.5 then
                                        if sample.velocity and math.abs(sample.velocity.Y)>2.5 then
                                            blockOpenBonus+=8
                                        else
                                            blockPenalty+=16
                                        end
                                    end
                                elseif lateralDist>width*0.5+2 then
                                    blockOpenBonus+=8
                                end
                            end
                        end
                    end
                end
            end
            local motions={Vector3.zero}
            if c.forcedGlideDirection and flat(c.forcedGlideDirection).Magnitude>0.1 then
                motions={flat(c.forcedGlideDirection).Unit}
            elseif(config.AutoSpikeGlide or c.manualSteering)and(c.glideSpeed or 0)>0 then
                if c.manualSteering and not(noWalk and c.force)then
                    if input.Magnitude>0.1 then motions={input.Unit}else motions={Vector3.zero}end
                else
                    local angle=math.atan2(toward:Dot(c.net.normal),toward:Dot(c.net.axis))
                    local octant=math.floor(angle/(math.pi/4)+0.5)
                    for _,shift in ipairs({0,-1,1})do
                        local a=(octant+shift)*math.pi/4
                        motions[#motions+1]=c.net.axis*math.cos(a)+c.net.normal*math.sin(a)
                    end
                    if noWalk and c.force and toward.Magnitude>0.1 then motions[#motions+1]=toward.Unit end
                end
            end
            for _,direction in ipairs(motions)do
            local native=pose(direction)
            local apex=native.power/c.gravity
            for _,fraction in ipairs({1.05,1,0.8,1.15,0.55,0.35,1.4})do
                local serverAir=apex*fraction
                local air=serverAir+(c.spikePoseLag or 0)
                local at=t-c.charge-air
                if c.launchDelay and(play=="Normal"or play=="Pipe")and not c.force and at<c.launchDelay then continue end
                local minAt=(play=="Quick"or play=="Short"or timingPref=="Quick")and -0.35 or(c.allowImmediate and -0.08 or 0.04)
                if at<minAt then continue end
                at=math.max(0,at)
                local rise=native.power*serverAir-0.5*c.gravity*serverAir*serverAir
                local reach=math.max(0.5,c.spikeRadius+(ball.Radius or 1.1)-0.45)
                local vertical=sim.Position.Y-(c.groundY+rise+offset.Y)
                if math.abs(vertical)>reach then continue end
                local horizontal=math.min(0.65,math.sqrt(math.max(0,reach*reach-vertical*vertical))*0.2)
                local moving=direction.Magnitude>0.1
                for _,chargeFraction in ipairs(moving and(noWalk and c.force or not c.manualSteering and not noWalk)and{0,1}or{1})do
                local chargeDistance=moving and(c.chargeSpeed or c.approachSpeed or c.speed)*c.charge*chargeFraction or 0
                local glideDistance=moving and native.speed*serverAir or 0
                local raw=Vector3.new(sim.Position.X-offset.X,c.groundY,sim.Position.Z-offset.Z)-direction*(chargeDistance+glideDistance)
                local delta=flat(raw-c.position)
                local desired=math.max(0,delta.Magnitude-horizontal)
                local effectiveSpeed=(delta.Magnitude>5 and config.AutoSpikeSprint and not noWalk and c.speed and c.speed>=10)and runSpeed or math.max(1,c.speed)
                local maxWalk=(c.manualSteering or noWalk)and 0 or at>0.06 and(at-0.06)*effectiveSpeed or 0
                local walk=noWalk and 0 or(c.allowImmediate and desired<=maxWalk+1.25 and math.min(desired,maxWalk)or desired)
                local request=noWalk and c.position or c.position+(delta.Magnitude>0.001 and delta.Unit*walk or Vector3.zero)
                if c.manualSteering and not noWalk then request=c.position+(input.Magnitude>0.1 and input.Unit*c.speed*at or Vector3.zero)end
                local distance=noWalk and 0 or flat(request-c.position).Magnitude
                local travel=(c.manualSteering or noWalk)and 0 or distance>0.1 and distance/effectiveSpeed+0.06 or 0
                if travel>at+1e-4 then continue end
                local takeoff=request+direction*chargeDistance
                local body=takeoff+direction*glideDistance
                local clientBody=takeoff+direction*(moving and native.speed*air or 0)
                local center=Vector3.new(body.X,c.groundY+rise,body.Z)+offset
                local gap=(sim.Position-center).Magnitude
                if gap>reach or not safe(request,c)or not safe(takeoff,c)or not safe(body,c)or not safe(clientBody,c)then continue end
                local side=Core.Side(c.position,c.net)
                if not c.force and play=="Pipe"and side and c.net.attackLines and c.net.attackLines[side]
                    and(takeoff-c.net.center):Dot(c.net.normal)*side<c.net.attackLines[side]+0.5 then continue end
                local apexLoss=math.max(0,native.power*native.power/(2*c.gravity)-rise)
                local horizontalGap=flat(sim.Position-center).Magnitude
                local movePenalty=moving and(noWalk and c.force and toward.Magnitude>0.5 and -2 or(config.AutoSpikeGlide and -1.2 or 0.8))or 0
                local timingBonus=0
                if timingPref=="Quick"and sample.velocity and sample.velocity.Y>1 then
                    timingBonus=sample.velocity.Y*1.5-t*3+(blockOpenBonus*0.5)-blockPenalty
                elseif timingPref=="Late"and sample.velocity and sample.velocity.Y< -1 then
                    timingBonus=-sample.velocity.Y*1.5+t*3+(blockOpenBonus*0.5)-blockPenalty
                elseif timingPref=="Dynamic"then
                    timingBonus=blockOpenBonus-blockPenalty
                else
                    timingBonus=blockOpenBonus*0.25-blockPenalty
                end
                local heightWeight=timingPref=="Apex"and 8 or 5
                local apexWeight=timingPref=="Apex"and 12 or 6
                local serverAirWeight=timingPref=="Apex"and 8 or 4
                local score=sim.Position.Y*heightWeight-horizontalGap*6-apexLoss*apexWeight-math.abs(serverAir-apex-0.025)*serverAirWeight-t*1.2-distance*0.25-movePenalty+timingBonus
                if moving and not(noWalk and c.force)and not config.AutoSpikeGlide then score-=chargeDistance*0.15 end
                -- Prefer the ball above the hand's center with contact reserve.
                -- A centered collision is reachable but gives away spike height.
                local upper=math.min(reach-0.2,c.spikeRadius*0.95)
                if not c.force then score+=math.clamp(vertical,0,upper)*9-math.max(0,-vertical)*10 end
                local flight=t-(c.launchDelay or 0)
                local distToTight=c.previewPoint and flat(takeoff-c.previewPoint).Magnitude
                    or(c.setterPosition and flat(takeoff-c.setterPosition).Magnitude)or 0
                if play=="Quick"or timingPref=="Quick"then score-=flight*35+horizontalGap*4+distToTight*18
                elseif play=="Short"then score-=flight*110+distance*3+(moving and 8 or 0)end
                if play=="Quick"and not c.force and moving and flat(ball.Velocity).Magnitude<15 then
                    -- A slow Quick can be met from a planted hop. Avoid adding
                    -- glide when a legal stationary interception is available.
                    score-=45
                end
                if not best or score>best.score then
                    best={point=request,takeoff=takeoff,contact=sim.Position,time=t,jumpAt=at,airTime=air,serverAirTime=serverAir,
                        glide=moving,glideDirection=direction,travel=travel,score=score,jumpPower=native.power,
                        contactOffset=vertical,desiredContactOffset=upper,lateCharge=moving and chargeFraction==0,
                        timingPhase=sample.velocity and(sample.velocity.Y>2.5 and "Quick"or sample.velocity.Y<-2.5 and "Late"or "Apex")or "Apex"}
                end
                end
                end
            end
        end
        api.LastMotionSearch={available=#samples,searched=searched,budgetExceeded=budget,
            elapsed=started and host.clock()-started or nil,found=best~=nil}
        return best
    end
    function api.CheckTakeoff(ball,c,time,direction,glide,lateCharge)
        if c.force or c.manualSteering or not Core.Finite(time)or not c.charge or time<=c.charge+0.06
            or not c.spikePosition or not c.spikeRadius or not c.gravity or c.gravity<=0 then return nil end
        direction=glide and direction or Vector3.zero
        local power,speed=c.jumpPower,c.glideSpeed or 0
        if host.predictJump then
            local forward=-c.net.normal*(Core.Side(c.position,c.net)or 1)
            local p,s=host.predictJump(direction,c.position+forward*40,false)
            if Core.Finite(p)and p>0 then power=p end
            if Core.Finite(s)and s>=0 then speed=s end
        end
        local reach=c.spikeRadius+(ball.Radius or 1.1)-0.45
        local side=Core.Side(c.position,c.net)
        local takeoff=c.position+direction*(c.chargeSpeed or c.approachSpeed or c.speed)*c.charge*(lateCharge and 0 or 1)
        if not safe(takeoff,c)or(config.AutoSetPlay=="Pipe"or c.receivedPlay=="Pipe")and side
            and c.net.attackLines and c.net.attackLines[side]
            and(takeoff-c.net.center):Dot(c.net.normal)*side<c.net.attackLines[side]+0.5 then return nil end
        for _,shift in ipairs({0,0.02,0.04,0.06})do
            local candidateTime=time+shift
            local clientAir=candidateTime-c.charge
            local air=clientAir-(c.spikePoseLag or 0)
            local ballTime=candidateTime-(c.launchDelay or 0)
            if air>=0.06 and ballTime>=0 then
                local body=takeoff+direction*speed*air
                local center=Vector3.new(body.X,c.groundY+power*air-0.5*c.gravity*air*air,body.Z)+c.spikePosition-c.position
                local contact=Core.AdvanceBall(ball,host.stepPhysics,ballTime).Position
                local minOffset=(config.AutoSetPlay=="Quick"or config.AutoSetPlay=="Short"or c.receivedPlay=="Quick"or c.receivedPlay=="Short")and 0 or c.spikeRadius*0.55
                if(contact-center).Magnitude<=reach and contact.Y-center.Y>=minOffset
                    and flat(contact-center).Magnitude<=1.5 and safe(body,c)
                    and safe(takeoff+direction*speed*clientAir,c)then
                    return{contact=contact,contactOffset=contact.Y-center.Y,airTime=air}
                end
            end
        end
        return nil
    end
    function api.GetTakeoffMove(character)
        if not config.AutoSpike or not config.AutoSpikeGlide or not job or job.character~=character
            or(config.AutoSpikeMove==false and not job.force)
            or job.emergency or not job.glide or not job.jumpIssued or job.airborne or job.requested
            or now()-job.jumpRequestedAt>job.charge+0.4 then return nil end
        return job.glideDirection
    end
    function api.GetMove(position,speed,dt)
        api.Move=Vector3.zero
        if not job or job.emergency or job.airborne or job.requested or not position
            or(config.AutoSpikeMove==false and not job.force)then return api.Move end
        if job.jumpIssued then api.Move=job.glide and not job.lateCharge and job.glideDirection or Vector3.zero;return api.Move end
        local delta=flat(job.point-position)
        if delta.Magnitude>0.3 then
            api.Move=delta.Unit*math.clamp((delta.Magnitude-0.2)/math.max(0.25,(speed or 1)*(dt or 1/60)*1.5),0,1)
        end
        return api.Move
    end
    local function shot(c,origin,locked,contactIn)
        local probe=table.clone(c)
        probe.plannedGlide=job and job.glide or c.nativeGlide==true
        probe.glideSpeed=c.airborne and flat(c.velocity or Vector3.zero).Magnitude or c.glideSpeed
        probe.ballRadius=job and job.ball.Radius or c.ballRadius
        if c.airborne and contactIn then
            local t=math.max(0,contactIn-(c.spikePoseLag or 0))
            probe.contactRoot=c.position+(c.velocity or Vector3.zero)*t-Vector3.yAxis*(c.gravity or 0)*t*t/2
        else
            local offset=c.spikePosition and c.spikePosition.Y-c.position.Y or 1.5
            probe.contactRoot=origin-Vector3.yAxis*(offset+(job and job.contactOffset or 3.9))
        end
        if c.airborne and locked then
            -- Native takeoff has already fixed the base yaw. The selected
            -- flight must use that same heading; only tilt remains adjustable.
            locked=c.facingDirection or locked
            probe.strictLock=true
        end
        local goal=host.planShot and host.planShot(probe,origin,locked)
        if goal and c.fixedPitch and math.abs((goal.pitch or 0)-c.fixedPitch)>math.rad(.25)then goal=nil end
        if goal then return goal end
        local side=Core.Side(c.position,c.net)
            or c.facingDirection and Core.Side(c.position-c.facingDirection,c.net)or 1
        local depth=math.abs((origin-c.net.center):Dot(c.net.normal))
        local lateral=(origin-c.net.center):Dot(c.net.axis)
        local lane=math.clamp(lateral*0.35,-(c.net.halfWidth-6),c.net.halfWidth-6)
        local point=c.net.center+c.net.axis*lane-c.net.normal*side*math.max(12,c.net.halfDepth*(depth<=10 and 0.55 or 0.72))
        if math.abs(lateral)>c.net.halfWidth-(c.ballRadius or 1.1)-0.75 then
            -- Clear the antenna toward a central lane. A blind far-sideline
            -- target spends nearly all landing tolerance on a guessed launch.
            local across=c.net.halfWidth-(c.ballRadius or 1.1)-1.25
            local available=across*math.max(.1,depth)/math.max(.1,math.abs(lateral)-across)
            local targetDepth=math.max(1.75,math.min(c.net.halfDepth*.35,available))
            point=c.net.center-c.net.normal*side*targetDepth
        end
        local direction=locked or flat(point-origin)
        if direction.Magnitude<0.01 then direction=-c.net.normal*side end
        local fallbackPitch=depth>20 and math.rad(12)
            or(origin.Y>=c.net.topY+5.5 and -math.rad(16)or 0)
        return{point=point,direction=direction.Unit,power=c.maxPower,
            pitch=c.fixedPitch or fallbackPitch,
            shot="Uncalibrated Spike",calibrated=false}
    end
    local function prepare(c,goal)
        if not goal then return end
        if host.power then host.power(goal.power or c.maxPower)end
        if c.rotationOpen==true and not job.rotationLocked and not config.AutoSpikeLateAim and host.face then
            host.face(goal.direction and c.position+goal.direction*60 or goal.point,false)
        end
        if not c.manualTilt and host.pitch then host.pitch(goal.pitch or 0,false,job.emergency and "Set"or "Spike")end
    end
    local function publish()
        api.LastPlan={ballId=job.ball.Id,revision=job.revision,play=job.play,
            point=job.point,contact=job.contact,contactAt=job.contactAt,jumpAt=job.jumpAt,
            glide=job.glide,glideDirection=job.glideDirection,phase="Approach",force=job.force,tool=job.tool,
            contactOffset=job.contactOffset,desiredContactOffset=job.desiredContactOffset,preview=job.preview==true,previewSource=job.previewSource,
            fromPreview=job.fromPreview==true,previewLead=job.previewLead,lateCharge=job.lateCharge==true,
            timingPhase=job.timingPhase}
    end
    local function planManualJump(ball,c)
        if c.airborne then
            local w=host.contactWindow(ball,c,0.6)
                or(c.spikePosition and Core.SpikeContact(ball,c.spikePosition,c.velocity,c.gravity,(c.spikeRadius or 3.5)+(ball.Radius or 1.1)+3,host.stepPhysics,0.8))
            return w and{point=c.position,contact=w.contact,time=w.enter,jumpAt=0,
                glide=c.nativeGlide,glideDirection=flat(c.nativeGlideVelocity or c.moveDirection or Vector3.zero),
                score=1000-w.enter}or nil
        end
        local physical=table.clone(c);physical.manualSteering=true;physical.allowImmediate=true
        local plan=api.PlanMotion(ball,physical)
        if plan then return plan end
        if not c.spikePosition or not c.spikeRadius or not c.jumpPower or not c.gravity then return nil end
        local dir=flat(c.moveDirection or Vector3.zero)
        local glideDir=dir.Magnitude>0.1 and dir.Unit or Vector3.zero
        local origin=c.spikePosition+glideDir*(c.glideSpeed or 0)*0.15
        local v0=glideDir*(c.glideSpeed or 0)+Vector3.new(0,c.jumpPower,0)
        local w=Core.SpikeContact(ball,origin,v0,c.gravity,c.spikeRadius+(ball.Radius or 1.1)+3,host.stepPhysics,0.9)
        return w and{point=c.position,contact=w.contact,time=w.enter,jumpAt=0,
            glide=glideDir.Magnitude>0.1,glideDirection=glideDir,score=500-w.enter}or nil
    end
    local function acquireManualJump(c,takeoffNow)
        if job or not config.AutoSpike or config.AutoSpikeMove~=false or not c or not c.ready or c.manual then return false end
        local at=now()
        local candidates=table.clone(c.balls or{})
        if Core.SetPlays[c.receivedPlay or config.AutoSetPlay]and c.previewCandidate and not c.airborne then
            local actual=false
            for _,v in ipairs(candidates)do if v.ball.Id==c.previewCandidate.ball.Id and api.Eligible(v,false)then actual=true;break end end
            if not actual then candidates[#candidates+1]=c.previewCandidate end
        end
        local best,candidate
        for _,forceEligible in ipairs({false,true})do
            for _,v in ipairs(candidates)do
                if api.Eligible(v,forceEligible)and(not forceEligible or not v.preview)then
                    local physical=c
                    if v.preview then physical=table.clone(c);physical.launchDelay=v.launchDelay end
                    local plan=planManualJump(v.ball,physical)
                    if plan and(not best or plan.score>best.score)then best,candidate=plan,v end
                end
            end
            if best then break end
        end
        if not best then return false end
        job={ball=candidate.ball,revision=candidate.revision or 0,character=c.character,created=at,
            point=c.position,contact=best.contact,contactAt=at+best.time,jumpAt=at,
            glide=best.glide,glideDirection=best.glideDirection,charge=c.charge,airborne=c.airborne,
            jumpIssued=true,jumpRequestedAt=takeoffNow and at-(c.charge or 0.4)or at,
            force=c.force,tool=c.tool,plannedAt=at,preview=candidate.preview,
            fromPreview=candidate.preview==true,previewLead=candidate.preview and candidate.launchDelay or nil,
            play=c.receivedPlay or config.AutoSetPlay,
            expectedSetAt=candidate.preview and at+(candidate.launchDelay or 0)or nil,
            contactOffset=best.contactOffset,desiredContactOffset=best.desiredContactOffset,
            overrideOnly=false,manualJump=true,takeoffDirection=c.airborne and c.facingDirection or nil,
            rotationLocked=c.airborne==true,timingPhase=best.timingPhase or "Apex"}
