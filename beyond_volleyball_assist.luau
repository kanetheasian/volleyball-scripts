            contactProjected=true,launchDelay=contactAt-host.now(),
            phase=job.requested and "Armed"or "Planning",pitch=choice.pitch or 0,launchAir=air,launchBack=backward,launchGlide=choice.launchGlide==true,
            acceleration=job.ball.Acceleration or Vector3.new(0,-25,0),radius=job.ball.Radius or 1.1,
