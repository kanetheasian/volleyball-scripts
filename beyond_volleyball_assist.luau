        for _,kind in ipairs(tryStanding and {"Jump","Ground"}or {"Ground"})do
            planningDeadline=reserve and started+reserve or nil;api.PlanningBudgetHit=false
            local search=table.clone(context);search.glideSpeed=nil
            search.requireJump=kind=="Jump";search.shallowJumpSupport=kind=="Jump"
