        local last=#forecast.Points
        local points={}
        local offset=vector(renderPosition) and renderPosition-ball.Position or Vector3.zero
        if offset.Magnitude>6 then offset=Vector3.zero end
        for index=1,last do
            local time=(index-1)*dt
            points[index]=forecast.Points[index]+offset*math.max(0,1-time/0.15)
        end
        local polyline=tracker.Polyline(points,curved and 128 or 64,curved and 0.035 or 0.08)
        forecast.DisplayPoints=polyline
        forecast.ShortPreview=false
        forecast.PreviewSeconds=math.min(horizon,forecast.Time or seconds)
        forecast.Changing=changing
        forecast.Curved=curved
        forecast.SpinPending=spinPending
        forecast.Step=dt
        forecast.EstimatedLanding=changing or spinPending or forecast.HorizonLimited==true
        -- Keep time-indexed simulation points for presentation. Adaptive chord indices
        -- change with curve phase and must not be used to match successive frames.
        state.segmentCount=math.max(state.segmentCount or 0,curved and 128 or math.max(8,#polyline-1))
        state.target={forecast=forecast,at=now,duration=forecast.Time or seconds,
            horizon=forecast.PreviewSeconds,maximum=state.segmentCount}
        if state.drawPhysics and not sameForces(state.drawPhysics,ball) then state.display=nil end
        state.drawPhysics=snapshot(ball);state.spinPending=spinPending
        state.lastDraw=now;state.dirty=false
        tracker.States[id]=state
        return forecast
    end
    local function sample(points,step,duration,time)
        if time<=0 or #points==1 then return points[1] end
        if time>=duration then return points[#points] end
        local index=math.min(math.floor(time/step)+1,#points-1)
        local span=math.min(step,duration-(index-1)*step)
        return points[index]:Lerp(points[index+1],math.clamp((time-(index-1)*step)/math.max(span,1e-9),0,1))
    end
    local function sampleHistory(display,time)
        if time<=display.horizon then return sample(display.points,display.step,display.horizon,time)end
        if time-display.horizon>0.1 then return nil end
        local points=display.points
        if #points<2 or display.endsAtLanding then return points[#points]end
        return points[#points]+(points[#points]-points[#points-1])*(time-display.horizon)/display.step
    end
    function tracker.Present(id,now,renderPosition)
        local state=tracker.States[id]
        local target=state and state.target
        if not target then return nil end
        local forecast=target.forecast
        local age=math.max(0,now-target.at)
        local horizon=math.max(0,target.horizon-age)
        local previous=nil -- New forecasts replace old geometry immediately; no stale-flight blending.
        local elapsed=previous and math.max(0,now-previous.at) or 0
        local alpha=previous and 1-math.exp(-elapsed/0.045) or 1
        local start=sample(forecast.Points,forecast.Step,target.duration,age)
        -- A large authoritative correction must snap instead of trailing an old arc.
        if previous then
            local old=sample(previous.points,previous.step,previous.horizon,elapsed)
            if elapsed>0.2 or (old-start).Magnitude>6 then previous=nil;alpha=1 end
        end
        if previous then
            local remaining=math.max(0,previous.horizon-elapsed)
            horizon=math.min(math.max(0,target.duration-age),remaining+(horizon-remaining)*alpha)
        end
        local count=horizon>0 and target.maximum or 0
        local step=count>0 and horizon/count or 1
        local points={}
        for index=0,count do
            local time=index*step
            local desired=sample(forecast.Points,forecast.Step,target.duration,age+time)
            if previous then
                local old=sampleHistory(previous,elapsed+time)
                if old then desired=old:Lerp(desired,alpha)end
            end
            points[index+1]=desired
        end
        local landing=forecast.Landing
        if landing and previous and previous.landing then landing=previous.landing:Lerp(landing,alpha) end
        state.display={at=now,points=points,step=step,horizon=horizon,landing=landing,
            endsAtLanding=forecast.Landing~=nil and not forecast.ShortPreview}
        local displayed={}
        local offset=vector(renderPosition) and renderPosition-points[1] or Vector3.zero
        if offset.Magnitude>6 then offset=Vector3.zero end
        for index,point in ipairs(points)do
            displayed[index]=point+offset*math.max(0,1-(index-1)*step/0.15)
        end
        return {DisplayPoints=displayed,Landing=landing,Time=forecast.Time and math.max(0,forecast.Time-age),
            NetHit=forecast.NetHit,NetContact=forecast.NetContact,HorizonLimited=forecast.HorizonLimited,
            Changing=forecast.Changing,ShortPreview=forecast.ShortPreview,EstimatedLanding=forecast.EstimatedLanding,
            SpinPending=forecast.SpinPending,
            PreviewSeconds=horizon,Step=forecast.Step}
    end
    return tracker
end

