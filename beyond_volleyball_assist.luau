    end
    function api.CloseNormalPower(origin,target,maximum,backward)
        local desired=backward and host.normalCloseBackPower or host.normalClosePower
        if not desired or not target.net or (maximum or 15)<desired
            or flat(target.position-origin).Magnitude>(host.normalCloseRange or 16)then return nil end
        return desired
    end
    function api.PreferNormalAttackHeight(height,target,best)
        local desired=api.NormalAttackHeight(target)
        local previousHeight=best and (best.predictedAttackHeight or best.contact and best.contact.Y)
        if host.normalFloat and config.AutoSetNormalArc=="High"and desired and previousHeight then
            local gap=math.abs(height-desired)-math.abs(previousHeight-desired)
            if math.abs(gap)>0.15 then return gap<0 end
        end
        if not desired or not previousHeight then return nil end
        local high,previousHigh=height>=desired,previousHeight>=desired
        if high~=previousHigh then return high end
