                    job.requested=at;api.LastPlan.phase="Spike armed";api.LastPlan.requestAt=at
                    api.LastPlan.requestBallPosition=job.ball.Position;api.LastPlan.requestSpikePosition=c.spikePosition
                    api.LastPlan.requestDistance=c.spikePosition and(job.ball.Position-c.spikePosition).Magnitude
                    api.LastPlan.requestReach=c.spikeRadius+(job.ball.Radius or 1.1)
                    api.LastPlan.predictedContactIn=window and window.enter
                    api.LastPlan.preferredApexContactIn=window and window.preferredAt
                    status(c.tool and(job.goal.tool and "Block-edge Spike attempt armed"or "No reachable edge: Spike armed")or "Spike armed before contact")
                else status("Native Spike rejected; waiting")end
            end
            if remaining< -0.65 and not window then
                local ball,revision=job.ball,job.revision
                release("Spike window passed without confirmed contact")
