    function Core.InCourt(position, net, margin)
        local offset = flat(position-net.courtCenter)
        return math.abs(offset:Dot(net.axis)) <= net.halfWidth-(margin or 0)+0.0001
            and math.abs(offset:Dot(net.normal)) <= net.halfDepth-(margin or 0)+0.0001
    end
    function Core.NearbySpikeCourt(position,courts,maximum)
        local best,distance,second
        for _,net in ipairs(courts)do
            if Core.InCourt(position,net)then return net end
            local offset=flat(position-net.courtCenter)
            local across=math.max(0,math.abs(offset:Dot(net.axis))-net.halfWidth)
            local deep=math.max(0,math.abs(offset:Dot(net.normal))-net.halfDepth)
            local gap=math.sqrt(across*across+deep*deep)
            if gap<=(maximum or 10)then
                if not distance or gap<distance then second=distance;best,distance=net,gap
                elseif not second or gap<second then second=gap end
            end
        end
        return best and (not second or second-distance>0.5) and best or nil
    end
    function Core.SetAimPoint(position, net, origin, inset)
        local side = Core.Side(origin,net)
        if not side then return nil end
        local along = math.clamp(flat(position-net.center):Dot(net.axis),-net.halfWidth,net.halfWidth)
        return net.center + net.axis*along + net.normal*side*math.clamp(inset or 0.2,0,net.halfDepth-1)
    end
    function Core.NormalSetPoint(position,net,origin)
        local point=Core.SetAimPoint(position,net,origin,Core.SetPlays.Normal.netInset)
        if not point then return nil end
        return Vector3.new(point.X,(net.topY or net.center.Y)+Core.SetPlays.Normal.contactLift,point.Z)
    end
    function Core.SetAttackForward(facing,net,side,airborne)
        local forward=-net.normal*(side or 1)
        local flatFacing=facing and flat(facing)
        if airborne and flatFacing and flatFacing.Magnitude>.1 and flatFacing.Unit:Dot(forward)>.15 then return flatFacing.Unit end
        return forward
    end
    function Core.PlayerAttackBand(groundCenter,jumpRise,radius,netTop,ballRadius,heightLift)
        local center=groundCenter+math.clamp(jumpRise,0,20)
        local lift=math.clamp(heightLift or 0,0,1.5)
        local baseMinimum=math.max(netTop+(ballRadius or 1.1)+0.5,center+radius*0.65)
        local maximum=math.max(baseMinimum,center+radius+(ballRadius or 1.1)*0.35)
        local minimum=math.min(maximum,baseMinimum+lift)
        return {minimum=minimum,ideal=math.clamp(center+radius*0.95+lift,minimum,maximum),maximum=maximum,center=center,
            contactMaximum=center+radius+(ballRadius or 1.1)*0.9}
    end
    function Core.AntennaTop(net,parts)
        local tops={}
        local edge=net.part and net.part.Size.X/2 or net.halfWidth
        for _,part in ipairs(parts)do
            local f,s=part.CFrame,part.Size
            local height=math.abs(f.RightVector.Y)*s.X+math.abs(f.UpVector.Y)*s.Y+math.abs(f.LookVector.Y)*s.Z
            local width=math.abs(f.RightVector:Dot(net.axis))*s.X+math.abs(f.UpVector:Dot(net.axis))*s.Y+math.abs(f.LookVector:Dot(net.axis))*s.Z
            local thick=math.abs(f.RightVector:Dot(net.normal))*s.X+math.abs(f.UpVector:Dot(net.normal))*s.Y+math.abs(f.LookVector:Dot(net.normal))*s.Z
            local offset=part.Position-net.center
            local across=offset:Dot(net.axis)
            local top=part.Position.Y+height/2
            if width<=0.6 and thick<=0.6 and height>=0.5 and top>net.topY+1.5
                and math.abs(offset:Dot(net.normal))<0.4 and math.abs(across)>=math.max(net.halfWidth-1,edge-4)
                and math.abs(across)<=edge+1 then
                local side=math.sign(across);tops[side]=math.max(tops[side]or -math.huge,top)
            end
        end
        if tops[-1]and tops[1]and math.abs(tops[-1]-tops[1])<=0.5 then return math.max(tops[-1],tops[1])end
    end
    function Core.UpperAttackBand(band,antennaTop,ballRadius,heightTrim)
        local result=table.clone(band)
        -- The ball center may sit above the visible sphere while its lower
        -- surface still overlaps. Reserve ten percent of the ball radius.
        if band.contactMaximum then
            result.maximum=math.max(band.maximum,band.contactMaximum)
            result.ideal=math.max(band.ideal,result.maximum-0.2)
        end
        result.recoveryMinimum=band.minimum
        result.preferredMinimum=math.max(band.minimum,result.ideal-0.5,antennaTop and antennaTop+0.15 or -math.huge)
        result.minimum=math.min(result.maximum,result.preferredMinimum)
        result.ideal=math.clamp(math.max(result.ideal,result.minimum),result.minimum,result.maximum)
        result.heightLimited=result.preferredMinimum>result.maximum
        result.unreachable=band.minimum>result.maximum
        -- Match the lower Normal target used during live-player tuning.
        -- Keep the physical center and reachable recovery floor unchanged.
        local trim=math.clamp(heightTrim or 0,0,1.5)
        if trim>0 then
            local floor=result.recoveryMinimum or result.minimum
            result.maximum=math.max(floor,result.maximum-trim)
            result.ideal=math.clamp(result.ideal-trim,floor,result.maximum)
            result.preferredMinimum=math.max(floor,result.preferredMinimum-trim)
            result.minimum=math.clamp(result.preferredMinimum,floor,result.maximum)
        end
        return result
    end
    function Core.SampleHitterReach(reach,grounded,centerY,groundY,rootY,velocityY,gravity,defaultRise)
        reach=reach or {}
        defaultRise=math.clamp(defaultRise or 7.2,0,20)
        reach.groundCenter=reach.groundCenter or centerY-math.max(0,rootY-groundY)
        if grounded then
            reach.groundCenter=centerY
            if reach.airRise then
                local history=reach.recentRises or {defaultRise,defaultRise}
                history[#history+1]=math.clamp(reach.airRise,0,20)
                if #history>3 then table.remove(history,1)end
                reach.recentRises=history
                local sorted=table.clone(history);table.sort(sorted)
                reach.jumpRise=sorted[math.ceil(#sorted/2)]
                reach.airRise=nil
            end
        else
            local rise=centerY-reach.groundCenter
            if rise>0.75 then
                local projected=rise+math.max(0,velocityY)^2/(2*math.max(1,gravity))
                reach.airRise=math.max(reach.airRise or 0,projected)
            end
        end
        reach.jumpRise=reach.jumpRise or defaultRise
        return reach
    end
    function Core.SampleBotMotion(previous,object,position,now)
        local points={}
        if previous and previous.object==object and now-previous.time<=0.35
            and flat(position-previous.position).Magnitude<=8 then
            for _,p in ipairs(previous.points)do if now-p.time<=0.55 then points[#points+1]=p end end
        else previous=nil end
        local last=points[#points]
        if not last or flat(position-last.position).Magnitude>0.005 or now-last.time>=0.2 then
            points[#points+1]={position=flat(position),time=now}
        end
        local velocity,acceleration=Vector3.zero,Vector3.zero
        last=points[#points]
        if #points>=3 and last.time-points[1].time>=0.15 then
            local sums={0,0,0,0,0};local ys={Vector3.zero,Vector3.zero,Vector3.zero}
            for _,p in ipairs(points)do
                local t=p.time-last.time;local power=1
                for i=1,5 do sums[i]+=power;if i<=3 then ys[i]+=p.position*power end;power*=t end
            end
            local m={{sums[1],sums[2],sums[3]},{sums[2],sums[3],sums[4]},{sums[3],sums[4],sums[5]}}
            local valid=true
            for col=1,3 do
                local pivot=m[col][col]
                if math.abs(pivot)<1e-8 then valid=false;break end
                for j=col,3 do m[col][j]/=pivot end;ys[col]/=pivot
                for row=1,3 do if row~=col then
                    local factor=m[row][col]
                    for j=col,3 do m[row][j]-=factor*m[col][j]end;ys[row]-=ys[col]*factor
                end end
            end
            if valid then
                acceleration=ys[3]*2
                if acceleration.Magnitude>8 then acceleration=acceleration.Unit*8 end
                velocity=ys[2]+acceleration*math.min(0.15,now-last.time)
            end
        elseif #points>=2 then
            local first=points[1];local dt=last.time-first.time
            if dt>0 then velocity=(last.position-first.position)/dt end
        end
        if velocity.Magnitude>45 then velocity=Vector3.zero;acceleration=Vector3.zero end
        if now-last.time>0.2 then velocity=Vector3.zero;acceleration=Vector3.zero end
        return {object=object,position=position,time=now,points=points,velocity=velocity,acceleration=acceleration}
    end
    function Core.LimitAirTurn(current,anchor,desired,dt,rate,limit)
        local a=flat(anchor.LookVector).Unit
        local b=flat(current.LookVector).Unit
        local d=flat(desired.LookVector).Unit
        local function angle(x,y)return math.atan2(x:Cross(y).Y,math.clamp(x:Dot(y),-1,1))end
        local nowAngle=angle(a,b)
        local desiredAngle=math.clamp(angle(a,d),-math.rad(limit),math.rad(limit))
        local step=math.rad(rate)*math.clamp(dt,0,0.1)
        local nextAngle=nowAngle+math.clamp(desiredAngle-nowAngle,-step,step)
        local frame=CFrame.lookAt(current.Position,current.Position+a)*CFrame.Angles(0,nextAngle,0)
        local result=Core.YawOnlyFrame(current,current.Position+frame.LookVector)
        return result,math.abs(angle(frame.LookVector,d))>math.rad(0.5)
    end
    function Core.QuickSetPoint(position,net,origin,velocity,spikeRadius)
        local point=Core.SetAimPoint(position,net,origin,Core.SetPlays.Quick.netInset)
        if not point then return nil end
        local side=Core.Side(origin,net)
        local depth=side and (position-net.center):Dot(net.normal)*side
        local line=side and net.attackLines and net.attackLines[side]
        if depth and depth>0 and (not line or depth<line)then
            local forward=math.min(0,(velocity or Vector3.zero):Dot(net.normal)*side)*0.25
            local clearance=math.clamp((spikeRadius or 3.5)*0.5,1.5,2.5)
            local attackDepth=math.min(Core.SetPlays.Quick.netInset,math.max(0.25,depth+forward-clearance))
            attackDepth=math.min(attackDepth,math.max(0.25,depth-0.25))
            local lateral=(position-net.center):Dot(net.axis)
            point=net.center+net.axis*math.clamp(lateral,-net.halfWidth,net.halfWidth)+net.normal*side*attackDepth
        end
        return Vector3.new(point.X,(net.topY or net.center.Y)+Core.SetPlays.Quick.contactLift,point.Z)
    end
    function Core.CreateSetPlanner(config)
        local planner={Config=config}
        planner.SetAimPoint=function(position,net,origin) return Core.SetAimPoint(position,net,origin,config.SetNetInset) end
        installSetTargetLead(planner)
