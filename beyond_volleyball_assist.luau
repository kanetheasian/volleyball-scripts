            emergency=true,emergencyReason=reason,power=goal.power,pitch=goal.pitch,aim=goal.point,landing=goal.landing,
            cornerValidated=goal.cornerValidated,safeLanding=goal.safeLanding,landingTime=goal.time}
        return true
    end
    local function tickEmergency(c,at)
        local lead=math.clamp((c.ping or 0)+0.1,0.1,0.2)
        if not job.requested and(not job.checkedAt or at-job.checkedAt>=0.08)then
            job.checkedAt=at
            local spike
            if c.airborne then spike=host.contactWindow(job.ball,c,0.5)else spike=api.PlanMotion(job.ball,c)end
            if spike then release("Spike contact recovered");searchAt=nil;api.Tick(c);return end
        end
        local goal=job.goal
        if c.manualSteering and not job.requested then
            local context=table.clone(c);context.emergencyPrepared=job.preparedAt and at-job.preparedAt or 0
            local revised=host.emergency(job.ball,context,c.airborne and c.facingDirection or nil,job.reason)
            if emergencyGoal(revised)then
                goal=revised;job.goal=goal;job.contactAt=at+(goal.contactDelay or goal.window.enter)
            end
