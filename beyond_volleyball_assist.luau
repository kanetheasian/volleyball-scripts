        local sample={key=mode(plan),time=now,height=plan.origin.Y,pitch=plan.pitch or 0,
            contactBasis=(plan.contactProjected and 1 or 0)+(plan.contactDelay and 2 or 0),
            h=h.Magnitude,v=plan.velocity.Y,heading=h.Unit,incoming=incoming.Unit,
            dh=actualH.Magnitude-h.Magnitude,dv=actual.velocity.Y-plan.velocity.Y,turn=turn,
            along=flat(delta):Dot(incoming.Unit),dy=delta.Y}
        if math.abs(sample.dh)>10 or math.abs(sample.dv)>8 then return false end
        api.Samples[#api.Samples+1]=sample
        if #api.Samples>64 then table.remove(api.Samples,1)end
