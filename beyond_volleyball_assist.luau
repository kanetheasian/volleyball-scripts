        if not defenseRequest then clearReceiveMove("Manual action");receiveManualUntil=os.clock()+0.25 end
        if autoSet and autoSet.IsBusy() then autoSet.Cancel("Manual action: "..tostring(name))end
        if UIS:GetFocusedTextBox() then return end
        if (name == "Set" or name=="SetFront") and config.SetAim then beginSet(false)
        elseif name == "SetBack" and config.BackAim then beginSet(true)
        elseif name == "Receive" and config.ReceiveAim then
            if not receiveAim then prepareReceiveAim("manual",0,0.2) else updateReceiveAim() end
        end
    end
    local autoUsed={}
    local sprintStep
    local function resolveSprintStep()
        if sprintStep then return sprintStep end
        local read=getupvalues or debug and debug.getupvalues
        local input=actionClient._inputService
        if not read or type(input.GetToBind)~="function" then return nil end
        local handler=input:GetToBind("Sprint")
        local nativeSource=debug.info(actionClient._bindSprint,"s")
        local seen={}
        local function find(fn,depth)
            if type(fn)~="function" or seen[fn] or depth>5 then return end
            seen[fn]=true
            local values=read(fn)
            local ownsInput,nativeFunctions=false,0
            for _,value in pairs(values)do
                if value==input then ownsInput=true end
                if type(value)=="function" and debug.info(value,"s")==nativeSource then nativeFunctions+=1 end
            end
            if ownsInput and nativeFunctions==2 then
                sprintStep=fn
                local constants=getconstants or debug and debug.getconstants
                if constants then
                    for _,value in pairs(values)do
                        if type(value)=="function"and debug.info(value,"s")==nativeSource then
                            local ok,items=pcall(constants,value)
                            if ok and type(items)=="table"then
                                local idle,trait=false,false
                                for _,item in pairs(items)do
                                    if item=="IsState"then idle=true end
                                    if item=="Stamina_Consumption_In_Action_Bool"then trait=true end
                                end
                                if idle and trait then api._receiveSprintGate=value end
                            end
                        end
                    end
                end
                return
            end
            for _,value in pairs(values)do if type(value)=="function"then find(value,depth+1);if sprintStep then return end end end
        end
        find(handler,0)
        return sprintStep
    end
    local function requestNativeSprint(reasonKey)
        local staminaOk,staminaError=pcall(api.RefillStamina)
        if not staminaOk then report("stamina refill",staminaError)end
        local step=resolveSprintStep()
        if not step then api[reasonKey]="Native sprint callback unavailable";return movement:GetSetSpeed(),false end
        local counter=movement.SprintUnits or actionClient._activeSprints
        local before=counter and counter.Value
        local beforeSpeed=movement:GetSetSpeed()
        local ok,err=pcall(step)
        local speed=movement:GetSetSpeed()
        local after=counter and counter.Value
        local accepted=ok and (Core.Finite(speed) and speed>beforeSpeed+0.05
            or Core.Finite(before) and Core.Finite(after) and after>before)
        api[reasonKey]=not ok and ("Native sprint failed: "..tostring(err)) or accepted and "Native sprint burst" or "Native sprint waiting for cooldown / stamina / action"
        return speed,accepted
    end
    local botMotionSamples=setmetatable({},{__mode="k"})
    local function autoSetTargets(context)
        local bots={}
        for _,model in ipairs(CollectionService:GetTagged("HitboxBot"))do
            local part=model:FindFirstChild("Spike")
            if model:GetAttribute("Enabled")~=false and model:GetAttribute("HitboxName")=="Spike" and part and part:IsA("BasePart")then
                local net=courtAt(part.Position,true)
                if net and net.part==context.net.part and Core.Side(part.Position,net)==Core.Side(context.position,net)then
                    local look=(model.PrimaryPart or part).CFrame.LookVector
                    local previous=botMotionSamples[model]
                    local sample=Core.SampleBotMotion(previous,model,part.Position,os.clock())
                    botMotionSamples[model]=sample
                    bots[#bots+1]={object=model,position=part.Position,velocity=sample.velocity,acceleration=sample.acceleration,radius=part.Size.X/2,net=net,
                        hitboxFrame=part.CFrame,hitboxSize=part.Size,
                        approachPosition=(model.PrimaryPart or part).Position,
                        slope=(math.abs(look.Y)+0.3)/math.max(0.15,math.abs(look:Dot(net.normal)))}
                end
            end
        end
        table.sort(bots,function(a,b)return (a.position-context.net.center):Dot(context.net.axis)<(b.position-context.net.center):Dot(context.net.axis)end)
        for i,target in ipairs(bots)do target.index=i;target.name=i==1 and "Outside bot" or i==#bots and "Opposite bot" or "Spike bot "..i end
        return bots
    end
