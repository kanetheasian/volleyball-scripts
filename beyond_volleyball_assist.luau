        end
        local lead=host.contactLead and host.contactLead(c)or math.clamp((c.ping or 0)+0.1,0.12,0.24)
        local window=c.airborne and host.contactWindow(job.ball,c,0.5)
        -- Recheck the actual airborne contact while tilt still has time to
        -- settle. Waiting for the swing window freezes a ground-plan pitch.
        local prepareDue=not job.jumpIssued and job.jumpAt-at<=0.18 or c.airborne and(window~=nil or not job.goal)or(job.jumpIssued and not job.goal)
        if prepareDue and not job.requested and(not job.shotAt or at-job.shotAt>=0.08 or job.tool~=job.shotTool)then
