    local function heartbeat(dt)
        if not api.Alive then return end
        if spikePlan or config.SpikeAim then
            local airborne=actionClient:_getAirborneJump()
            if not airborne or not config.SpikeAim and not config.TakeoffAim or jump._blocking.Value or setAim or autoSet.IsBusy() then
                clearSpikeAim();if not airborne then spikeSwingLocked=false end
            elseif config.SpikeAim and not spikeSwingLocked and os.clock()-lastSpikeUpdate>=0.09 then
                local ok,err=pcall(updateSpikeTilt);if not ok then report("spike aim",err)end
            end
        end
        updateReceivePower()
        updateServeSpin()
        if config.AutoSet or api.AutoSetOverride or api.DumpHeld or autoSet.IsBusy() then
            local ok,err=pcall(function()autoSet.Tick(autoSetContext())end)
            if not ok then report("auto set",err);autoSet.Cancel("Auto set error");config.AutoSet=false end
        end
        visualForecast.Frame(dt)
        local part, humanoid, character = getRoot()
        if not part or not humanoid then clearReceiveMove("Waiting for character");clearAim(); return end
        local balls = ballService.RenderedBallMap._map
        if config.StaminaEnabled and not player:GetAttribute("Spec_NoAction") then
            local maximum = player:GetAttribute("MaxStamina")
            if Core.Finite(maximum) and maximum > 0 and movement.Stamina.Value < maximum then movement.Stamina.Value = maximum end
        end
        if not autoSet.IsBusy() and (config.AutoReceive or config.AutoDive or config.ReceiveAim) then
            local ok, err = pcall(defense, balls, part, humanoid, character,dt)
            if not ok then report("defense",err); config.AutoReceive, config.AutoDive = false,false;clearReceiveMove("Defense error");clearReceiveAim() end
        else clearReceiveMove(autoSet.IsBusy() and "Auto Set priority" or "Receive movement disabled")end
        -- Forecasts are presented on RenderStepped; auxiliary UI stays throttled.
        local auxiliaryDue=os.clock()-lastFrame>=0.05
        if auxiliaryDue then lastFrame=os.clock();sampleTargets() end
        if auxiliaryDue then updateVolumes(character);updateLabels()end
        api.NativeState = (machine:GetCurrent() or {}).Name or "Idle"
    end
